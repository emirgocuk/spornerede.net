# Content Engine — GIT'E EKLEMEYIN (.env olarak kopyalayin)

# ===== PocketBase (zorunlu) =====
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# ===== OpenRouter (zorunlu) =====
# Anahtari ASLA repoya commit etmeyin. Sohbette paylasildiysa OpenRouter'da yenileyin.
OPENROUTER_API_KEY=

# Birincil: https://openrouter.ai/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
SEO_OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Yedek (birincil 429/hata):
SEO_OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-v4-flash:free

SEO_LLM_PROVIDER=openrouter

# ===== Davranis =====
SEO_USE_PAID_APIS=false
SEO_DAILY_ARTICLE_LIMIT=1
SEO_AUTO_PUBLISH=false

# ===== Google Search Console =====
# Kurulum: content-engine/GSC-KURULUM-tr.md
SEO_GSC_SITE_URL=sc-domain:spornerede.net

# Yontem A — service account (GSC arayuzunde "e-posta bulunamadi" olabilir)
SEO_GSC_AUTH_MODE=service_account
SEO_GSC_SERVICE_ACCOUNT_PATH=./secrets/gsc-service-account.json

# Yontem B — OAuth (mulk sahibi kisisel Google hesabi; onerilen yedek)
# SEO_GSC_AUTH_MODE=oauth
# SEO_GSC_OAUTH_CLIENT_PATH=./secrets/gsc-oauth-client.json
# SEO_GSC_OAUTH_TOKEN_PATH=./secrets/gsc-oauth-token.json

# ===== Site (ic link) =====
SITE_URL=https://spornerede.net
