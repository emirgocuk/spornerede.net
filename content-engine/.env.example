# Content Engine — GIT'E EKLEMEYIN (.env olarak kopyalayin)

# ===== PocketBase (zorunlu) =====
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# ===== OpenRouter (zorunlu) =====
# Anahtari ASLA repoya commit etmeyin. Sohbette paylasildiysa OpenRouter'da yenileyin.
OPENROUTER_API_KEY=

# Birincil + yedek + virgulle ek modeller (429/bos yanit → siradaki)
SEO_OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
SEO_OPENROUTER_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free
SEO_OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m2.5:free
SEO_OPENROUTER_MAX_MODEL_TRIES=4
SEO_OPENROUTER_REQUEST_TIMEOUT_MS=90000
# NOT: nvidia/llama-nemotron-embed-vl-1b-v2:free embedding modelidir, chat listesine eklemeyin

SEO_LLM_PROVIDER=openrouter
SEO_DRAFT_FAIL_SOFT=true

# ===== Davranis =====
SEO_USE_PAID_APIS=false
SEO_DAILY_ARTICLE_LIMIT=1
# Otonom SEO haber: llm = tam uretim, ozgun (varsayilan)
# template_llm | template | hybrid = sablon tabanli (deneme icin)
SEO_NEWS_MODE=llm
SEO_LLM_REWRITE=true
SEO_TEMPLATE_LLM_POLISH=true
SEO_NEWS_TEMPLATE_AUTO_PUBLISH=true
SEO_AUTO_PUBLISH=false

# ===== Google Search Console =====
# Kurulum: content-engine/GSC-KURULUM-tr.md
SEO_GSC_SITE_URL=sc-domain:spornerede.net

# Yontem A — service account (GSC arayuzunde "e-posta bulunamadi" olabilir)
SEO_GSC_AUTH_MODE=service_account
SEO_GSC_SERVICE_ACCOUNT_PATH=./secrets/gsc-service-account.json

# Yontem B — OAuth (mulk sahibi kisisel Google hesabi; onerilen yedek)
# SEO_GSC_AUTH_MODE=oauth
# SEO_GSC_OAUTH_CLIENT_PATH=./secrets/gsc-oauth-client.json
# SEO_GSC_OAUTH_TOKEN_PATH=./secrets/gsc-oauth-token.json

# dusuk_performans / CTR kurallari (job:gsc)
SEO_GSC_LOW_PERF_WEEKS=4
SEO_GSC_LOW_PERF_MAX_IMPRESSIONS=10
SEO_GSC_LOW_CTR_MIN_IMPRESSIONS=50
SEO_GSC_LOW_CTR_MAX=0.03

# ===== Site (ic link) =====
SITE_URL=https://spornerede.net
