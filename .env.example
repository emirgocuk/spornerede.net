# SporNerede.net — Ortam Değişkenleri
# Bu dosyayı .env olarak kaydedin ve GIT'e EKLEMEYİN!

# ===== SMTP (E-posta) Ayarları =====
SMTP_HOST=mail.spornerede.net
SMTP_PORT=587
SMTP_USER=info@spornerede.net
SMTP_PASS=BURAYA_SMTP_SIFRENIZI_YAZIN
MAIL_FROM=no-reply@spornerede.net

# E-postaların gönderileceği alıcı (kurucu) adresi
MAIL_TO=murat@spornerede.net
MAIL_QUEUE_TOKEN=

# ===== Site URL =====
SITE_URL=https://spornerede.net
PORT=3000
HOST=127.0.0.1

# ===== PocketBase =====
# Ornek: http://127.0.0.1:8090
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# ===== Basit Admin Erişimi =====
# /admin endpointleri icin Bearer token
ADMIN_TOKEN=

# ===== ImageBB =====
# Haber/editor ve panel geri bildirim gorselleri icin
IMGBB_API_KEY=

# ===== Production Backup =====
# Ornek: backup@1.2.3.4:/srv/backups/spornerede
OFFSITE_BACKUP_TARGET=
LOCAL_RETENTION_DAYS=7
OFFSITE_RETENTION_DAYS=30

# ===== Kulüp başvurusu — havale/EFT (public, /basvuru) =====
PUBLIC_BANK_IBAN=TR970003200000000151985050
PUBLIC_BANK_ACCOUNT_NAME=Murat Aktaş
PUBLIC_BANK_NAME=Türk Ekonomi Bankası (TEB)
PUBLIC_BANK_BRANCH=Etimesgut şubesi

# ===== Analytics & Ads (Faz 13 — olcum; AdSense sonra) =====
# ONEMLI: PUBLIC_* degiskenleri BUILD sirasinda okunur. Sunucuda /opt/spornerede/.env
# icine yazip deploy/build sonrasi aktif olur (deploy/server-auto-update.sh env yukler).
#
# Adim 1 — Google Analytics 4: analytics.google.com → Yeni mülk → spornerede.net
# Adim 2 — Google Tag Manager: tagmanager.google.com → GTM-XXXXXXX olustur
# Adim 3 — GTM icinde:
#   - Consent Overview: Google tag + Additional consent "analytics_storage" / "ad_storage"
#   - Tag: GA4 Configuration (Measurement ID = G-XXXX), tetikleyici All Pages
#   - Her custom event icin GA4 Event tag (view_club, view_listing, search_performed,
#     lead_phone_click, lead_email_click, lead_maps_click, application_submit,
#     application_success, contact_form_submit, feedback_submit)
# Adim 4 — Asagidaki ID'leri doldur, deploy et, GA4 DebugView ile dogrula
#
PUBLIC_GTM_ID=

# GTM kullaniyorsaniz bos birakin. Sadece GTM yoksa dogrudan GA4 icin:
PUBLIC_GA4_ID=

# Server-side first-party log (opsiyonel; simdilik stdout). Rastgele uretin:
INTERNAL_TRACK_TOKEN=

# Reklam yayini (AdSense vb.) — simdilik BOS birakin. Aktif: "adsense" / "direct" / "custom"
PUBLIC_AD_PROVIDER=

# ===== Content Engine (izole SEO otopilot) =====
# Ayri dosya: content-engine/.env.example → content-engine/.env
# Ana site .env ile PB admin ayni olabilir; OpenRouter key sadece content-engine/.env icinde.
