# SporNerede.net — Ortam Değişkenleri
# Bu dosyayı .env olarak kaydedin ve GIT'e EKLEMEYİN!

# ===== SMTP (E-posta) Ayarları =====
SMTP_HOST=mail.spornerede.net
SMTP_PORT=587
SMTP_USER=info@spornerede.net
SMTP_PASS=BURAYA_SMTP_SIFRENIZI_YAZIN
MAIL_FROM=no-reply@spornerede.net

# E-postaların gönderileceği alıcı (kurucu) adresi
MAIL_TO=murat@spornerede.net
MAIL_QUEUE_TOKEN=

# ===== Site URL =====
SITE_URL=https://spornerede.net
PORT=3000
HOST=127.0.0.1

# ===== PocketBase =====
# Ornek: http://127.0.0.1:8090
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# ===== Basit Admin Erişimi =====
# /admin endpointleri icin Bearer token
ADMIN_TOKEN=

# ===== ImageBB =====
# Haber/editor ve panel geri bildirim gorselleri icin
IMGBB_API_KEY=

# ===== Production Backup =====
# Ornek: backup@1.2.3.4:/srv/backups/spornerede
OFFSITE_BACKUP_TARGET=
LOCAL_RETENTION_DAYS=7
OFFSITE_RETENTION_DAYS=30

# ===== Kulüp başvurusu — havale/EFT (public, /basvuru) =====
PUBLIC_BANK_IBAN=TR970003200000000151985050
PUBLIC_BANK_ACCOUNT_NAME=Murat Aktaş
PUBLIC_BANK_NAME=Türk Ekonomi Bankası (TEB)
PUBLIC_BANK_BRANCH=Etimesgut şubesi

# ===== Analytics & Ads =====
# Google Tag Manager Container ID (ornek: GTM-XXXXXXX)
# Bos birakilirsa GTM enjekte edilmez.
PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (ornek: G-XXXXXXXXXX)
# Genelde GTM uzerinden yonetildigi icin opsiyoneldir.
PUBLIC_GA4_ID=

# Server-side first-party event log icin internal token (rastgele uretin)
INTERNAL_TRACK_TOKEN=

# Reklam yayini aktif mi? Bos = pasif, "adsense" / "direct" / "custom"
# Aktif edildiginde AdSlot component'i gorunur hale gelir.
PUBLIC_AD_PROVIDER=

# ===== Content Engine (izole SEO otopilot) =====
# Ayri dosya: content-engine/.env.example → content-engine/.env
# Ana site .env ile PB admin ayni olabilir; OpenRouter key sadece content-engine/.env icinde.
