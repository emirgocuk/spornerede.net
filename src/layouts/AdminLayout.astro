---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'SporNerede yönetim paneli' } = Astro.props;
const pageTitle = `${title} | SporNerede`;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
  </head>
  <body class="admin-body">
    <slot />
  </body>
</html>

<style is:global>
  html,
  body.admin-body,
  html:has(.admin-body) {
    margin: 0;
    min-height: 100vh;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    background: #f1f5f9;
    font-family: 'Outfit', system-ui, sans-serif;
    color: #0f172a;
  }

  .admin-body *,
  .admin-body *::before,
  .admin-body *::after {
    box-sizing: border-box;
  }

  /* Admin Paneli Açık / Beyaz Tema Scrollbar Düzenlemesi */
  html:has(.admin-body),
  .admin-body,
  .admin-body * {
    scrollbar-color: #cbd5e1 #f8fafc !important;
    scrollbar-width: thin !important;
  }

  html:has(.admin-body)::-webkit-scrollbar,
  .admin-body ::-webkit-scrollbar,
  .admin-body::-webkit-scrollbar {
    width: 6px !important;
    height: 6px !important;
  }

  html:has(.admin-body)::-webkit-scrollbar-track,
  .admin-body ::-webkit-scrollbar-track,
  .admin-body::-webkit-scrollbar-track {
    background: #f8fafc !important;
    border-radius: 8px !important;
  }

  html:has(.admin-body)::-webkit-scrollbar-thumb,
  .admin-body ::-webkit-scrollbar-thumb,
  .admin-body::-webkit-scrollbar-thumb {
    background: #cbd5e1 !important;
    border-radius: 8px !important;
    border: 1px solid #f8fafc !important;
  }

  html:has(.admin-body)::-webkit-scrollbar-thumb:hover,
  .admin-body ::-webkit-scrollbar-thumb:hover,
  .admin-body::-webkit-scrollbar-thumb:hover {
    background: #94a3b8 !important;
  }
</style>
