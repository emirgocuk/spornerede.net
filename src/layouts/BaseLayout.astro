---
/**
 * BaseLayout.astro
 * SporNerede.net için ortak sayfa şablonu.
 * Tüm sayfalar bu layout'u kullanır.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PanelFeedback from '../components/PanelFeedback.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import TrackingAutoListeners from '../components/TrackingAutoListeners.astro';
import {
  organizationSchema,
  websiteSchema,
  jsonLdScript,
  breadcrumbSchema,
  SITE_OG_DEFAULT,
} from '../lib/seo/jsonld';

export type BreadcrumbProp = { name: string; url: string };

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  canonical?: string;
  noIndex?: boolean;
  /** Sayfa basina ek JSON-LD nodes (Course / SportsActivityLocation / ItemList vb.) */
  jsonLd?: unknown | unknown[];
  /** Sayfa basina breadcrumb (otomatik BreadcrumbList JSON-LD eklenir) */
  breadcrumbs?: BreadcrumbProp[];
}

const {
  title,
  description,
  keywords = 'turkiye spor kulupleri, cocuk spor kursu, spor branslari, futbol kursu, yuzme kursu, karate kursu',
  ogImage,
  ogType = 'website',
  canonical,
  noIndex = false,
  jsonLd,
  breadcrumbs,
} = Astro.props;

const siteUrl = 'https://spornerede.net';
const fullTitle = `${title} | SporNerede.net`;
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const resolvedOgImage = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${siteUrl}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`
  : SITE_OG_DEFAULT;

// Analytics network ipuclari sadece GTM/GA gercekten enjekte ediliyorsa eklenir.
// Aksi halde Lighthouse "Unused preconnect" uyarisi cikariyor.
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? '';
const hasAnalytics = Boolean(gtmId || ga4Id);

// Her sayfaya her zaman Organization + WebSite enjekte et
const globalJsonLd: unknown[] = [organizationSchema(), websiteSchema()];
if (breadcrumbs && breadcrumbs.length > 0) {
  globalJsonLd.push(breadcrumbSchema(breadcrumbs));
}
const pageJsonLd: unknown[] = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const combinedJsonLd = jsonLdScript([...globalJsonLd, ...pageJsonLd]);
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ===== SEO TEMEL ===== -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="tr-TR" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
  {noIndex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  }

  <!-- ===== OPEN GRAPH ===== -->
  <meta property="og:type"        content={ogType} />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={resolvedOgImage} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"      content="tr_TR" />
  <meta property="og:site_name"   content="SporNerede.net" />

  <!-- ===== TWITTER CARD ===== -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={resolvedOgImage} />
  <meta name="twitter:site"        content="@Spor_Nerede" />

  <!-- ===== FAVICON ===== -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- ===== NETWORK IPUCLARI (sadece analytics aktifse) ===== -->
  {hasAnalytics && (
    <>
      <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
      <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
      <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    </>
  )}

  <!-- ===== SELF-HOSTED FONT PRELOAD — LCP icin ===== -->
  <link
    rel="preload"
    href="/fonts/outfit/outfit-latin-700-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    rel="preload"
    href="/fonts/outfit/outfit-latin-400-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <!-- ===== THEME COLOR (mobil tarayıcı üst bar) ===== -->
  <meta name="theme-color" content="#E30A17" />

  <!-- ===== JSON-LD: Organization + WebSite + (sayfa bazli ek schema) ===== -->
  <script type="application/ld+json" set:html={combinedJsonLd} is:inline></script>

  <!-- ===== ANALYTICS: GTM / GA4 (consent-aware) ===== -->
  <GoogleTagManager />
</head>

<body>
  <GoogleTagManagerNoscript />

  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 btn btn-primary z-[9999]">
    İçeriğe Geç
  </a>

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />
  <PanelFeedback />
  <ConsentBanner />
  <TrackingAutoListeners />
</body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .focus\:not-sr-only:focus {
    position: absolute;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>
