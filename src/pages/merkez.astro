    tabButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        const tabKey = button.getAttribute('data-tab-target') || 'dashboard';
        switchTab(tabKey);
        if (tabKey === 'applications' && !cachedApps.length) {
          await loadApplications();
        }
        if (tabKey === 'clubs' && !cachedClubs.length) {
          await loadClubs();
        }
        if (tabKey === 'contact' && !cachedContactMessages.length) {
          await loadContactMessages();
        }
        if (tabKey === 'feedback' && !cachedFeedbacks.length) {
          await loadFeedbacks();
        }
        if (tabKey === 'news' && !cachedNews.length) {
          await loadNews();
        }
        if (tabKey === 'guides') {
          await guidesAdmin?.loadGuides();
        } else {
          await destroyRichTextEditor('guide-icerik');
          await destroyRichTextEditor('news-editor');
        }
        if (tabKey === 'pricing') {
          await loadMembershipPlansAdmin();
        }
      });
    });

    loadPricingBtn?.addEventListener('click', () => loadMembershipPlansAdmin());

    loadButton?.addEventListener('click', async () => {
      await loadApplications();
    });

    loadClubsButton?.addEventListener('click', async () => {
      await loadClubs();
    });

    loadContactButton?.addEventListener('click', async () => {
      await loadContactMessages();
    });

    loadFeedbacksButton?.addEventListener('click', async () => {
      await loadFeedbacks();
    });

    loadNewsBtn?.addEventListener('click', async () => {
      await loadNews();
    });

    downloadBackupBtn?.addEventListener('click', async () => {
      await downloadManualBackup();
    });

    addNewsBtn?.addEventListener('click', () => {
      selectedNewsId = 0;
      renderNewsList();
      renderNewsDetail(0);
    });

    newsListEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const deleteBtn = target.closest('button[data-delete-news-id]');
      if (deleteBtn) {
        event.preventDefault();
        event.stopPropagation();
        const id = Number(deleteBtn.getAttribute('data-delete-news-id'));
        if (id) await deleteNewsItem(id);
        return;
      }
      const button = target.closest('button[data-news-id]');
      if (!button) return;
      const id = Number(button.getAttribute('data-news-id'));
      if (id !== undefined) {
        await renderNewsDetail(id);
      }
    });

    searchInput?.addEventListener('input', () => {
      renderList();
    });

    clubSearchInput?.addEventListener('input', () => {
      renderClubsList();
    });

    contactSearchInput?.addEventListener('input', () => {
      renderContactMessagesList();
    });

    feedbackSearch?.addEventListener('input', () => {
      renderFeedbacksList();
    });

    statusFilter?.addEventListener('change', () => {
      renderList();
    });

    contactFilter?.addEventListener('change', () => {
      renderContactMessagesList();
    });

    contactViewSelect?.addEventListener('change', async () => {
      contactView = contactViewSelect instanceof HTMLSelectElement ? contactViewSelect.value : 'inbox';
      selectedContactMessageId = 0;
      if (contactDetailEl) {
        contactDetailEl.innerHTML = `
          <div class="empty-state">
            <div class="empty-icon">✉️</div>
            <h3>Mesaj Seçin</h3>
            <p>İletişim formundan gelen mesajları görüntülemek için soldan bir kayıt seçin.</p>
          </div>`;
      }
      await loadContactMessages();
    });

    feedbackFilter?.addEventListener('change', () => {
      renderFeedbacksList();
    });

    // Ana Sayfa hızlı işlem kısayolları (data-switch-to)
    document.querySelectorAll('[data-switch-to]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-switch-to');
        if (!target) return;
        const tabBtn = document.querySelector(`.admin-tab[data-tab-target="${target}"]`);
        if (tabBtn instanceof HTMLElement) {
          tabBtn.click();
        } else {
          switchTab(target);
        }
      });
    });

    // Init
    switchTab('dashboard');
    loadApplications().catch(() => undefined);
    loadContactMessages().catch(() => undefined);
    loadFeedbacks().catch(() => undefined);
  </script>

