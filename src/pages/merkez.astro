    /** Content Engine konusu (HTML yorumu); editore gitmez */
    function parseNewsOzetMeta(raw) {
      const html = String(raw ?? '');
      const match = html.match(/<!--\s*ce-konu:([\s\S]*?)\s*-->/i);
      const konu = match?.[1]?.trim() ?? '';
      const body = konu ? html.replace(/<!--\s*ce-konu:[\s\S]*?-->\s*/i, '').trim() : html;
      return { konu, body };
    }

