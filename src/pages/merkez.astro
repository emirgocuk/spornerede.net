              ? `<button id="close-feedback-btn" class="btn btn-outline" type="button">Kapatıldı Olarak İşaretle</button>` 
              : `<button id="reopen-feedback-btn" class="btn btn-outline" type="button">Yeniden Aç (İncelendi)</button>`}
          </div>
        `;

        document.getElementById('close-feedback-btn')?.addEventListener('click', async () => {
          await apiPost('/api/admin/feedbacks', { id: feedbackId, durum: 'kapandi' });
          feedback.durum = 'kapandi';
          updateNotificationBadges();
          renderFeedbackDetail(feedbackId);
        });

        document.getElementById('reopen-feedback-btn')?.addEventListener('click', async () => {
          await apiPost('/api/admin/feedbacks', { id: feedbackId, durum: 'incelendi' });
          feedback.durum = 'incelendi';
          updateNotificationBadges();
          renderFeedbackDetail(feedbackId);
        });

      } catch (error) {
        renderDetailError(error.message);
      }
    }

    async function loadFeedbacks() {
      if (!feedbacksListEl) return;
      feedbacksListEl.innerHTML = '<li class="loading-state"><div class="spinner-small"></div> Yükleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/feedbacks');
        cachedFeedbacks = rows || [];
        updateNotificationBadges();
        if (selectedFeedbackId && !cachedFeedbacks.some((f) => f.id === selectedFeedbackId)) {
          selectedFeedbackId = 0;
        }
        renderFeedbacksList();
        if (selectedFeedbackId) {
          await renderFeedbackDetail(selectedFeedbackId);
        }
      } catch (error) {
        feedbacksListEl.innerHTML = `<li class="error-state">${error.message}</li>`;
        if (feedbackDetailEl) {
          feedbackDetailEl.innerHTML = '<div class="error-state">Geribildirimler yüklenemedi.</div>';
        }
      }
    }

    function getFilteredClubs() {
      const query = clubSearchInput?.value?.trim()?.toLowerCase() || '';
      return cachedClubs.filter((item) => {
        if (!query) return true;
        const haystack = `${item.ad || ''} ${item.il || ''} ${item.ilce || ''}`.toLowerCase();
        return haystack.includes(query);
      });
    }

    function renderClubsList() {
      if (!clubsListEl) return;
      const filtered = getFilteredClubs();
      if (!filtered.length) {
        clubsListEl.innerHTML = '<li class="empty-list">Kulüp bulunamadı.</li>';
        return;
      }
      clubsListEl.innerHTML = filtered
        .map((club) => {
          const activeClass = club.id === selectedClubId ? 'is-active' : '';
          return `<li>
            <button class="list-item ${activeClass}" data-club-id="${club.id}">
              <div class="item-main">
                <span class="item-title">${club.ad}</span>
                <span class="item-meta">📍 ${club.il || '-'} / ${club.ilce || '-'}</span>
              </div>
            </button>
          </li>`;
        })
        .join('');
    }

    function renderClubDetailLoading() {
      if (!clubDetailEl) return;
      clubDetailEl.innerHTML = '<div class="loading-state"><div class="spinner"></div><p>Detay yükleniyor...</p></div>';
    }

    function renderClubPrograms(programs) {
      return buildClubProgramsSectionHtml(programs, adminBransList);
    }

    async function renderClubDetail(clubId) {
