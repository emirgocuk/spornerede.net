                  <textarea id="club-admin-note" class="modern-textarea" rows="3" placeholder="Gerekçe, eksik evrak, kontrol notu...">${club.adminNotu || ''}</textarea>
                </div>
                <button id="save-club-note-btn" class="btn btn-dark w-full" type="button">Notları Kaydet</button>
              </section>

              <section class="card-section border-green">
                <div class="section-head">
                  <span class="icon">👤</span>
                  <h3>Sorumlu Kişi Hesabı</h3>
                </div>
                <p class="section-help text-sm">Kulüp adına panele giriş yapacak yönetici hesabı.</p>
                ${linkedUsersHtml}
                <div class="form-group">
                  <label>Hesap E-posta</label>
                  <input id="club-provision-email" class="modern-input" type="email" value="${club.email || ''}" />
