    async function renderContactMessageDetail(messageId) {
      selectedContactMessageId = messageId;
      renderContactMessagesList();
      renderContactDetailLoading();
      try {
        const message = await apiGet(`/api/admin/contact-messages?id=${messageId}`);
        if (!message.okundu && !message.copKutusu) {
          await apiPost('/api/admin/contact-messages', { id: messageId, okundu: true });
          const cached = cachedContactMessages.find((item) => item.id === messageId);
          if (cached) cached.okundu = true;
          contactInboxUnreadCount = Math.max(0, contactInboxUnreadCount - 1);
          updateNotificationBadges();
          renderContactMessagesList();
          message.okundu = true;
        }

        if (!contactDetailEl) return;
        contactDetailEl.innerHTML = `
          <div class="detail-header">
            <div class="detail-title-area">
              <span class="kicker">İLETİŞİM MESAJI #${message.id}</span>
              <h2>${escapeHtml(message.adSoyad)}</h2>
            </div>
            <div class="detail-status">
              ${
                message.cevaplandi
                  ? '<span class="status-badge status-approved">Cevaplandı</span>'
                  : '<span class="status-badge status-pending">Takipte</span>'
              }
            </div>
          </div>

          <div class="detail-grid detail-grid--single">
            <section class="card-section">
              <div class="section-head">
                <span class="icon">✉️</span>
                <h3>Mesaj İçeriği</h3>
              </div>
              <div class="info-list">
                <div class="info-item">
                  <span class="label">Konu</span>
                  <span class="value">${escapeHtml(message.konu || '-')}</span>
                </div>
                <div class="info-item">
                  <span class="label">Gönderim Tarihi</span>
                  <span class="value">${formatDate(message.createdAt)}</span>
                </div>
                <div class="info-item">
                  <span class="label">Mesaj</span>
                  <span class="value text-box">${escapeHtml(message.mesaj || '-')}</span>
                </div>
              </div>
            </section>

            <section class="card-section">
              <div class="section-head">
                <span class="icon">📞</span>
                <h3>Gönderen Bilgileri</h3>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <span class="label">E-posta</span>
                  <span class="value"><a href="mailto:${escapeHtml(message.email)}">${escapeHtml(message.email || '-')}</a></span>
                </div>
                <div class="info-item">
                  <span class="label">Telefon</span>
                  <span class="value">${escapeHtml(message.telefon || '-')}</span>
                </div>
              </div>
              <div class="contact-actions">
                ${
                  message.copKutusu
                    ? `<button id="restore-contact-message" class="btn btn-primary" type="button">Gelen Kutusuna Geri Al</button>`
                    : `<button id="toggle-contact-answered" class="btn btn-primary" type="button">
                  ${message.cevaplandi ? 'Cevaplandı Etiketini Kaldır' : 'Cevaplandı Olarak İşaretle'}
                </button>
                <button id="mark-contact-unread" class="btn btn-outline" type="button">Okunmadı Yap</button>
                <button id="trash-contact-message" class="btn btn-outline btn-danger-outline" type="button">Çöp Kutusuna Taşı</button>`
                }
              </div>
            </section>
          </div>
        `;

        document.getElementById('toggle-contact-answered')?.addEventListener('click', async () => {
          const nextAnswered = !message.cevaplandi;
          await apiPost('/api/admin/contact-messages', { id: messageId, cevaplandi: nextAnswered });
          const cached = cachedContactMessages.find((item) => item.id === messageId);
          if (cached) cached.cevaplandi = nextAnswered;
          await renderContactMessageDetail(messageId);
        });

        document.getElementById('mark-contact-unread')?.addEventListener('click', async () => {
          await apiPost('/api/admin/contact-messages', { id: messageId, okundu: false });
          const cached = cachedContactMessages.find((item) => item.id === messageId);
          if (cached) cached.okundu = false;
          contactInboxUnreadCount = Math.max(0, contactInboxUnreadCount + 1);
          updateNotificationBadges();
          renderContactMessagesList();
        });

        document.getElementById('trash-contact-message')?.addEventListener('click', async () => {
          if (!confirm('Bu mesajı çöp kutusuna taşımak istiyor musunuz?')) return;
          await apiPost('/api/admin/contact-messages', { id: messageId, trash: true });
          selectedContactMessageId = 0;
          if (contactDetailEl) {
            contactDetailEl.innerHTML = `
              <div class="empty-state">
                <div class="empty-icon">🗑️</div>
                <h3>Mesaj çöp kutusuna taşındı</h3>
                <p>30 gün sonra otomatik silinecektir.</p>
              </div>`;
          }
          await loadContactMessages();
        });

        document.getElementById('restore-contact-message')?.addEventListener('click', async () => {
          await apiPost('/api/admin/contact-messages', { id: messageId, restore: true });
          contactView = 'inbox';
          if (contactViewSelect instanceof HTMLSelectElement) contactViewSelect.value = 'inbox';
          await loadContactMessages();
          await renderContactMessageDetail(messageId);
        });
      } catch (error) {
        if (contactDetailEl) {
          contactDetailEl.innerHTML = `<div class="error-state">${error.message}</div>`;
        }
      }
    }

    function switchTab(tabKey) {
      tabButtons.forEach((button) => {
        const isActive = button.getAttribute('data-tab-target') === tabKey;
        button.classList.toggle('is-active', isActive);
      });
      tabPanels.forEach((panel) => {
        const isCurrent = panel.getAttribute('data-tab-panel') === tabKey;
        panel.classList.toggle('is-hidden', !isCurrent);
      });
    }

    async function loadDocuments(appId) {
      const rows = await apiGet(`/api/admin/application-documents?applicationId=${appId}`);
      if (!rows.length) {
        return '<div class="empty-hint">Bu başvuruya ait belge bulunamadı.</div>';
      }
      return `<ul class="doc-list">
        ${rows
          .map(
            (doc) =>
              `<li>
                <div class="doc-icon">📄</div>
                <div class="doc-info">
                  <strong>${doc.kind}</strong>
                  <span class="doc-meta">${doc.originalFilename} (${Math.round(doc.byteSize/1024)} KB)</span>
                </div>
                <a class="btn-download" href="${adminDownloadUrl(doc.id)}" target="_blank" title="Belgeyi İndir">⬇️</a>
              </li>`
          )
          .join('')}
      </ul>`;
    }

