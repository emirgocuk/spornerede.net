    async function saveNewsData(id) {
      const baslik = document.getElementById('news-baslik')?.value || '';
      const kategori = document.getElementById('news-kategori')?.value || '';
      const kategoriRenk = document.getElementById('news-kategoriRenk')?.value || 'gray';
      const tarihInput = document.getElementById('news-tarih')?.value || '';
      const editNews = id ? cachedNews.find((n) => n.id === id) : null;
      const tarihIso = tarihInput
        ? dateInputToNewsTarihIso(tarihInput, editNews?.tarih, editNews?.id ?? id)
        : new Date().toISOString();
      const link = document.getElementById('news-link')?.value || '';
      const seoTitleInput = document.getElementById('news-seo-title')?.value || '';
      const seoDescriptionInput = document.getElementById('news-seo-description')?.value || '';
      const slugInputValue = document.getElementById('news-slug')?.value || '';
      let bodyHtml = stripCeKonuComment(getRichTextContent('news-editor'));
      const parsedKonu = editNews ? parseNewsOzetMeta(editNews.ozet || '').konu : '';
      const storedKonu =
        id > 0 ? sessionStorage.getItem(`ce-konu-${id}`) || '' : '';
      const konu = parsedKonu || storedKonu;
      if (konu) bodyHtml = wrapOzetWithKonu(konu, bodyHtml);
      const ozet = bodyHtml;
      const tmp = document.createElement('div');
      tmp.innerHTML = stripCeKonuComment(ozet);
      const ozetText = tmp.textContent?.trim() ?? '';
      const aktif = true;
      const isCeTemplateSave = /<!--\s*ce-template:/i.test(editNews?.ozet || ozet || '');
      const publishCheck = assessNewsDraft(stripCeKonuComment(ozet), konu || baslik, {
        template: isCeTemplateSave,
      });
      if (!publishCheck.complete) {
        const force = confirm(
          `Bazi kontroller tamam degil:\n${publishCheck.issues.join('\n')}\n\nYine de yayinlamak istiyor musunuz?`,
        );
        if (!force) return;
      }
      const seoTitle = String(seoTitleInput).trim() || baslik;
      const seoDescription = String(seoDescriptionInput).trim() || stripHtmlTags(ozet).slice(0, 160);
      const baseSlug = slugInputValue || slugifyNews(baslik);
      const slug = id ? `${baseSlug.replace(/-\d+$/, '')}-${id}` : baseSlug;

      if (!baslik || !ozetText || !tarihInput) {
         alert("Başlık, özet ve tarih zorunludur.");
         return;
      }

      try {
        const forcePublish = !publishCheck.complete;
        if (id) {
          await apiPut('/api/admin/news', {
            id,
            baslik,
            kategori,
            kategoriRenk,
            tarih: tarihIso,
            link,
            ozet,
            aktif,
            slug,
            seoTitle,
            seoDescription,
            forcePublish,
          });
        } else {
          const result = await apiPost('/api/admin/news', {
            baslik,
            kategori,
            kategoriRenk,
            tarih: tarihIso,
            link,
            ozet,
            aktif,
            slug,
            seoTitle,
            seoDescription,
            forcePublish,
          });
          id = result.id;
        }
        await loadNews();
        
        selectedNewsId = id;
        await renderNewsDetail(selectedNewsId);
      } catch (e) {
        alert(e.message);
      }
    }

    async function loadNews() {
      if (!newsListEl) return;
      newsListEl.innerHTML = '<li class="loading-state"><div class="spinner-small"></div> Yükleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/news');
        cachedNews = rows || [];
        if (selectedNewsId && !cachedNews.some((f) => f.id === selectedNewsId)) {
          selectedNewsId = 0;
        }
        renderNewsList();
        if (selectedNewsId) {
          await renderNewsDetail(selectedNewsId);
        }
      } catch (error) {
        newsListEl.innerHTML = `<li class="error-state">${error.message}</li>`;
        if (newsDetailEl) {
          newsDetailEl.innerHTML = '<div class="error-state">Haberler yüklenemedi.</div>';
        }
      }
    }

