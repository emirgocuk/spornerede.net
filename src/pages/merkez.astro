    function getFilteredContactMessages() {
      const query = contactSearchInput?.value?.trim()?.toLowerCase() || '';
      const filter = contactFilter?.value || 'all';
      return cachedContactMessages.filter((item) => {
        if (filter === 'unread' && item.okundu) return false;
        if (filter === 'read' && !item.okundu) return false;
        if (!query) return true;
        const haystack = `${item.adSoyad || ''} ${item.email || ''} ${item.konu || ''}`.toLowerCase();
        return haystack.includes(query);
      });
    }

