    async function loadMembershipPlansAdmin() {
      if (!membershipPlansAdminEl) return;
      membershipPlansAdminEl.innerHTML = '<div class="spinner-small"></div>';
      try {
        const plans = await apiGet('/api/admin/membership-plans');
        if (!plans.length) {
          membershipPlansAdminEl.innerHTML = '<p class="section-help">Paket bulunamadı.</p>';
          return;
        }
        membershipPlansAdminEl.innerHTML = `
          <div class="membership-plans-admin-grid">
            ${plans
              .map(
                (plan) => `<article class="membership-plan-admin-card" data-plan-id="${plan.legacyId}">
                  <h4>${escapeHtml(plan.ad)} <span class="text-muted">(${escapeHtml(plan.kod)})</span></h4>
                  <div class="form-group">
                    <label>Görünen ad</label>
                    <input class="modern-input" data-plan-field="ad" value="${escapeHtml(plan.ad)}" />
                  </div>
                  <div class="form-group">
                    <label>Ücret (TL)</label>
                    <input class="modern-input" data-plan-field="ucret" type="number" min="0" step="1" value="${plan.ucret}" />
                  </div>
                  <div class="form-group">
                    <label>Açıklama</label>
                    <textarea class="modern-textarea" data-plan-field="aciklama" rows="2">${escapeHtml(plan.aciklama || '')}</textarea>
                  </div>
                  <label class="program-active-toggle">
                    <input data-plan-field="aktif" type="checkbox" ${plan.aktif ? 'checked' : ''} />
                    <span>Başvuruda göster (aktif)</span>
                  </label>
                  <button class="btn btn-primary w-full mt-2" type="button" data-save-plan="${plan.legacyId}">Kaydet</button>
                </article>`,
              )
              .join('')}
          </div>`;
        membershipPlansAdminEl.querySelectorAll('[data-save-plan]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const legacyId = Number(btn.getAttribute('data-save-plan'));
            const card = btn.closest('[data-plan-id]');
            if (!legacyId || !(card instanceof HTMLElement)) return;
            const read = (field) => card.querySelector(`[data-plan-field="${field}"]`);
            try {
              btn.textContent = 'Kaydediliyor...';
              await apiPut('/api/admin/membership-plans', {
                legacyId,
                ad: read('ad')?.value || '',
                ucret: Number(read('ucret')?.value || 0),
                aciklama: read('aciklama')?.value || '',
                aktif: read('aktif') instanceof HTMLInputElement ? read('aktif').checked : true,
              });
              btn.textContent = 'Kaydedildi';
              setTimeout(() => {
                btn.textContent = 'Kaydet';
              }, 1200);
            } catch (error) {
              btn.textContent = 'Kaydet';
              alert(error.message);
            }
          });
        });
      } catch (error) {
        membershipPlansAdminEl.innerHTML = `<p class="error-text">${escapeHtml(error.message)}</p>`;
      }
    }

