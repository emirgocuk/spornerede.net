                    ? `<div class="info-item">
                        <span class="label">Ek Görsel</span>
                        <span class="value"><a href="${escapeHtml(feedback.gorselUrl)}" target="_blank" rel="noopener noreferrer">Görseli yeni sekmede aç</a></span>
                        <img src="${escapeHtml(feedback.gorselUrl)}" alt="Geribildirim görseli" style="max-width:100%;margin-top:.75rem;border-radius:10px;border:1px solid #e2e8f0;" />
