    function filenameFromContentDisposition(value) {
      const match = String(value || '').match(/filename="([^"]+)"/);
      return match?.[1] || `spornerede-data-backup-${new Date().toISOString().slice(0, 10)}.tar.gz`;
    }

    async function downloadManualBackup() {
      if (!(downloadBackupBtn instanceof HTMLButtonElement)) return;
      const previousText = downloadBackupBtn.textContent || '⬇️ Yedek Oluştur ve İndir';
      downloadBackupBtn.disabled = true;
      downloadBackupBtn.textContent = '⏳ Yedek hazırlanıyor...';
      if (backupStatus) {
        backupStatus.textContent = 'Sunucuda yedek arşivi hazırlanıyor. Dosya boyutuna göre biraz sürebilir.';
      }

      try {
        const response = await fetch('/api/admin/backup-download');
        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          throw new Error(payload.error || `Yedek alınamadı (${response.status})`);
        }

        const blob = await response.blob();
        const filename = filenameFromContentDisposition(response.headers.get('Content-Disposition'));
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);

        if (backupStatus) {
          backupStatus.textContent = `Yedek indirildi: ${filename}`;
        }
      } catch (error) {
        if (backupStatus) {
          backupStatus.textContent = error instanceof Error ? error.message : 'Yedek alınamadı.';
        }
        alert(error instanceof Error ? error.message : 'Yedek alınamadı.');
      } finally {
        downloadBackupBtn.disabled = false;
        downloadBackupBtn.textContent = previousText;
      }
    }

    async function apiPut(path, body) {
      const response = await fetch(path, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        const issues = Array.isArray(payload.issues) ? `\n${payload.issues.join('\n')}` : '';
        throw new Error((payload.error || `Request failed (${response.status})`) + issues);
      }
      const payload = await response.json();
      return payload.data;
    }

    async function apiDelete(path, body) {
      const response = await fetch(path, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `Request failed (${response.status})`);
      }
      return response.json().catch(() => ({}));
    }

    function formatDate(value) {
      if (!value) return '-';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '-';
      return new Intl.DateTimeFormat('tr-TR', {
        dateStyle: 'short',
        timeStyle: 'short',
      }).format(date);
    }

    function formatLogDateTime(value) {
      if (!value) return 'Tarih bilgisi yok';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Tarih bilgisi yok';
      return new Intl.DateTimeFormat('tr-TR', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).format(date);
    }

    function escapeHtml(text) {
      return String(text ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function slugifyNews(text) {
      return String(text ?? '')
        .toLowerCase()
        .trim()
        .replace(/ğ/g, 'g')
        .replace(/ü/g, 'u')
        .replace(/ş/g, 's')
        .replace(/ı/g, 'i')
        .replace(/ö/g, 'o')
        .replace(/ç/g, 'c')
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
    }

    function stripHtmlTags(text) {
      return String(text ?? '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function statusLabelTr(status) {
