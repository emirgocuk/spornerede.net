                    <button class="btn-action action-approve" data-status="approved">✅ ${statusActionLabel(app.durum, 'approved')}</button>
                    <button class="btn-action action-pending" data-status="pending">⏳ ${statusActionLabel(app.durum, 'pending')}</button>
                    <button class="btn-action action-reject" data-status="rejected">❌ ${statusActionLabel(app.durum, 'rejected')}</button>
                  </div>
                  ${
                    canEditFields
                      ? `<button id="delete-application-btn" class="btn btn-danger w-full" style="margin-top: 1.25rem;" type="button">🗑️ Başvuruyu Sil</button>
                  <p class="section-help text-sm mt-2">Kalıcı siler: kulüp kaydı, ilanlar, belgeler ve loglar. Onaylı kayıtlar silinemez.</p>`
