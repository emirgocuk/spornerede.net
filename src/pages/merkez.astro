                </div>
              </section>

              <section class="card-section">
                <div class="section-head">
                  <span class="icon">📋</span>
                  <h3>Kayıt & Onay Bilgileri</h3>
                </div>
                <div class="info-list">
                  <div class="info-item">
                    <span class="label">📅 Kaydolma / Başvuru Tarihi</span>
