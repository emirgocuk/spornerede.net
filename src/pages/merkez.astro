                  </div>
                  <div class="form-group">
                    <label>Açıklama</label>
                    <textarea id="app-edit-aciklama" class="modern-textarea" rows="3">${escapeHtml(app.aciklama || '')}</textarea>
                  </div>
                </div>`
                    : `<div class="info-list">
                  <div class="info-item"><span class="label">Ad</span><span class="value">${escapeHtml(app.ad || '-')}</span></div>
                  <div class="info-item"><span class="label">Konum</span><span class="value">${escapeHtml(app.il || '-')} / ${escapeHtml(app.ilce || '-')}</span></div>
                  <div class="info-item"><span class="label">Tesis / Adres</span><span class="value">${escapeHtml(app.adres || '-')}</span></div>
                  <div class="info-item"><span class="label">Telefon</span><span class="value">${escapeHtml(app.telefon || '-')}</span></div>
                  <div class="info-item"><span class="label">E-posta</span><span class="value">${escapeHtml(app.email || '-')}</span></div>
                  <div class="info-item"><span class="label">Açıklama</span><span class="value text-box">${escapeHtml(app.aciklama || '-')}</span></div>
                </div>`
