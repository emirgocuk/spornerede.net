              </section>

              <section class="card-section border-red">
                <div class="section-head">
                  <span class="icon">⛔</span>
                  <h3>Onaylı Listeden Kaldır (Red)</h3>
                </div>
                <p class="section-help text-sm">Kulüp reddedilir ve sitede görünmez. Başvurular sekmesinden yeniden değerlendirilebilir.</p>
                <button id="revoke-club-btn" class="btn btn-outline btn-danger-outline w-full" type="button">Onaylı Listeden Kaldır</button>
              </section>
            </div>

            <div class="detail-column">
              <section class="card-section">
                <div class="section-head">
                  <span class="icon">⏱️</span>
                  <h3>İşlem Geçmişi</h3>
                </div>
                <div id="club-admin-log-timeline" class="log-timeline-container"><div class="spinner-small"></div></div>
              </section>

              <section class="card-section">
                <div class="section-head">
                  <span class="icon">📋</span>
                  <h3>Yayınlanan İlanlar / Kurslar</h3>
                </div>
                <p class="section-help text-sm mb-4">Vitrinde görünen programlar. Aşağıdan yeni ilan ekleyebilirsiniz.</p>
                ${renderClubPrograms(club.programs || [])}
              </section>
            </div>
          </div>
        `;

        const renderClubLogTimeline = async () => {
          const logEl = document.getElementById('club-admin-log-timeline');
          if (!logEl) return;
          try {
            const logs = await apiGet(`/api/admin/applications?logsForId=${clubId}`);
            if (!logs.length) {
              logEl.innerHTML = '<div class="empty-hint text-center py-4">Henüz işlem geçmişi yok.</div>';
              return;
            }
            logEl.innerHTML = `
              <ul class="timeline">
                ${logs
                  .map((log) => {
                    const timeLine = formatLogDateTime(log.createdAt);
                    const title = escapeHtml(logActionTitle(log.action));
                    const actor = log.actorEmail ? escapeHtml(log.actorEmail) : 'Sistem';
                    return `
                    <li class="timeline-item">
                      <div class="timeline-marker"></div>
                      <div class="timeline-content">
                        <div class="timeline-head">
                          <span class="timeline-title">${title}</span>
                          <span class="timeline-time">${timeLine}</span>
                        </div>
                        <div class="timeline-actor">👤 ${actor}</div>
                        ${log.note ? `<div class="timeline-note">${escapeHtml(log.note)}</div>` : ''}
                      </div>
                    </li>`;
                  })
                  .join('')}
              </ul>
            `;
          } catch {
            logEl.innerHTML = '<div class="error-text">Geçmiş yüklenemedi.</div>';
          }
        };
        await renderClubLogTimeline();

        const revokeBtn = document.getElementById('revoke-club-btn');
        revokeBtn?.addEventListener('click', async () => {
          const confirmed = confirm(
            'Bu kulübü onaylı listeden kaldırmak istediğinize emin misiniz? Sitede görünmez olur.',
          );
          if (!confirmed) return;
          try {
            revokeBtn.textContent = 'Kaldırılıyor...';
            await apiDelete('/api/admin/clubs', { clubId, revokeClub: true });
            selectedClubId = 0;
            await loadClubs();
            if (clubDetailEl) {
              clubDetailEl.innerHTML = `
                <div class="empty-state">
                  <div class="empty-icon">✅</div>
                  <h3>Kulüp listeden kaldırıldı</h3>
                  <p>Onaylı kulüpler listesinden çıkarıldı.</p>
                </div>`;
            }
          } catch (error) {
            revokeBtn.textContent = 'Onaylı Listeden Kaldır';
            alert(error.message);
          }
        });

        const collectClubUpdatePayload = () => ({
          id: clubId,
          ad: document.getElementById('club-ad')?.value || '',
          telefon: document.getElementById('club-telefon')?.value || '',
          email: document.getElementById('club-email')?.value || '',
          yasAraligi: document.getElementById('club-yas-araligi')?.value || '',
          fiyatBilgisi: document.getElementById('club-fiyat-bilgisi')?.value || '',
          adres: document.getElementById('club-adres')?.value || '',
          aciklama: document.getElementById('club-aciklama')?.value || '',
          il: document.getElementById('club-il')?.value || '',
          ilce: document.getElementById('club-ilce')?.value || '',
          membershipPeriod: document.getElementById('club-membership-period')?.value || 'six_month',
        });

        const saveClubUpdate = async (button, loadingText, resetText) => {
          try {
            if (button) button.textContent = loadingText;
            await apiPost('/api/admin/clubs', collectClubUpdatePayload());
            await loadClubs();
            await renderClubDetail(clubId);
          } catch (error) {
            if (button) button.textContent = resetText;
            alert(error.message);
          }
        };

        const saveBtn = document.getElementById('save-club-btn');
        saveBtn?.addEventListener('click', async () => {
          await saveClubUpdate(saveBtn, 'Kaydediliyor...', 'Değişiklikleri Kaydet');
        });

        const saveSummaryBtn = document.getElementById('save-club-summary-btn');
        saveSummaryBtn?.addEventListener('click', async () => {
          await saveClubUpdate(saveSummaryBtn, 'Güncelleniyor...', 'Başvuru Özetini Güncelle');
        });

        const clubIlSelect = document.getElementById('club-il');
        const clubIlceSelect = document.getElementById('club-ilce');
        clubIlSelect?.addEventListener('change', () => {
          if (!(clubIlceSelect instanceof HTMLSelectElement) || !(clubIlSelect instanceof HTMLSelectElement)) return;
          clubIlceSelect.innerHTML = '<option value="">İlçe seçin</option>' + renderDistrictOptions(clubIlSelect.value, '');
        });

        const withdrawBtn = document.getElementById('withdraw-club-btn');
        withdrawBtn?.addEventListener('click', async () => {
          const confirmed = confirm('Onayı geri çekmek istediğinize emin misiniz? Kulüp Başvurular listesine döner.');
          if (!confirmed) return;
          try {
            withdrawBtn.textContent = 'Geri çekiliyor...';
            await apiDelete('/api/admin/clubs', { clubId, withdrawApproval: true });
            selectedClubId = 0;
            await loadClubs();
            await loadApplications();
            switchTab('applications');
            if (clubDetailEl) {
              clubDetailEl.innerHTML = '<div class="empty-state"><div class="empty-icon">↩️</div><h3>Onay geri çekildi</h3><p>Kulüp Başvurular sekmesinde görüntüleyebilirsiniz.</p></div>';
            }
          } catch (error) {
            withdrawBtn.textContent = 'Onayını Geri Çek';
            alert(error.message);
          }
        });

        const programWorkspace = clubDetailEl.querySelector('#club-program-workspace');
        if (programWorkspace instanceof HTMLElement) {
          bindClubProgramEditor(
            programWorkspace,
            clubId,
            club.programs || [],
            {
              post: apiPost,
              put: apiPut,
            },
            () => renderClubDetail(clubId),
          );
        }

        const saveClubNoteBtn = document.getElementById('save-club-note-btn');
        saveClubNoteBtn?.addEventListener('click', async () => {
          try {
            saveClubNoteBtn.textContent = 'Kaydediliyor...';
            await apiPost('/api/admin/clubs', {
              id: clubId,
              ad: club.ad,
              telefon: club.telefon,
              email: club.email,
              adres: club.adres,
              aciklama: club.aciklama,
              yasAraligi: club.yasAraligi,
              fiyatBilgisi: club.fiyatBilgisi,
              adminNotu: document.getElementById('club-admin-note')?.value || '',
              sorumluAdminEmail: document.getElementById('club-assigned-admin-email')?.value?.trim() || '',
            });
            await renderClubDetail(clubId);
          } catch (error) {
            saveClubNoteBtn.textContent = 'Notları Kaydet';
            alert(error.message);
          }
        });

        const clubProvisionBtn = document.getElementById('club-provision-user-btn');
        const clubGeneratePasswordBtn = document.getElementById('club-generate-password-btn');
        const clubProvisionPasswordInput = document.getElementById('club-provision-password');

        clubProvisionPasswordInput?.addEventListener('input', () => {
          draftProvisionPasswords.set(clubId, clubProvisionPasswordInput.value);
        });

        clubGeneratePasswordBtn?.addEventListener('click', () => {
          const nextPassword = generateTemporaryPassword();
          if (clubProvisionPasswordInput) clubProvisionPasswordInput.value = nextPassword;
          draftProvisionPasswords.set(clubId, nextPassword);
        });

        clubProvisionBtn?.addEventListener('click', async () => {
          const email = document.getElementById('club-provision-email')?.value?.trim() || '';
          const password = document.getElementById('club-provision-password')?.value || '';
          if (!email || !password) {
            alert('E-posta ve geçici şifre zorunlu.');
            return;
          }
          try {
            clubProvisionBtn.textContent = 'İşleniyor...';
            const result = await apiPost('/api/admin/provision-club-user', {
              clubId,
              email,
              password,
              membershipRole: 'owner',
            });
            alert(`Hesap başarıyla oluşturuldu/güncellendi.\nE-posta: ${result.email}`);
            clubProvisionBtn.textContent = 'Hesabı Oluştur / Güncelle';
            await renderClubDetail(clubId);
          } catch (error) {
            clubProvisionBtn.textContent = 'Hesabı Oluştur / Güncelle';
            alert(error.message);
          }
        });

        const clubUploadDocBtn = document.getElementById('club-upload-doc-btn');
        clubUploadDocBtn?.addEventListener('click', async () => {
          const fileInput = document.getElementById('club-doc-file');
          if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.length) {
            alert('Lütfen bir PDF dosyası seçin.');
            return;
          }
          const file = fileInput.files[0];
          const looksLikePdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
          if (!looksLikePdf) {
            alert('Yalnızca PDF dekont yükleyebilirsiniz.');
            return;
          }
          try {
            clubUploadDocBtn.textContent = 'Yükleniyor...';
            const formData = new FormData();
            formData.append('applicationId', String(clubId));
            formData.append('document', file);
            const response = await fetch('/api/admin/application-documents-upload', {
              method: 'POST',
              body: formData,
            });
            if (!response.ok) {
              const payload = await response.json().catch(() => ({}));
              throw new Error(payload.error || `Request failed (${response.status})`);
            }
            await renderClubDetail(clubId);
          } catch (error) {
            clubUploadDocBtn.textContent = 'Yükle';
            alert(error.message);
          }
        });
      } catch (error) {
        renderDetailError(error.message);
      }
    }

    async function loadClubs() {
      if (!clubsListEl) return;
      clubsListEl.innerHTML = '<li class="loading-state"><div class="spinner-small"></div> Yükleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/clubs');
        cachedClubs = rows || [];
        if (!selectedClubId && cachedClubs.length) {
          selectedClubId = cachedClubs[0].id;
        }
        renderClubsList();
        if (selectedClubId) {
          await renderClubDetail(selectedClubId);
        }
      } catch (error) {
        clubsListEl.innerHTML = `<li class="error-state">${error.message}</li>`;
        if (clubDetailEl) {
          clubDetailEl.innerHTML = '<div class="error-state">Kulüp listesi yüklenemedi.</div>';
        }
      }
    }

    function renderNewsList() {
      if (!newsListEl) return;
      if (!cachedNews.length) {
        newsListEl.innerHTML = '<li class="empty-list">Haber bulunamadı.</li>';
        return;
      }
      newsListEl.innerHTML = cachedNews
        .map((news) => {
          const activeClass = news.id === selectedNewsId ? 'is-active' : '';
