                  </div>
                  <div class="info-item">
                    <span class="label">✅ Onaylanma Tarihi</span>
                    <span class="value"><span class="status-badge status-approved">${club.approvedAt ? formatDate(club.approvedAt) + ' tarihinde onaylandı' : 'Sistemde Onaylı'}</span></span>
                  </div>
                  <div class="info-item">
                    <span class="label">🎁 Üyelik Durumu</span>
