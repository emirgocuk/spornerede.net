---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminLogin from '../components/AdminLogin.astro';
import { getCurrentSessionUser } from '../lib/auth/session';
import { getAdminClubSummary, getAllBranches, getAllCities, getAllDistrictsWithCities } from '../lib/repositories/catalog';
import { getPendingGuidesCount } from '../lib/repositories/seoArticles';

const session = await getCurrentSessionUser(Astro.request).catch(() => null);
if (session?.role === 'club') {
  if (session.mustChangePassword) {
    return Astro.redirect('/panel/sifre-degistir?required=1');
  }
  return Astro.redirect('/panel');
}
const isLoggedInAdmin = session?.role === 'admin';
const loginError = Astro.url.searchParams.get('error') ?? '';

const summary = await getAdminClubSummary();
const pendingGuidesCount = isLoggedInAdmin ? await getPendingGuidesCount() : 0;
const branchRows = await getAllBranches();
const adminBransList = [...branchRows.map((b) => b.isim).sort((a, b) => a.localeCompare(b, 'tr')), 'Diğer'];
const [cityRows, districtRows] = await Promise.all([getAllCities(), getAllDistrictsWithCities()]);
const adminDistrictsByCity = districtRows.reduce<Record<string, { ad: string; slug: string }[]>>((acc, district) => {
  if (!district.il) return acc;
  acc[district.il] ??= [];
  acc[district.il].push({ ad: district.ad, slug: district.slug });
  return acc;
}, {});
for (const il of Object.keys(adminDistrictsByCity)) {
  adminDistrictsByCity[il].sort((a, b) => a.ad.localeCompare(b.ad, 'tr'));
}
const adminLocationData = {
  cities: cityRows.map((c) => ({ ad: c.ad, slug: c.slug })),
  districtsByCity: adminDistrictsByCity,
};
---

