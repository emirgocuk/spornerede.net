---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllBranches, searchClubs } from '../../lib/repositories/catalog';

const branches = await getAllBranches();
const tumKulupler = await searchClubs({});

const branchCards = branches.map((branch) => {
  const kulupSayisi = tumKulupler.filter((club) => club.bransSlug === branch.slug).length;
  return { ...branch, kulupSayisi };
});
---

<BaseLayout
  title="Tüm Spor Branşları"
  description="Türkiye genelinde arayabileceğiniz tüm spor branşları. Branşa göre kulüp ve kursları keşfedin."
  keywords="türkiye spor branşları, çocuk spor branşları, futbol basketbol yüzme kursları"
>
  <section class="section">
    <div class="container">
      <div class="head">
        <h1 class="title">Tüm Spor Branşları</h1>
        <p class="desc">Branşa göre tüm kulüp ve kurs listelerine hızlıca ulaşabilirsiniz.</p>
      </div>

      <div class="grid" role="list" aria-label="Branş listesi">
        {branchCards.map((branch) => (
          <a href={`/branslar/${branch.slug}`} class="card" role="listitem">
            <div class="icon" style={`--branch-color: ${branch.renk}`}>{branch.emoji}</div>
            <div class="content">
              <h2>{branch.isim}</h2>
              <p>{branch.aciklama}</p>
            </div>
            <span class="count">{branch.kulupSayisi} kulüp</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head { margin-bottom: 2rem; }
  .title { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 900; color: #212529; }
  .desc { margin-top: .5rem; color: #6C757D; max-width: 640px; }
  .grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .card {
    display: flex; align-items: center; gap: .875rem; text-decoration: none;
    border: 1px solid #E9ECEF; border-radius: .9rem; background: #fff; padding: 1rem;
    transition: all .2s ease;
  }
  .card:hover { border-color: #E30A17; box-shadow: 0 8px 24px rgba(227,10,23,.09); transform: translateY(-2px); }
  .icon {
    width: 44px; height: 44px; border-radius: .6rem; flex-shrink: 0; display: grid; place-items: center;
    background: color-mix(in srgb, var(--branch-color, #E30A17) 14%, transparent);
    font-size: 1.3rem;
  }
  .content { min-width: 0; flex: 1; }
  .content h2 { color: #212529; font-size: 1rem; font-weight: 800; line-height: 1.35; }
  .content p { color: #6C757D; font-size: .82rem; margin-top: .15rem; }
  .count { color: #E30A17; font-size: .78rem; font-weight: 700; white-space: nowrap; }
</style>

