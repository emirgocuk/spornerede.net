---
/**
 * basvuru.astro
 * Kulüp Başvuru Sayfası — /basvuru
 * Kulüplerin platforma kayıt için dolduracağı form.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BasvuruFormSections from '../components/BasvuruFormSections.astro';
import { getAllCities, getAllDistrictsWithCities, getAllBranches } from '../lib/repositories/catalog';
import { BRANCHES } from '../data/mockData';

const success = Astro.url.searchParams.get('success') === '1';
const errorCode = Astro.url.searchParams.get('error') ?? '';
const errorMessages: Record<string, string> = {
  missing: 'Lütfen zorunlu alanları eksiksiz doldurun.',
  email: 'Lütfen geçerli bir e-posta adresi yazın.',
  server: 'Başvuru gönderilemedi. Lütfen tekrar deneyin.',
  rate_limit: 'Çok fazla istek gönderildi. Lütfen biraz bekleyip tekrar deneyin.',
};
const errorMessage = errorMessages[errorCode] ?? '';

const [cityRows, districtRows, branchRows] = await Promise.all([
  getAllCities(),
  getAllDistrictsWithCities(),
  getAllBranches(),
]);
const CITIES = cityRows.map((c) => c.ad);
const DISTRICTS_BY_CITY = districtRows.reduce<Record<string, { ad: string; slug: string }[]>>((acc, district) => {
  if (!district.il) return acc;
  acc[district.il] ??= [];
  acc[district.il].push({ ad: district.ad, slug: district.slug });
  return acc;
}, {});
for (const il of Object.keys(DISTRICTS_BY_CITY)) {
  DISTRICTS_BY_CITY[il].sort((a, b) => a.ad.localeCompare(b.ad, 'tr'));
}

const rawBranchNames = [
  ...branchRows.map((b) => b.isim),
  ...BRANCHES.map((b) => b.isim),
  'Oryantiring',
  'Satranç',
];
const uniqueBranches = Array.from(new Set(rawBranchNames))
  .filter((name) => Boolean(name) && name !== 'Diğer')
  .sort((a, b) => a.localeCompare(b, 'tr'));

const bransListesi = [
  ...uniqueBranches,
  'Diğer',
];

const adimlar = [
  { num: '1', label: 'Kulüp' },
  { num: '2', label: 'Branş Sayısı' },
  { num: '3', label: 'İlanlar' },
];
---

<BaseLayout
  title="Kulübünü Ekle — Ücretsiz Başvuru Formu"
  description="SporNerede.net'e kulübünüzü veya kursunuzu ücretsiz ekleyin. Türkiye genelinde spor arayan ailelere ulaşın. Başvuru formu hızlı ve kolay."
  keywords="ücretsiz spor kulübü ekle, ücretsiz spor kursu ekle, spornerede başvuru, kulüp listesi"
>

  <div class="basvuru-page">

    <!-- ===== HERO ÜSTÜ ===== -->
    <div class="basvuru-hero">
      <div class="basvuru-hero-bg" aria-hidden="true">
        <div class="bh-orb bh-orb-1"></div>
        <div class="bh-orb bh-orb-2"></div>
      </div>
      <div class="container basvuru-hero-content">
        <div class="hero-left-content">
          <div class="basvuru-badge">🏆 Ücretsiz Platforma Katıl</div>
          <h1 class="basvuru-title">Kulübünüzü<br />Ücretsiz Listeleyin</h1>
          <p class="basvuru-desc">
            Kulüp bilgilerinizi girin, yayınlanacak branş sayınızı seçin ve ilanlarınızı oluşturun. Onay sonrası ilanlarınız ücretsiz olarak yayına alınır.
          </p>
          <!-- Adım göstergesi -->
          <div class="adimlar" aria-label="Form Adımları" role="list">
            {adimlar.map((adim, i) => (
              <div class="adim" role="listitem">
                <div class={`adim-num ${i === 0 ? 'adim-aktif' : ''}`} aria-current={i === 0 ? 'step' : undefined}>
                  {adim.num}
                </div>
                <span class="adim-label">{adim.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="hero-right-content" aria-hidden="true"></div>
      </div>
    </div>

    <!-- ===== FORM ALANI ===== -->
    <div class="basvuru-form-wrapper">
      <div class="container">
        <div class="basvuru-grid">

          <!-- Form -->
          <main class="basvuru-form-card" id="main-content">

            {success ? (
              <!-- Başarı durumu (SSR Fallback) -->
              <div class="success-card" role="alert" aria-live="polite">
                <div class="success-badge-wrapper">
                  <div class="success-badge-glow"></div>
                  <div class="success-badge-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  </div>
                </div>

                <span class="success-pill">🏆 Başvurunuz Alındı</span>
                <h2 class="success-title">Tebrikler, Başvurunuz Başarıyla İletildi!</h2>
                <p class="success-desc">
                  Kulüp başvurunuz sisteme başarıyla kaydedildi. Editörlerimiz bilgilerinizi inceledikten sonra ilanınız ücretsiz olarak yayına alınacaktır.
                </p>

                <div class="success-steps-box">
                  <h3 class="success-steps-title">Bundan sonra ne olacak?</h3>
                  <div class="success-steps-list">
                    <div class="success-step-item">
                      <div class="success-step-num">1</div>
                      <div class="success-step-info">
                        <strong>Ön İnceleme</strong>
                        <span>Kulüp ve branş bilgileriniz editörlerimizce incelenir.</span>
                      </div>
                    </div>
                    <div class="success-step-item">
                      <div class="success-step-num">2</div>
                      <div class="success-step-info">
                        <strong>İletişim & Teyit</strong>
                        <span>Gerekli durumlarda yetkili telefonunuzdan teyit için bilgi alınır.</span>
                      </div>
                    </div>
                    <div class="success-step-item">
                      <div class="success-step-num">3</div>
                      <div class="success-step-info">
                        <strong>Ücretsiz Yayın</strong>
                        <span>İlanınız vitrinde ailelerin ve sporcuların erişimine açılır.</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="success-actions">
                  <a href="/" class="btn btn-primary btn-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                      <polyline points="9 22 9 12 15 22"/>
                    </svg>
                    Ana Sayfaya Dön
                  </a>
                  <a href="/basvuru" class="btn btn-secondary btn-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 5v14M5 12h14"/>
                    </svg>
                    Yeni Başvuru Yap
                  </a>
                </div>

                <div class="success-whatsapp-box">
                  <img src="/icons/whatsapp.svg" alt="" width="26" height="26" />
                  <div class="success-whatsapp-text">
                    <strong>Sorularınız veya acil talepleriniz mi var?</strong>
                    <span>WhatsApp destek hattımız üzerinden doğrudan ekibimize ulaşabilirsiniz.</span>
                  </div>
                  <a
                    href="https://wa.me/905362982218?text=Merhaba,%20kulüp%20başvurumuzu%20tamamladık,%20bilgi%20almak%20istiyoruz."
                    class="btn-success-whatsapp"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    WhatsApp Destek
                  </a>
                </div>
              </div>
            ) : (
              <>
                <!-- İstemci tarafı (AJAX) dinamik başarı durumu -->
                <div class="success-card" id="client-success-view" style="display:none;" role="alert" aria-live="polite">
                  <div class="success-badge-wrapper">
                    <div class="success-badge-glow"></div>
                    <div class="success-badge-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    </div>
                  </div>

                  <span class="success-pill">🏆 Başvurunuz Alındı</span>
                  <h2 class="success-title">Tebrikler, Başvurunuz Başarıyla İletildi!</h2>
                  <p class="success-desc">
                    <strong id="success-club-name" class="success-highlight-club">Kulübünüzün</strong> başvurusu sisteme başarıyla kaydedildi. Editörlerimiz bilgilerinizi inceledikten sonra ilanınız ücretsiz olarak yayına alınacaktır.
                  </p>

                  <div class="success-steps-box">
                    <h3 class="success-steps-title">Bundan sonra ne olacak?</h3>
                    <div class="success-steps-list">
                      <div class="success-step-item">
                        <div class="success-step-num">1</div>
                        <div class="success-step-info">
                          <strong>Ön İnceleme</strong>
                          <span>Kulüp ve branş bilgileriniz editörlerimizce incelenir.</span>
                        </div>
                      </div>
                      <div class="success-step-item">
                        <div class="success-step-num">2</div>
                        <div class="success-step-info">
                          <strong>İletişim & Teyit</strong>
                          <span>Gerekli durumlarda yetkili telefonunuzdan teyit için bilgi alınır.</span>
                        </div>
                      </div>
                      <div class="success-step-item">
                        <div class="success-step-num">3</div>
                        <div class="success-step-info">
                          <strong>Ücretsiz Yayın</strong>
                          <span>İlanınız vitrinde ailelerin ve sporcuların erişimine açılır.</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="success-actions">
                    <a href="/" class="btn btn-primary btn-lg">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 22"/>
                      </svg>
                      Ana Sayfaya Dön
                    </a>
                    <button type="button" class="btn btn-secondary btn-lg" id="btn-new-application">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"/>
                      </svg>
                      Yeni Başvuru Yap
                    </button>
                  </div>

                  <div class="success-whatsapp-box">
                    <img src="/icons/whatsapp.svg" alt="" width="26" height="26" />
                    <div class="success-whatsapp-text">
                      <strong>Sorularınız veya acil talepleriniz mi var?</strong>
                      <span>WhatsApp destek hattımız üzerinden doğrudan ekibimize ulaşabilirsiniz.</span>
                    </div>
                    <a
                      href="https://wa.me/905362982218?text=Merhaba,%20kulüp%20başvurumuzu%20tamamladık,%20bilgi%20almak%20istiyoruz."
                      class="btn-success-whatsapp"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      WhatsApp Destek
                    </a>
                  </div>
                </div>

                <form
                  id="basvuru-form"
                  method="post"
                  action="/api/basvuru"
                  novalidate
                  aria-label="Kulüp Başvuru Formu"
                >
                  <div id="form-error-banner" class="form-alert form-alert--error" style="display:none;" role="alert" aria-live="polite"></div>

                  <BasvuruFormSections
                    cities={CITIES}
                    bransListesi={bransListesi}
                    errorMessage={errorMessage || undefined}
                  />

                  <!-- Submit -->
                  <div class="form-submit-area">
                    <p class="form-gizlilik">
                      Başvurarak <a href="/gizlilik" class="gizlilik-link">Gizlilik Politikası</a>'nı kabul etmiş olursunuz. Bilgileriniz üçüncü taraflarla paylaşılmaz.
                    </p>
                    <button type="submit" class="btn btn-primary btn-lg submit-btn" id="basvuru-submit-btn">
                      <svg class="submit-btn-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span class="submit-btn-text">Ücretsiz Başvuruyu Gönder</span>
                    </button>
                  </div>

                  <div class="form-contact-card">
                    <h3 class="form-contact-title">Sorularınız mı var?</h3>
                    <p class="form-contact-text">Başvuru süreciyle ilgili yardım için bize ulaşın:</p>
                    <div class="form-contact-actions">
                      <a
                        href="https://wa.me/905362982218"
                        class="form-contact-action form-contact-action--whatsapp"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="WhatsApp ile doğrudan mesaj gönder"
                      >
                        <img src="/icons/whatsapp.svg" alt="" aria-hidden="true" width="16" height="16" />
                        WhatsApp'tan Ulaş
                      </a>
                      <a
                        href="mailto:info@spornerede.net"
                        class="form-contact-action form-contact-action--email"
                        aria-label="E-posta ile iletişime geç"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                          <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        info@spornerede.net
                      </a>
                    </div>
                  </div>

                </form>
              </>
            )}
          </main>

        </div>
      </div>
    </div>

  </div>

  <script id="district-data" type="application/json" set:html={JSON.stringify(DISTRICTS_BY_CITY)}></script>

  <script is:inline>
    const citySelect = document.getElementById('kulup-il');
    const districtSelect = document.getElementById('kulup-ilce');
    const districtDataEl = document.getElementById('district-data');
    const districtsByCity = districtDataEl ? JSON.parse(districtDataEl.textContent || '{}') : {};
    const formDraftKey = 'spornerede:basvuru-form-draft:v1';

    function fillDistricts(cityName, selectedDistrict = '') {
      if (!(districtSelect instanceof HTMLSelectElement)) return;
      districtSelect.innerHTML = '';

      const districts = districtsByCity[cityName] || [];
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = cityName ? (districts.length ? 'İlçe seçin...' : 'Bu il için ilçe bulunamadı') : 'Önce il seçin...';
      districtSelect.appendChild(placeholder);

      districts.forEach((district) => {
        const option = document.createElement('option');
        option.value = district.ad;
        option.textContent = district.ad;
        option.selected = district.ad === selectedDistrict;
        districtSelect.appendChild(option);
      });
    }

    if (citySelect instanceof HTMLSelectElement) {
      fillDistricts(citySelect.value);
      citySelect.addEventListener('change', () => fillDistricts(citySelect.value));
    }

    const branchRoot = document.getElementById('branch-listings-root');
    const branchTemplate = document.getElementById('branch-listing-template');
    const branchFieldKeys = ['brans', 'yasAraligi', 'aidat'];

    function configureBranchSection(section, index) {
      if (!(section instanceof HTMLElement)) return;
      const title = section.querySelector('.branch-listing-title-text');
      if (title) title.textContent = `${index + 1}. Branş Bilgileri (İlan)`;
      const numEl = section.querySelector('.branch-listing-num');
      if (numEl) numEl.textContent = String(index + 3);
      branchFieldKeys.forEach((field) => {
        const el = section.querySelector(`[data-field="${field}"]`);
        if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement) {
          el.name = `ilan_${index}_${field}`;
        }
      });
    }

    function renderBranchSections(count) {
      if (!branchRoot || !branchTemplate) return;
      const source = branchTemplate.content?.firstElementChild;
      if (!source) return;
      const fragment = document.createDocumentFragment();
      for (let i = 0; i < count; i++) {
        const section = source.cloneNode(true);
        configureBranchSection(section, i);
        fragment.appendChild(section);
      }
      branchRoot.replaceChildren(fragment);
    }

    const kulupInput = document.getElementById('kulup-ad');
    const branchCountHidden = document.getElementById('brans-sayisi-hidden');
    const branchCountInputs = Array.from(document.querySelectorAll('[data-branch-input]'));

    function collectBranchDraft() {
      return Array.from(branchRoot?.querySelectorAll('[data-branch-section]') || []).map((section) => ({
        brans: section.querySelector('[data-field="brans"]')?.value || '',
        yasAraligi: section.querySelector('[data-field="yasAraligi"]')?.value || '',
        aidat: section.querySelector('[data-field="aidat"]')?.value || '',
      }));
    }

    function applyBranchDraft(ilanlar) {
      if (!Array.isArray(ilanlar)) return;
      Array.from(branchRoot?.querySelectorAll('[data-branch-section]') || []).forEach((section, index) => {
        const ilan = ilanlar[index] || {};
        branchFieldKeys.forEach((field) => {
          const el = section.querySelector(`[data-field="${field}"]`);
          if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement) {
            el.value = ilan[field] || '';
          }
        });
      });
    }

    function getDraftValue(id) {
      const el = document.getElementById(id);
      return el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement
        ? el.value
        : '';
    }

    function collectFormDraft() {
      return {
        bransSayisi: branchCountHidden instanceof HTMLInputElement ? branchCountHidden.value : '1',
        kulupad: getDraftValue('kulup-ad'),
        il: getDraftValue('kulup-il'),
        ilce: getDraftValue('kulup-ilce'),
        adres: getDraftValue('kulup-adres'),
        yetkili: getDraftValue('yetkili-ad'),
        telefon: getDraftValue('yetkili-telefon'),
        email: getDraftValue('yetkili-email'),
        ilanlar: collectBranchDraft(),
      };
    }

    function saveFormDraft() {
      try {
        window.localStorage.setItem(formDraftKey, JSON.stringify(collectFormDraft()));
      } catch {
        // LocalStorage kapalıysa form normal şekilde çalışmaya devam eder.
      }
    }

    function readFormDraft() {
      try {
        const raw = window.localStorage.getItem(formDraftKey);
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    }

    function applyFormDraft(draft) {
      if (!draft || typeof draft !== 'object') return;

      const simpleFields = {
        'kulup-ad': draft.kulupad,
        'kulup-adres': draft.adres,
        'yetkili-ad': draft.yetkili,
        'yetkili-telefon': draft.telefon ? formatPhoneTR(draft.telefon) : '',
        'yetkili-email': draft.email,
      };
      Object.entries(simpleFields).forEach(([id, value]) => {
        const el = document.getElementById(id);
        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
          el.value = value || '';
        }
      });

      if (citySelect instanceof HTMLSelectElement) {
        citySelect.value = draft.il || '';
        fillDistricts(citySelect.value, draft.ilce || '');
      }

      const branchCount = Number(draft.bransSayisi || draft.ilanlar?.length || 1);
      syncBranchCount(branchCount, Array.isArray(draft.ilanlar) ? draft.ilanlar : []);
    }

    function syncBranchCount(nextValue, preservedIlanlar = collectBranchDraft()) {
      const count = Number.isFinite(nextValue) ? Math.max(1, Math.min(1, Math.floor(nextValue))) : 1;
      if (branchCountHidden instanceof HTMLInputElement) {
        branchCountHidden.value = String(count);
      }
      branchCountInputs.forEach((input) => {
        if (input instanceof HTMLInputElement && input.value !== String(count)) {
          input.value = String(count);
        }
      });
      renderBranchSections(count);
      applyBranchDraft(preservedIlanlar);
    }

    // Telefon numarası otomatik formatlama (+90 531 707 26 96)
    const telefonInput = document.getElementById('yetkili-telefon');

    function formatPhoneTR(value) {
      if (!value) return '';
      let digits = value.replace(/\D/g, '');
      if (digits.startsWith('90')) {
        digits = digits.slice(2);
      } else if (digits.startsWith('0')) {
        digits = digits.slice(1);
      }
      digits = digits.slice(0, 10);
      if (!digits.length) return '';

      let res = '+90 ' + digits.slice(0, 3);
      if (digits.length > 3) res += ' ' + digits.slice(3, 6);
      if (digits.length > 6) res += ' ' + digits.slice(6, 8);
      if (digits.length > 8) res += ' ' + digits.slice(8, 10);
      return res;
    }

    function handlePhoneInput(e) {
      const el = e.target;
      if (!(el instanceof HTMLInputElement)) return;

      const oldVal = el.value;
      const oldCursor = el.selectionEnd || 0;

      let digitsBefore = oldVal.slice(0, oldCursor).replace(/\D/g, '');
      if (digitsBefore.startsWith('90')) digitsBefore = digitsBefore.slice(2);
      else if (digitsBefore.startsWith('0')) digitsBefore = digitsBefore.slice(1);
      const targetCount = digitsBefore.length;

      const formatted = formatPhoneTR(oldVal);
      el.value = formatted;

      if (formatted) {
        if (oldCursor >= oldVal.length) {
          el.setSelectionRange(formatted.length, formatted.length);
        } else {
          let count = 0;
          let newPos = formatted.length;
          for (let i = 4; i < formatted.length; i++) {
            if (/\d/.test(formatted[i])) {
              count++;
              if (count === targetCount) {
                newPos = i + 1;
                break;
              }
            }
          }
          el.setSelectionRange(newPos, newPos);
        }
      }
    }

    telefonInput?.addEventListener('input', handlePhoneInput);

    telefonInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && telefonInput instanceof HTMLInputElement) {
        const cursor = telefonInput.selectionStart;
        const end = telefonInput.selectionEnd;
        if (cursor === end && cursor && cursor > 0) {
          const charBefore = telefonInput.value[cursor - 1];
          if (charBefore === ' ') {
            e.preventDefault();
            const val = telefonInput.value;
            const updated = val.slice(0, cursor - 2) + val.slice(cursor);
            telefonInput.value = formatPhoneTR(updated);
            const newPos = Math.max(0, cursor - 2);
            telefonInput.setSelectionRange(newPos, newPos);
            telefonInput.dispatchEvent(new Event('input'));
          } else if (cursor <= 5 && telefonInput.value.replace(/\D/g, '').length <= 1) {
            telefonInput.value = '';
          }
        }
      }
    });

    kulupInput?.addEventListener('input', () => {
      saveFormDraft();
    });
    branchCountInputs.forEach((input) => {
      input.addEventListener('input', () => {
        syncBranchCount(Number(input.value));
        saveFormDraft();
      });
      input.addEventListener('click', (event) => event.stopPropagation());
      input.addEventListener('keydown', (event) => event.stopPropagation());
    });
    syncBranchCount(1);
    if (new URLSearchParams(window.location.search).has('error')) {
      applyFormDraft(readFormDraft());
    }
    if (telefonInput instanceof HTMLInputElement && telefonInput.value) {
      telefonInput.value = formatPhoneTR(telefonInput.value);
    }
    document.getElementById('basvuru-form')?.addEventListener('input', saveFormDraft);
    document.getElementById('basvuru-form')?.addEventListener('change', saveFormDraft);

    // AJAX Form Submit Handler (Sayfa yönlendirmesi olmaksızın, yerinde işlem)
    const formEl = document.getElementById('basvuru-form');
    const submitBtn = document.getElementById('basvuru-submit-btn');
    const errorBanner = document.getElementById('form-error-banner');
    const clientSuccessView = document.getElementById('client-success-view');

    function showError(message) {
      if (!errorBanner) return;
      errorBanner.innerHTML = `
        <div class="form-alert-flex">
          <div class="form-alert-msg-wrap">
            <span class="form-alert-icon">⚠️</span>
            <span class="form-alert-msg">${message}</span>
          </div>
          <a
            href="https://wa.me/905362982218?text=${encodeURIComponent('Merhaba, siteden kulüp başvurusu yaparken bir sorun yaşadım. Yardımcı olabilir misiniz?')}"
            target="_blank"
            rel="noopener noreferrer"
            class="form-alert-wa-btn"
          >
            <img src="/icons/whatsapp.svg" alt="" width="14" height="14" />
            WhatsApp'tan İlet
          </a>
        </div>
      `;
      errorBanner.style.display = 'block';
      errorBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function hideError() {
      if (!errorBanner) return;
      errorBanner.style.display = 'none';
      errorBanner.innerHTML = '';
    }

    formEl?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();
      saveFormDraft();

      // İstemci tarafı temel doğrulamalar
      const kulupAdVal = getDraftValue('kulup-ad').trim();
      if (!kulupAdVal) {
        showError('Lütfen kulüp veya kurs adınızı yazın.');
        document.getElementById('kulup-ad')?.focus();
        return;
      }

      const ilVal = (citySelect instanceof HTMLSelectElement ? citySelect.value : '').trim();
      if (!ilVal) {
        showError('Lütfen kulübünüzün bulunduğu ili seçin.');
        citySelect?.focus();
        return;
      }

      const ilceVal = (districtSelect instanceof HTMLSelectElement ? districtSelect.value : '').trim();
      if (!ilceVal) {
        showError('Lütfen ilçeyi seçin.');
        districtSelect?.focus();
        return;
      }

      const yetkiliVal = getDraftValue('yetkili-ad').trim();
      if (!yetkiliVal) {
        showError('Lütfen yetkili kişi ismini yazın.');
        document.getElementById('yetkili-ad')?.focus();
        return;
      }

      const telefonVal = getDraftValue('yetkili-telefon').trim();
      const phoneDigits = telefonVal.replace(/\D/g, '');
      const nationalDigits = phoneDigits.startsWith('90')
        ? phoneDigits.slice(2)
        : (phoneDigits.startsWith('0') ? phoneDigits.slice(1) : phoneDigits);

      if (!telefonVal || nationalDigits.length === 0) {
        showError('Lütfen yetkili telefon numarasını yazın.');
        document.getElementById('yetkili-telefon')?.focus();
        return;
      }

      if (nationalDigits.length < 10) {
        showError('Lütfen geçerli bir telefon numarası girin (+90 5XX XXX XX XX).');
        document.getElementById('yetkili-telefon')?.focus();
        return;
      }

      // Branş kontrolleri
      const branchSections = Array.from(branchRoot?.querySelectorAll('[data-branch-section]') || []);
      for (let i = 0; i < branchSections.length; i++) {
        const bransEl = branchSections[i].querySelector('[data-field="brans"]');
        if (bransEl instanceof HTMLSelectElement && !bransEl.value) {
          showError(`Lütfen ${i + 1}. branş alanını seçin.`);
          bransEl.focus();
          return;
        }
      }

      // Buton yükleniyor durumuna alınır (mükerrer tıklamayı önler)
      const originalBtnContent = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.classList.add('is-loading');
        submitBtn.innerHTML = `
          <svg class="spinner" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
            <path d="M12 2a10 10 0 0 1 10 10" stroke="#ffffff"></path>
          </svg>
          <span class="submit-btn-text">Başvurunuz Gönderiliyor...</span>
        `;
      }

      try {
        const formData = new FormData(formEl);
        const response = await fetch('/api/basvuru', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json',
          },
        });

        const data = await response.json().catch(() => null);

        if (response.ok && data?.success) {
          // Başarılı gönderim!
          window.localStorage.removeItem(formDraftKey);
          if (typeof window.spornereedeTrack === 'function') {
            window.spornereedeTrack('application_success');
          }

          // Formu gizle, başarı ekranını göster
          formEl.style.display = 'none';
          if (clientSuccessView) {
            const clubNameEl = document.getElementById('success-club-name');
            if (clubNameEl) clubNameEl.textContent = kulupAdVal;
            clientSuccessView.style.display = 'flex';
            clientSuccessView.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        } else {
          // Sunucu hatası
          const msg = data?.message || 'Başvuru kaydedilirken bir hata oluştu. Lütfen tekrar deneyin.';
          showError(msg);
          if (submitBtn instanceof HTMLButtonElement) {
            submitBtn.disabled = false;
            submitBtn.classList.remove('is-loading');
            submitBtn.innerHTML = originalBtnContent;
          }
        }
      } catch (err) {
        console.error('Başvuru gönderme hatası:', err);
        showError('İnternet bağlantınızda bir sorun oluştu veya istek zaman aşımına uğradı. Lütfen tekrar deneyin veya doğrudan WhatsApp hattımızdan bize iletin.');
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.classList.remove('is-loading');
          submitBtn.innerHTML = originalBtnContent;
        }
      }
    });

    document.getElementById('btn-new-application')?.addEventListener('click', () => {
      if (clientSuccessView) clientSuccessView.style.display = 'none';
      if (formEl) {
        formEl.reset();
        fillDistricts('');
        hideError();
        window.localStorage.removeItem(formDraftKey);
        formEl.style.display = 'block';
        syncBranchCount(1);
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.classList.remove('is-loading');
          submitBtn.innerHTML = `
            <svg class="submit-btn-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="submit-btn-text">Ücretsiz Başvuruyu Gönder</span>
          `;
        }
        formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    if (new URLSearchParams(window.location.search).get('success') === '1') {
      window.localStorage.removeItem(formDraftKey);
      window.addEventListener('load', function () {
        if (typeof window.spornereedeTrack === 'function') {
          window.spornereedeTrack('application_success');
        }
      }, { once: true });
    }
  </script>

</BaseLayout>


