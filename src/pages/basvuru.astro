---
/**
 * basvuru.astro
 * Kulüp Başvuru Sayfası — /basvuru
 * Kulüplerin platforma kayıt için dolduracağı form.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllCities, getAllDistrictsWithCities, getAllBranches } from '../lib/repositories/catalog';
import { getBankTransferDisplay } from '../lib/billing/bankTransfer';

const success = Astro.url.searchParams.get('success') === '1';
const errorCode = Astro.url.searchParams.get('error') ?? '';
const errorMessages: Record<string, string> = {
  missing: 'Lütfen zorunlu alanları eksiksiz doldurun.',
  email: 'Lütfen geçerli bir e-posta adresi yazın.',
  payment: 'Başvuru için ödeme onayı zorunludur.',
  receipt: 'Dekont dosyası zorunludur.',
  receipt_size: 'Dekont dosyası 10MB sınırını aşıyor.',
  receipt_type: 'Dekont için yalnızca PDF, JPG, PNG veya WEBP kabul edilir.',
  server: 'Başvuru gönderilemedi. Lütfen tekrar deneyin.',
};
const errorMessage = errorMessages[errorCode] ?? '';

const [cityRows, districtRows, branchRows] = await Promise.all([
  getAllCities(),
  getAllDistrictsWithCities(),
  getAllBranches(),
]);
const CITIES = cityRows.map(c => c.ad);
const MEMBERSHIP_PLANS = [
  { kod: 'alti-aylik', ad: '6 Aylık', ucret: 7500, sure: '1 Branş Dahil', oneCikan: true },
  { kod: 'on-iki-aylik', ad: 'Yıllık', ucret: 12000, sure: '1 Branş Dahil', oneCikan: false },
];
const DISTRICTS_BY_CITY = districtRows.reduce<Record<string, { ad: string; slug: string }[]>>((acc, district) => {
  if (!district.il) return acc;
  acc[district.il] ??= [];
  acc[district.il].push({ ad: district.ad, slug: district.slug });
  return acc;
}, {});

const bransListesi = [
  ...branchRows.map((b) => b.isim).sort((a, b) => a.localeCompare(b, 'tr')),
  'Diğer',
];

const adimlar = [
  { num: '1', label: 'Kulüp Bilgileri' },
  { num: '2', label: 'İletişim' },
  { num: '3', label: 'Paket' },
];

const { iban, accountName, bankName, branch } = getBankTransferDisplay();
---

<BaseLayout
  title="Kulübünü Ekle — Başvuru Formu"
  description="SporNerede.net'e kulübünüzü veya kursunuzu ekleyin. Türkiye genelinde spor arayan ailelere ulaşın. Başvuru formu hızlı ve kolay."
  keywords="spor kulübü ekle, spor kursu ekle, spornerede başvuru, kulüp listesi"
>

  <div class="basvuru-page">

    <!-- ===== HERO ÜSTÜ ===== -->
    <div class="basvuru-hero">
      <div class="basvuru-hero-bg" aria-hidden="true">
        <div class="bh-orb bh-orb-1"></div>
        <div class="bh-orb bh-orb-2"></div>
      </div>
      <div class="container basvuru-hero-content">
        <div class="hero-left-content">
          <div class="basvuru-badge">🏆 Platforma Katıl</div>
          <h1 class="basvuru-title">Kulübünüzü<br />Listeleyin</h1>
          <p class="basvuru-desc">
            Başvurunuz 24 saat içinde incelenir. Onaylandıktan sonra profiliniz yayına alınır.
          </p>
          <!-- Adım göstergesi -->
          <div class="adimlar" aria-label="Form Adımları" role="list">
            {adimlar.map((adim, i) => (
              <div class="adim" role="listitem">
                <div class={`adim-num ${i === 0 ? 'adim-aktif' : ''}`} aria-current={i === 0 ? 'step' : undefined}>
                  {adim.num}
                </div>
                <span class="adim-label">{adim.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="hero-right-content" aria-hidden="true"></div>
      </div>
    </div>

    <!-- ===== FORM ALANI ===== -->
    <div class="basvuru-form-wrapper">
      <div class="container">
        <div class="basvuru-grid">

          <!-- Form -->
          <main class="basvuru-form-card" id="main-content">

            {success ? (
              <!-- Başarı durumu -->
              <div class="success-state" role="alert" aria-live="polite">
                <div class="success-icon" aria-hidden="true">✅</div>
                <h2 class="success-title">Başvurunuz Alındı!</h2>
                <p class="success-desc">
                  Başvurunuzu inceleyeceğiz ve 24 saat içinde iletişim bilgileriniz üzerinden size dönüş yapacağız.
                </p>
                <a href="/" class="btn btn-primary">Ana Sayfaya Dön</a>
              </div>
            ) : (
              <form
                id="basvuru-form"
                method="post"
                action="/api/basvuru"
                novalidate
                aria-label="Kulüp Başvuru Formu"
              >

                {errorMessage && (
                  <div class="form-alert form-alert--error" role="alert" aria-live="polite">
                    {errorMessage}
                  </div>
                )}

                <!-- Bölüm 1: Kulüp Bilgileri -->
                <div class="form-section">
                  <h2 class="form-section-title">
                    <span class="form-section-num" aria-hidden="true">1</span>
                    Kulüp / Kurs Bilgileri
                  </h2>

                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="kulup-ad">
                        Kulüp / Kurs Adı <span class="required" aria-label="zorunlu alan">*</span>
                      </label>
                      <input
                        type="text"
                        id="kulup-ad"
                        name="kulupad"
                        class="form-input"
                        placeholder="Örn: Türkiye Futbol Akademisi"
                        required
                        autocomplete="organization"
                        aria-required="true"
                      />
                    </div>
                  </div>

                  <div class="form-row form-row-2col">
                    <div class="form-group">
                      <label class="form-label" for="kulup-il">
                        İl <span class="required" aria-label="zorunlu alan">*</span>
                      </label>
                      <select id="kulup-il" name="il" class="form-select" required aria-required="true">
                        <option value="">İl seçin...</option>
                        {CITIES.map((il) => (
                          <option value={il}>{il}</option>
                        ))}
                      </select>
                    </div>
                    <div class="form-group">
                      <label class="form-label" for="kulup-ilce">
                        İlçe <span class="required" aria-label="zorunlu alan">*</span>
                      </label>
                      <select id="kulup-ilce" name="ilce" class="form-select" required aria-required="true">
                        <option value="">Önce il seçin...</option>
                      </select>
                    </div>

                    <div class="form-group">
                      <label class="form-label" for="kulup-brans">
                        Branş <span class="required" aria-label="zorunlu alan">*</span>
                      </label>
                      <select id="kulup-brans" name="brans" class="form-select" required aria-required="true">
                        <option value="">Branş seçin...</option>
                        {bransListesi.map((brans) => (
                          <option value={brans}>{brans}</option>
                        ))}
                      </select>
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="kulup-adres">
                        Tam Adres - Tesis İsmi
                      </label>
                      <input
                        type="text"
                        id="kulup-adres"
                        name="adres"
                        class="form-input"
                        placeholder="Mahalle, cadde/sokak, no — ilçe, il"
                        autocomplete="street-address"
                      />
                    </div>
                  </div>

                  <div class="form-row form-row-2col">
                    <div class="form-group">
                      <label class="form-label" for="kulup-yas">Yaş Aralığı (isteğe bağlı)</label>
                      <input
                        type="text"
                        id="kulup-yas"
                        name="yasaraligi"
                        class="form-input"
                        placeholder="Örn: 6–18"
                      />
                    </div>

                    <div class="form-group">
                      <label class="form-label" for="kulup-fiyat">Aylık Ücret (₺) (isteğe bağlı)</label>
                      <input
                        type="text"
                        id="kulup-fiyat"
                        name="fiyat"
                        class="form-input"
                        placeholder="Örn: 500"
                      />
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="kulup-aciklama">Kulüp / Kurs Hakkında (isteğe bağlı)</label>
                      <textarea
                        id="kulup-aciklama"
                        name="aciklama"
                        class="form-textarea"
                        rows={4}
                        placeholder="Kulübünüz veya kursunuz hakkında kısa bilgi verin. Antrenörler, tesisler, başarılar..."
                      ></textarea>
                    </div>
                  </div>
                </div>

                <!-- Bölüm 2: İletişim Bilgileri -->
                <div class="form-section">
                  <h2 class="form-section-title">
                    <span class="form-section-num" aria-hidden="true">2</span>
                    İletişim Bilgileri
                  </h2>

                  <div class="form-row form-row-2col">
                    <div class="form-group">
                      <label class="form-label" for="yetkili-ad">
                        Yetkili Kişi Adı <span class="required" aria-label="zorunlu alan">*</span>
                      </label>
                      <input
                        type="text"
                        id="yetkili-ad"
                        name="yetkili"
                        class="form-input"
                        placeholder="Ad Soyad"
                        required
                        autocomplete="name"
                        aria-required="true"
                      />
                    </div>

                    <div class="form-group">
                      <label class="form-label" for="yetkili-telefon">
                        Telefon <span class="required" aria-label="zorunlu alan">*</span>
                      </label>
                      <input
                        type="tel"
                        id="yetkili-telefon"
                        name="telefon"
                        class="form-input"
                        placeholder="0555 123 45 67"
                        required
                        autocomplete="tel"
                        aria-required="true"
                      />
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="yetkili-email">E-posta (isteğe bağlı)</label>
                      <input
                        type="email"
                        id="yetkili-email"
                        name="email"
                        class="form-input"
                        placeholder="kulup@orneksiteniz.com"
                        autocomplete="email"
                      />
                    </div>
                  </div>
                </div>

                <div class="form-section">
                  <h2 class="form-section-title">
                    <span class="form-section-num" aria-hidden="true">3</span>
                    Üyelik Paketi
                  </h2>
                  <p class="paket-subtitle">6 aylık veya yıllık paketinizi seçin. Her paket 1 branş içerir; sonraki her branş %50 indirimlidir.</p>
                  <div class="membership-grid" role="radiogroup" aria-label="Üyelik Paketi">
                    {MEMBERSHIP_PLANS.length ? MEMBERSHIP_PLANS.map((plan) => {
                      return (
                        <label class="membership-card" for={`uyelik-${plan.kod}`}>
                          <input
                            id={`uyelik-${plan.kod}`}
                            class="membership-radio"
                            type="radio"
                            name="paket"
                            value={plan.kod}
                            data-plan-name={plan.ad}
                            data-plan-price={plan.ucret}
                            required
                          />
                          <div class="membership-card-content">
                            <div class="membership-header">
                              <h3 class="membership-name">{plan.ad}</h3>
                              <span class="membership-period">{plan.sure}</span>
                            </div>
                            
                            <div class="membership-price-area">
                              <div class="membership-price">
                                {new Intl.NumberFormat('tr-TR').format(plan.ucret)} <span class="currency">TL</span>
                              </div>
                              <div class="membership-monthly">1 BRANŞ</div>
                              <div class="membership-discount-badge">Ek Branşlar %50 İndirimli</div>
                            </div>
                            
                            <div class="membership-divider"></div>
                            
                            <div class="membership-select-btn">Planı Seç</div>
                          </div>
                        </label>
                      );
                    }) : (
                      <div class="form-alert form-alert--error membership-empty" role="alert">
                        Üyelik paketleri şu an yüklenemedi. Lütfen daha sonra tekrar deneyin.
                      </div>
                    )}
                  </div>
                  <div class="membership-branch-global">
                    <label for="brans-sayisi-global">Yayınlanacak Branş Sayısı</label>
                    <p class="membership-branch-help">
                      Seçtiğiniz pakete 1 branş dahildir. Ek yayınlanacak her branş %50 indirimlidir.
                    </p>
                    <input
                      id="brans-sayisi-global"
                      type="number"
                      min="1"
                      step="1"
                      value="1"
                      class="form-input membership-branch-input membership-branch-input--global"
                      data-branch-input
                    />
                  </div>
                  <input type="hidden" id="brans-sayisi-hidden" name="bransSayisi" value="1" />

                  <div class="payment-box">
                    <h3 class="payment-title">Banka Havalesi ile Ödeme</h3>
                    <p class="payment-desc">Kısa vadede ödeme modelimiz havale/EFT + dekont onayı şeklindedir.</p>
                    <div class="payment-grid">
                      <div class="payment-item">
                        <span class="payment-label">Banka</span>
                        <strong>{bankName}</strong>
                      </div>
                      <div class="payment-item">
                        <span class="payment-label">Hesap Adı</span>
                        <strong>{accountName}</strong>
                      </div>
                      <div class="payment-item">
                        <span class="payment-label">Şube</span>
                        <strong>{branch}</strong>
                      </div>
                      <div class="payment-item payment-item--iban">
                        <span class="payment-label">IBAN</span>
                        <strong>{iban}</strong>
                      </div>
                      <div class="payment-item payment-item--iban">
                        <span class="payment-label">Gönderilecek Tutar</span>
                        <strong id="dyn-payment-total" class="payment-total-pending" data-empty="1">—</strong>
                      </div>
                    </div>
                    <div class="payment-reference">
                      <label for="dyn-payment-ref">Banka Açıklama</label>
                      <input id="dyn-payment-ref" type="text" readonly value="Kulüp veya Kurs Adınızı -" />
                    </div>
                    <ol class="payment-steps">
                      <li><strong id="dyn-payment-amount">Paket tutarını</strong> yukarıdaki IBAN hesabına gönderin.</li>
                      <li>Açıklama alanına <strong id="dyn-payment-desc">Kulüp veya Kurs Adınızı</strong> yazın.</li>
                      <li>Ödeme onay kutusunu işaretleyip başvuruyu tamamlayın.</li>
                    </ol>
                    <label class="payment-confirm">
                      <input type="checkbox" name="odemeOnay" value="1" class="sr-only-checkbox" required aria-required="true" />
                      <div class="custom-checkbox">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </div>
                      <span>Ödemeyi yaptım ve dekontun doğru olduğunu onaylıyorum.</span>
                    </label>
                  </div>
                </div>

                <!-- Submit -->
                <div class="form-submit-area">
                  <p class="form-gizlilik">
                    Başvurarak <a href="/gizlilik" class="gizlilik-link">Gizlilik Politikası</a>'nı kabul etmiş olursunuz. Bilgileriniz üçüncü taraflarla paylaşılmaz.
                  </p>
                  <button type="submit" class="btn btn-primary btn-lg submit-btn" id="basvuru-submit-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Başvuruyu Gönder
                  </button>
                </div>

                <div class="form-contact-card">
                  <h3 class="form-contact-title">Sorularınız mı var?</h3>
                  <p class="form-contact-text">Başvuru süreciyle ilgili yardım için bize ulaşın:</p>
                  <div class="form-contact-actions">
                    <a
                      href="https://wa.me/905362982218"
                      class="form-contact-action form-contact-action--whatsapp"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="WhatsApp ile doğrudan mesaj gönder"
                    >
                      <img src="/icons/whatsapp.svg" alt="" aria-hidden="true" width="16" height="16" />
                      WhatsApp'tan Ulaş
                    </a>
                    <a
                      href="mailto:info@spornerede.net"
                      class="form-contact-action form-contact-action--email"
                      aria-label="E-posta ile iletişime geç"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                        <polyline points="22,6 12,13 2,6"/>
                      </svg>
                      info@spornerede.net
                    </a>
                  </div>
                </div>

              </form>
            )}
          </main>

        </div>
      </div>
    </div>

  </div>

  <script id="district-data" type="application/json" set:html={JSON.stringify(DISTRICTS_BY_CITY)}></script>

  <script is:inline>
    const citySelect = document.getElementById('kulup-il');
    const districtSelect = document.getElementById('kulup-ilce');
    const districtDataEl = document.getElementById('district-data');
    const districtsByCity = districtDataEl ? JSON.parse(districtDataEl.textContent || '{}') : {};

    function fillDistricts(cityName) {
      if (!(districtSelect instanceof HTMLSelectElement)) return;
      districtSelect.innerHTML = '';

      const districts = districtsByCity[cityName] || [];
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = cityName ? (districts.length ? 'İlçe seçin...' : 'Bu il için ilçe bulunamadı') : 'Önce il seçin...';
      districtSelect.appendChild(placeholder);

      districts.forEach((district) => {
        const option = document.createElement('option');
        option.value = district.ad;
        option.textContent = district.ad;
        districtSelect.appendChild(option);
      });
    }

    if (citySelect instanceof HTMLSelectElement) {
      fillDistricts(citySelect.value);
      citySelect.addEventListener('change', () => fillDistricts(citySelect.value));
    }

    // Dinamik odeme metinleri
    const kulupInput = document.getElementById('kulup-ad');
    const dynDesc = document.getElementById('dyn-payment-desc');
    const dynAmount = document.getElementById('dyn-payment-amount');
    const dynTotal = document.getElementById('dyn-payment-total');
    const dynReference = document.getElementById('dyn-payment-ref');
    const branchCountHidden = document.getElementById('brans-sayisi-hidden');
    const branchCountInputs = Array.from(document.querySelectorAll('[data-branch-input]'));
    const radios = document.querySelectorAll('input[name="paket"]');

    const formatTL = (amount) => `${new Intl.NumberFormat('tr-TR').format(amount)} TL`;
    const getSelectedPlan = () => Array.from(radios).find((radio) => radio.checked);

    const CLUB_PAYMENT_LABEL = 'Kulüp veya Kurs Adınızı';

    function displayClubLabel(clubName) {
      return clubName || CLUB_PAYMENT_LABEL;
    }

    function setPaymentTotalPending(pending) {
      if (!(dynTotal instanceof HTMLElement)) return;
      dynTotal.dataset.empty = pending ? '1' : '0';
      dynTotal.classList.toggle('payment-total-pending', pending);
    }

    function updatePaymentInfo() {
      const selected = getSelectedPlan();
      const clubName = kulupInput instanceof HTMLInputElement ? kulupInput.value.trim() : '';
      const clubLabel = displayClubLabel(clubName);
      const branchCountRaw = branchCountHidden instanceof HTMLInputElement ? Number(branchCountHidden.value || 1) : 1;
      const branchCount = Number.isFinite(branchCountRaw) ? Math.max(1, Math.floor(branchCountRaw)) : 1;
      const extraCount = Math.max(0, branchCount - 1);

      if (dynDesc) dynDesc.textContent = `"${clubLabel}"`;

      if (!selected) {
        if (dynAmount) dynAmount.textContent = 'Paket tutarını';
        if (dynTotal) dynTotal.textContent = '—';
        setPaymentTotalPending(true);
        if (dynReference instanceof HTMLInputElement) {
          dynReference.value = `${clubLabel} -`;
        }
        return;
      }

      const basePrice = Number(selected.dataset.planPrice || 0);
      const totalAmount = basePrice + extraCount * basePrice * 0.5;
      const totalText = formatTL(totalAmount);

      if (dynAmount) dynAmount.textContent = `${totalText} tutarını`;
      if (dynTotal) dynTotal.textContent = totalText;
      setPaymentTotalPending(false);
      if (dynReference instanceof HTMLInputElement) {
        dynReference.value = `${clubLabel} - ${totalText}`;
      }
    }

    function syncBranchCount(nextValue) {
      const count = Number.isFinite(nextValue) ? Math.max(1, Math.floor(nextValue)) : 1;
      if (branchCountHidden instanceof HTMLInputElement) {
        branchCountHidden.value = String(count);
      }
      branchCountInputs.forEach((input) => {
        if (input instanceof HTMLInputElement && input.value !== String(count)) {
          input.value = String(count);
        }
      });
      updatePaymentInfo();
    }

    kulupInput?.addEventListener('input', updatePaymentInfo);
    branchCountInputs.forEach((input) => {
      input.addEventListener('input', () => syncBranchCount(Number(input.value)));
      input.addEventListener('click', (event) => event.stopPropagation());
      input.addEventListener('keydown', (event) => event.stopPropagation());
    });
    radios.forEach((radio) => radio.addEventListener('change', updatePaymentInfo));
    syncBranchCount(1);
    updatePaymentInfo();
  </script>

</BaseLayout>

<style>
  /* ===== GENEL SAYFA ===== */
  .basvuru-page {
    min-height: 100vh;
    background: #F8F9FA;
  }

  /* ===== HERO ===== */
  .basvuru-hero {
    position: relative;
    background: linear-gradient(135deg, #0D0D0D 0%, #1a0002 60%, #2d0005 100%);
    color: #ffffff;
    padding: 4rem 0 3rem;
    overflow: hidden;
  }

  .basvuru-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .bh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
  }

  .bh-orb-1 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(227,10,23,0.2) 0%, transparent 70%);
    top: -100px;
    right: 5%;
  }

  .bh-orb-2 {
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(255,255,255,0.04) 0%, transparent 70%);
    bottom: 0;
    left: 10%;
  }

  .basvuru-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 840px;
  }

  @media (min-width: 900px) {
    .basvuru-hero-content {
      display: flex;
    }
  }

  .hero-left-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-right-content {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .hero-right-content {
      justify-content: flex-end;
    }
  }

  .hero-feature-card-glass {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
