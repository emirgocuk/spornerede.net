---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurrentSessionUser } from '../../lib/auth/session';
import { getUserPrimaryClub } from '../../lib/repositories/auth';
import { getPanelProfile } from '../../lib/repositories/panelProfile';

const session = await getCurrentSessionUser(Astro.request);
if (!session) {
  return Astro.redirect('/admin?error=auth');
}
if (session.mustChangePassword) {
  return Astro.redirect('/panel/sifre-degistir?required=1');
}
const membership = await getUserPrimaryClub(session.userId);
if (!membership || membership.clubStatus !== 'approved') {
  return Astro.redirect('/admin?error=forbidden');
}

const profile = await getPanelProfile(session.userId);
if (!profile) {
  return Astro.redirect('/panel?saved=0');
}

const saveStatus = Astro.url.searchParams.get('saved');
---

<BaseLayout title="Kulüp Profili | SporNerede" description="Kulüp profil bilgilerini düzenleyin." noIndex={true}>
  <div class="panel-background"></div>
  <section class="section panel-profile relative z-10">
    <div class="container container--narrow">
      
      <header class="page-header animate-fade-in-up">
        <a href="/panel" class="back-link">← Panele Dön</a>
        <h1 class="page-title">Kulüp Profili</h1>
        <p class="page-lead">İletişim ve genel bilgilerinizi güncelleyerek sporcuların size daha kolay ulaşmasını sağlayın.</p>
      </header>

      <!-- Feedback Messages -->
      {saveStatus === '1' && (
        <div class="alert-box success animate-fade-in-up delay-100">
          <div class="alert-icon">✅</div>
          <div class="alert-content">
            <strong>Başarılı!</strong> Profil bilgileriniz güncellendi.
          </div>
        </div>
      )}
      
      {saveStatus === '0' && (
        <div class="alert-box error animate-fade-in-up delay-100">
          <div class="alert-icon">⚠️</div>
          <div class="alert-content">
            <strong>Hata!</strong> Profil kaydedilemedi. Lütfen zorunlu alanları kontrol edin.
          </div>
        </div>
      )}

      <!-- Form Container -->
      <div class="form-wrapper card-glass animate-fade-in-up delay-100">
        <div class="form-header">
          <div class="club-avatar">
            <span class="avatar-text">{profile.ad ? profile.ad.substring(0, 1).toUpperCase() : 'K'}</span>
          </div>
          <div class="club-title">
            <h2>{profile.ad || 'Kulüp Bilgileri'}</h2>
            <span class="badge-modern">Onaylı Kulüp</span>
          </div>
        </div>

        <form class="profile-form" method="post" action="/api/panel/profile">
          <div class="form-group">
            <label>Kulüp Adı</label>
            <input class="modern-input disabled" value={profile.ad} disabled title="Kulüp adını değiştirmek için sistem yöneticisine başvurunuz." />
            <span class="input-hint">Kulüp adını değiştirmek isterseniz iletişime geçiniz.</span>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="telefon">Telefon Numarası <span class="text-red">*</span></label>
              <div class="input-icon-wrapper">
                <i class="input-icon">📞</i>
                <input id="telefon" name="telefon" class="modern-input with-icon" value={profile.telefon} required placeholder="05XX XXX XX XX" />
              </div>
            </div>
            <div class="form-group">
              <label for="email">E-posta Adresi <span class="text-red">*</span></label>
              <div class="input-icon-wrapper">
                <i class="input-icon">📧</i>
                <input id="email" name="email" type="email" class="modern-input with-icon" value={profile.email} required placeholder="ornek@kulup.com" />
              </div>
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="yasAraligi">Hitap Edilen Yaş Aralığı</label>
              <input id="yasAraligi" name="yasAraligi" class="modern-input" value={profile.yasAraligi} placeholder="Örn: 6-18 Yaş" />
            </div>
            <div class="form-group">
              <label for="fiyatBilgisi">Genel Fiyat Bilgisi</label>
              <input id="fiyatBilgisi" name="fiyatBilgisi" class="modern-input" value={profile.fiyatBilgisi} placeholder="Örn: 1000 TL - 3000 TL" />
            </div>
          </div>

          <div class="form-group">
            <label for="adres">Tam Adres</label>
            <textarea id="adres" name="adres" class="modern-textarea" rows="3" placeholder="Mahalle, Sokak, No, İlçe/İl">{profile.adres}</textarea>
          </div>

          <div class="form-group">
            <label for="aciklama">Kulüp Hakkında</label>
            <textarea id="aciklama" name="aciklama" class="modern-textarea" rows="5" placeholder="Kulübünüzün tarihi, vizyonu, başarıları ve tesis imkanları hakkında bilgi verin.">{profile.aciklama}</textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary-gradient">💾 Değişiklikleri Kaydet</button>
            <a href="/panel" class="btn-white">İptal Et</a>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Base Layout */
  .panel-background {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(135deg, #f8f9fa 0%, #f1f5f9 100%);
    z-index: 0;
    pointer-events: none;
  }
  
  .panel-profile {
    min-height: 80vh;
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  
  .container--narrow { max-width: 800px; }

  /* Shared Glass Card */
  .card-glass {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03), inset 0 1px 0 rgba(255,255,255,1);
    border-radius: 1.25rem;
    overflow: hidden;
  }

  /* Header */
  .page-header { margin-bottom: 2rem; }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-brand-gray-600);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--color-brand-red); }

  .page-title {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 900;
    color: var(--color-brand-gray-900);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  
  .page-lead { margin: 0; color: var(--color-brand-gray-600); font-size: 1.05rem; }

  /* Alert Messages */
  .alert-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .alert-icon { font-size: 1.5rem; }
  .alert-content strong { display: block; margin-bottom: 0.1rem; }

  .alert-box.success {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
  }

  .alert-box.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  /* Form Styling */
  .form-wrapper { padding: 2rem; }

  .form-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px dashed var(--color-brand-gray-200);
  }

  .club-avatar {
    width: 64px; height: 64px;
    background: linear-gradient(135deg, var(--color-brand-red) 0%, #b5080f 100%);
    border-radius: 1rem;
    display: grid; place-items: center;
    color: white; font-size: 2rem; font-weight: 900;
    box-shadow: 0 4px 10px rgba(227, 10, 23, 0.2);
  }

  .club-title h2 { margin: 0 0 0.4rem; font-size: 1.4rem; font-weight: 800; color: var(--color-brand-gray-900); }
  
  .badge-modern {
    display: inline-block;
    background: #ecfdf5;
    color: #059669;
    border: 1px solid #d1fae5;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .profile-form { display: flex; flex-direction: column; gap: 1.25rem; }

  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  
  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  
  @media (min-width: 600px) { .form-row-2 { grid-template-columns: 1fr 1fr; } }

  label { font-size: 0.85rem; font-weight: 700; color: var(--color-brand-gray-700); }
  .text-red { color: var(--color-brand-red); }

  .modern-input, .modern-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-brand-gray-300);
    border-radius: 0.75rem;
    font-family: inherit;
    font-size: 0.95rem;
    transition: all 0.2s;
    background: white;
    color: var(--color-brand-gray-900);
  }

  .modern-input:focus, .modern-textarea:focus {
    outline: none;
    border-color: var(--color-brand-red);
    box-shadow: 0 0 0 3px rgba(227, 10, 23, 0.1);
  }

  .modern-input.disabled { background: var(--color-brand-gray-50); color: var(--color-brand-gray-500); cursor: not-allowed; }
  .input-hint { font-size: 0.75rem; color: var(--color-brand-gray-500); margin-top: 0.2rem; }

  .modern-textarea { resize: vertical; min-height: 80px; }

  .input-icon-wrapper { position: relative; display: flex; align-items: center; }
  .input-icon { position: absolute; left: 1rem; font-style: normal; opacity: 0.6; }
  .modern-input.with-icon { padding-left: 2.5rem; }

  /* Actions */
  .form-actions {
    display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;
    margin-top: 1rem; padding-top: 1.5rem;
    border-top: 1px dashed var(--color-brand-gray-200);
  }

  .btn-primary-gradient {
    display: inline-flex; justify-content: center; align-items: center;
    padding: 0.8rem 1.5rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, var(--color-brand-red) 0%, #b5080f 100%);
    color: white;
    font-weight: 800;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(227, 10, 23, 0.2);
    transition: all 0.2s;
  }
  .btn-primary-gradient:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(227, 10, 23, 0.3); }

  .btn-white {
    display: inline-flex; justify-content: center; align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    background: white;
    color: var(--color-brand-gray-700);
    font-weight: 700;
    font-size: 0.95rem;
    border: 1px solid var(--color-brand-gray-300);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-white:hover { background: var(--color-brand-gray-50); color: var(--color-brand-gray-900); }

  /* Animations */
  .animate-fade-in-up { animation: fadeInUp 0.5s ease-out forwards; opacity: 0; transform: translateY(15px); }
  .delay-100 { animation-delay: 0.1s; }
  @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }
</style>
