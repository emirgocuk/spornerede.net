---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurrentSessionUser } from '../../lib/auth/session';
import { getUserPrimaryClub } from '../../lib/repositories/auth';

const currentSession = await getCurrentSessionUser(Astro.request).catch(() => null);

let clubMembership: Awaited<ReturnType<typeof getUserPrimaryClub>> = null;
if (currentSession?.role === 'club' && !currentSession.mustChangePassword) {
  clubMembership = await getUserPrimaryClub(currentSession.userId);
}

if (currentSession?.role === 'admin') {
  return Astro.redirect('/admin');
}
if (currentSession?.role === 'club') {
  if (currentSession.mustChangePassword) {
    return Astro.redirect('/panel/sifre-degistir?required=1');
  }
  if (clubMembership?.clubStatus === 'approved') {
    return Astro.redirect('/panel');
  }
}

const showPanelAccessDenied =
  currentSession?.role === 'club' && !currentSession.mustChangePassword && clubMembership?.clubStatus !== 'approved';

const errorCode = Astro.url.searchParams.get('error') ?? '';
const errorMessage =
  errorCode === 'invalid'
    ? 'E-posta veya şifre hatalı.'
    : errorCode === 'missing'
      ? 'Lütfen e-posta ve şifre alanlarını doldurun.'
      : errorCode === 'auth'
        ? 'Bu sayfayı görmek için önce giriş yapmalısınız.'
        : errorCode === 'forbidden'
          ? 'Panele giriş için onaylı kulüp ve aktif üyelik gerekir. Kulüp henüz onaylanmadıysa veya üyelik süresi bittiyse yönetici ile iletişime geçin.'
        : errorCode === 'password_changed'
          ? 'Şifreniz güncellendi, yeni şifrenizle giriş yapabilirsiniz.'
        : '';
---

<BaseLayout
  title="Kulüp paneli — Üye girişi"
  description="Kayıtlı kulüp ve kurs temsilcileri için giriş sayfası. Oturum açma yakında etkinleştirilecek."
  noIndex={true}
>
  <section class="section panel-login">
    <div class="container container--narrow">
      <h1 class="page-title">Üye girişi</h1>
      <p class="page-lead">
        Onaylı kulüp ve kurs temsilcileri için panel girişi buradan yapılır.
      </p>
      {errorMessage && <p class="error-box">{errorMessage}</p>}

      {showPanelAccessDenied && (
        <div class="warn-box" role="alert">
          <p>
            Oturumunuz açık ancak kulüp paneline erişiminiz yok (onaylı kulüp veya aktif üyelik şartı). Çıkış yapıp doğru
            hesapla tekrar deneyebilir veya yöneticiye başvurabilirsiniz.
          </p>
          <form method="post" action="/api/panel/logout">
            <button type="submit" class="logout-inline-btn">Çıkış yap</button>
          </form>
        </div>
      )}

      <form class="login-form" method="post" action="/api/panel/login">
        <input type="hidden" name="redirectTo" value="/panel" />
        <label>
          E-posta
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          Şifre
          <input name="password" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Giriş yap</button>
      </form>
      <p class="forgot-password">
        <a href="/panel/sifremi-unuttum">Sifrenizi mi unuttunuz?</a>
      </p>

      <p class="page-note">
        Henüz hesabınız yoksa kulüp kaydı için <a href="/basvuru">başvuru formunu</a> kullanabilirsiniz.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .panel-login {
    background: #f8f9fa;
    min-height: 55vh;
    padding-block: 2.5rem;
  }
  .container--narrow {
    max-width: 36rem;
  }
  .page-title {
    font-size: clamp(1.65rem, 3vw, 2rem);
    font-weight: 900;
    color: #212529;
    margin: 0;
  }
  .page-lead {
    margin-top: 0.75rem;
    color: #495057;
    line-height: 1.65;
  }
  .page-note {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: #6c757d;
  }
  .forgot-password {
    margin-top: 0.85rem;
  }
  .forgot-password a {
    color: #e30a17;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .forgot-password a:hover {
    color: #b5080f;
  }
  .error-box {
    margin-top: 1rem;
    border: 1px solid #ffc9c9;
    background: #fff5f5;
    color: #c92a2a;
    border-radius: 0.65rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.92rem;
  }
  .warn-box {
    margin-top: 1rem;
    border: 1px solid #ffe08a;
    background: #fff9db;
    color: #5c4a00;
    border-radius: 0.65rem;
    padding: 0.75rem 0.9rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .warn-box p {
    margin: 0 0 0.65rem;
  }
  .logout-inline-btn {
    border: 0;
    border-radius: 0.55rem;
    background: #495057;
    color: #fff;
    font-weight: 700;
    padding: 0.45rem 0.85rem;
    cursor: pointer;
    font-size: 0.88rem;
  }
  .logout-inline-btn:hover {
    background: #343a40;
  }
  .login-form {
    margin-top: 1rem;
    display: grid;
    gap: 0.85rem;
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 0.85rem;
    padding: 1rem;
  }
  .login-form label {
    display: grid;
    gap: 0.45rem;
    color: #343a40;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .login-form input {
    border: 1px solid #dee2e6;
    border-radius: 0.6rem;
    padding: 0.62rem 0.7rem;
    font-size: 0.95rem;
  }
  .login-form button {
    margin-top: 0.15rem;
    border: 0;
    border-radius: 0.65rem;
    background: #e30a17;
    color: #fff;
    font-weight: 700;
    padding: 0.62rem 0.9rem;
    cursor: pointer;
  }
  .login-form button:hover {
    background: #b5080f;
  }
  .page-note a {
    color: #e30a17;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .page-note a:hover {
    color: #b5080f;
  }
</style>
