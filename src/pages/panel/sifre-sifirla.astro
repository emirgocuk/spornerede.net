---
import BaseLayout from '../../layouts/BaseLayout.astro';

const token = Astro.url.searchParams.get('token') ?? '';
const ok = Astro.url.searchParams.get('ok');
const error = ok === '0' ? 'Gecersiz veya suresi dolmus link. Lutfen yeni sifirlama talebi olusturun.' : '';
---

<BaseLayout title="Sifre sifirla" description="Kulup paneli sifre sifirlama sayfasi." noIndex={true}>
  <section class="reset-page section">
    <div class="container container--narrow">
      <h1 class="page-title">Sifre sifirla</h1>
      <p class="page-lead">Yeni sifrenizi belirleyin ve hesabiniza tekrar giris yapin.</p>

      {!token && <p class="error-box">Gecersiz link. Lutfen sifremi unuttum sayfasindan yeni link isteyin.</p>}
      {error && <p class="error-box">{error}</p>}

      {token && (
        <form class="reset-form" method="post" action="/api/panel/reset-password">
          <input type="hidden" name="token" value={token} />
          <label>
            Yeni sifre
            <input name="password" type="password" minlength="8" autocomplete="new-password" required />
          </label>
          <label>
            Yeni sifre (tekrar)
            <input name="passwordAgain" type="password" minlength="8" autocomplete="new-password" required />
          </label>
          <button type="submit">Sifreyi guncelle</button>
        </form>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .reset-page {
    background: #f8f9fa;
    min-height: 55vh;
    padding-block: 2.5rem;
  }
  .container--narrow {
    max-width: 36rem;
  }
  .page-title {
    font-size: clamp(1.65rem, 3vw, 2rem);
    font-weight: 900;
    color: #212529;
    margin: 0;
  }
  .page-lead {
    margin-top: 0.75rem;
    color: #495057;
    line-height: 1.65;
  }
  .error-box {
    margin-top: 1rem;
    border: 1px solid #ffc9c9;
    background: #fff5f5;
    color: #c92a2a;
    border-radius: 0.65rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.92rem;
  }
  .reset-form {
    margin-top: 1rem;
    display: grid;
    gap: 0.85rem;
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 0.85rem;
    padding: 1rem;
  }
  .reset-form label {
    display: grid;
    gap: 0.45rem;
    color: #343a40;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .reset-form input {
    border: 1px solid #dee2e6;
    border-radius: 0.6rem;
    padding: 0.62rem 0.7rem;
    font-size: 0.95rem;
  }
  .reset-form button {
    margin-top: 0.15rem;
    border: 0;
    border-radius: 0.65rem;
    background: #e30a17;
    color: #fff;
    font-weight: 700;
    padding: 0.62rem 0.9rem;
    cursor: pointer;
  }
  .reset-form button:hover {
    background: #b5080f;
  }
</style>
