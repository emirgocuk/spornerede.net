---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurrentSessionUser } from '../../lib/auth/session';
import { getUserPrimaryClub } from '../../lib/repositories/auth';

const session = await getCurrentSessionUser(Astro.request);
if (!session) {
  return Astro.redirect('/panel/giris?error=auth');
}
if (session.mustChangePassword) {
  return Astro.redirect('/panel/sifre-degistir?required=1');
}
const membership = await getUserPrimaryClub(session.userId);
if (!membership || membership.clubStatus !== 'approved') {
  return Astro.redirect('/panel/giris?error=forbidden');
}
---

<BaseLayout title="Kurs / Program Yönetimi | SporNerede" description="Kulüp kurs ve programlarını yönetin." noIndex={true}>
  <div class="panel-background"></div>
  <section class="section panel-programs relative z-10">
    <div class="container container--wide">
      
      <!-- Header -->
      <header class="page-header animate-fade-in-up">
        <a href="/panel" class="back-link">← Panele Dön</a>
        <h1 class="page-title">Kurs ve Program Yönetimi</h1>
        <p class="page-lead">Yeni bir kurs ilanı yayınlayın, mevcut ilanlarınızı güncelleyin veya yayından kaldırın.</p>
      </header>

      <div id="program-list-view" class="program-list-view animate-fade-in-up delay-100">
        <div class="program-list-box card-glass">
          <div class="list-header">
            <div>
              <h2>İlan Listesi</h2>
              <p>Yayınladığınız ilanları buradan açıp düzenleyebilir veya yeni ilan oluşturabilirsiniz.</p>
            </div>
            <div class="list-header-actions">
              <span class="badge-modern bg-gray" id="program-count">0 İlan</span>
              <button id="new-program-btn" class="btn-primary-gradient btn-compact" type="button">+ Yeni İlan</button>
            </div>
          </div>
          <ul id="program-list" class="modern-program-list">
            <li class="empty-state">
              <div class="spinner-small"></div>
              <p>İlanlar yükleniyor...</p>
            </li>
          </ul>
        </div>
      </div>

      <div id="program-editor-view" class="program-editor-view is-hidden animate-fade-in-up delay-100">
        <button id="back-to-list" class="back-link editor-back" type="button">← İlanlara geri dön</button>
        <div class="program-layout">
          <div class="form-column">
          <form id="program-form" class="program-form card-glass">
            <div class="form-header">
              <h2 class="form-title">İlan Detayları</h2>
              <span class="badge-modern">Yeni Kayıt</span>
            </div>
            
            <input id="program-id" type="hidden" />
            
            <section class="form-section">
              <div class="section-heading">
                <span class="section-step">1</span>
                <div>
                  <h3>Temel Bilgiler</h3>
                  <p>İlanın ailelere görünecek kısa ve net adını yazın.</p>
                </div>
              </div>
              <div class="form-group">
                <label for="program-ad">Program Adı <span class="text-red">*</span></label>
                <input id="program-ad" class="modern-input" required placeholder="Örn: Çocuklar için temel yüzme eğitimi" />
              </div>
              <div class="form-row-2">
                <div class="form-group">
                  <label for="program-seviye">Seviye</label>
                  <select id="program-seviye" class="modern-input" required>
                    <option value="">Seviye seçin</option>
                    <option value="Başlangıç">Başlangıç</option>
                    <option value="Orta">Orta</option>
                    <option value="İleri">İleri</option>
                    <option value="Tüm seviyeler">Tüm seviyeler</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="program-ucret">Ücret Bilgisi</label>
                  <input id="program-ucret" class="modern-input" required placeholder="Örn: Aylık 1500 TL" />
                </div>
              </div>
            </section>

            <section class="form-section">
              <div class="section-heading">
                <span class="section-step">2</span>
                <div>
                  <h3>Takvim</h3>
                  <p>Günleri seçin, saat aralığını belirleyin. Sürekli ilanlarda bitiş tarihi zorunlu değildir.</p>
                </div>
              </div>
              <div class="day-picker" aria-label="Program günleri">
                {['Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi', 'Pazar'].map((day) => (
                  <label class="day-chip">
                    <input type="checkbox" name="program-day" value={day} />
                    <span>{day}</span>
                  </label>
                ))}
              </div>
              <div class="form-row-2">
                <div class="form-group">
                  <label for="program-start-time">Başlangıç Saati</label>
                  <input id="program-start-time" type="time" class="modern-input" required />
                </div>
                <div class="form-group">
                  <label for="program-end-time">Bitiş Saati</label>
                  <input id="program-end-time" type="time" class="modern-input" required />
                </div>
              </div>
              <div class="form-row-2">
                <div class="form-group">
                  <label for="program-event-date">Başlangıç Tarihi</label>
                  <input id="program-event-date" type="date" class="modern-input" required />
                </div>
                <div class="form-group">
                  <label for="program-end-date">Bitiş Tarihi</label>
                  <input id="program-end-date" type="date" class="modern-input" required />
                </div>
              </div>
              <label class="inline-check">
                <input id="program-ongoing" type="checkbox" />
                <span>Bu ilan sürekli devam ediyor</span>
              </label>
            </section>

            <section class="form-section">
              <div class="section-heading">
                <span class="section-step">3</span>
                <div>
                  <h3>Konum</h3>
                  <p>Şube/adres bilgisini yazın, Google Maps paylaşım bağlantısını ekleyin.</p>
                </div>
              </div>
              <div class="form-group">
                <label for="program-location">Konum / Şube</label>
                <input id="program-location" class="modern-input" required placeholder="Örn: Kadıköy Merkez Şube, Caferağa" />
              </div>
              <div class="maps-input-row">
                <input id="program-maps-url" class="modern-input" type="url" required placeholder="Google Maps bağlantısı yapıştırın" />
                <a class="btn-map" href="https://www.google.com/maps" target="_blank" rel="noreferrer">Maps'i Aç</a>
              </div>
            </section>

            <section class="form-section">
              <div class="section-heading">
                <span class="section-step">4</span>
                <div>
                  <h3>İlan Metni</h3>
                  <p>Kısa özet kartlarda görünür; geniş metin detay sayfasında zengin içerik olarak yayınlanır.</p>
                </div>
              </div>
              <div class="form-group">
                <label for="program-aciklama">Kısa Özet</label>
                <textarea id="program-aciklama" class="modern-textarea" rows="2" required placeholder="Kursun temel amacını 1-2 cümleyle özetleyin..."></textarea>
              </div>
              <div class="form-group">
                <label>Geniş Tanıtım Metni</label>
                <div class="editor-shell">
                  <textarea id="program-editor" class="program-editor"></textarea>
                </div>
              </div>
            </section>

            <section class="form-section">
              <div class="section-heading">
                <span class="section-step">5</span>
                <div>
                  <h3>Galeri Görselleri</h3>
                  <p>Görselleri alana sürükleyip bırakın veya tıklayarak seçin. Yüklenen görseller sonradan kaldırılabilir.</p>
                </div>
              </div>
              <div id="gallery-dropzone" class="gallery-dropzone">
                <input id="gallery-file" type="file" accept="image/*" class="modern-file-input" />
                <div class="dropzone-copy">
                  <strong>Görseli buraya bırakın</strong>
                  <span>veya tıklayıp dosya seçin</span>
                </div>
                <button id="gallery-upload-btn" type="button" class="btn-outline-sm">Yükle</button>
              </div>
              <ul id="gallery-list" class="gallery-list"></ul>
            </section>

            <div class="form-group checkbox-wrapper">
              <label class="toggle-label">
                <input id="program-aktif" type="checkbox" checked class="toggle-input" />
                <div class="toggle-switch"></div>
                <span class="toggle-text">İlanı Yayına Al (Aktif)</span>
              </label>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn-primary-gradient w-full">💾 İlanı Kaydet</button>
              <button id="form-reset" type="button" class="btn-white w-full mt-2">🔄 Formu Temizle</button>
            </div>
          </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import tinymce from 'tinymce/tinymce';
    import 'tinymce/icons/default';
    import 'tinymce/models/dom';
    import 'tinymce/themes/silver';
    import 'tinymce/plugins/advlist';
    import 'tinymce/plugins/autoresize';
    import 'tinymce/plugins/lists';
    import 'tinymce/skins/content/default/content.min.css';
    import 'tinymce/skins/ui/oxide/content.min.css';
    import 'tinymce/skins/ui/oxide/skin.min.css';

    const form = document.getElementById('program-form');
    const list = document.getElementById('program-list');
    const resetBtn = document.getElementById('form-reset');
    const idEl = document.getElementById('program-id');
    const adEl = document.getElementById('program-ad');
    const eventDateEl = document.getElementById('program-event-date');
    const endDateEl = document.getElementById('program-end-date');
    const ongoingEl = document.getElementById('program-ongoing');
    const dayInputs = Array.from(document.querySelectorAll('input[name="program-day"]'));
    const startTimeEl = document.getElementById('program-start-time');
    const endTimeEl = document.getElementById('program-end-time');
    const locationEl = document.getElementById('program-location');
    const mapsUrlEl = document.getElementById('program-maps-url');
    const seviyeEl = document.getElementById('program-seviye');
    const ucretEl = document.getElementById('program-ucret');
    const aciklamaEl = document.getElementById('program-aciklama');
    const aktifEl = document.getElementById('program-aktif');
    const galleryFileEl = document.getElementById('gallery-file');
    const galleryUploadBtn = document.getElementById('gallery-upload-btn');
    const galleryDropzone = document.getElementById('gallery-dropzone');
    const galleryListEl = document.getElementById('gallery-list');
    const editorRoot = document.getElementById('program-editor');
    const countBadge = document.getElementById('program-count');
    const listView = document.getElementById('program-list-view');
    const editorView = document.getElementById('program-editor-view');
    const newProgramBtn = document.getElementById('new-program-btn');
    const backToListBtn = document.getElementById('back-to-list');

    let programs = [];
    let gallery = [];
    let editor = null;

    function escapeEditorHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderInlineNodes(nodes = []) {
      return nodes
        .map((node) => {
          if (!node || typeof node !== 'object') return '';
          let text = escapeEditorHtml(node.text || '');
          if (!text) return '';
          const marks = Array.isArray(node.marks) ? node.marks : [];
          if (marks.some((mark) => mark.type === 'bold')) text = `<strong>${text}</strong>`;
          if (marks.some((mark) => mark.type === 'italic')) text = `<em>${text}</em>`;
          return text;
        })
        .join('');
    }

    function programBodyJsonToHtml(bodyJson) {
      if (!bodyJson || typeof bodyJson !== 'object' || !Array.isArray(bodyJson.content)) return '';
      return bodyJson.content
        .map((node) => {
          if (!node || typeof node !== 'object') return '';
          if (node.type === 'heading') {
            const level = node.attrs?.level === 2 ? 2 : 3;
            return `<h${level}>${renderInlineNodes(node.content)}</h${level}>`;
          }
          if (node.type === 'bulletList' || node.type === 'orderedList') {
            const tag = node.type === 'orderedList' ? 'ol' : 'ul';
            const items = Array.isArray(node.content)
              ? node.content
                  .map((item) => {
                    const paragraph = Array.isArray(item?.content)
                      ? item.content.find((child) => child?.type === 'paragraph')
                      : null;
                    return `<li>${renderInlineNodes(paragraph?.content || [])}</li>`;
                  })
                  .join('')
              : '';
            return `<${tag}>${items}</${tag}>`;
          }
          return `<p>${renderInlineNodes(node.content || [])}</p>`;
        })
        .join('');
    }

    function inlineNodesFromElement(element) {
      const nodes = [];
      element.childNodes.forEach((child) => {
        if (child.nodeType === Node.TEXT_NODE) {
          const text = child.textContent || '';
          if (text.trim()) nodes.push({ type: 'text', text });
          return;
        }
        if (!(child instanceof HTMLElement)) return;
        const text = child.textContent || '';
        if (!text.trim()) return;
        const marks = [];
        if (['STRONG', 'B'].includes(child.tagName)) marks.push({ type: 'bold' });
        if (['EM', 'I'].includes(child.tagName)) marks.push({ type: 'italic' });
        nodes.push({ type: 'text', text, ...(marks.length ? { marks } : {}) });
      });
      return nodes;
    }

    function programHtmlToBodyJson(html) {
      const doc = new DOMParser().parseFromString(html || '', 'text/html');
      const content = [];
      doc.body.childNodes.forEach((child) => {
        if (!(child instanceof HTMLElement)) return;
        if (child.matches('h2,h3')) {
          const inlineContent = inlineNodesFromElement(child);
          if (inlineContent.length) {
            content.push({ type: 'heading', attrs: { level: child.tagName === 'H2' ? 2 : 3 }, content: inlineContent });
          }
          return;
        }
        if (child.matches('ul,ol')) {
          const listItems = Array.from(child.querySelectorAll(':scope > li'))
            .map((item) => ({
              type: 'listItem',
              content: [{ type: 'paragraph', content: inlineNodesFromElement(item) }],
            }))
            .filter((item) => item.content[0].content.length);
          if (listItems.length) {
            content.push({ type: child.tagName === 'OL' ? 'orderedList' : 'bulletList', content: listItems });
          }
          return;
        }
        const inlineContent = inlineNodesFromElement(child);
        if (inlineContent.length) {
          content.push({ type: 'paragraph', content: inlineContent });
        }
      });
      return { type: 'doc', content };
    }

    async function initProgramEditor() {
      if (!(editorRoot instanceof HTMLTextAreaElement)) return;
      const editors = await tinymce.init({
        target: editorRoot,
        height: 360,
        menubar: false,
        branding: false,
        promotion: false,
        license_key: 'gpl',
        statusbar: false,
        resize: false,
        skin: false,
        content_css: false,
        plugins: 'advlist autoresize lists',
        toolbar: 'undo redo | blocks | bold italic | bullist numlist',
        block_formats: 'Paragraf=p; Başlık 2=h2; Başlık 3=h3',
        valid_elements: 'p,strong/b,em/i,ul,ol,li,h2,h3',
        invalid_elements: 'a,img,table,iframe,script,style',
        paste_as_text: true,
      });
      editor = editors[0] ?? null;
    }

    const editorReady = initProgramEditor();

    function resetEditorContent() {
      editor?.setContent('');
    }

    function showListView() {
      listView.classList.remove('is-hidden');
      editorView.classList.add('is-hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function showEditorView() {
      listView.classList.add('is-hidden');
      editorView.classList.remove('is-hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function editorPlainText() {
      return editor?.getContent({ format: 'text' }).trim() || '';
    }

    function setEditorFromJson(bodyJson) {
      editor?.setContent(programBodyJsonToHtml(bodyJson));
    }

    function clearForm() {
      idEl.value = '';
      adEl.value = '';
      eventDateEl.value = '';
      endDateEl.value = '';
      ongoingEl.checked = false;
      endDateEl.disabled = false;
      dayInputs.forEach((input) => {
        input.checked = false;
      });
      startTimeEl.value = '';
      endTimeEl.value = '';
      locationEl.value = '';
      mapsUrlEl.value = '';
      seviyeEl.value = '';
      ucretEl.value = '';
      aciklamaEl.value = '';
      aktifEl.checked = true;
      gallery = [];
      galleryFileEl.value = '';
      renderGallery();
      resetEditorContent();
      document.querySelector('.form-header .badge-modern').textContent = 'Yeni Kayıt';
    }

    async function fillForm(program) {
      await editorReady;
      idEl.value = String(program.id);
      adEl.value = program.ad || '';
      eventDateEl.value = program.eventDate || '';
      endDateEl.value = program.endDate || '';
      ongoingEl.checked = Boolean(program.isOngoing);
      endDateEl.disabled = Boolean(program.isOngoing);
      const selectedDays = Array.isArray(program.days) ? program.days : [];
      dayInputs.forEach((input) => {
        input.checked = selectedDays.includes(input.value);
      });
      startTimeEl.value = program.startTime || '';
      endTimeEl.value = program.endTime || '';
      locationEl.value = program.locationText || '';
      mapsUrlEl.value = program.mapsUrl || '';
      seviyeEl.value = program.seviye || '';
      ucretEl.value = program.ucretBilgisi || '';
      aciklamaEl.value = program.aciklama || '';
      aktifEl.checked = Boolean(program.aktif);
      gallery = Array.isArray(program.gallery) ? [...program.gallery] : [];
      renderGallery();
      setEditorFromJson(program.bodyJson);
      
      document.querySelector('.form-header .badge-modern').textContent = 'Düzenleniyor';
      showEditorView();
      adEl.focus();
    }

    function renderGallery() {
      if (!gallery.length) {
        galleryListEl.innerHTML = '';
        return;
      }
      galleryListEl.innerHTML = gallery
        .map(
          (url, index) => `
            <li class="gallery-item">
              <img src="${url}" alt="Görsel" />
              <button type="button" class="btn-remove-img" data-gallery-remove="${index}" title="Kaldır">✕</button>
            </li>
          `
        )
        .join('');
    }

    function getSelectedDays() {
      return dayInputs.filter((input) => input.checked).map((input) => input.value);
    }

    function buildScheduleText(days, startTime, endTime) {
      const dayText = days.length ? days.join(', ') : '';
      const timeText = startTime && endTime ? `${startTime} - ${endTime}` : startTime || endTime || '';
      return [dayText, timeText].filter(Boolean).join(' / ');
    }

    function validatePayload(payload) {
      if (!payload.ad) return 'Program adı zorunlu.';
      if (!payload.seviye) return 'Seviye seçimi zorunlu.';
      if (!payload.ucretBilgisi) return 'Ücret bilgisi zorunlu.';
      if (!payload.days.length) return 'En az bir gün seçmelisiniz.';
      if (!payload.startTime || !payload.endTime) return 'Başlangıç ve bitiş saati zorunlu.';
      if (!payload.eventDate) return 'Başlangıç tarihi zorunlu.';
      if (!payload.isOngoing && !payload.endDate) return 'Bitiş tarihi zorunlu. Sürekli ilan ise ilgili seçeneği işaretleyin.';
      if (!payload.locationText) return 'Konum / şube bilgisi zorunlu.';
      if (!payload.mapsUrl) return 'Google Maps bağlantısı zorunlu.';
      if (!payload.aciklama) return 'Kısa özet zorunlu.';
      if (!editorPlainText()) return 'Geniş tanıtım metni zorunlu.';
      if (payload.gallery.length < 3) return 'En az 3 galeri görseli yüklemelisiniz.';
      return '';
    }

    function renderList() {
      if (countBadge) countBadge.textContent = `${programs.length} İlan`;
      
      if (!programs.length) {
        list.innerHTML = `
          <li class="empty-state">
            <div class="empty-icon">📝</div>
            <p>Henüz ilan eklenmedi.</p>
          </li>
        `;
        return;
      }
      
      list.innerHTML = programs
        .map((p) => {
          const firstImg = Array.isArray(p.gallery) && p.gallery[0] ? p.gallery[0] : '';
          const galCount = Array.isArray(p.gallery) ? p.gallery.length : 0;
          const dateRange = p.isOngoing
            ? '♾️ Sürekli ilan'
            : p.eventDate
              ? `📅 ${p.eventDate}${p.endDate ? ' – ' + p.endDate : ''}`
              : '';
          const liveClass = p.aktif ? 'pcard--live' : 'pcard--draft';
          const liveDot = p.aktif
            ? '<span class="pcard-dot dot-live"></span>Yayında'
            : '<span class="pcard-dot dot-draft"></span>Taslak';
          return `
            <li class="pcard ${liveClass}">
              <div class="pcard-thumb">
                ${firstImg
                  ? `<img src="${firstImg}" alt="${p.ad}" />`
                  : `<div class="pcard-thumb-placeholder">SN</div>`}
                <div class="pcard-thumb-overlay">
                  <span class="pcard-status-pill">${liveDot}</span>
                </div>
              </div>

              <div class="pcard-body">
                <header class="pcard-head">
                  <div class="pcard-title-area">
                    <strong class="pcard-title">${p.ad}</strong>
                    ${p.seviye ? `<span class="pcard-badge">${p.seviye}</span>` : ''}
                  </div>
                  ${p.ucretBilgisi ? `<span class="pcard-price">${p.ucretBilgisi}</span>` : ''}
                </header>

                <p class="pcard-summary">${p.aciklama || ''}</p>

                <div class="pcard-meta">
                  ${p.gunSaat ? `<span class="pcard-chip">⏰ ${p.gunSaat}</span>` : ''}
                  ${dateRange ? `<span class="pcard-chip">${dateRange}</span>` : ''}
                  ${p.locationText ? `<span class="pcard-chip">📍 ${p.locationText}</span>` : ''}
                </div>
              </div>

              <div class="pcard-aside">
                <div class="pcard-stat ${p.aktif ? 'pcard-stat--live' : 'pcard-stat--draft'}">
                  <span class="pcard-stat-value">${liveDot}</span>
                  <span class="pcard-stat-hint">${p.aktif ? 'Vitrine çıktı' : 'Yayında değil'}</span>
                </div>
                <div class="pcard-stat">
                  <span class="pcard-stat-value">🖼 ${galCount}</span>
                  <span class="pcard-stat-hint">Galeri görseli</span>
                </div>
                <div class="pcard-actions">
                  <button class="pcard-btn-main" data-action="edit" data-id="${p.id}" type="button">İlana Gir</button>
                  <button class="pcard-btn-danger" data-action="delete" data-id="${p.id}" type="button">Sil</button>
                </div>
              </div>
            </li>
          `;
        })
        .join('');
    }

    async function loadPrograms() {
      try {
        const response = await fetch('/api/panel/programs');
        if (!response.ok) throw new Error();
        const payload = await response.json();
        programs = payload.data || [];
        renderList();
      } catch (error) {
        list.innerHTML = '<li class="empty-state"><p class="text-red">İlanlar yüklenirken hata oluştu.</p></li>';
      }
    }

    async function saveProgram(event) {
      event.preventDefault();
      await editorReady;
      const days = getSelectedDays();
      const startTime = startTimeEl.value.trim();
      const endTime = endTimeEl.value.trim();
      const payload = {
        id: Number(idEl.value || '0'),
        ad: adEl.value.trim(),
        gunSaat: buildScheduleText(days, startTime, endTime),
        eventDate: eventDateEl.value.trim(),
        endDate: ongoingEl.checked ? '' : endDateEl.value.trim(),
        isOngoing: ongoingEl.checked,
        days,
        startTime,
        endTime,
        locationText: locationEl.value.trim(),
        mapsUrl: mapsUrlEl.value.trim(),
        seviye: seviyeEl.value.trim(),
        ucretBilgisi: ucretEl.value.trim(),
        aciklama: aciklamaEl.value.trim(),
        bodyJson: programHtmlToBodyJson(editor?.getContent() || ''),
        gallery,
        aktif: aktifEl.checked,
      };
      const validationMessage = validatePayload(payload);
      if (validationMessage) {
        alert(validationMessage);
        return;
      }

      const submitBtn = event.target.querySelector('button[type="submit"]');
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<div class="spinner-small"></div> Kaydediliyor...';
      submitBtn.disabled = true;

      try {
        const isEdit = payload.id > 0;
        const response = await fetch('/api/panel/programs', {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        
        const responsePayload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(responsePayload?.error || 'Kayıt işlemi başarısız oldu.');
        
        await loadPrograms();
        showListView();
      } catch (err) {
        alert(err.message);
      } finally {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      }
    }

    async function uploadGalleryImage(selectedFile) {
      const file = selectedFile || galleryFileEl.files?.[0];
      if (!file) {
        alert('Lütfen bir görsel seçin.');
        return;
      }
      
      galleryUploadBtn.disabled = true;
      galleryUploadBtn.innerHTML = '<div class="spinner-small"></div>';
      
      try {
        const formData = new FormData();
        formData.append('image', file);
        
        const response = await fetch('/api/panel/program-image-upload', {
          method: 'POST',
          body: formData,
        });
        
        const payload = await response.json().catch(() => ({}));
        
        if (!response.ok || !payload.url) {
          throw new Error(payload?.error || 'Görsel yüklenemedi.');
        }
        
        gallery.push(payload.url);
        galleryFileEl.value = '';
        renderGallery();
      } catch (err) {
        alert(err.message);
      } finally {
        galleryUploadBtn.disabled = false;
        galleryUploadBtn.textContent = 'Yükle';
      }
    }

    function handleGalleryFileSelection(fileList) {
      if (!fileList?.length) return;
      uploadGalleryImage(fileList[0]);
    }

    async function removeProgram(id) {
      const ok = confirm('Bu ilanı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');
      if (!ok) return;
      
      try {
        const response = await fetch('/api/panel/programs', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        
        if (!response.ok) throw new Error('Silme işlemi başarısız oldu.');
        
        if (Number(idEl.value || '0') === id) {
          clearForm();
        }
        await loadPrograms();
      } catch (err) {
        alert(err.message);
      }
    }

    list.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-action]');
      if (!button) return;
      
      const action = button.getAttribute('data-action');
      const id = Number(button.getAttribute('data-id'));
      if (!id) return;
      
      const row = programs.find((item) => item.id === id);
      if (!row) return;
      
      if (action === 'edit') {
        await fillForm(row);
      } else if (action === 'delete') {
        await removeProgram(id);
      }
    });

    galleryListEl.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-gallery-remove]');
      if (!button) return;
      
      const index = Number(button.getAttribute('data-gallery-remove'));
      if (Number.isNaN(index)) return;
      
      gallery = gallery.filter((_, itemIndex) => itemIndex !== index);
      renderGallery();
    });

    form.addEventListener('submit', saveProgram);
    resetBtn.addEventListener('click', clearForm);
    newProgramBtn.addEventListener('click', async () => {
      await editorReady;
      clearForm();
      showEditorView();
      adEl.focus();
    });
    backToListBtn.addEventListener('click', showListView);
    galleryUploadBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      galleryFileEl.click();
    });
    galleryDropzone.addEventListener('click', (event) => {
      if (event.target === galleryUploadBtn) return;
      galleryFileEl.click();
    });
    galleryFileEl.addEventListener('change', () => uploadGalleryImage());
    galleryDropzone.addEventListener('dragover', (event) => {
      event.preventDefault();
      galleryDropzone.classList.add('is-dragging');
    });
    galleryDropzone.addEventListener('dragleave', () => {
      galleryDropzone.classList.remove('is-dragging');
    });
    galleryDropzone.addEventListener('drop', (event) => {
      event.preventDefault();
      galleryDropzone.classList.remove('is-dragging');
      handleGalleryFileSelection(event.dataTransfer?.files);
    });
    ongoingEl.addEventListener('change', () => {
      endDateEl.disabled = ongoingEl.checked;
      if (ongoingEl.checked) endDateEl.value = '';
    });
    
    // Init
    loadPrograms();
    renderGallery();
    showListView();
  </script>

