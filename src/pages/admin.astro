---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAdminClubSummary } from '../lib/repositories/catalog';

const summary = await getAdminClubSummary();
---

<BaseLayout
  title="Admin Paneli"
  description="Kulüp başvurularını ve üyelik durumlarını yönetin."
  noIndex={true}
>
  <section class="section admin-page">
    <div class="container">
      <div class="admin-head">
        <div>
          <h1 class="admin-title">Admin Paneli</h1>
          <p class="admin-desc">
            Bu ekranda basvuru listesini, detayini, durum guncellemesini ve belge kayitlarini yonetebilirsiniz.
          </p>
        </div>
        <form method="post" action="/api/panel/logout" class="admin-logout-form">
          <button type="submit" class="admin-logout-btn">Çıkış Yap</button>
        </form>
      </div>

      <div class="admin-grid">
        <article class="admin-card">
          <h2>Toplam Kulüp</h2>
          <p>{summary.total}</p>
        </article>
        <article class="admin-card">
          <h2>Onay Bekleyen</h2>
          <p>{summary.pending}</p>
        </article>
        <article class="admin-card">
          <h2>Onaylı</h2>
          <p>{summary.approved}</p>
        </article>
        <article class="admin-card">
          <h2>Reddedilen</h2>
          <p>{summary.rejected}</p>
        </article>
      </div>

      <div class="admin-tabs" role="tablist" aria-label="Admin sekmeleri">
        <button type="button" class="admin-tab is-active" data-tab-target="applications">Başvurular</button>
        <button type="button" class="admin-tab" data-tab-target="clubs">Kulüpler</button>
      </div>

      <section class="admin-shell" data-tab-panel="applications">
        <div class="admin-toolbar">
          <label>
            Ara
            <input id="app-search" type="text" placeholder="Kulüp adı, il, ilçe..." />
          </label>
          <label>
            Durum
            <select id="status-filter">
              <option value="all">Tüm durumlar</option>
              <option value="pending">Bekliyor</option>
              <option value="approved">Onaylı</option>
              <option value="rejected">Reddedildi</option>
            </select>
          </label>
          <button id="load-apps" type="button">Başvuruları Yükle</button>
        </div>

        <div class="admin-columns">
          <aside class="admin-list">
            <h2>Başvuru Listesi</h2>
            <p class="section-help">Solda tum basvurulari gorursunuz. Bir kayda tikladiginizda sag tarafta ayrintilar acilir.</p>
            <ul id="applications-list"></ul>
          </aside>

          <article class="admin-detail">
            <h2>Başvuru Detayı</h2>
            <p class="section-help">Secilen basvurunun tum bilgileri, belgeleri ve yonetim islemleri bu alanda yer alir.</p>
            <div id="application-detail" class="detail-empty">
              Sag listeden bir basvuru secin.
            </div>
          </article>
        </div>
      </section>

      <section class="admin-shell is-hidden" data-tab-panel="clubs">
        <div class="admin-toolbar">
          <label>
            Ara
            <input id="club-search" type="text" placeholder="Kulüp adı, il, ilçe..." />
          </label>
          <button id="load-clubs" type="button">Kulüpleri Yükle</button>
        </div>

        <div class="admin-columns">
          <aside class="admin-list">
            <h2>Onaylı Kulüpler</h2>
            <p class="section-help">Yalnızca onaylı kulüpler burada listelenir. Kayıt seçince sağdan bilgileri güncelleyebilirsiniz.</p>
            <ul id="clubs-list"></ul>
          </aside>

          <article class="admin-detail">
            <h2>Kulüp Detayı</h2>
            <p class="section-help">Kulüp iletişim/profil bilgilerini düzenleyip, altında yayınlanan ilanları görebilirsiniz.</p>
            <div id="club-detail" class="detail-empty">
              Sol listeden bir kulüp seçin.
            </div>
          </article>
        </div>
      </section>
    </div>
  </section>

  <script is:inline>
    const searchInput = document.getElementById('app-search');
    const statusFilter = document.getElementById('status-filter');
    const loadButton = document.getElementById('load-apps');
    const listEl = document.getElementById('applications-list');
    const detailEl = document.getElementById('application-detail');
    const clubSearchInput = document.getElementById('club-search');
    const clubsListEl = document.getElementById('clubs-list');
    const clubDetailEl = document.getElementById('club-detail');
    const loadClubsButton = document.getElementById('load-clubs');
    const tabButtons = Array.from(document.querySelectorAll('.admin-tab'));
    const tabPanels = Array.from(document.querySelectorAll('[data-tab-panel]'));

    let cachedApps = [];
    let selectedAppId = 0;
    let cachedClubs = [];
    let selectedClubId = 0;
    const draftProvisionPasswords = new Map();

    function adminDownloadUrl(documentId) {
      return `/api/admin/application-document-download?documentId=${encodeURIComponent(documentId)}`;
    }

    async function apiGet(path) {
      const response = await fetch(path);
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `Request failed (${response.status})`);
      }
      const payload = await response.json();
      return payload.data;
    }

    async function apiPost(path, body) {
      const response = await fetch(path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `Request failed (${response.status})`);
      }
      const payload = await response.json();
      return payload.data;
    }

    function formatDate(value) {
      if (!value) return '-';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '-';
      return new Intl.DateTimeFormat('tr-TR', {
        dateStyle: 'short',
        timeStyle: 'short',
      }).format(date);
    }

    function formatLogDateTime(value) {
      if (!value) return 'Tarih bilgisi yok';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Tarih bilgisi yok';
      return new Intl.DateTimeFormat('tr-TR', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).format(date);
    }

    function escapeHtml(text) {
      return String(text ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function statusLabelTr(status) {
      const map = { pending: 'Bekliyor', approved: 'Onaylı', rejected: 'Reddedildi' };
      return map[status] || status || '—';
    }

    function logActionTitle(action) {
      if (action === 'application_created') return 'Başvuru oluşturuldu';
      if (action === 'status_update') return 'Durum güncellendi';
      return action || 'İşlem';
    }

    function statusBadge(status) {
      const map = {
        pending: 'Bekliyor',
        approved: 'Onaylı',
        rejected: 'Reddedildi',
      };
      return `<span class="status status-${status}">${map[status] || status}</span>`;
    }

    function statusActionLabel(currentStatus, targetStatus) {
      if (targetStatus === 'approved') return currentStatus === 'approved' ? 'Onaylı' : 'Onayla';
      if (targetStatus === 'pending') return 'Onayi Geri Cek';
      return 'Reddet';
    }

    function generateTemporaryPassword(length = 8) {
      const letters = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
      const digits = '23456789';
      const allChars = letters + digits;

      let password = letters[Math.floor(Math.random() * letters.length)];
      password += digits[Math.floor(Math.random() * digits.length)];

      for (let i = 2; i < length; i += 1) {
        password += allChars[Math.floor(Math.random() * allChars.length)];
      }

      return password
        .split('')
        .sort(() => Math.random() - 0.5)
        .join('');
    }

    function renderList() {
      if (!listEl) return;
      const filteredApps = getFilteredApps();
      if (!filteredApps.length) {
        listEl.innerHTML = '<li class="empty">Kayıt bulunamadı.</li>';
        return;
      }
      listEl.innerHTML = filteredApps
        .map((item) => {
          const activeClass = item.id === selectedAppId ? 'is-active' : '';
          return `<li>
            <button class="app-item ${activeClass}" data-id="${item.id}">
              <span class="app-item-title">${item.ad}</span>
              <span class="app-item-meta">${item.il || '-'} / ${item.ilce || '-'}</span>
              <span class="app-item-status">${statusBadge(item.durum)}</span>
            </button>
          </li>`;
        })
        .join('');
    }

    function getFilteredApps() {
      const query = searchInput?.value?.trim()?.toLowerCase() || '';
      const status = statusFilter?.value || 'all';
      return cachedApps.filter((item) => {
        const statusOk = status === 'all' ? true : item.durum === status;
        if (!statusOk) return false;
        if (!query) return true;
        const haystack = `${item.ad || ''} ${item.il || ''} ${item.ilce || ''}`.toLowerCase();
        return haystack.includes(query);
      });
    }

    function renderDetailLoading() {
      if (!detailEl) return;
      detailEl.innerHTML = '<p>Detay yükleniyor...</p>';
    }

    function renderDetailError(message) {
      if (!detailEl) return;
      detailEl.innerHTML = `<p class="error">${message}</p>`;
    }

    function switchTab(tabKey) {
      tabButtons.forEach((button) => {
        const isActive = button.getAttribute('data-tab-target') === tabKey;
        button.classList.toggle('is-active', isActive);
      });
      tabPanels.forEach((panel) => {
        const isCurrent = panel.getAttribute('data-tab-panel') === tabKey;
        panel.classList.toggle('is-hidden', !isCurrent);
      });
    }

    async function loadDocuments(appId) {
      const rows = await apiGet(`/api/admin/application-documents?applicationId=${appId}`);
      if (!rows.length) {
        return '<p class="hint">Belge kaydi yok.</p>';
      }
      return `<ul class="docs">
        ${rows
          .map(
            (doc) =>
              `<li>
                <strong>${doc.kind}</strong> - ${doc.originalFilename} (${doc.byteSize} byte)
                <br /><code>${doc.storageKey}</code>
                <br /><a class="doc-download-link" href="${adminDownloadUrl(doc.id)}">Belgeyi indir</a>
              </li>`
          )
          .join('')}
      </ul>`;
    }

    async function renderDetail(appId) {
      selectedAppId = appId;
      renderList();
      renderDetailLoading();
      try {
        const app = await apiGet(`/api/admin/applications?id=${appId}`);
        const docsHtml = await loadDocuments(appId);
        if (!detailEl) return;
        detailEl.innerHTML = `
          <div class="detail-hero">
            <div>
              <p class="detail-kicker">Başvuru dosyası</p>
              <h3>${app.ad}</h3>
            </div>
            ${statusBadge(app.durum)}
          </div>

          <section class="qa-section qa-section-red">
            <h4>Kulüp / Kurs Bilgileri</h4>
            <p class="section-help">Başvuru yapan kurumun temel kimlik bilgileri burada yer alır. Adres ve açıklama ile kaydın doğruluğunu kontrol edebilirsiniz.</p>
            <div class="qa-list">
              <article class="qa-item"><p class="qa-question">Kulüp / Kurs Adı</p><p class="qa-answer">${app.ad || '-'}</p></article>
              <article class="qa-item"><p class="qa-question">İl / İlçe</p><p class="qa-answer">${app.il || '-'} / ${app.ilce || '-'}</p></article>
              <article class="qa-item"><p class="qa-question">Tam Adres</p><p class="qa-answer">${app.adres || '-'}</p></article>
              <article class="qa-item"><p class="qa-question">Kulüp Açıklaması</p><p class="qa-answer">${app.aciklama || '-'}</p></article>
            </div>
          </section>

          <section class="qa-section qa-section-blue">
            <h4>İletişim Bilgileri</h4>
            <p class="section-help">Kulüp yetkilisine ulaşmak için kullanılan resmi iletişim kanalları burada bulunur.</p>
            <div class="qa-list qa-list-two">
              <article class="qa-item"><p class="qa-question">Telefon</p><p class="qa-answer">${app.telefon || '-'}</p></article>
              <article class="qa-item"><p class="qa-question">E-posta</p><p class="qa-answer">${app.email || '-'}</p></article>
            </div>
          </section>

          <section class="qa-section qa-section-amber">
            <h4>Durum ve İnceleme Notları</h4>
            <p class="section-help">Başvurunun ne zaman açıldığı, son durumu ve inceleme sürecinde bırakılan yönetsel notlar bu bölümde tutulur.</p>
            <div class="qa-list qa-list-three">
              <article class="qa-item"><p class="qa-question">Oluşturma</p><p class="qa-answer">${formatDate(app.createdAt)}</p></article>
              <article class="qa-item"><p class="qa-question">Güncelleme</p><p class="qa-answer">${formatDate(app.updatedAt)}</p></article>
              <article class="qa-item"><p class="qa-question">Mevcut Durum</p><p class="qa-answer">${statusBadge(app.durum)}</p></article>
            </div>
            <label class="admin-note">
              <strong>Sorumlu Admin E-posta</strong>
              <p class="field-help">Bu başvuruyu takip eden admin hesabının e-posta adresi. Ekip içi sorumluluk takibi için kullanılır.</p>
              <input id="assigned-admin-email" placeholder="admin@spornerede.net" value="${app.sorumluAdminEmail || ''}" />
            </label>
            <label class="admin-note">
              <strong>Admin Notu</strong>
              <p class="field-help">İnceleme adımları, eksik evrak bilgisi veya red/onay gerekçesini kısa ve net biçimde buraya yazın.</p>
              <textarea id="admin-note" rows="4" placeholder="Takip notu, kontrol adimi, red gerekcesi vb.">${app.adminNotu || ''}</textarea>
            </label>
            <button id="save-note-btn" type="button">Notu Kaydet</button>
          </section>

          <section class="qa-section qa-section-slate">
            <h4>Belgeler</h4>
            <p class="section-help">Sisteme kayıtlı tüm belge bilgileri ve indirme bağlantıları bu alanda listelenir.</p>
            ${docsHtml}
          </section>

          <section class="qa-section qa-section-slate">
            <h4>Belge Yükle (PDF Dekont)</h4>
            <p class="section-help">PDF dekont dosyasını seçin, sistem dosyayı otomatik kaydedip belge kaydını kendisi oluşturur.</p>
            <div class="form-grid">
              <label>Dekont Dosyası (PDF)
                <input id="doc-file" type="file" accept=".pdf,application/pdf" />
              </label>
            </div>
            <button id="upload-doc-btn" type="button">PDF Dekontu Yükle</button>
          </section>

          <section class="qa-section qa-section-green">
            <h4>Sorumlu Kişi Hesabı</h4>
            <p class="section-help">Kulüp adına panele giriş yapacak tek sorumlu kişi hesabı bu alandan oluşturulur veya güncellenir.</p>
            <div class="form-grid">
              <label>E-posta
                <input id="provision-email" type="email" placeholder="kulup@example.com" value="${app.email || ''}" />
              </label>
              <label>Geçici Şifre
                <div class="provision-password-row">
                  <input
                    id="provision-password"
                    type="text"
                    value="${draftProvisionPasswords.get(appId) || ''}"
                    placeholder="En az 8 karakter"
                  />
                  <button id="generate-password-btn" type="button" class="secondary-button">Şifre Oluştur</button>
                </div>
              </label>
            </div>
            <button id="provision-user-btn" type="button">Sorumlu Kişiyi Oluştur/Güncelle</button>
            <p class="hint">Bu işlem mevcut kullanıcı varsa şifresini günceller ve kulübe bağlar.</p>
          </section>

          <section class="qa-section qa-section-slate">
            <h4>İşlem Geçmişi</h4>
            <p class="section-help">Bu başvuru üzerinde yapılan tüm işlemler, kim tarafından ve ne zaman yapıldığıyla birlikte kayıt altındadır.</p>
            <div id="admin-log-timeline"><p class="hint">Yükleniyor...</p></div>
          </section>

          <section class="qa-section qa-section-action">
            <h4>Karar</h4>
            <p class="section-help">Başvuruyu onaylama, beklemeye alma veya reddetme işlemini buradan yapabilirsiniz.</p>
            <label>
              Üyelik Periyodu (Onay için)
              <select id="membership-period">
                <option value="monthly">Aylık</option>
                <option value="yearly">Yıllık</option>
              </select>
            </label>
            <div class="actions">
              <button class="action-approve" data-status="approved">${statusActionLabel(app.durum, 'approved')}</button>
              <button class="action-pending" data-status="pending">${statusActionLabel(app.durum, 'pending')}</button>
              <button class="action-reject" data-status="rejected">${statusActionLabel(app.durum, 'rejected')}</button>
            </div>
          </section>
        `;

        const renderLogTimeline = async () => {
          const logEl = document.getElementById('admin-log-timeline');
          if (!logEl) return;
          try {
            const logs = await apiGet(`/api/admin/applications?logsForId=${appId}`);
            if (!logs.length) {
              logEl.innerHTML = '<p class="hint">Henüz işlem geçmişi yok.</p>';
              return;
            }
            logEl.innerHTML = `
              <div class="log-timeline-scroll" role="region" aria-label="İşlem geçmişi listesi">
                <ul class="log-timeline">
                  ${logs
                    .map((log) => {
                      const timeLine = formatLogDateTime(log.createdAt);
                      const title = escapeHtml(logActionTitle(log.action));
                      const prev = log.previousStatus ? statusLabelTr(log.previousStatus) : '';
                      const next = log.nextStatus ? statusLabelTr(log.nextStatus) : '';
                      const statusLine =
                        prev && next ? `${escapeHtml(prev)} → ${escapeHtml(next)}` : next ? escapeHtml(next) : '';
                      const actor = log.actorEmail ? escapeHtml(log.actorEmail) : '';
                      const assigned = log.assignedAdminEmail ? escapeHtml(log.assignedAdminEmail) : '';
                      const note = log.note?.trim() ? escapeHtml(log.note.trim()) : '';
                      return `<li class="log-entry">
                        <div class="log-entry-head">
                          <time class="log-entry-time" datetime="${escapeHtml(log.createdAt || '')}">${escapeHtml(timeLine)}</time>
                          <span class="log-entry-title">${title}</span>
                        </div>
                        ${statusLine ? `<p class="log-entry-status">${statusLine}</p>` : ''}
                        <dl class="log-entry-meta">
                          ${actor ? `<div class="log-meta-row"><dt>İşlemi yapan</dt><dd>${actor}</dd></div>` : ''}
                          ${assigned ? `<div class="log-meta-row"><dt>Atanan admin</dt><dd>${assigned}</dd></div>` : ''}
                        </dl>
                        ${note ? `<p class="log-entry-note"><span class="log-note-label">Not</span>${note}</p>` : ''}
                      </li>`;
                    })
                    .join('')}
                </ul>
              </div>
            `;
          } catch {
            logEl.innerHTML = '<p class="error">Geçmiş yüklenemedi.</p>';
          }
        };
        await renderLogTimeline();

        detailEl.querySelectorAll('.actions button').forEach((button) => {
          button.addEventListener('click', async () => {
            const nextStatus = button.getAttribute('data-status');
            if (!nextStatus) return;
            const adminNote = document.getElementById('admin-note')?.value || '';
            const assignedAdminEmail = document.getElementById('assigned-admin-email')?.value?.trim() || '';
            const membershipPeriod = document.getElementById('membership-period')?.value === 'yearly' ? 'yearly' : 'monthly';
            try {
              await apiPost('/api/admin/applications', {
                id: appId,
                status: nextStatus,
                adminNote,
                assignedAdminEmail,
                membershipPeriod,
              });
              await loadApplications();
              await renderDetail(appId);
            } catch (error) {
              renderDetailError(error.message);
            }
          });
        });

        const saveNoteBtn = document.getElementById('save-note-btn');
        saveNoteBtn?.addEventListener('click', async () => {
          const adminNote = document.getElementById('admin-note')?.value || '';
          const assignedAdminEmail = document.getElementById('assigned-admin-email')?.value?.trim() || '';
          try {
            await apiPost('/api/admin/applications', {
              id: appId,
              status: app.durum,
              adminNote,
              assignedAdminEmail,
            });
            await loadApplications();
            await renderDetail(appId);
          } catch (error) {
            renderDetailError(error.message);
          }
        });

        const uploadDocBtn = document.getElementById('upload-doc-btn');
        uploadDocBtn?.addEventListener('click', async () => {
          const fileInput = document.getElementById('doc-file');
          if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.length) {
            alert('Lütfen bir PDF dosyası seçin.');
            return;
          }
          const file = fileInput.files[0];
          const looksLikePdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
          if (!looksLikePdf) {
            alert('Yalnızca PDF dekont yükleyebilirsiniz.');
            return;
          }

          try {
            const formData = new FormData();
            formData.append('applicationId', String(appId));
            formData.append('document', file);

            const response = await fetch('/api/admin/application-documents-upload', {
              method: 'POST',
              body: formData,
            });
            if (!response.ok) {
              const payload = await response.json().catch(() => ({}));
              throw new Error(payload.error || `Request failed (${response.status})`);
            }

            await renderDetail(appId);
          } catch (error) {
            renderDetailError(error.message);
          }
        });

        const provisionBtn = document.getElementById('provision-user-btn');
        const generatePasswordBtn = document.getElementById('generate-password-btn');
        const provisionPasswordInput = document.getElementById('provision-password');

        provisionPasswordInput?.addEventListener('input', () => {
          draftProvisionPasswords.set(appId, provisionPasswordInput.value);
        });

        generatePasswordBtn?.addEventListener('click', () => {
          const nextPassword = generateTemporaryPassword();
          if (provisionPasswordInput) {
            provisionPasswordInput.value = nextPassword;
          }
          draftProvisionPasswords.set(appId, nextPassword);
        });

        provisionBtn?.addEventListener('click', async () => {
          const email = document.getElementById('provision-email')?.value?.trim() || '';
          const password = document.getElementById('provision-password')?.value || '';
          const membershipRole = 'owner';
          if (!email || !password) {
            alert('E-posta ve geçici şifre zorunlu.');
            return;
          }
          try {
            const result = await apiPost('/api/admin/provision-club-user', {
              clubId: appId,
              email,
              password,
              membershipRole,
            });
            alert(`Hesap hazir: ${result.email} (${result.clubName || app.ad})`);
          } catch (error) {
            renderDetailError(error.message);
          }
        });
      } catch (error) {
        renderDetailError(error.message);
      }
    }

    async function loadApplications() {
      if (!listEl) return;
      listEl.innerHTML = '<li class="empty">Yükleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/applications');
        cachedApps = rows || [];
        if (!selectedAppId && cachedApps.length) {
          selectedAppId = cachedApps[0].id;
        }
        renderList();
        if (selectedAppId) {
          await renderDetail(selectedAppId);
        }
      } catch (error) {
        listEl.innerHTML = `<li class="empty error">${error.message}</li>`;
        if (detailEl) {
          detailEl.innerHTML = '<p class="error">Başvuru listesi yüklenemedi.</p>';
        }
      }
    }

    function getFilteredClubs() {
      const query = clubSearchInput?.value?.trim()?.toLowerCase() || '';
      return cachedClubs.filter((item) => {
        if (!query) return true;
        const haystack = `${item.ad || ''} ${item.il || ''} ${item.ilce || ''}`.toLowerCase();
        return haystack.includes(query);
      });
    }

    function renderClubsList() {
      if (!clubsListEl) return;
      const filtered = getFilteredClubs();
      if (!filtered.length) {
        clubsListEl.innerHTML = '<li class="empty">Onaylı kulüp bulunamadı.</li>';
        return;
      }
      clubsListEl.innerHTML = filtered
        .map((club) => {
          const activeClass = club.id === selectedClubId ? 'is-active' : '';
          return `<li>
            <button class="app-item ${activeClass}" data-club-id="${club.id}">
              <span class="app-item-title">${club.ad}</span>
              <span class="app-item-meta">${club.il || '-'} / ${club.ilce || '-'}</span>
            </button>
          </li>`;
        })
        .join('');
    }

    function renderClubDetailLoading() {
      if (!clubDetailEl) return;
      clubDetailEl.innerHTML = '<p>Detay yükleniyor...</p>';
    }

    function renderClubDetailError(message) {
      if (!clubDetailEl) return;
      clubDetailEl.innerHTML = `<p class="error">${message}</p>`;
    }

    function renderClubPrograms(programs) {
      if (!programs.length) {
        return '<p class="hint">Bu kulübün yayınlanmış ilanı bulunmuyor.</p>';
      }
      return `<ul class="docs">
        ${programs
          .map(
            (program) => `<li>
              <strong>${program.ad || '-'}</strong> ${program.aktif ? '<span class="status status-approved">Aktif</span>' : '<span class="status status-rejected">Pasif</span>'}
              ${program.gunSaat ? `<br /><small>${program.gunSaat}</small>` : ''}
              ${program.seviye ? `<br /><small>Seviye: ${program.seviye}</small>` : ''}
              ${program.ucretBilgisi ? `<br /><small>Ücret: ${program.ucretBilgisi}</small>` : ''}
              ${program.aciklama ? `<br /><span>${program.aciklama}</span>` : ''}
            </li>`
          )
          .join('')}
      </ul>`;
    }

    async function renderClubDetail(clubId) {
      selectedClubId = clubId;
      renderClubsList();
      renderClubDetailLoading();
      try {
        const club = await apiGet(`/api/admin/clubs?id=${clubId}`);
        if (!clubDetailEl) return;
        clubDetailEl.innerHTML = `
          <div class="detail-hero">
            <div>
              <p class="detail-kicker">Onaylı kulüp profili</p>
              <h3>${club.ad}</h3>
            </div>
            <span class="status status-approved">Onaylı</span>
          </div>

          <section class="qa-section qa-section-blue">
            <h4>Kulüp Bilgileri</h4>
            <div class="form-grid">
              <label>Kulüp Adı
                <input id="club-ad" type="text" value="${club.ad || ''}" />
              </label>
              <label>Telefon
                <input id="club-telefon" type="text" value="${club.telefon || ''}" />
              </label>
              <label>E-posta
                <input id="club-email" type="email" value="${club.email || ''}" />
              </label>
              <label>Yaş Aralığı
                <input id="club-yas-araligi" type="text" value="${club.yasAraligi || ''}" />
              </label>
              <label>Fiyat Bilgisi
                <input id="club-fiyat-bilgisi" type="text" value="${club.fiyatBilgisi || ''}" />
              </label>
            </div>
            <label class="admin-note">
              <strong>Adres</strong>
              <textarea id="club-adres" rows="3">${club.adres || ''}</textarea>
            </label>
            <label class="admin-note">
              <strong>Açıklama</strong>
              <textarea id="club-aciklama" rows="4">${club.aciklama || ''}</textarea>
            </label>
            <button id="save-club-btn" type="button">Kulüp Bilgilerini Kaydet</button>
          </section>

          <section class="qa-section qa-section-slate">
            <h4>Yayınlanan İlanlar</h4>
            <p class="section-help">Kulübün panelden eklediği ilan/program kayıtları aşağıda listelenir.</p>
            ${renderClubPrograms(club.programs || [])}
          </section>
        `;

        const saveBtn = document.getElementById('save-club-btn');
        saveBtn?.addEventListener('click', async () => {
          try {
            await apiPost('/api/admin/clubs', {
              id: clubId,
              ad: document.getElementById('club-ad')?.value || '',
              telefon: document.getElementById('club-telefon')?.value || '',
              email: document.getElementById('club-email')?.value || '',
              yasAraligi: document.getElementById('club-yas-araligi')?.value || '',
              fiyatBilgisi: document.getElementById('club-fiyat-bilgisi')?.value || '',
              adres: document.getElementById('club-adres')?.value || '',
              aciklama: document.getElementById('club-aciklama')?.value || '',
            });
            await loadClubs();
            await renderClubDetail(clubId);
          } catch (error) {
            renderClubDetailError(error.message);
          }
        });
      } catch (error) {
        renderClubDetailError(error.message);
      }
    }

    async function loadClubs() {
      if (!clubsListEl) return;
      clubsListEl.innerHTML = '<li class="empty">Yükleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/clubs');
        cachedClubs = rows || [];
        if (!selectedClubId && cachedClubs.length) {
          selectedClubId = cachedClubs[0].id;
        }
        renderClubsList();
        if (selectedClubId) {
          await renderClubDetail(selectedClubId);
        }
      } catch (error) {
        clubsListEl.innerHTML = `<li class="empty error">${error.message}</li>`;
        if (clubDetailEl) {
          clubDetailEl.innerHTML = '<p class="error">Kulüp listesi yüklenemedi.</p>';
        }
      }
    }

    listEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-id]');
      if (!button) return;
      const id = Number(button.getAttribute('data-id'));
      if (!id) return;
      await renderDetail(id);
    });

    clubsListEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-club-id]');
      if (!button) return;
      const id = Number(button.getAttribute('data-club-id'));
      if (!id) return;
      await renderClubDetail(id);
    });

    tabButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        const tabKey = button.getAttribute('data-tab-target') || 'applications';
        switchTab(tabKey);
        if (tabKey === 'clubs' && !cachedClubs.length) {
          await loadClubs();
        }
      });
    });

    loadButton?.addEventListener('click', async () => {
      await loadApplications();
    });

    loadClubsButton?.addEventListener('click', async () => {
      await loadClubs();
    });

    searchInput?.addEventListener('input', () => {
      renderList();
    });

    clubSearchInput?.addEventListener('input', () => {
      renderClubsList();
    });

    statusFilter?.addEventListener('change', () => {
      renderList();
    });

    switchTab('applications');
    loadApplications().catch((error) => {
      if (listEl) {
        listEl.innerHTML = `<li class="empty error">${error?.message || 'Başvurular yüklenemedi.'}</li>`;
      }
    });
  </script>
</BaseLayout>

