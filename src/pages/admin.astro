---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAdminClubSummary } from '../lib/repositories/catalog';

const summary = await getAdminClubSummary();
---

<BaseLayout
  title="Admin Paneli"
  description="Kulup basvurulari ve uyelik durumlarini yonetin."
  noIndex={true}
>
  <section class="section admin-page">
    <div class="container">
      <h1 class="admin-title">Admin Paneli</h1>
      <p class="admin-desc">
        Bu ekranda basvuru listesini, detayini, durum guncellemesini ve belge kayitlarini yonetebilirsiniz.
      </p>

      <div class="admin-grid">
        <article class="admin-card">
          <h2>Toplam Kulup</h2>
          <p>{summary.total}</p>
        </article>
        <article class="admin-card">
          <h2>Onay Bekleyen</h2>
          <p>{summary.pending}</p>
        </article>
        <article class="admin-card">
          <h2>Onayli</h2>
          <p>{summary.approved}</p>
        </article>
        <article class="admin-card">
          <h2>Reddedilen</h2>
          <p>{summary.rejected}</p>
        </article>
      </div>

      <section class="admin-shell">
        <div class="admin-toolbar">
          <label>
            Admin Token
            <input id="admin-token" type="password" placeholder="ADMIN_TOKEN" />
          </label>
          <label>
            Ara
            <input id="app-search" type="text" placeholder="Kulup adi, il, ilce..." />
          </label>
          <label>
            Durum
            <select id="status-filter">
              <option value="all">Tum durumlar</option>
              <option value="pending">Bekliyor</option>
              <option value="approved">Onayli</option>
              <option value="rejected">Reddedildi</option>
            </select>
          </label>
          <button id="load-apps" type="button">Basvurulari Yukle</button>
        </div>

        <div class="admin-columns">
          <aside class="admin-list">
            <h2>Basvuru Listesi</h2>
            <ul id="applications-list"></ul>
          </aside>

          <article class="admin-detail">
            <h2>Basvuru Detayi</h2>
            <div id="application-detail" class="detail-empty">
              Sag listeden bir basvuru secin.
            </div>
          </article>
        </div>
      </section>
    </div>
  </section>

  <script is:inline>
    const tokenInput = document.getElementById('admin-token');
    const searchInput = document.getElementById('app-search');
    const statusFilter = document.getElementById('status-filter');
    const loadButton = document.getElementById('load-apps');
    const listEl = document.getElementById('applications-list');
    const detailEl = document.getElementById('application-detail');

    let cachedApps = [];
    let selectedAppId = 0;

    function getToken() {
      return tokenInput?.value?.trim() ?? '';
    }

    function adminDownloadUrl(documentId) {
      const token = getToken();
      if (!token) return '#';
      return `/api/admin/application-document-download?documentId=${encodeURIComponent(documentId)}&token=${encodeURIComponent(token)}`;
    }

    async function apiGet(path) {
      const token = getToken();
      if (!token) {
        throw new Error('Admin token gerekli.');
      }
      const separator = path.includes('?') ? '&' : '?';
      const response = await fetch(`${path}${separator}token=${encodeURIComponent(token)}`);
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `Request failed (${response.status})`);
      }
      const payload = await response.json();
      return payload.data;
    }

    async function apiPost(path, body) {
      const token = getToken();
      if (!token) {
        throw new Error('Admin token gerekli.');
      }
      const response = await fetch(`${path}?token=${encodeURIComponent(token)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `Request failed (${response.status})`);
      }
      const payload = await response.json();
      return payload.data;
    }

    function formatDate(value) {
      if (!value) return '-';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '-';
      return new Intl.DateTimeFormat('tr-TR', {
        dateStyle: 'short',
        timeStyle: 'short',
      }).format(date);
    }

    function statusBadge(status) {
      const map = {
        pending: 'Bekliyor',
        approved: 'Onayli',
        rejected: 'Reddedildi',
      };
      return `<span class="status status-${status}">${map[status] || status}</span>`;
    }

    function renderList() {
      if (!listEl) return;
      const filteredApps = getFilteredApps();
      if (!filteredApps.length) {
        listEl.innerHTML = '<li class="empty">Kayit bulunamadi.</li>';
        return;
      }
      listEl.innerHTML = filteredApps
        .map((item) => {
          const activeClass = item.id === selectedAppId ? 'is-active' : '';
          return `<li>
            <button class="app-item ${activeClass}" data-id="${item.id}">
              <strong>${item.ad}</strong>
              <small>${item.il || '-'} / ${item.ilce || '-'}</small>
              <small>${statusBadge(item.durum)}</small>
            </button>
          </li>`;
        })
        .join('');
    }

    function getFilteredApps() {
      const query = searchInput?.value?.trim()?.toLowerCase() || '';
      const status = statusFilter?.value || 'all';
      return cachedApps.filter((item) => {
        const statusOk = status === 'all' ? true : item.durum === status;
        if (!statusOk) return false;
        if (!query) return true;
        const haystack = `${item.ad || ''} ${item.il || ''} ${item.ilce || ''}`.toLowerCase();
        return haystack.includes(query);
      });
    }

    function renderDetailLoading() {
      if (!detailEl) return;
      detailEl.innerHTML = '<p>Detay yukleniyor...</p>';
    }

    function renderDetailError(message) {
      if (!detailEl) return;
      detailEl.innerHTML = `<p class="error">${message}</p>`;
    }

    async function loadDocuments(appId) {
      const rows = await apiGet(`/api/admin/application-documents?applicationId=${appId}`);
      if (!rows.length) {
        return '<p class="hint">Belge kaydi yok.</p>';
      }
      return `<ul class="docs">
        ${rows
          .map(
            (doc) =>
              `<li>
                <strong>${doc.kind}</strong> - ${doc.originalFilename} (${doc.byteSize} byte)
                <br /><code>${doc.storageKey}</code>
                <br /><a class="doc-download-link" href="${adminDownloadUrl(doc.id)}">Belgeyi indir</a>
              </li>`
          )
          .join('')}
      </ul>`;
    }

    async function renderDetail(appId) {
      selectedAppId = appId;
      renderList();
      renderDetailLoading();
      try {
        const app = await apiGet(`/api/admin/applications?id=${appId}`);
        const docsHtml = await loadDocuments(appId);
        if (!detailEl) return;
        detailEl.innerHTML = `
          <div class="detail-header">
            <h3>${app.ad}</h3>
            ${statusBadge(app.durum)}
          </div>
          <p><strong>Il / Ilce:</strong> ${app.il || '-'} / ${app.ilce || '-'}</p>
          <p><strong>Telefon:</strong> ${app.telefon || '-'}</p>
          <p><strong>E-posta:</strong> ${app.email || '-'}</p>
          <p><strong>Adres:</strong> ${app.adres || '-'}</p>
          <p><strong>Olusturma:</strong> ${formatDate(app.createdAt)}</p>
          <p><strong>Guncelleme:</strong> ${formatDate(app.updatedAt)}</p>
          <p><strong>Aciklama:</strong> ${app.aciklama || '-'}</p>
          <label class="admin-note">
            <strong>Sorumlu Admin E-posta:</strong>
            <input id="assigned-admin-email" placeholder="admin@spornerede.net" value="${app.sorumluAdminEmail || ''}" />
          </label>
          <label class="admin-note">
            <strong>Admin Notu:</strong>
            <textarea id="admin-note" rows="4" placeholder="Takip notu, kontrol adimi, red gerekcesi vb.">${app.adminNotu || ''}</textarea>
          </label>
          <button id="save-note-btn" type="button">Notu Kaydet</button>

          <div class="actions">
            <button data-status="approved">Onayla</button>
            <button data-status="rejected">Reddet</button>
            <button data-status="pending">Beklemeye Al</button>
          </div>

          <h4>Belgeler</h4>
          ${docsHtml}

          <div class="doc-add">
            <h4>Belge Metaverisi Ekle</h4>
            <label>Tur
              <select id="doc-kind">
                <option value="dekont">dekont</option>
                <option value="kimlik">kimlik</option>
                <option value="sozlesme">sozlesme</option>
                <option value="diger">diger</option>
              </select>
            </label>
            <label>Storage Key
              <input id="doc-storage-key" placeholder="applications/${appId}/ornek.pdf" />
            </label>
            <label>Original Filename
              <input id="doc-original-filename" placeholder="ornek.pdf" />
            </label>
            <label>Mime Type
              <input id="doc-mime-type" value="application/pdf" />
            </label>
            <label>Byte Size
              <input id="doc-byte-size" type="number" value="0" />
            </label>
            <button id="add-doc-btn" type="button">Belge Kaydi Ekle</button>
          </div>

          <div class="account-provision">
            <h4>Kulup Kullanici Hesabi (Onboarding)</h4>
            <label>E-posta
              <input id="provision-email" type="email" placeholder="kulup@example.com" value="${app.email || ''}" />
            </label>
            <label>Gecici Sifre
              <input id="provision-password" type="text" placeholder="En az 8 karakter" />
            </label>
            <label>Uyelik Rolu
              <select id="provision-role">
                <option value="owner">owner</option>
                <option value="staff">staff</option>
              </select>
            </label>
            <button id="provision-user-btn" type="button">Kullanici Olustur/Guncelle</button>
            <p class="hint">Bu islem mevcut kullanici varsa sifresini gunceller ve kulube baglar.</p>
          </div>

          <div class="log-timeline-wrap">
            <h4>İşlem Geçmişi</h4>
            <div id="admin-log-timeline"><p class="hint">Yukleniyor...</p></div>
          </div>
        `;

        const renderLogTimeline = async () => {
          const logEl = document.getElementById('admin-log-timeline');
          if (!logEl) return;
          try {
            const logs = await apiGet(`/api/admin/applications?logsForId=${appId}`);
            if (!logs.length) {
              logEl.innerHTML = '<p class="hint">Henüz işlem geçmişi yok.</p>';
              return;
            }
            logEl.innerHTML = `
              <ul class="log-list">
                ${logs
                  .map(
                    (log) => `
                      <li>
                        <strong>${log.action}</strong> ${log.nextStatus ? `→ ${log.nextStatus}` : ''}
                        <br /><small>${formatDate(log.createdAt)}${log.actorEmail ? ` • ${log.actorEmail}` : ''}</small>
                        ${log.assignedAdminEmail ? `<br /><small>Atanan: ${log.assignedAdminEmail}</small>` : ''}
                        ${log.note ? `<br /><span>${log.note}</span>` : ''}
                      </li>
                    `
                  )
                  .join('')}
              </ul>
            `;
          } catch {
            logEl.innerHTML = '<p class="error">Geçmiş yüklenemedi.</p>';
          }
        };
        await renderLogTimeline();

        detailEl.querySelectorAll('.actions button').forEach((button) => {
          button.addEventListener('click', async () => {
            const nextStatus = button.getAttribute('data-status');
            if (!nextStatus) return;
            const adminNote = document.getElementById('admin-note')?.value || '';
            const assignedAdminEmail = document.getElementById('assigned-admin-email')?.value?.trim() || '';
            try {
              await apiPost('/api/admin/applications', { id: appId, status: nextStatus, adminNote, assignedAdminEmail });
              await loadApplications();
              await renderDetail(appId);
            } catch (error) {
              renderDetailError(error.message);
            }
          });
        });

        const saveNoteBtn = document.getElementById('save-note-btn');
        saveNoteBtn?.addEventListener('click', async () => {
          const adminNote = document.getElementById('admin-note')?.value || '';
          const assignedAdminEmail = document.getElementById('assigned-admin-email')?.value?.trim() || '';
          try {
            await apiPost('/api/admin/applications', {
              id: appId,
              status: app.durum,
              adminNote,
              assignedAdminEmail,
            });
            await loadApplications();
            await renderDetail(appId);
          } catch (error) {
            renderDetailError(error.message);
          }
        });

        const addDocBtn = document.getElementById('add-doc-btn');
        addDocBtn?.addEventListener('click', async () => {
          const kind = document.getElementById('doc-kind')?.value || 'diger';
          const storageKey = document.getElementById('doc-storage-key')?.value?.trim() || '';
          const originalFilename = document.getElementById('doc-original-filename')?.value?.trim() || '';
          const mimeType = document.getElementById('doc-mime-type')?.value?.trim() || 'application/octet-stream';
          const byteSize = Number(document.getElementById('doc-byte-size')?.value || '0');

          if (!storageKey || !originalFilename) {
            alert('Storage key ve original filename zorunlu.');
            return;
          }

          try {
            await apiPost('/api/admin/application-documents', {
              applicationId: appId,
              kind,
              storageKey,
              originalFilename,
              mimeType,
              byteSize,
            });
            await renderDetail(appId);
          } catch (error) {
            renderDetailError(error.message);
          }
        });

        const provisionBtn = document.getElementById('provision-user-btn');
        provisionBtn?.addEventListener('click', async () => {
          const email = document.getElementById('provision-email')?.value?.trim() || '';
          const password = document.getElementById('provision-password')?.value || '';
          const membershipRole = document.getElementById('provision-role')?.value || 'owner';
          if (!email || !password) {
            alert('E-posta ve gecici sifre zorunlu.');
            return;
          }
          try {
            const result = await apiPost('/api/admin/provision-club-user', {
              clubId: appId,
              email,
              password,
              membershipRole,
            });
            alert(`Hesap hazir: ${result.email} (${result.clubName || app.ad})`);
          } catch (error) {
            renderDetailError(error.message);
          }
        });
      } catch (error) {
        renderDetailError(error.message);
      }
    }

    async function loadApplications() {
      if (!listEl) return;
      listEl.innerHTML = '<li class="empty">Yukleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/applications');
        cachedApps = rows || [];
        if (!selectedAppId && cachedApps.length) {
          selectedAppId = cachedApps[0].id;
        }
        renderList();
        if (selectedAppId) {
          await renderDetail(selectedAppId);
        }
      } catch (error) {
        listEl.innerHTML = `<li class="empty error">${error.message}</li>`;
        if (detailEl) {
          detailEl.innerHTML = '<p class="error">Basvuru listesi yuklenemedi.</p>';
        }
      }
    }

    listEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-id]');
      if (!button) return;
      const id = Number(button.getAttribute('data-id'));
      if (!id) return;
      await renderDetail(id);
    });

    loadButton?.addEventListener('click', async () => {
      await loadApplications();
    });

    searchInput?.addEventListener('input', () => {
      renderList();
    });

    statusFilter?.addEventListener('change', () => {
      renderList();
    });
  </script>
</BaseLayout>

<style>
  .admin-page { background: #F8F9FA; min-height: 60vh; }
  .admin-title { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 900; color: #212529; }
  .admin-desc { margin-top: .5rem; color: #6C757D; max-width: 800px; line-height: 1.6; }
  .admin-grid { margin-top: 1.25rem; display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 900px) { .admin-grid { grid-template-columns: repeat(4, 1fr); } }
  .admin-card { background: #fff; border: 1px solid #E9ECEF; border-radius: .9rem; padding: 1rem; }
  .admin-card h2 { color: #6C757D; font-size: .85rem; font-weight: 700; text-transform: uppercase; }
  .admin-card p { margin-top: .4rem; font-size: 1.6rem; font-weight: 900; color: #E30A17; }
  .admin-shell { margin-top: 1.25rem; }
  .admin-toolbar { display: flex; flex-wrap: wrap; gap: .75rem; align-items: end; }
  .admin-toolbar label { display: grid; gap: .35rem; font-weight: 600; color: #495057; }
  .admin-toolbar input {
    min-width: 280px;
    border: 1px solid #dee2e6;
    border-radius: .6rem;
    padding: .55rem .65rem;
  }
  .admin-toolbar select {
    min-width: 180px;
    border: 1px solid #dee2e6;
    border-radius: .6rem;
    padding: .55rem .65rem;
    background: #fff;
  }
  .admin-toolbar button {
    border: 0;
    border-radius: .6rem;
    padding: .58rem .9rem;
    background: #E30A17;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
  }
  .admin-toolbar button:hover { background: #b5080f; }
  .admin-columns {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 1000px) {
    .admin-columns {
      grid-template-columns: minmax(270px, 340px) 1fr;
      align-items: start;
    }
  }
  .admin-list, .admin-detail {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: .9rem;
    padding: .9rem;
  }
  .admin-list h2, .admin-detail h2 {
    margin: 0 0 .75rem;
    font-size: 1rem;
    font-weight: 800;
    color: #212529;
  }
  .admin-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: .5rem;
  }
  .app-item {
    width: 100%;
    text-align: left;
    border: 1px solid #dee2e6;
    border-radius: .7rem;
    background: #fff;
    padding: .6rem .65rem;
    display: grid;
    gap: .25rem;
    cursor: pointer;
  }
  .app-item.is-active {
    border-color: #E30A17;
    box-shadow: 0 0 0 1px #E30A17 inset;
  }
  .app-item strong { color: #212529; }
  .app-item small { color: #6c757d; }
  .status {
    display: inline-block;
    border-radius: 999px;
    padding: .2rem .5rem;
    font-size: .75rem;
    font-weight: 700;
  }
  .status-pending { background: #fff3bf; color: #8d6b00; }
  .status-approved { background: #d3f9d8; color: #2b8a3e; }
  .status-rejected { background: #ffe3e3; color: #c92a2a; }
  .detail-empty { color: #6c757d; }
  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .5rem;
  }
  .actions {
    margin: .85rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .actions button, .doc-add button {
    border: 0;
    border-radius: .55rem;
    padding: .46rem .75rem;
    background: #212529;
    color: #fff;
    cursor: pointer;
    font-weight: 600;
  }
  .actions button:hover, .doc-add button:hover { background: #000; }
  .docs {
    margin: .5rem 0 0;
    padding-left: 1rem;
    display: grid;
    gap: .45rem;
  }
  .docs code {
    font-size: .75rem;
    color: #495057;
  }
  .doc-download-link {
    display: inline-block;
    margin-top: .28rem;
    font-size: .82rem;
    font-weight: 700;
    color: #1864ab;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .doc-download-link:hover {
    color: #0b4f87;
  }
  .doc-add {
    margin-top: 1rem;
    border-top: 1px solid #e9ecef;
    padding-top: .8rem;
    display: grid;
    gap: .45rem;
  }
  .doc-add label {
    display: grid;
    gap: .25rem;
    color: #495057;
    font-size: .9rem;
  }
  .doc-add input, .doc-add select {
    border: 1px solid #dee2e6;
    border-radius: .5rem;
    padding: .46rem .55rem;
  }
  .account-provision {
    margin-top: 1rem;
    border-top: 1px solid #e9ecef;
    padding-top: .85rem;
    display: grid;
    gap: .45rem;
  }
  .account-provision label {
    display: grid;
    gap: .25rem;
    color: #495057;
    font-size: .9rem;
  }
  .account-provision input, .account-provision select {
    border: 1px solid #dee2e6;
    border-radius: .5rem;
    padding: .46rem .55rem;
  }
  .account-provision button {
    border: 0;
    border-radius: .55rem;
    padding: .48rem .75rem;
    background: #1864ab;
    color: #fff;
    cursor: pointer;
    font-weight: 700;
    width: fit-content;
  }
  .account-provision button:hover { background: #0b4f87; }
  .hint { color: #6c757d; }
  .empty { color: #6c757d; font-size: .92rem; }
  .error { color: #c92a2a; }
  .admin-note {
    margin-top: .5rem;
    display: grid;
    gap: .35rem;
  }
  .admin-note textarea {
    border: 1px solid #dee2e6;
    border-radius: .6rem;
    padding: .55rem .65rem;
    resize: vertical;
  }
  .admin-note input {
    border: 1px solid #dee2e6;
    border-radius: .6rem;
    padding: .55rem .65rem;
  }
  #save-note-btn {
    margin-top: .45rem;
    border: 0;
    border-radius: .55rem;
    padding: .45rem .75rem;
    background: #495057;
    color: #fff;
    cursor: pointer;
    font-weight: 600;
  }
  #save-note-btn:hover { background: #343a40; }
  .log-timeline-wrap {
    margin-top: 1rem;
    border-top: 1px solid #e9ecef;
    padding-top: .8rem;
  }
  .log-list {
    margin: .45rem 0 0;
    padding-left: 1rem;
    display: grid;
    gap: .6rem;
  }
  .log-list li {
    color: #495057;
    font-size: .88rem;
    line-height: 1.5;
  }
  .log-list small {
    color: #6c757d;
    font-size: .78rem;
  }
</style>

