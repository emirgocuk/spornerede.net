---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAdminClubSummary } from '../lib/repositories/catalog';

const summary = await getAdminClubSummary();
---

<BaseLayout
  title="Admin Paneli | SporNerede"
  description="Kulüp başvurularını ve üyelik durumlarını yönetin."
  noIndex={true}
>
  <div class="admin-dashboard">
    <!-- Sidebar / Header Layout for modern dashboard look -->
    <header class="admin-header">
      <div class="header-container">
        <div class="brand">
          <div class="brand-logo">SN</div>
          <div>
            <h1 class="admin-title">Yönetim Paneli</h1>
            <p class="admin-subtitle">Sistem ve başvuru süreçlerini yönetin</p>
          </div>
        </div>
        <form method="post" action="/api/panel/logout" class="admin-logout-form">
          <button type="submit" class="admin-logout-btn">
            <span>🚪</span> Çıkış Yap
          </button>
        </form>
      </div>
    </header>

    <main class="admin-main">
      <div class="container">
        <!-- Dashboard Stats -->
        <div class="stats-grid animate-fade-in-up">
          <div class="stat-card">
            <div class="stat-icon bg-blue">📊</div>
            <div class="stat-content">
              <h3>Toplam Kulüp</h3>
              <p class="stat-value">{summary.total}</p>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon bg-amber">⏳</div>
            <div class="stat-content">
              <h3>Onay Bekleyen</h3>
              <p class="stat-value text-amber">{summary.pending}</p>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon bg-green">✅</div>
            <div class="stat-content">
              <h3>Onaylı</h3>
              <p class="stat-value text-green">{summary.approved}</p>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon bg-red">❌</div>
            <div class="stat-content">
              <h3>Reddedilen</h3>
              <p class="stat-value text-red">{summary.rejected}</p>
            </div>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="admin-tabs-wrapper animate-fade-in-up delay-100">
          <div class="admin-tabs" role="tablist" aria-label="Admin sekmeleri">
            <button type="button" class="admin-tab is-active" data-tab-target="applications">
              <span class="tab-icon">📥</span> Başvurular
              <span id="applications-tab-badge" class="tab-badge">{summary.pending}</span>
            </button>
            <button type="button" class="admin-tab" data-tab-target="clubs">
              <span class="tab-icon">🏢</span> Onaylı Kulüpler
            </button>
            <button type="button" class="admin-tab" data-tab-target="contact">
              <span class="tab-icon">✉️</span> İletişim Formu
              <span id="contact-tab-badge" class="tab-badge is-hidden">0</span>
            </button>
            <button type="button" class="admin-tab" data-tab-target="feedback">
              <span class="tab-icon">💬</span> Geribildirimler
              <span id="feedback-tab-badge" class="tab-badge is-hidden">0</span>
            </button>
          </div>
        </div>

        <!-- Applications Tab Panel -->
        <section class="admin-shell animate-fade-in-up delay-200" data-tab-panel="applications">
          <div class="admin-toolbar">
            <div class="search-box">
              <span class="search-icon">🔍</span>
              <input id="app-search" type="text" placeholder="Kulüp adı, il, ilçe ile ara..." />
            </div>
            <div class="filter-box">
              <select id="status-filter" class="modern-select">
                <option value="all">Tüm Durumlar</option>
                <option value="pending">⏳ Bekliyor</option>
                <option value="approved">✅ Onaylı</option>
                <option value="rejected">❌ Reddedildi</option>
              </select>
            </div>
            <button id="load-apps" class="btn btn-primary shadow-sm" type="button">🔄 Yenile</button>
          </div>

          <div class="admin-columns">
            <aside class="admin-list-container">
              <div class="list-header">
                <h2>Başvuru Listesi</h2>
                <span class="badge badge-gray">Seçmek için tıklayın</span>
              </div>
              <ul id="applications-list" class="admin-list custom-scrollbar"></ul>
            </aside>

            <article class="admin-detail-container">
              <div id="application-detail" class="detail-content">
                <div class="empty-state">
                  <div class="empty-icon">👈</div>
                  <h3>Başvuru Seçin</h3>
                  <p>Detayları görüntülemek ve işlem yapmak için sol taraftaki listeden bir başvuru seçin.</p>
                </div>
              </div>
            </article>
          </div>
        </section>

        <!-- Clubs Tab Panel -->
        <section class="admin-shell is-hidden" data-tab-panel="clubs">
          <div class="admin-toolbar">
            <div class="search-box">
              <span class="search-icon">🔍</span>
              <input id="club-search" type="text" placeholder="Kulüp adı, il, ilçe ile ara..." />
            </div>
            <button id="load-clubs" class="btn btn-primary shadow-sm" type="button">🔄 Yenile</button>
          </div>

          <div class="admin-columns">
            <aside class="admin-list-container">
              <div class="list-header">
                <h2>Onaylı Kulüpler</h2>
                <span class="badge badge-success">Aktif</span>
              </div>
              <ul id="clubs-list" class="admin-list custom-scrollbar"></ul>
            </aside>

            <article class="admin-detail-container">
              <div id="club-detail" class="detail-content">
                <div class="empty-state">
                  <div class="empty-icon">🏢</div>
                  <h3>Kulüp Seçin</h3>
                  <p>Kulüp bilgilerini düzenlemek ve ilanları görmek için listeden bir kulüp seçin.</p>
                </div>
              </div>
            </article>
          </div>
        </section>

        <!-- Contact Messages Tab Panel -->
        <section class="admin-shell is-hidden" data-tab-panel="contact">
          <div class="admin-toolbar">
            <div class="search-box">
              <span class="search-icon">🔍</span>
              <input id="contact-search" type="text" placeholder="Ad soyad, e-posta, konu ile ara..." />
            </div>
            <div class="filter-box">
              <select id="contact-filter" class="modern-select">
                <option value="all">Tüm Mesajlar</option>
                <option value="unread">Okunmamış</option>
                <option value="read">Okunmuş</option>
              </select>
            </div>
            <button id="load-contact-messages" class="btn btn-primary shadow-sm" type="button">🔄 Yenile</button>
          </div>

          <div class="admin-columns">
            <aside class="admin-list-container">
              <div class="list-header">
                <h2>İletişim Mesajları</h2>
                <span class="badge badge-gray">Form kayıtları</span>
              </div>
              <ul id="contact-messages-list" class="admin-list custom-scrollbar"></ul>
            </aside>

            <article class="admin-detail-container">
              <div id="contact-message-detail" class="detail-content">
                <div class="empty-state">
                  <div class="empty-icon">✉️</div>
                  <h3>Mesaj Seçin</h3>
                  <p>İletişim formundan gelen mesajları görüntülemek için soldan bir kayıt seçin.</p>
                </div>
              </div>
            </article>
          </div>
        </section>

        <!-- Feedbacks Tab Panel -->
        <section class="admin-shell is-hidden" data-tab-panel="feedback">
          <div class="admin-toolbar">
            <div class="search-box">
              <span class="search-icon">🔍</span>
              <input id="feedback-search" type="text" placeholder="Mesaj veya kullanıcı ile ara..." />
            </div>
            <div class="filter-box">
              <select id="feedback-filter" class="modern-select">
                <option value="all">Tüm Geribildirimler</option>
                <option value="yeni">Yeni</option>
                <option value="incelendi">İncelendi</option>
                <option value="kapandi">Kapandı</option>
              </select>
            </div>
            <button id="load-feedbacks" class="btn btn-primary shadow-sm" type="button">🔄 Yenile</button>
          </div>

          <div class="admin-columns">
            <aside class="admin-list-container">
              <div class="list-header">
                <h2>Geribildirimler</h2>
                <span class="badge badge-gray">Panel yorumları</span>
              </div>
              <ul id="feedbacks-list" class="admin-list custom-scrollbar"></ul>
            </aside>

            <article class="admin-detail-container">
              <div id="feedback-detail" class="detail-content">
                <div class="empty-state">
                  <div class="empty-icon">💬</div>
                  <h3>Geribildirim Seçin</h3>
                  <p>Kullanıcıların panel hakkındaki düşüncelerini okumak için soldan bir kayıt seçin.</p>
                </div>
              </div>
            </article>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script is:inline>
    const searchInput = document.getElementById('app-search');
    const statusFilter = document.getElementById('status-filter');
    const loadButton = document.getElementById('load-apps');
    const listEl = document.getElementById('applications-list');
    const detailEl = document.getElementById('application-detail');
    const clubSearchInput = document.getElementById('club-search');
    const clubsListEl = document.getElementById('clubs-list');
    const clubDetailEl = document.getElementById('club-detail');
    const loadClubsButton = document.getElementById('load-clubs');
    const contactSearchInput = document.getElementById('contact-search');
    const contactFilter = document.getElementById('contact-filter');
    const contactListEl = document.getElementById('contact-messages-list');
    const contactDetailEl = document.getElementById('contact-message-detail');
    const loadContactButton = document.getElementById('load-contact-messages');
    const feedbacksListEl = document.getElementById('feedbacks-list');
    const feedbackDetailEl = document.getElementById('feedback-detail');
    const loadFeedbacksButton = document.getElementById('load-feedbacks');
    const feedbackSearch = document.getElementById('feedback-search');
    const feedbackFilter = document.getElementById('feedback-filter');
    const applicationsTabBadge = document.getElementById('applications-tab-badge');
    const contactTabBadge = document.getElementById('contact-tab-badge');
    const feedbackTabBadge = document.getElementById('feedback-tab-badge');
    const tabButtons = Array.from(document.querySelectorAll('.admin-tab'));
    const tabPanels = Array.from(document.querySelectorAll('[data-tab-panel]'));

    let cachedApps = [];
    let selectedAppId = 0;
    let cachedClubs = [];
    let selectedClubId = 0;
    let cachedContactMessages = [];
    let selectedContactMessageId = 0;
    let cachedFeedbacks = [];
    let selectedFeedbackId = 0;
    const draftProvisionPasswords = new Map();

    function adminDownloadUrl(documentId) {
      return `/api/admin/application-document-download?documentId=${encodeURIComponent(documentId)}`;
    }

    async function apiGet(path) {
      const response = await fetch(path);
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `Request failed (${response.status})`);
      }
      const payload = await response.json();
      return payload.data;
    }

    async function apiPost(path, body) {
      const response = await fetch(path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `Request failed (${response.status})`);
      }
      const payload = await response.json();
      return payload.data;
    }

    async function apiPut(path, body) {
      const response = await fetch(path, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `Request failed (${response.status})`);
      }
      const payload = await response.json();
      return payload.data;
    }

    async function apiDelete(path, body) {
      const response = await fetch(path, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `Request failed (${response.status})`);
      }
      return response.json().catch(() => ({}));
    }

    function formatDate(value) {
      if (!value) return '-';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '-';
      return new Intl.DateTimeFormat('tr-TR', {
        dateStyle: 'short',
        timeStyle: 'short',
      }).format(date);
    }

    function formatLogDateTime(value) {
      if (!value) return 'Tarih bilgisi yok';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Tarih bilgisi yok';
      return new Intl.DateTimeFormat('tr-TR', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).format(date);
    }

    function escapeHtml(text) {
      return String(text ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function statusLabelTr(status) {
      const map = { pending: 'Bekliyor', approved: 'Onaylı', rejected: 'Reddedildi' };
      return map[status] || status || '—';
    }

    function logActionTitle(action) {
      if (action === 'application_created') return 'Başvuru oluşturuldu';
      if (action === 'status_update') return 'Durum güncellendi';
      return action || 'İşlem';
    }

    function statusBadge(status) {
      const map = {
        pending: 'Bekliyor',
        approved: 'Onaylı',
        rejected: 'Reddedildi',
      };
      return `<span class="status-badge status-${status}">${map[status] || status}</span>`;
    }

    function statusActionLabel(currentStatus, targetStatus) {
      if (targetStatus === 'approved') return currentStatus === 'approved' ? 'Onaylı' : 'Onayla';
      if (targetStatus === 'pending') return 'Onayı Geri Çek';
      return 'Reddet';
    }

    function generateTemporaryPassword(length = 8) {
      const letters = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
      const digits = '23456789';
      const allChars = letters + digits;

      let password = letters[Math.floor(Math.random() * letters.length)];
      password += digits[Math.floor(Math.random() * digits.length)];

      for (let i = 2; i < length; i += 1) {
        password += allChars[Math.floor(Math.random() * allChars.length)];
      }

      return password
        .split('')
        .sort(() => Math.random() - 0.5)
        .join('');
    }

    function renderList() {
      if (!listEl) return;
      const filteredApps = getFilteredApps();
      if (!filteredApps.length) {
        listEl.innerHTML = '<li class="empty-list">Kayıt bulunamadı.</li>';
        return;
      }
      listEl.innerHTML = filteredApps
        .map((item) => {
          const activeClass = item.id === selectedAppId ? 'is-active' : '';
          return `<li>
            <button class="list-item ${activeClass}" data-id="${item.id}">
              <div class="item-main">
                <span class="item-title">${item.ad}</span>
                <span class="item-meta">📍 ${item.il || '-'} / ${item.ilce || '-'}</span>
              </div>
              <div class="item-side">
                ${statusBadge(item.durum)}
              </div>
            </button>
          </li>`;
        })
        .join('');
    }

    function getFilteredApps() {
      const query = searchInput?.value?.trim()?.toLowerCase() || '';
      const status = statusFilter?.value || 'all';
      return cachedApps.filter((item) => {
        const statusOk = status === 'all' ? true : item.durum === status;
        if (!statusOk) return false;
        if (!query) return true;
        const haystack = `${item.ad || ''} ${item.il || ''} ${item.ilce || ''}`.toLowerCase();
        return haystack.includes(query);
      });
    }

    function renderDetailLoading() {
      if (!detailEl) return;
      detailEl.innerHTML = '<div class="loading-state"><div class="spinner"></div><p>Detay yükleniyor...</p></div>';
    }

    function renderDetailError(message) {
      if (!detailEl) return;
      detailEl.innerHTML = `<div class="error-state">⚠️ <p>${message}</p></div>`;
    }

    function updateNotificationBadges() {
      const pendingApps = cachedApps.filter((item) => item.durum === 'pending').length;
      if (applicationsTabBadge) {
        applicationsTabBadge.textContent = String(pendingApps);
        applicationsTabBadge.classList.toggle('is-hidden', pendingApps === 0);
      }

      const unreadMessages = cachedContactMessages.filter((item) => !item.okundu).length;
      if (contactTabBadge) {
        contactTabBadge.textContent = String(unreadMessages);
        contactTabBadge.classList.toggle('is-hidden', unreadMessages === 0);
      }

      const unreadFeedbacks = cachedFeedbacks.filter((item) => item.durum === 'yeni').length;
      if (feedbackTabBadge) {
        feedbackTabBadge.textContent = String(unreadFeedbacks);
        feedbackTabBadge.classList.toggle('is-hidden', unreadFeedbacks === 0);
      }
    }

    function getFilteredContactMessages() {
      const query = contactSearchInput?.value?.trim()?.toLowerCase() || '';
      const filter = contactFilter?.value || 'all';
      return cachedContactMessages.filter((item) => {
        if (filter === 'unread' && item.okundu) return false;
        if (filter === 'read' && !item.okundu) return false;
        if (!query) return true;
        const haystack = `${item.adSoyad || ''} ${item.email || ''} ${item.konu || ''}`.toLowerCase();
        return haystack.includes(query);
      });
    }

    function renderContactMessagesList() {
      if (!contactListEl) return;
      const filtered = getFilteredContactMessages();
      if (!filtered.length) {
        contactListEl.innerHTML = '<li class="empty-list">Mesaj bulunamadı.</li>';
        return;
      }

      contactListEl.innerHTML = filtered
        .map((message) => {
          const activeClass = message.id === selectedContactMessageId ? 'is-active' : '';
          const unreadClass = message.okundu ? '' : 'is-unread';
          const answeredBadge = message.cevaplandi ? '<span class="status-badge status-approved">Cevaplandı</span>' : '';
          return `<li>
            <button class="list-item contact-list-item ${activeClass} ${unreadClass}" data-contact-id="${message.id}">
              <div class="item-main">
                <span class="item-title">${escapeHtml(message.adSoyad)}</span>
                <span class="item-meta">${escapeHtml(message.konu || '-')} · ${formatDate(message.createdAt)}</span>
              </div>
              <div class="item-side">
                ${answeredBadge || (message.okundu ? '<span class="status-badge status-approved">Okundu</span>' : '<span class="status-badge status-pending">Yeni</span>')}
              </div>
            </button>
          </li>`;
        })
        .join('');
    }

    function renderContactDetailLoading() {
      if (!contactDetailEl) return;
      contactDetailEl.innerHTML = '<div class="loading-state"><div class="spinner"></div><p>Mesaj yükleniyor...</p></div>';
    }

    async function renderContactMessageDetail(messageId) {
      selectedContactMessageId = messageId;
      renderContactMessagesList();
      renderContactDetailLoading();
      try {
        const message = await apiGet(`/api/admin/contact-messages?id=${messageId}`);
        if (!message.okundu) {
          await apiPost('/api/admin/contact-messages', { id: messageId, okundu: true });
          const cached = cachedContactMessages.find((item) => item.id === messageId);
          if (cached) cached.okundu = true;
          updateNotificationBadges();
          renderContactMessagesList();
          message.okundu = true;
        }

        if (!contactDetailEl) return;
        contactDetailEl.innerHTML = `
          <div class="detail-header">
            <div class="detail-title-area">
              <span class="kicker">İLETİŞİM MESAJI #${message.id}</span>
              <h2>${escapeHtml(message.adSoyad)}</h2>
            </div>
            <div class="detail-status">
              ${
                message.cevaplandi
                  ? '<span class="status-badge status-approved">Cevaplandı</span>'
                  : '<span class="status-badge status-pending">Takipte</span>'
              }
            </div>
          </div>

          <div class="detail-grid detail-grid--single">
            <section class="card-section">
              <div class="section-head">
                <span class="icon">✉️</span>
                <h3>Mesaj İçeriği</h3>
              </div>
              <div class="info-list">
                <div class="info-item">
                  <span class="label">Konu</span>
                  <span class="value">${escapeHtml(message.konu || '-')}</span>
                </div>
                <div class="info-item">
                  <span class="label">Gönderim Tarihi</span>
                  <span class="value">${formatDate(message.createdAt)}</span>
                </div>
                <div class="info-item">
                  <span class="label">Mesaj</span>
                  <span class="value text-box">${escapeHtml(message.mesaj || '-')}</span>
                </div>
              </div>
            </section>

            <section class="card-section">
              <div class="section-head">
                <span class="icon">📞</span>
                <h3>Gönderen Bilgileri</h3>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <span class="label">E-posta</span>
                  <span class="value"><a href="mailto:${escapeHtml(message.email)}">${escapeHtml(message.email || '-')}</a></span>
                </div>
                <div class="info-item">
                  <span class="label">Telefon</span>
                  <span class="value">${escapeHtml(message.telefon || '-')}</span>
                </div>
              </div>
              <div class="contact-actions">
                <button id="toggle-contact-answered" class="btn btn-primary" type="button">
                  ${message.cevaplandi ? 'Cevaplandı Etiketini Kaldır' : 'Cevaplandı Olarak İşaretle'}
                </button>
                <button id="mark-contact-unread" class="btn btn-outline" type="button">Okunmadı Yap</button>
              </div>
            </section>
          </div>
        `;

        document.getElementById('toggle-contact-answered')?.addEventListener('click', async () => {
          const nextAnswered = !message.cevaplandi;
          await apiPost('/api/admin/contact-messages', { id: messageId, cevaplandi: nextAnswered });
          const cached = cachedContactMessages.find((item) => item.id === messageId);
          if (cached) cached.cevaplandi = nextAnswered;
          await renderContactMessageDetail(messageId);
        });

        document.getElementById('mark-contact-unread')?.addEventListener('click', async () => {
          await apiPost('/api/admin/contact-messages', { id: messageId, okundu: false });
          const cached = cachedContactMessages.find((item) => item.id === messageId);
          if (cached) cached.okundu = false;
          updateNotificationBadges();
          renderContactMessagesList();
        });
      } catch (error) {
        if (contactDetailEl) {
          contactDetailEl.innerHTML = `<div class="error-state">${error.message}</div>`;
        }
      }
    }

    function switchTab(tabKey) {
      tabButtons.forEach((button) => {
        const isActive = button.getAttribute('data-tab-target') === tabKey;
        button.classList.toggle('is-active', isActive);
      });
      tabPanels.forEach((panel) => {
        const isCurrent = panel.getAttribute('data-tab-panel') === tabKey;
        panel.classList.toggle('is-hidden', !isCurrent);
      });
    }

    async function loadDocuments(appId) {
      const rows = await apiGet(`/api/admin/application-documents?applicationId=${appId}`);
      if (!rows.length) {
        return '<div class="empty-hint">Bu başvuruya ait belge bulunamadı.</div>';
      }
      return `<ul class="doc-list">
        ${rows
          .map(
            (doc) =>
              `<li>
                <div class="doc-icon">📄</div>
                <div class="doc-info">
                  <strong>${doc.kind}</strong>
                  <span class="doc-meta">${doc.originalFilename} (${Math.round(doc.byteSize/1024)} KB)</span>
                </div>
                <a class="btn-download" href="${adminDownloadUrl(doc.id)}" target="_blank" title="Belgeyi İndir">⬇️</a>
              </li>`
          )
          .join('')}
      </ul>`;
    }

    async function renderDetail(appId) {
      selectedAppId = appId;
      renderList();
      renderDetailLoading();
      try {
        const app = await apiGet(`/api/admin/applications?id=${appId}`);
        const docsHtml = await loadDocuments(appId);
        if (!detailEl) return;
        detailEl.innerHTML = `
          <div class="detail-header">
            <div class="detail-title-area">
              <span class="kicker">BAŞVURU DOSYASI #${app.id}</span>
              <h2>${app.ad}</h2>
            </div>
            <div class="detail-status">
              ${statusBadge(app.durum)}
            </div>
          </div>

          <div class="detail-grid">
            <!-- Sol Kolon: Bilgiler -->
            <div class="detail-column">
              <section class="card-section">
                <div class="section-head">
                  <span class="icon">🏢</span>
                  <h3>Kurum Bilgileri</h3>
                </div>
                <div class="info-list">
                  <div class="info-item">
                    <span class="label">Ad / Ünvan</span>
                    <span class="value">${app.ad || '-'}</span>
                  </div>
                  <div class="info-item">
                    <span class="label">Konum</span>
                    <span class="value">${app.il || '-'} / ${app.ilce || '-'}</span>
                  </div>
                  <div class="info-item">
                    <span class="label">Tam Adres</span>
                    <span class="value">${app.adres || '-'}</span>
                  </div>
                  <div class="info-item">
                    <span class="label">Açıklama</span>
                    <span class="value text-box">${app.aciklama || '-'}</span>
                  </div>
                </div>
              </section>

              <section class="card-section">
                <div class="section-head">
                  <span class="icon">📞</span>
                  <h3>İletişim</h3>
                </div>
                <div class="info-grid">
                  <div class="info-item">
                    <span class="label">Telefon</span>
                    <span class="value">${app.telefon || '-'}</span>
                  </div>
                  <div class="info-item">
                    <span class="label">E-posta</span>
                    <span class="value"><a href="mailto:${app.email}">${app.email || '-'}</a></span>
                  </div>
                </div>
              </section>
              
              <section class="card-section">
                <div class="section-head">
                  <span class="icon">📂</span>
                  <h3>Belgeler</h3>
                </div>
                <div class="doc-section-body">
                  ${docsHtml}
                  
                  <div class="upload-box mt-4">
                    <h4>Dekont Yükle (PDF)</h4>
                    <div class="upload-controls">
                      <input id="doc-file" type="file" accept=".pdf,application/pdf" class="file-input" />
                      <button id="upload-doc-btn" class="btn btn-outline" type="button">Yükle</button>
                    </div>
                  </div>
                </div>
              </section>
            </div>

            <!-- Sağ Kolon: İşlemler & Yönetim -->
            <div class="detail-column">
              <section class="card-section action-section">
                <div class="section-head">
                  <span class="icon">⚖️</span>
                  <h3>Karar & Onay</h3>
                </div>
                <div class="action-body">
                  <div class="form-group">
                    <label>Üyelik Periyodu</label>
                    <select id="membership-period" class="modern-select">
                      <option value="monthly">Aylık</option>
                      <option value="yearly">Yıllık</option>
                    </select>
                  </div>
                  <div class="action-buttons">
                    <button class="btn-action action-approve" data-status="approved">✅ ${statusActionLabel(app.durum, 'approved')}</button>
                    <button class="btn-action action-pending" data-status="pending">⏳ ${statusActionLabel(app.durum, 'pending')}</button>
                    <button class="btn-action action-reject" data-status="rejected">❌ ${statusActionLabel(app.durum, 'rejected')}</button>
                  </div>
                </div>
              </section>

              <section class="card-section">
                <div class="section-head">
                  <span class="icon">📝</span>
                  <h3>Yönetim Notları</h3>
                </div>
                <div class="form-group">
                  <label>Sorumlu Admin E-posta</label>
                  <input id="assigned-admin-email" class="modern-input" placeholder="admin@spornerede.net" value="${app.sorumluAdminEmail || ''}" />
                </div>
                <div class="form-group">
                  <label>Admin Notu</label>
                  <textarea id="admin-note" class="modern-textarea" rows="3" placeholder="Gerekçe, eksik evrak, kontrol notu...">${app.adminNotu || ''}</textarea>
                </div>
                <button id="save-note-btn" class="btn btn-dark w-full" type="button">Notları Kaydet</button>
              </section>

              <section class="card-section border-green">
                <div class="section-head">
                  <span class="icon">👤</span>
                  <h3>Sorumlu Kişi Hesabı</h3>
                </div>
                <p class="section-help text-sm">Kulüp adına panele giriş yapacak yönetici hesabı.</p>
                <div class="form-group">
                  <label>Hesap E-posta</label>
                  <input id="provision-email" class="modern-input" type="email" value="${app.email || ''}" />
                </div>
                <div class="form-group">
                  <label>Geçici Şifre</label>
                  <div class="password-input-group">
                    <input id="provision-password" class="modern-input" type="text" value="${draftProvisionPasswords.get(appId) || ''}" placeholder="Şifre" />
                    <button id="generate-password-btn" class="btn btn-outline-sm" type="button">Üret</button>
                  </div>
                </div>
                <button id="provision-user-btn" class="btn btn-success w-full mt-2" type="button">Hesabı Oluştur / Güncelle</button>
              </section>

              <section class="card-section">
                <div class="section-head">
                  <span class="icon">⏱️</span>
                  <h3>İşlem Geçmişi</h3>
                </div>
                <div id="admin-log-timeline" class="log-timeline-container"><div class="spinner-small"></div></div>
              </section>
            </div>
          </div>
        `;

        const renderLogTimeline = async () => {
          const logEl = document.getElementById('admin-log-timeline');
          if (!logEl) return;
          try {
            const logs = await apiGet(`/api/admin/applications?logsForId=${appId}`);
            if (!logs.length) {
              logEl.innerHTML = '<div class="empty-hint text-center py-4">Henüz işlem geçmişi yok.</div>';
              return;
            }
            logEl.innerHTML = `
              <ul class="timeline">
                ${logs
                  .map((log) => {
                    const timeLine = formatLogDateTime(log.createdAt);
                    const title = escapeHtml(logActionTitle(log.action));
                    const actor = log.actorEmail ? escapeHtml(log.actorEmail) : 'Sistem';
                    return `
                    <li class="timeline-item">
                      <div class="timeline-marker"></div>
                      <div class="timeline-content">
                        <div class="timeline-head">
                          <span class="timeline-title">${title}</span>
                          <span class="timeline-time">${timeLine}</span>
                        </div>
                        <div class="timeline-actor">👤 ${actor}</div>
                        ${log.note ? `<div class="timeline-note">${escapeHtml(log.note)}</div>` : ''}
                      </div>
                    </li>`;
                  })
                  .join('')}
              </ul>
            `;
          } catch {
            logEl.innerHTML = '<div class="error-text">Geçmiş yüklenemedi.</div>';
          }
        };
        await renderLogTimeline();

        // Event Listeners for Buttons
        detailEl.querySelectorAll('.btn-action').forEach((button) => {
          button.addEventListener('click', async () => {
            const nextStatus = button.getAttribute('data-status');
            if (!nextStatus) return;
            const adminNote = document.getElementById('admin-note')?.value || '';
            const assignedAdminEmail = document.getElementById('assigned-admin-email')?.value?.trim() || '';
            const membershipPeriod = document.getElementById('membership-period')?.value === 'yearly' ? 'yearly' : 'monthly';
            try {
              button.classList.add('loading');
              await apiPost('/api/admin/applications', {
                id: appId,
                status: nextStatus,
                adminNote,
                assignedAdminEmail,
                membershipPeriod,
              });
              await loadApplications();
              await renderDetail(appId);
            } catch (error) {
              button.classList.remove('loading');
              alert(error.message);
            }
          });
        });

        const saveNoteBtn = document.getElementById('save-note-btn');
        saveNoteBtn?.addEventListener('click', async () => {
          const adminNote = document.getElementById('admin-note')?.value || '';
          const assignedAdminEmail = document.getElementById('assigned-admin-email')?.value?.trim() || '';
          try {
            saveNoteBtn.textContent = 'Kaydediliyor...';
            await apiPost('/api/admin/applications', {
              id: appId,
              status: app.durum,
              adminNote,
              assignedAdminEmail,
            });
            await renderDetail(appId);
          } catch (error) {
            saveNoteBtn.textContent = 'Notları Kaydet';
            alert(error.message);
          }
        });

        const uploadDocBtn = document.getElementById('upload-doc-btn');
        uploadDocBtn?.addEventListener('click', async () => {
          const fileInput = document.getElementById('doc-file');
          if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.length) {
            alert('Lütfen bir PDF dosyası seçin.');
            return;
          }
          const file = fileInput.files[0];
          const looksLikePdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
          if (!looksLikePdf) {
            alert('Yalnızca PDF dekont yükleyebilirsiniz.');
            return;
          }

          try {
            uploadDocBtn.textContent = 'Yükleniyor...';
            const formData = new FormData();
            formData.append('applicationId', String(appId));
            formData.append('document', file);

            const response = await fetch('/api/admin/application-documents-upload', {
              method: 'POST',
              body: formData,
            });
            if (!response.ok) {
              const payload = await response.json().catch(() => ({}));
              throw new Error(payload.error || `Request failed (${response.status})`);
            }
            await renderDetail(appId);
          } catch (error) {
            uploadDocBtn.textContent = 'Yükle';
            alert(error.message);
          }
        });

        const provisionBtn = document.getElementById('provision-user-btn');
        const generatePasswordBtn = document.getElementById('generate-password-btn');
        const provisionPasswordInput = document.getElementById('provision-password');

        provisionPasswordInput?.addEventListener('input', () => {
          draftProvisionPasswords.set(appId, provisionPasswordInput.value);
        });

        generatePasswordBtn?.addEventListener('click', () => {
          const nextPassword = generateTemporaryPassword();
          if (provisionPasswordInput) {
            provisionPasswordInput.value = nextPassword;
          }
          draftProvisionPasswords.set(appId, nextPassword);
        });

        provisionBtn?.addEventListener('click', async () => {
          const email = document.getElementById('provision-email')?.value?.trim() || '';
          const password = document.getElementById('provision-password')?.value || '';
          const membershipRole = 'owner';
          if (!email || !password) {
            alert('E-posta ve geçici şifre zorunlu.');
            return;
          }
          try {
            provisionBtn.textContent = 'İşleniyor...';
            const result = await apiPost('/api/admin/provision-club-user', {
              clubId: appId,
              email,
              password,
              membershipRole,
            });
            alert(`Hesap başarıyla oluşturuldu/güncellendi.\nE-posta: ${result.email}`);
            provisionBtn.textContent = 'Hesabı Oluştur / Güncelle';
          } catch (error) {
            provisionBtn.textContent = 'Hesabı Oluştur / Güncelle';
            alert(error.message);
          }
        });
      } catch (error) {
        renderDetailError(error.message);
      }
    }

    async function loadApplications() {
      if (!listEl) return;
      listEl.innerHTML = '<li class="loading-state"><div class="spinner-small"></div> Yükleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/applications');
        cachedApps = rows || [];
        updateNotificationBadges();
        if (!selectedAppId && cachedApps.length) {
          selectedAppId = cachedApps[0].id;
        }
        renderList();
        if (selectedAppId) {
          await renderDetail(selectedAppId);
        }
      } catch (error) {
        listEl.innerHTML = `<li class="error-state">${error.message}</li>`;
        if (detailEl) {
          detailEl.innerHTML = '<div class="error-state">Başvuru listesi yüklenemedi.</div>';
        }
      }
    }

    async function loadContactMessages() {
      if (!contactListEl) return;
      contactListEl.innerHTML = '<li class="loading-state"><div class="spinner-small"></div> Yükleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/contact-messages');
        cachedContactMessages = rows || [];
        updateNotificationBadges();
        if (selectedContactMessageId && !cachedContactMessages.some((message) => message.id === selectedContactMessageId)) {
          selectedContactMessageId = 0;
        }
        renderContactMessagesList();
        if (selectedContactMessageId) {
          await renderContactMessageDetail(selectedContactMessageId);
        }
      } catch (error) {
        contactListEl.innerHTML = `<li class="error-state">${error.message}</li>`;
        if (contactDetailEl) {
          contactDetailEl.innerHTML = '<div class="error-state">İletişim mesajları yüklenemedi.</div>';
        }
      }
    }

    function getFilteredFeedbacks() {
      const query = feedbackSearch?.value?.trim()?.toLowerCase() || '';
      const filter = feedbackFilter?.value || 'all';
      return cachedFeedbacks.filter((item) => {
        if (filter !== 'all' && item.durum !== filter) return false;
        if (!query) return true;
        const haystack = `${item.mesaj || ''} ${item.kullaniciLegacyId || ''}`.toLowerCase();
        return haystack.includes(query);
      });
    }

    function renderFeedbacksList() {
      if (!feedbacksListEl) return;
      const filtered = getFilteredFeedbacks();
      if (!filtered.length) {
        feedbacksListEl.innerHTML = '<li class="empty-list">Geribildirim bulunamadı.</li>';
        return;
      }

      feedbacksListEl.innerHTML = filtered
        .map((feedback) => {
          const activeClass = feedback.id === selectedFeedbackId ? 'is-active' : '';
          const unreadClass = feedback.durum === 'yeni' ? 'is-unread' : '';
          
          let badgeHtml = '';
          if (feedback.durum === 'yeni') badgeHtml = '<span class="status-badge status-pending">Yeni</span>';
          else if (feedback.durum === 'incelendi') badgeHtml = '<span class="status-badge status-approved" style="background:#e0f2fe;color:#1e40af;border-color:#bae6fd;">İncelendi</span>';
          else badgeHtml = '<span class="status-badge status-rejected">Kapandı</span>';

          return `<li>
            <button class="list-item contact-list-item ${activeClass} ${unreadClass}" data-feedback-id="${feedback.id}">
              <div class="item-main">
                <span class="item-title">Kullanıcı: #${feedback.kullaniciLegacyId}</span>
                <span class="item-meta">${formatDate(feedback.createdAt)}</span>
              </div>
              <div class="item-side">${badgeHtml}</div>
            </button>
          </li>`;
        })
        .join('');
    }

    function renderFeedbackDetailLoading() {
      if (!feedbackDetailEl) return;
      feedbackDetailEl.innerHTML = '<div class="loading-state"><div class="spinner"></div><p>Geribildirim yükleniyor...</p></div>';
    }

    async function renderFeedbackDetail(feedbackId) {
      selectedFeedbackId = feedbackId;
      renderFeedbacksList();
      renderFeedbackDetailLoading();
      try {
        const feedback = cachedFeedbacks.find((f) => f.id === feedbackId);
        if (!feedback) throw new Error('Bulunamadı');

        if (feedback.durum === 'yeni') {
          await apiPost('/api/admin/feedbacks', { id: feedbackId, durum: 'incelendi' });
          feedback.durum = 'incelendi';
          updateNotificationBadges();
          renderFeedbacksList();
        }

        if (!feedbackDetailEl) return;
        
        const isKapandi = feedback.durum === 'kapandi';

        feedbackDetailEl.innerHTML = `
          <div class="detail-header">
            <div class="detail-title-area">
              <span class="kicker">GERİBİLDİRİM #${feedback.id}</span>
              <h2>Kullanıcı #${feedback.kullaniciLegacyId}</h2>
            </div>
            <div class="detail-status">
              ${isKapandi ? '<span class="status-badge status-rejected">Kapandı</span>' : '<span class="status-badge status-approved" style="background:#e0f2fe;color:#1e40af;border-color:#bae6fd;">İncelendi</span>'}
            </div>
          </div>

          <div class="detail-grid detail-grid--single">
            <section class="card-section">
              <div class="section-head">
                <span class="icon">💬</span>
                <h3>Geribildirim İçeriği</h3>
              </div>
              <div class="info-list">
                <div class="info-item">
                  <span class="label">Gönderim Tarihi</span>
                  <span class="value">${formatDate(feedback.createdAt)}</span>
                </div>
                <div class="info-item">
                  <span class="label">Mesaj</span>
                  <span class="value text-box">${escapeHtml(feedback.mesaj || '-')}</span>
                </div>
              </div>
            </section>
          </div>

          <div class="contact-actions" style="margin-top:2rem;">
            ${!isKapandi 
              ? `<button id="close-feedback-btn" class="btn btn-outline" type="button">Kapatıldı Olarak İşaretle</button>` 
              : `<button id="reopen-feedback-btn" class="btn btn-outline" type="button">Yeniden Aç (İncelendi)</button>`}
          </div>
        `;

        document.getElementById('close-feedback-btn')?.addEventListener('click', async () => {
          await apiPost('/api/admin/feedbacks', { id: feedbackId, durum: 'kapandi' });
          feedback.durum = 'kapandi';
          updateNotificationBadges();
          renderFeedbackDetail(feedbackId);
        });

        document.getElementById('reopen-feedback-btn')?.addEventListener('click', async () => {
          await apiPost('/api/admin/feedbacks', { id: feedbackId, durum: 'incelendi' });
          feedback.durum = 'incelendi';
          updateNotificationBadges();
          renderFeedbackDetail(feedbackId);
        });

      } catch (error) {
        renderDetailError(error.message);
      }
    }

    async function loadFeedbacks() {
      if (!feedbacksListEl) return;
      feedbacksListEl.innerHTML = '<li class="loading-state"><div class="spinner-small"></div> Yükleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/feedbacks');
        cachedFeedbacks = rows || [];
        updateNotificationBadges();
        if (selectedFeedbackId && !cachedFeedbacks.some((f) => f.id === selectedFeedbackId)) {
          selectedFeedbackId = 0;
        }
        renderFeedbacksList();
        if (selectedFeedbackId) {
          await renderFeedbackDetail(selectedFeedbackId);
        }
      } catch (error) {
        feedbacksListEl.innerHTML = `<li class="error-state">${error.message}</li>`;
        if (feedbackDetailEl) {
          feedbackDetailEl.innerHTML = '<div class="error-state">Geribildirimler yüklenemedi.</div>';
        }
      }
    }

    function getFilteredClubs() {
      const query = clubSearchInput?.value?.trim()?.toLowerCase() || '';
      return cachedClubs.filter((item) => {
        if (!query) return true;
        const haystack = `${item.ad || ''} ${item.il || ''} ${item.ilce || ''}`.toLowerCase();
        return haystack.includes(query);
      });
    }

    function renderClubsList() {
      if (!clubsListEl) return;
      const filtered = getFilteredClubs();
      if (!filtered.length) {
        clubsListEl.innerHTML = '<li class="empty-list">Kulüp bulunamadı.</li>';
        return;
      }
      clubsListEl.innerHTML = filtered
        .map((club) => {
          const activeClass = club.id === selectedClubId ? 'is-active' : '';
          return `<li>
            <button class="list-item ${activeClass}" data-club-id="${club.id}">
              <div class="item-main">
                <span class="item-title">${club.ad}</span>
                <span class="item-meta">📍 ${club.il || '-'} / ${club.ilce || '-'}</span>
              </div>
            </button>
          </li>`;
        })
        .join('');
    }

    function renderClubDetailLoading() {
      if (!clubDetailEl) return;
      clubDetailEl.innerHTML = '<div class="loading-state"><div class="spinner"></div><p>Detay yükleniyor...</p></div>';
    }

    function renderClubPrograms(programs) {
      if (!programs.length) {
        return '<div class="empty-hint">Kulübe ait ilan/program bulunmuyor.</div>';
      }
      return `<div class="admin-program-editor-list">
        ${programs
          .map(
            (program) => `<article class="admin-program-editor" data-program-editor="${program.id}">
              <div class="program-editor-head">
                <div>
                  <span class="kicker">PROGRAM #${program.id}</span>
                  <strong>${escapeHtml(program.ad || '-')}</strong>
                </div>
                ${program.aktif ? '<span class="status-badge status-approved">Aktif</span>' : '<span class="status-badge status-rejected">Pasif</span>'}
              </div>
              <div class="form-layout">
                <div class="form-group">
                  <label>Program / Kurs Adı</label>
                  <input class="modern-input" data-program-field="ad" type="text" value="${escapeHtml(program.ad || '')}" />
                </div>
                <div class="form-row-2">
                  <div class="form-group">
                    <label>Gün / Saat</label>
                    <input class="modern-input" data-program-field="gunSaat" type="text" value="${escapeHtml(program.gunSaat || '')}" />
                  </div>
                  <div class="form-group">
                    <label>Seviye</label>
                    <input class="modern-input" data-program-field="seviye" type="text" value="${escapeHtml(program.seviye || '')}" />
                  </div>
                </div>
                <div class="form-row-2">
                  <div class="form-group">
                    <label>Ücret Bilgisi</label>
                    <input class="modern-input" data-program-field="ucretBilgisi" type="text" value="${escapeHtml(program.ucretBilgisi || '')}" />
                  </div>
                  <label class="program-active-toggle">
                    <input data-program-field="aktif" type="checkbox" ${program.aktif ? 'checked' : ''} />
                    <span>Yayında / Aktif</span>
                  </label>
                </div>
                <div class="form-group">
                  <label>Açıklama</label>
                  <textarea class="modern-textarea" data-program-field="aciklama" rows="3">${escapeHtml(program.aciklama || '')}</textarea>
                </div>
                <div class="program-editor-actions">
                  <button class="btn btn-primary save-program-btn" data-program-id="${program.id}" type="button">Programı Kaydet</button>
                  <button class="btn btn-danger delete-program-btn" data-program-id="${program.id}" type="button">Programı Sil</button>
                </div>
              </div>
            </article>`
          )
          .join('')}
      </div>`;
    }

    async function renderClubDetail(clubId) {
      selectedClubId = clubId;
      renderClubsList();
      renderClubDetailLoading();
      try {
        const club = await apiGet(`/api/admin/clubs?id=${clubId}`);
        if (!clubDetailEl) return;
        clubDetailEl.innerHTML = `
          <div class="detail-header">
            <div class="detail-title-area">
              <span class="kicker">ONAYLI KULÜP PROFİLİ</span>
              <h2>${club.ad}</h2>
            </div>
            <div class="detail-status">
              <span class="status-badge status-approved">Sistemde Aktif</span>
            </div>
          </div>

          <div class="detail-grid">
            <div class="detail-column">
              <section class="card-section">
                <div class="section-head">
                  <span class="icon">✏️</span>
                  <h3>Kulüp Bilgilerini Düzenle</h3>
                </div>
                <div class="form-layout">
                  <div class="form-group">
                    <label>Kulüp Adı</label>
                    <input id="club-ad" class="modern-input" type="text" value="${club.ad || ''}" />
                  </div>
                  <div class="form-row-2">
                    <div class="form-group">
                      <label>Telefon</label>
                      <input id="club-telefon" class="modern-input" type="text" value="${club.telefon || ''}" />
                    </div>
                    <div class="form-group">
                      <label>E-posta</label>
                      <input id="club-email" class="modern-input" type="email" value="${club.email || ''}" />
                    </div>
                  </div>
                  <div class="form-row-2">
                    <div class="form-group">
                      <label>Yaş Aralığı</label>
                      <input id="club-yas-araligi" class="modern-input" type="text" value="${club.yasAraligi || ''}" placeholder="Örn: 5-15" />
                    </div>
                    <div class="form-group">
                      <label>Fiyat Bilgisi</label>
                      <input id="club-fiyat-bilgisi" class="modern-input" type="text" value="${club.fiyatBilgisi || ''}" placeholder="Aylık 1500 TL vs." />
                    </div>
                  </div>
                  <div class="form-group">
                    <label>Tam Adres</label>
                    <textarea id="club-adres" class="modern-textarea" rows="2">${club.adres || ''}</textarea>
                  </div>
                  <div class="form-group">
                    <label>Hakkımızda / Açıklama</label>
                    <textarea id="club-aciklama" class="modern-textarea" rows="4">${club.aciklama || ''}</textarea>
                  </div>
                  <button id="save-club-btn" class="btn btn-primary w-full" type="button">Değişiklikleri Kaydet</button>
                </div>
              </section>
            </div>

            <div class="detail-column">
              <section class="card-section">
                <div class="section-head">
                  <span class="icon">📋</span>
                  <h3>Yayınlanan İlanlar / Kurslar</h3>
                </div>
                <p class="section-help text-sm mb-4">Kulübün panelden eklediği ve vitrinde görünen programları.</p>
                ${renderClubPrograms(club.programs || [])}
              </section>
            </div>
          </div>
        `;

        const saveBtn = document.getElementById('save-club-btn');
        saveBtn?.addEventListener('click', async () => {
          try {
            saveBtn.textContent = 'Kaydediliyor...';
            await apiPost('/api/admin/clubs', {
              id: clubId,
              ad: document.getElementById('club-ad')?.value || '',
              telefon: document.getElementById('club-telefon')?.value || '',
              email: document.getElementById('club-email')?.value || '',
              yasAraligi: document.getElementById('club-yas-araligi')?.value || '',
              fiyatBilgisi: document.getElementById('club-fiyat-bilgisi')?.value || '',
              adres: document.getElementById('club-adres')?.value || '',
              aciklama: document.getElementById('club-aciklama')?.value || '',
            });
            await loadClubs();
            await renderClubDetail(clubId);
          } catch (error) {
            saveBtn.textContent = 'Değişiklikleri Kaydet';
            alert(error.message);
          }
        });

        clubDetailEl.querySelectorAll('.save-program-btn').forEach((button) => {
          button.addEventListener('click', async () => {
            const programId = Number(button.getAttribute('data-program-id'));
            const editor = button.closest('[data-program-editor]');
            if (!programId || !(editor instanceof HTMLElement)) return;
            const fieldValue = (name) => editor.querySelector(`[data-program-field="${name}"]`)?.value || '';
            const activeInput = editor.querySelector('[data-program-field="aktif"]');
            try {
              button.textContent = 'Kaydediliyor...';
              await apiPut('/api/admin/clubs', {
                clubId,
                programId,
                ad: fieldValue('ad'),
                gunSaat: fieldValue('gunSaat'),
                seviye: fieldValue('seviye'),
                ucretBilgisi: fieldValue('ucretBilgisi'),
                aciklama: fieldValue('aciklama'),
                aktif: activeInput instanceof HTMLInputElement ? activeInput.checked : true,
              });
              await renderClubDetail(clubId);
            } catch (error) {
              button.textContent = 'Programı Kaydet';
              alert(error.message);
            }
          });
        });

        clubDetailEl.querySelectorAll('.delete-program-btn').forEach((button) => {
          button.addEventListener('click', async () => {
            const programId = Number(button.getAttribute('data-program-id'));
            if (!programId) return;
            const confirmed = confirm('Bu programı kalıcı olarak silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');
            if (!confirmed) return;
            try {
              button.textContent = 'Siliniyor...';
              await apiDelete('/api/admin/clubs', { clubId, programId });
              await renderClubDetail(clubId);
            } catch (error) {
              button.textContent = 'Programı Sil';
              alert(error.message);
            }
          });
        });
      } catch (error) {
        renderDetailError(error.message);
      }
    }

    async function loadClubs() {
      if (!clubsListEl) return;
      clubsListEl.innerHTML = '<li class="loading-state"><div class="spinner-small"></div> Yükleniyor...</li>';
      try {
        const rows = await apiGet('/api/admin/clubs');
        cachedClubs = rows || [];
        if (!selectedClubId && cachedClubs.length) {
          selectedClubId = cachedClubs[0].id;
        }
        renderClubsList();
        if (selectedClubId) {
          await renderClubDetail(selectedClubId);
        }
      } catch (error) {
        clubsListEl.innerHTML = `<li class="error-state">${error.message}</li>`;
        if (clubDetailEl) {
          clubDetailEl.innerHTML = '<div class="error-state">Kulüp listesi yüklenemedi.</div>';
        }
      }
    }

    listEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-id]');
      if (!button) return;
      const id = Number(button.getAttribute('data-id'));
      if (!id) return;
      await renderDetail(id);
    });

    clubsListEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-club-id]');
      if (!button) return;
      const id = Number(button.getAttribute('data-club-id'));
      if (!id) return;
      await renderClubDetail(id);
    });

    contactListEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-contact-id]');
      if (!button) return;
      const id = Number(button.getAttribute('data-contact-id'));
      if (!id) return;
      await renderContactMessageDetail(id);
    });

    feedbacksListEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-feedback-id]');
      if (!button) return;
      const id = Number(button.getAttribute('data-feedback-id'));
      if (!id) return;
      await renderFeedbackDetail(id);
    });

    tabButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        const tabKey = button.getAttribute('data-tab-target') || 'applications';
        switchTab(tabKey);
        if (tabKey === 'clubs' && !cachedClubs.length) {
          await loadClubs();
        }
        if (tabKey === 'contact' && !cachedContactMessages.length) {
          await loadContactMessages();
        }
        if (tabKey === 'feedback' && !cachedFeedbacks.length) {
          await loadFeedbacks();
        }
      });
    });

    loadButton?.addEventListener('click', async () => {
      await loadApplications();
    });

    loadClubsButton?.addEventListener('click', async () => {
      await loadClubs();
    });

    loadContactButton?.addEventListener('click', async () => {
      await loadContactMessages();
    });

    loadFeedbacksButton?.addEventListener('click', async () => {
      await loadFeedbacks();
    });

    searchInput?.addEventListener('input', () => {
      renderList();
    });

    clubSearchInput?.addEventListener('input', () => {
      renderClubsList();
    });

    contactSearchInput?.addEventListener('input', () => {
      renderContactMessagesList();
    });

    feedbackSearch?.addEventListener('input', () => {
      renderFeedbacksList();
    });

    statusFilter?.addEventListener('change', () => {
      renderList();
    });

    contactFilter?.addEventListener('change', () => {
      renderContactMessagesList();
    });

    feedbackFilter?.addEventListener('change', () => {
      renderFeedbacksList();
    });

    // Init
    switchTab('applications');
    loadApplications().catch((error) => {
      if (listEl) {
        listEl.innerHTML = `<li class="error-state">${error?.message || 'Başvurular yüklenemedi.'}</li>`;
      }
    });
    loadContactMessages().catch(() => undefined);
    loadFeedbacks().catch(() => undefined);
  </script>

