---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedGuides } from '../../lib/repositories/seoArticles';

export const prerender = false;

const guides = await getPublishedGuides();
---

<BaseLayout
  title="Spor Rehberleri"
  description="Spor branslari, kurs secimi ve sehir bazli rehberler — SporNerede.net"
  keywords="spor rehberi, kurs rehberi, cocuk sporu, brans secimi"
  breadcrumbs={[
    { name: 'Ana Sayfa', url: 'https://spornerede.net/' },
    { name: 'Rehber', url: 'https://spornerede.net/rehber' },
  ]}
>
  <section class="news-page section">
    <div class="container news-container">
      <div class="news-head">
        <div>
          <p class="news-eyebrow">Bilgi & rehber</p>
          <h1 class="section-title">
            Spor <span class="title-underline">Rehberleri</span>
          </h1>
          <p class="section-subtitle">
            Brans secimi, kurs onerileri ve veli rehberleri. Yakininizdaki kulup ve kurslar icin arama yapin.
          </p>
        </div>
        <div class="news-head-card">
          <span>Yayinda</span>
          <strong>{guides.length} rehber</strong>
        </div>
      </div>

      {guides.length === 0 ? (
        <p class="section-subtitle">Henuz yayinlanmis rehber yok. Yakinda eklenecek.</p>
      ) : (
        <div class="news-grid">
          {guides.map((guide) => (
            <article class="news-card">
              <span class="badge badge-blue">Rehber</span>
              <h2><a href={`/rehber/${guide.slug}`}>{guide.baslik}</a></h2>
              <p>{guide.metaDescription}</p>
              {guide.yayinlanmaLabel && (
                <time datetime={guide.yayinlanmaTarihi}>{guide.yayinlanmaLabel}</time>
              )}
              <a href={`/rehber/${guide.slug}`} class="news-link">Oku →</a>
            </article>
          ))}
        </div>
      )}

      <p class="rehber-cta">
        <a class="btn btn-primary" href="/ara">Yakinindaki kurslari ara</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .news-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    margin-top: 2rem;
  }
  .news-card {
    border: 1px solid var(--color-border, #e8e8e8);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .news-card h2 {
    font-size: 1.15rem;
    margin: 0;
  }
  .news-card h2 a {
    color: inherit;
    text-decoration: none;
  }
  .news-card h2 a:hover {
    color: var(--color-primary, #e11d48);
  }
  .rehber-cta {
    margin-top: 2.5rem;
    text-align: center;
  }
</style>
