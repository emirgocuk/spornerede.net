---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleDetail from '../../components/ArticleDetail.astro';
import { getPublishedGuideBySlug, getPublishedGuides } from '../../lib/repositories/seoArticles';
import { articleGuideSchema, faqPageSchema } from '../../lib/seo/jsonld';

export const prerender = false;

const slug = String(Astro.params.slug ?? '').trim();
const guide = await getPublishedGuideBySlug(slug);

if (!guide) {
  Astro.response.status = 404;
}

const all = await getPublishedGuides();
const related = all.filter((g) => g.slug !== slug).slice(0, 4);

const canonical = `https://spornerede.net/rehber/${slug}`;
const pageTitle = guide?.metaTitle || 'Rehber Bulunamadi';
const pageDescription = guide?.metaDescription || 'Aradiginiz rehber bulunamadi.';

const jsonLdNodes = guide
  ? [
      articleGuideSchema({
        headline: guide.metaTitle,
        description: guide.metaDescription,
        datePublished: guide.yayinlanmaTarihi || new Date().toISOString(),
        url: canonical,
        schemaType: guide.semaTipi === 'HowTo' ? 'HowTo' : 'Article',
      }),
      ...(guide.faq.length > 0
        ? [
            faqPageSchema(
              guide.faq.map((item) => ({ question: item.soru, answer: item.cevap })),
            ),
          ]
        : []),
    ]
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogType="article"
  keywords="spor rehberi, kurs secimi, spor kursu"
  breadcrumbs={[
    { name: 'Ana Sayfa', url: 'https://spornerede.net/' },
    { name: 'Rehber', url: 'https://spornerede.net/rehber' },
    ...(guide ? [{ name: guide.baslik, url: canonical }] : []),
  ]}
  jsonLd={jsonLdNodes}
>
  {guide ? (
    <ArticleDetail
      breadcrumbs={[
        { label: 'Ana Sayfa', href: '/' },
        { label: 'Rehber', href: '/rehber' },
        { label: guide.baslik },
      ]}
      badgeLabel="Rehber"
      badgeClass="article-badge-blue"
      dateLabel={guide.yayinlanmaLabel}
      dateIso={guide.yayinlanmaTarihi}
      title={guide.baslik}
      lead={guide.metaDescription}
    >
      <div set:html={guide.icerikHtml} />

      <div slot="footer">
        {guide.faq.length > 0 && (
          <section class="article-faq" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Sikca sorulan sorular</h2>
            {guide.faq.map((item) => (
              <div class="article-faq-item">
                <h3>{item.soru}</h3>
                <p>{item.cevap}</p>
              </div>
            ))}
          </section>
        )}
        <div class="article-cta-band">
          <a class="btn btn-primary" href="/ara">Bu bransta yakinindaki kurslari bul</a>
        </div>
      </div>

      {related.length > 0 && (
        <div slot="aside">
          <h2>Diger rehberler</h2>
          <div class="article-related-grid">
            {related.map((item) => (
              <a class="article-related-card" href={`/rehber/${item.slug}`}>
                <strong>{item.baslik}</strong>
                <span>{item.metaDescription}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </ArticleDetail>
  ) : (
    <section class="article-page section">
      <div class="container article-page-container">
        <div class="article-empty">
          <h1>Rehber bulunamadi</h1>
          <p>Aradiginiz icerik kaldirilmis veya adres hatali olabilir.</p>
          <a class="btn btn-primary" href="/rehber">Rehberlere don</a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
