---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleDetail from '../../components/ArticleDetail.astro';
import InternalLinksHub from '../../components/InternalLinksHub.astro';
import { getActiveNews, getActiveNewsBySlug } from '../../lib/repositories/news';
import { getPublishedGuides } from '../../lib/repositories/seoArticles';
import { buildAraSearchFromNews, pickGuidesForNews } from '../../lib/seo/internalLinks';
import { newsArticleSchema } from '../../lib/seo/jsonld';

export const prerender = false;

const slug = String(Astro.params.slug ?? '').trim();
const haber = await getActiveNewsBySlug(slug);

if (!haber) {
  Astro.response.status = 404;
}

const allNews = await getActiveNews();
const relatedNews = allNews.filter((item) => item.slug !== slug).slice(0, 4);

const publishedGuides = haber ? await getPublishedGuides() : [];
const relatedGuides = haber ? pickGuidesForNews(haber, publishedGuides, 3) : [];
const araSearch = haber ? buildAraSearchFromNews(haber) : null;

const pageTitle = haber?.seoTitle || haber?.baslik || 'Haber Bulunamadi';
const pageDescription = haber?.seoDescription || 'Aradiginiz haber bulunamadi.';
const canonical = `https://spornerede.net/haberler/${slug}`;

const badgeClass = `article-badge-${haber?.kategoriRenk || 'gray'}`;

const articleSchema = haber
  ? newsArticleSchema({
      headline: haber.seoTitle || haber.baslik,
      description: haber.seoDescription,
      datePublished: haber.tarihIso || new Date().toISOString(),
      url: canonical,
    })
  : null;

const breadcrumbs = haber
  ? [
      { name: 'Ana Sayfa', url: 'https://spornerede.net/' },
      { name: 'Haberler', url: 'https://spornerede.net/haberler' },
      { name: haber.baslik, url: canonical },
    ]
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords="spor haberleri, kulup duyurulari, spor etkinlikleri"
  ogType="article"
  breadcrumbs={breadcrumbs}
  jsonLd={articleSchema ?? undefined}
>
  {haber ? (
    <ArticleDetail
      breadcrumbs={[
        { label: 'Ana Sayfa', href: '/' },
        { label: 'Haberler', href: '/haberler' },
        { label: haber.baslik },
      ]}
      badgeLabel={haber.kategori}
      badgeClass={badgeClass}
      dateLabel={haber.tarih}
      dateIso={haber.tarihIso}
      title={haber.baslik}
      lead={haber.seoDescription}
    >
      <div set:html={haber.ozet} />

      <div slot="footer">
        {haber.link && haber.link !== '#' && (
          <p class="article-source-link">
            Kaynak:
            <a href={haber.link} target="_blank" rel="noopener noreferrer">{haber.link}</a>
          </p>
        )}
      </div>

      <div slot="aside">
        <InternalLinksHub
          title="Ilgili rehber ve kurs aramasi"
          araLink={
            araSearch
              ? {
                  href: araSearch.href,
                  title: araSearch.label,
                  description: 'Yakinindaki spor kurslarini listeleyin.',
                }
              : undefined
          }
          guideLinks={relatedGuides.map((g) => ({
            href: `/rehber/${g.slug}`,
            title: g.baslik,
            description: g.metaDescription,
          }))}
        />

        {relatedNews.length > 0 && (
          <>
            <h2>Diger haberler</h2>
            <div class="article-related-grid">
              {relatedNews.map((item) => (
                <a class="article-related-card" href={`/haberler/${item.slug}`}>
                  <span class={`article-badge article-badge-${item.kategoriRenk || 'gray'}`}>
                    {item.kategori}
                  </span>
                  <strong>{item.baslik}</strong>
                  <small>{item.tarih}</small>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    </ArticleDetail>
  ) : (
    <section class="article-page section">
      <div class="container article-page-container">
        <div class="article-empty">
          <h1>Haber bulunamadi</h1>
          <p>Bu icerik kaldirilmis veya URL hatali olabilir.</p>
          <a class="btn btn-primary" href="/haberler">Haberlere don</a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .article-source-link {
    margin: 0;
    font-size: 0.9rem;
    color: #4b5563;
  }
  .article-source-link a {
    margin-left: 0.35rem;
    color: #b5080f;
    word-break: break-all;
  }
  .article-aside :global(.internal-links-hub) {
    margin-bottom: 2rem;
  }
</style>
