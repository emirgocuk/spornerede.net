---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCityBranchLanding } from '../../../lib/repositories/catalog';

const ilSlug = Astro.params.il ?? '';
const bransSlug = Astro.params.brans ?? '';

const landing = await getCityBranchLanding(ilSlug, bransSlug);
if (!landing.city || !landing.branch) {
  return Astro.redirect('/ara');
}
---

<BaseLayout
  title={`${landing.city.ad} ${landing.branch.isim} Kurslari`}
  description={`${landing.city.ad} sehrinde ${landing.branch.isim.toLowerCase()} kurslari ve spor kuluplerini listeleyin.`}
  keywords={`${landing.city.slug} ${landing.branch.slug} kursu, ${landing.city.slug} spor kulubu`}
  canonical={`https://spornerede.net/sehirler/${landing.city.slug}/${landing.branch.slug}`}
>
  <section class="section seo-page">
    <div class="container">
      <h1>{landing.city.ad} {landing.branch.isim} Kurslari</h1>
      <p>{landing.clubs.length} kulup bulundu. Filtreli sonuclar icin arama sayfasina gecin.</p>
      <a class="btn btn-primary btn-sm" href={`/ara?il=${landing.city.slug}&brans=${landing.branch.slug}`}>Filtreli Sonuclari Ac</a>
    </div>
  </section>
</BaseLayout>

<style>
  .seo-page { min-height: 50vh; background: #F8F9FA; }
  .seo-page h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900; color: #212529; }
  .seo-page p { margin-top: .5rem; color: #6C757D; margin-bottom: 1rem; }
</style>

