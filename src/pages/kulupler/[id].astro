---
import AnalyticsPageEvent from '../../components/AnalyticsPageEvent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getClubById, getClubProgramsByClubId } from '../../lib/repositories/catalog';
import {
  sportsActivityLocationSchema,
  courseSchema,
  SITE_URL,
} from '../../lib/seo/jsonld';
import { extractIdFromSlug, clubSlug, listingSlug, isPureNumericSlug } from '../../lib/seo/slug';

// URL segmenti hem "42" hem "atakoy-spor-kulubu-42" olabilir.
const rawSlug = String(Astro.params.id ?? '').trim();
const id = extractIdFromSlug(rawSlug);
const club = id !== null ? await getClubById(id) : null;
if (!club) {
  return new Response(null, { status: 404 });
}

// Kanonik kulup slug
const expectedSlug = clubSlug({ id: club.id, ad: club.ad });

// Gelen slug pure-numeric veya yanlis ise 301
if (isPureNumericSlug(rawSlug) || rawSlug !== expectedSlug) {
  return Astro.redirect(`/kulupler/${expectedSlug}`, 301);
}

const programs = await getClubProgramsByClubId(club.id);

const canonicalUrl = `${SITE_URL}/kulupler/${expectedSlug}`;

// Yapisal veri: kulup -> SportsActivityLocation + LocalBusiness
// + her aktif program -> Course
const clubJsonLd = sportsActivityLocationSchema({
  clubId: club.id,
  name: club.ad,
  url: canonicalUrl,
  description: club.aciklama || `${club.ad} ${club.brans || 'spor'} branşında hizmet veren bir kuruluştur.`,
  branch: club.brans,
  emoji: club.emoji,
  telephone: club.telefon || undefined,
  address: club.adres || undefined,
  addressLocality: club.ilce || undefined,
  addressRegion: club.il || undefined,
  latitude: club.enlem || undefined,
  longitude: club.boylam || undefined,
  priceRange: club.fiyat || undefined,
});

const programCourses = programs
  .filter((p) => p.aktif)
  .map((program) =>
    courseSchema({
      url: `${SITE_URL}/ilanlar/${listingSlug({ id: program.id, ad: program.ad, clubAd: club.ad })}`,
      name: program.ad,
      description: program.aciklama || undefined,
      providerName: club.ad,
      providerUrl: canonicalUrl,
      branch: club.brans,
      level: program.seviye || undefined,
      price: program.ucretBilgisi || undefined,
      startDate: program.eventDate || undefined,
      endDate: program.endDate || undefined,
      isOngoing: program.isOngoing,
      locationText: program.locationText || club.ilce || club.il || undefined,
      latitude: club.enlem || undefined,
      longitude: club.boylam || undefined,
      image: program.gallery,
    })
  );

const breadcrumbs = [
  { name: 'Ana Sayfa', url: `${SITE_URL}/` },
  { name: 'Arama', url: `${SITE_URL}/ara` },
  ...(club.bransSlug
    ? [{ name: club.brans, url: `${SITE_URL}/branslar/${club.bransSlug}` }]
    : []),
  { name: club.ad, url: canonicalUrl },
];

const clubOgParams = new URLSearchParams({
  title: club.ad,
  kicker: club.brans || 'Spor kulübü',
  badge: club.ilce || club.il || '',
});
const clubOgImage = `${SITE_URL}/api/og.png?${clubOgParams.toString()}`;
import { cleanPhoneNumber, formatPhoneDisplay, formatPhoneTelLink } from '../../lib/phone';

const cleanedPhone = cleanPhoneNumber(club.telefon);
const formattedPhone = formatPhoneDisplay(club.telefon);
const whatsappText = encodeURIComponent(
  `Merhaba, SporNerede.net üzerinden "${club.ad}" kulübünüz hakkında bilgi almak istiyorum.`
);
const whatsappUrl = cleanedPhone ? `https://wa.me/${cleanedPhone}?text=${whatsappText}` : null;
const telUrl = formatPhoneTelLink(club.telefon);

const fullAddress = [club.adres, club.ilce, club.il]
  .filter(Boolean)
  .filter((v, i, a) => a.indexOf(v) === i)
  .join(', ');

const mapsQuery = encodeURIComponent([club.ad, fullAddress].filter(Boolean).join(', '));
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
---

<BaseLayout
  title={`${club.ad} | ${club.ilce || club.il}`}
  description={club.aciklama
    ? club.aciklama.slice(0, 160)
    : `${club.ad}, ${club.ilce || club.il} bölgesinde ${club.brans?.toLowerCase() || 'spor'} branşında hizmet veren spor kulübü. Aktif ilanları, iletişim ve temel bilgiler.`}
  keywords={`${club.bransSlug} kulubu turkiye, ${(club.ilce ?? '').toLowerCase()} spor kulubu, ${club.ad.toLowerCase()}`}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={clubOgImage}
  breadcrumbs={breadcrumbs}
  jsonLd={[clubJsonLd, ...programCourses]}
>
  <div class="page-wrap">
    <div class="page-container">

      <!-- Üst Navigasyon & Breadcrumb -->
      <div class="top-nav-bar">
        <Breadcrumb items={breadcrumbs.map((b) => ({ name: b.name, url: b.url }))} />
        <a href={`/ara?brans=${club.bransSlug || ''}`} class="back-link">
          <span class="arrow" aria-hidden="true">←</span>
          <span>{club.brans || 'Arama'} sonuçlarına dön</span>
        </a>
      </div>

      <!-- Hero Karşılama Kartı -->
      <header class="club-hero" style={`--accent-color: ${club.renk || '#E30A17'}`}>
        <div class="hero-ambient-glow" aria-hidden="true"></div>

        <div class="hero-header-content">
          <div class="hero-avatar-box">
            <span class="hero-emoji" aria-hidden="true">{club.emoji || '🏅'}</span>
          </div>

          <div class="hero-info">
            <div class="hero-badge-row">
              <span class="kicker-badge">{club.brans ? `${club.brans.toUpperCase()} KULÜBÜ` : 'SPOR KULÜBÜ'}</span>
              {club.oneCikan && (
                <span class="featured-badge">⭐ Öne Çıkan</span>
              )}
            </div>

            <h1 class="hero-title">{club.ad}</h1>

            <p class="hero-subtitle">
              <span class="location-pin" aria-hidden="true">📍</span>
              <strong>{club.ilce ? `${club.ilce}, ` : ''}{club.il || 'Türkiye'}</strong>
              <span class="sep" aria-hidden="true">•</span>
              <span>{club.yasAraligi ? `${club.yasAraligi}` : 'Tüm yaş grupları'}</span>
            </p>

            <div class="hero-chips">
              <div class="chip">
                <span class="chip-label">Branş:</span>
                <span class="chip-value">{club.brans || 'Spor'}</span>
              </div>
              <div class="chip">
                <span class="chip-label">Program:</span>
                <span class="chip-value">{programs.length} Aktif İlan</span>
              </div>
              {club.fiyat && (
                <div class="chip chip-price">
                  <span class="chip-label">Başlangıç:</span>
                  <span class="chip-value">{club.fiyat}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      </header>

      <!-- İki Kolonlu Profesyonel Düzen -->
      <div class="content-grid-layout">

        <!-- Sol Kolon: Tanıtım, İlanlar ve Lokasyon -->
        <main class="main-content-flow">

          <!-- 1. Kulüp Tanıtımı & Standartlar -->
          <section class="card-box">
            <div class="card-box-header">
              <div class="header-title-group">
                <span class="section-tag">Kurumsal Bilgi</span>
                <h2 class="card-box-title">Kulüp Tanıtımı & Standartlar</h2>
              </div>
              <span class="trust-badge-pill">🛡️ Doğrulanmış Profil</span>
            </div>

            <div class="about-text-content">
              {club.aciklama ? (
                <p class="about-paragraph">{club.aciklama}</p>
              ) : (
                <p class="about-paragraph">
                  <strong>{club.ad}</strong>, {club.ilce || club.il} bölgesinde {club.brans ? club.brans.toLowerCase() : 'spor'} branşında lisanslı ve düzenli eğitim faaliyetlerini yürüten onaylı bir spor kulübüdür. Sporcuların yaş ve seviyelerine göre özel olarak planlanan gruplarla, güvenli ve disiplinli bir antrenman ortamı sunmaktadır.
                </p>
              )}
            </div>

            <!-- 4 Avantaj Kartı -->
            <div class="features-highlight-grid">
              <div class="feature-tile">
                <div class="feature-icon">🏅</div>
                <div class="feature-text">
                  <h3>Lisanslı Eğitmenler</h3>
                  <p>Branşında deneyimli, pedagojik ve teknik donanımlı uzman antrenör kadrosu.</p>
                </div>
              </div>

              <div class="feature-tile">
                <div class="feature-icon">🛡️</div>
                <div class="feature-text">
                  <h3>Güvenli Tesis Ortamı</h3>
                  <p>Sporcu sağlığı ve güvenliği standartlarına uygun antrenman alanları.</p>
                </div>
              </div>

              <div class="feature-tile">
                <div class="feature-icon">🎯</div>
                <div class="feature-text">
                  <h3>Kademeli Gelişim</h3>
                  <p>Yaşa ve fiziksel yeterliliğe göre ayrılmış homojen çalışma grupları.</p>
                </div>
              </div>

              <div class="feature-tile">
                <div class="feature-icon">📍</div>
                <div class="feature-text">
                  <h3>Merkezi Lokasyon</h3>
                  <p>{club.ilce || club.il} bölgesinde kolay ulaşılabilir, toplu taşımaya yakın adres.</p>
                </div>
              </div>
            </div>
          </section>

          <!-- 2. Aktif Spor İlanları (Programlar) -->
          <section class="card-box" id="aktif-ilanlar">
            <div class="card-box-header">
              <div class="header-title-group">
                <span class="section-tag">Eğitimler</span>
                <h2 class="card-box-title">Aktif Spor Kursları & İlanlar</h2>
              </div>
              <span class="program-count-pill">{programs.length} Yayında</span>
            </div>

            {programs.length > 0 ? (
              <div class="programs-listing-stack">
                {programs.map((program) => (
                  <article class="program-listing-card">
                    <div class="program-card-top">
                      <div class="program-title-area">
                        <div class="program-title-badges">
                          <span class="live-pulse-badge">
                            <span class="pulse-dot"></span>
                            <span>{program.aktif ? 'Yayında' : 'Pasif'}</span>
                          </span>
                          <span class="branch-small-pill">{club.brans || 'Spor'}</span>
                        </div>
                        <h3 class="program-item-title">{program.ad}</h3>
                        <p class="program-item-sub">
                          <span>{club.ad}</span>
                          <span class="bullet">•</span>
                          <span>{club.ilce || club.il}</span>
                        </p>
                      </div>

                      <div class="program-price-tag">
                        <span class="price-val">{program.ucretBilgisi || 'Fiyat sorunuz'}</span>
                        <span class="price-sub">Aidat / Ücret</span>
                      </div>
                    </div>

                    <!-- Program Parametreleri -->
                    <div class="program-specs-grid">
                      <div class="spec-col">
                        <span class="spec-label">Yaş Grubu</span>
                        <strong class="spec-value">{program.yasAraligi || club.yasAraligi || 'Her Yaş'}</strong>
                      </div>
                      <div class="spec-col">
                        <span class="spec-label">Seviye</span>
                        <strong class="spec-value">{program.seviye || 'Tüm Seviyeler'}</strong>
                      </div>
                      <div class="spec-col">
                        <span class="spec-label">Ders Saatleri</span>
                        <strong class="spec-value">{program.gunSaat || 'Kulüpten Öğreniniz'}</strong>
                      </div>
                      <div class="spec-col">
                        <span class="spec-label">Konum</span>
                        <strong class="spec-value">{program.locationText || club.ilce || club.il}</strong>
                      </div>
                    </div>

                    {program.aciklama && (
                      <p class="program-card-summary">{program.aciklama}</p>
                    )}

                    <!-- Galeri Önizleme -->
                    {program.gallery && program.gallery.length > 0 && (
                      <div class="program-card-gallery">
                        <span class="gallery-label">Tesis Görselleri:</span>
                        <div class="mini-gallery-row">
                          {program.gallery.slice(0, 4).map((imgUrl, idx) => (
                            <button
                              type="button"
                              class="mini-gallery-thumb"
                              data-viewer-image={imgUrl}
                              aria-label={`Görseli büyüt ${idx + 1}`}
                            >
                              <img src={imgUrl} alt={`${club.ad} görsel`} loading="lazy" />
                            </button>
                          ))}
                          {program.gallery.length > 4 && (
                            <span class="more-photos-badge">+{program.gallery.length - 4}</span>
                          )}
                        </div>
                      </div>
                    )}

                    <!-- İlan Aksiyon Satırı -->
                    <div class="program-card-actions">
                      <a
                        href={`/ilanlar/${listingSlug({ id: program.id, ad: program.ad, clubAd: club.ad })}`}
                        class="btn-view-program"
                      >
                        <span>İlan Detayı ve Tesis Bilgilerini İncele</span>
                        <span class="arrow" aria-hidden="true">→</span>
                      </a>

                      {whatsappUrl && (
                        <a
                          href={whatsappUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-whatsapp-compact"
                          title="Bu ilan için WhatsApp ile bilgi alın"
                        >
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.23.9 2.43 1.03 2.6.13.16 1.78 2.71 4.3 3.8.6.26 1.07.41 1.44.53.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.3z" />
                          </svg>
                          <span>Hızlı Soru Sor</span>
                        </a>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="empty-programs-notice">
                <div class="empty-icon">📅</div>
                <div class="empty-content">
                  <h3>Aktif İlan Bulunmuyor</h3>
                  <p>Kulübün şu anda yayında olan bir dönem kursu bulunmamaktadır. Yeni dönem açılışları ve kontenjanlar için doğrudan kulüple iletişime geçebilirsiniz.</p>
                </div>
              </div>
            )}
          </section>

          <!-- 3. Tesis Konumu ve Yol Tarifi -->
          <section class="card-box" id="konum" data-club-lat={club.enlem || ''} data-club-lng={club.boylam || ''}>
            <div class="card-box-header">
              <div class="header-title-group">
                <span class="section-tag">Ulaşım & Harita</span>
                <h2 class="card-box-title">Tesis ve Salon Konumu</h2>
              </div>
              <span class="distance-output-badge distance-output">Mesafe hesaplanıyor...</span>
            </div>

            <div class="location-box-inner">
              <div class="address-display-row">
                <div class="pin-circle">📍</div>
                <div class="address-text-col">
                  <strong>{club.ad} Tesis Adresi</strong>
                  <p class="address-full">{fullAddress || 'Adres bilgisi için lütfen kulüple iletişime geçin.'}</p>
                </div>
              </div>

              <div class="location-actions-row">
                <a
                  href={googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-maps-action"
                >
                  <svg class="btn-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" />
                    <line x1="8" y1="2" x2="8" y2="18" />
                    <line x1="16" y1="6" x2="16" y2="22" />
                  </svg>
                  <span>Google Haritalar'da Aç & Yol Tarifi Al</span>
                </a>
              </div>
            </div>
          </section>

        </main>

        <!-- Sağ Kolon: Sticky İletişim Kartı & Kulüp Güvencesi -->
        <aside class="sidebar-flow">
          <div class="sticky-contact-card">

            <!-- İletişim Başlığı -->
            <div class="contact-card-head">
              <span class="contact-eyebrow">Doğrudan Kulüp İletişimi</span>
              <h3 class="contact-title">Kulüple İletişime Geçin</h3>
              <p class="contact-subtitle">Kontenjan, antrenman günleri ve deneme dersi için doğrudan kulüp yetkilisiyle görüşün.</p>
            </div>

            <!-- Aksiyon Butonları -->
            <div class="contact-actions-stack">
              {whatsappUrl && (
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-whatsapp-sidebar"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.23.9 2.43 1.03 2.6.13.16 1.78 2.71 4.3 3.8.6.26 1.07.41 1.44.53.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.3z" />
                  </svg>
                  <div class="btn-whatsapp-text">
                    <strong>WhatsApp ile Bilgi Al</strong>
                    <span>Hızlı mesaj gönderin</span>
                  </div>
                </a>
              )}

              {telUrl && (
                <a href={telUrl} class="btn-phone-sidebar">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                  <div class="btn-phone-text">
                    <strong>{formattedPhone}</strong>
                    <span>Telefonla hemen arayın</span>
                  </div>
                </a>
              )}
            </div>

            <!-- İletişim Detay Listesi -->
            <div class="contact-info-list">
              <div class="contact-row">
                <span class="row-label">Telefon:</span>
                <span class="row-val">
                  {telUrl ? <a href={telUrl} class="tel-link">{formattedPhone}</a> : 'Belirtilmedi'}
                </span>
              </div>

              {club.email && club.email !== 'Belirtilmedi' && (
                <div class="contact-row">
                  <span class="row-label">E-posta:</span>
                  <span class="row-val">
                    <a href={`mailto:${club.email}`} class="mail-link">{club.email}</a>
                  </span>
                </div>
              )}

              <div class="contact-row">
                <span class="row-label">Adres:</span>
                <span class="row-val">{fullAddress || 'İletişime geçiniz'}</span>
              </div>
            </div>

            <!-- Güvenlik & Doğrudan İletişim Notu -->
            <div class="trust-notice-box">
              <div class="trust-notice-item">
                <span class="trust-check">✓</span>
                <span><strong>%100 Komisyonsuz:</strong> Kulüple doğrudan iletişim kurar, aracısız kayıt olursunuz.</span>
              </div>
              <div class="trust-notice-item">
                <span class="trust-check">✓</span>
                <span><strong>Onaylı Kulüp:</strong> SporNerede güvencesiyle iletişim bilgileri teyit edilmiştir.</span>
              </div>
            </div>

          </div>
        </aside>

      </div>

    </div>
  </div>

  <!-- Büyütülmüş Görsel Viewer Modalı -->
  <div class="image-viewer" aria-hidden="true">
    <div class="image-viewer-backdrop" data-close-viewer></div>
    <div class="image-viewer-dialog" role="dialog" aria-modal="true" aria-label="Görsel görüntüleyici">
      <button type="button" class="image-viewer-close" data-close-viewer aria-label="Kapat">×</button>
      <img class="image-viewer-img" src="" alt="Büyütülmüş ilan görseli" />
    </div>
  </div>

  <AnalyticsPageEvent
    event="view_club"
    params={{ club_id: club.id, branch: club.bransSlug || club.brans || '', city: club.il || '' }}
  />
</BaseLayout>

<script is:inline>
  const card = document.querySelector('[data-club-lat]');
  if (card) {
    const lat = Number(card.getAttribute('data-club-lat'));
    const lng = Number(card.getAttribute('data-club-lng'));
    const outputs = Array.from(document.querySelectorAll('.distance-output'));
    const setOutput = (text) => outputs.forEach((node) => (node.textContent = text));
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
      setOutput('Konum bilgisi mevcut');
    } else if (!navigator.geolocation) {
      setOutput('Merkezi Konum');
    } else {
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const toRad = (value) => (value * Math.PI) / 180;
          const earthRadiusKm = 6371;
          const dLat = toRad(lat - pos.coords.latitude);
          const dLon = toRad(lng - pos.coords.longitude);
          const a =
            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(toRad(pos.coords.latitude)) * Math.cos(toRad(lat)) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
          const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
          const km = Math.round(earthRadiusKm * c * 10) / 10;
          setOutput(`📍 ~${km} km yakınınızda`);
        },
        () => setOutput('📍 Haritada İnceleyin')
      );
    }
  }

  const viewer = document.querySelector('.image-viewer');
  const viewerImage = viewer?.querySelector('.image-viewer-img');
  const closeTriggers = viewer ? Array.from(viewer.querySelectorAll('[data-close-viewer]')) : [];
  const galleryButtons = Array.from(document.querySelectorAll('[data-viewer-image]'));

  const closeViewer = () => {
    if (!viewer || !viewerImage) return;
    viewer.classList.remove('is-open');
    viewer.setAttribute('aria-hidden', 'true');
    viewerImage.setAttribute('src', '');
    document.body.style.overflow = '';
  };

  galleryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!viewer || !viewerImage) return;
      const imageUrl = button.getAttribute('data-viewer-image') || '';
      if (!imageUrl) return;
      viewerImage.setAttribute('src', imageUrl);
      viewer.classList.add('is-open');
      viewer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    });
  });

  closeTriggers.forEach((node) => node.addEventListener('click', closeViewer));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeViewer();
  });
</script>

