---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getClubById, getClubProgramsByClubId } from '../../lib/repositories/catalog';
import {
  sportsActivityLocationSchema,
  courseSchema,
  SITE_URL,
} from '../../lib/seo/jsonld';
import { extractIdFromSlug, clubSlug, listingSlug, isPureNumericSlug } from '../../lib/seo/slug';

// URL segmenti hem "42" hem "atakoy-spor-kulubu-42" olabilir.
const rawSlug = String(Astro.params.id ?? '').trim();
const id = extractIdFromSlug(rawSlug);
const club = id !== null ? await getClubById(id) : null;
if (!club) {
  return new Response(null, { status: 404 });
}

// Kanonik kulup slug
const expectedSlug = clubSlug({ id: club.id, ad: club.ad });

// Gelen slug pure-numeric veya yanlis ise 301
if (isPureNumericSlug(rawSlug) || rawSlug !== expectedSlug) {
  return Astro.redirect(`/kulupler/${expectedSlug}`, 301);
}

const programs = await getClubProgramsByClubId(club.id);

const canonicalUrl = `${SITE_URL}/kulupler/${expectedSlug}`;

// Yapisal veri: kulup -> SportsActivityLocation + LocalBusiness
// + her aktif program -> Course
const clubJsonLd = sportsActivityLocationSchema({
  clubId: club.id,
  name: club.ad,
  url: canonicalUrl,
  description: club.aciklama || `${club.ad} ${club.brans || 'spor'} branşında hizmet veren bir kuruluştur.`,
  branch: club.brans,
  emoji: club.emoji,
  telephone: club.telefon || undefined,
  address: club.adres || undefined,
  addressLocality: club.ilce || undefined,
  addressRegion: club.il || undefined,
  latitude: club.enlem || undefined,
  longitude: club.boylam || undefined,
  priceRange: club.fiyat || undefined,
  aggregateRating: club.yorumSayisi > 0
    ? { ratingValue: club.puan, reviewCount: club.yorumSayisi }
    : undefined,
});

const programCourses = programs
  .filter((p) => p.aktif)
  .map((program) =>
    courseSchema({
      url: `${SITE_URL}/ilanlar/${listingSlug({ id: program.id, ad: program.ad, clubAd: club.ad })}`,
      name: program.ad,
      description: program.aciklama || undefined,
      providerName: club.ad,
      providerUrl: canonicalUrl,
      branch: club.brans,
      level: program.seviye || undefined,
      price: program.ucretBilgisi || undefined,
      startDate: program.eventDate || undefined,
      endDate: program.endDate || undefined,
      isOngoing: program.isOngoing,
      locationText: program.locationText || club.ilce || club.il || undefined,
      latitude: club.enlem || undefined,
      longitude: club.boylam || undefined,
      image: program.gallery,
    })
  );

const breadcrumbs = [
  { name: 'Ana Sayfa', url: `${SITE_URL}/` },
  { name: 'Arama', url: `${SITE_URL}/ara` },
  ...(club.bransSlug
    ? [{ name: club.brans, url: `${SITE_URL}/branslar/${club.bransSlug}` }]
    : []),
  { name: club.ad, url: canonicalUrl },
];

const clubOgParams = new URLSearchParams({
  title: club.ad,
  kicker: club.brans || 'Spor kulubu',
  badge: club.ilce || club.il || '',
});
const clubOgImage = `${SITE_URL}/api/og.png?${clubOgParams.toString()}`;

function getBodySections(bodyJson: unknown) {
  if (!bodyJson || typeof bodyJson !== 'object') return [];
  const content = (bodyJson as { content?: unknown }).content;
  if (!Array.isArray(content)) return [];
  return content
    .map((node) => {
      if (!node || typeof node !== 'object') return '';
      const typedNode = node as { type?: string; content?: unknown };
      const children = Array.isArray(typedNode.content) ? typedNode.content : [];
      const text = children
        .map((child) => {
          if (!child || typeof child !== 'object') return '';
          const childNode = child as { text?: unknown; content?: unknown };
          if (typeof childNode.text === 'string') return childNode.text;
          if (Array.isArray(childNode.content)) {
            return childNode.content
              .map((nested) =>
                nested && typeof nested === 'object' && typeof (nested as { text?: unknown }).text === 'string'
                  ? String((nested as { text?: unknown }).text)
                  : ''
              )
              .join(' ')
              .trim();
          }
          return '';
        })
        .join(' ')
        .trim();
      if (!text) return '';
      return typedNode.type === 'heading' ? `# ${text}` : text;
    })
    .filter(Boolean);
}
---

<BaseLayout
  title={`${club.ad} | ${club.ilce || club.il}`}
  description={club.aciklama
    ? club.aciklama.slice(0, 160)
    : `${club.ad}, ${club.ilce || club.il} bölgesinde ${club.brans?.toLowerCase() || 'spor'} branşında hizmet veren spor kulübü. Aktif ilanları, iletişim ve temel bilgiler.`}
  keywords={`${club.bransSlug} kulubu turkiye, ${(club.ilce ?? '').toLowerCase()} spor kulubu, ${club.ad.toLowerCase()}`}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={clubOgImage}
  breadcrumbs={breadcrumbs}
  jsonLd={[clubJsonLd, ...programCourses]}
>
  <section class="section detail-page">
    <div class="container detail">
      <Breadcrumb items={breadcrumbs.map((b) => ({ name: b.name, url: b.url }))} />
      <a href={`/ara?brans=${club.bransSlug}`} class="back-link">← Arama sonuçlarına dön</a>

      <header class="hero">
        <div class="hero-main">
          <div class="icon" style={`--branch-color: ${club.renk}`}>{club.emoji}</div>
          <div>
            <p class="hero-kicker">{club.brans} ilanları</p>
            <h1>{club.ad}</h1>
            <p class="hero-sub">{club.ilce || club.il} • {club.yasAraligi || 'Tüm yaş grupları'}</p>
          </div>
        </div>
        <div class="hero-badges">
          <span>{programs.length} aktif ilan</span>
          <span>{club.brans}</span>
          <span>{club.ilce || club.il}</span>
        </div>
      </header>

      <article class="program-zone" data-club-lat={club.enlem || ''} data-club-lng={club.boylam || ''}>
        <h2 class="section-title">Spor ilanları</h2>
        {programs.length > 0 ? (
          <ul class="program-list">
            {programs.map((program) => (
              <li class="program-item">
                <div class="listing-header">
                  <div>
                    <strong>{program.ad}</strong>
                    <p class="listing-meta">{program.seviye || 'Genel seviye'}</p>
                  </div>
                  <div class="listing-badges">
                    <span class="price-badge">{program.ucretBilgisi || 'Fiyat sorunuz'}</span>
                    <span class="program-level">{program.aktif ? 'Yayında' : 'Pasif'}</span>
                  </div>
                </div>
                <ul class="listing-grid">
                  <li><span>Tarih</span><strong>{program.eventDate || 'Belirtilmedi'}</strong></li>
                  <li><span>Saat</span><strong>{program.gunSaat || 'Belirtilmedi'}</strong></li>
                  <li><span>Konum</span><strong>{program.locationText || club.ilce || club.il}</strong></li>
                  <li><span>Eve uzaklık</span><strong class="distance-output">Konum izni bekleniyor</strong></li>
                </ul>
                {program.aciklama && <p class="listing-summary">{program.aciklama}</p>}
                {getBodySections(program.bodyJson).length > 0 && (
                  <div class="listing-body">
                    {getBodySections(program.bodyJson).map((line) => (
                      <p>{line}</p>
                    ))}
                  </div>
                )}
                <div class="listing-gallery">
                  <h3>Galeri</h3>
                  {program.gallery.length > 0 ? (
                    <div class="gallery-grid">
                      {program.gallery.map((imageUrl, idx) => (
                        <button type="button" class="gallery-item" data-viewer-image={imageUrl}>
                          <img
                            src={imageUrl}
                            alt={`${club.ad} - ${program.ad} görseli ${idx + 1}`}
                            loading="lazy"
                            decoding="async"
                            width="640"
                            height="480"
                          />
                        </button>
                      ))}
                    </div>
                  ) : (
                    <p class="muted">Bu ilan için galeri görseli eklenmedi.</p>
                  )}
                </div>
                <div class="listing-contact">
                  <h3>İletişim Bilgileri</h3>
                  <ul class="contact-list">
                    <li><strong>Telefon:</strong> {club.telefon || 'Belirtilmedi'}</li>
                    <li><strong>E-posta:</strong> {club.email || 'Belirtilmedi'}</li>
                    <li><strong>Adres:</strong> {club.adres || program.locationText || club.ilce || club.il || 'Belirtilmedi'}</li>
                  </ul>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="program-empty">Bu kulüp için henüz aktif program bilgisi girilmedi.</p>
        )}
      </article>
    </div>
  </section>
  <div class="image-viewer" aria-hidden="true">
    <div class="image-viewer-backdrop" data-close-viewer></div>
    <div class="image-viewer-dialog" role="dialog" aria-modal="true" aria-label="Görsel görüntüleyici">
      <button type="button" class="image-viewer-close" data-close-viewer aria-label="Kapat">×</button>
      <img class="image-viewer-img" src="" alt="Büyütülmüş ilan görseli" />
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const card = document.querySelector('.program-zone');
  if (card) {
    const lat = Number(card.getAttribute('data-club-lat'));
    const lng = Number(card.getAttribute('data-club-lng'));
    const outputs = Array.from(document.querySelectorAll('.distance-output'));
    const setOutput = (text) => outputs.forEach((node) => (node.textContent = text));
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
      setOutput('Konum bilgisi yok');
    } else if (!navigator.geolocation) {
      setOutput('Tarayıcı konum desteklemiyor');
    } else {
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const toRad = (value) => (value * Math.PI) / 180;
          const earthRadiusKm = 6371;
          const dLat = toRad(lat - pos.coords.latitude);
          const dLon = toRad(lng - pos.coords.longitude);
          const a =
            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(toRad(pos.coords.latitude)) * Math.cos(toRad(lat)) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
          const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
          const km = Math.round(earthRadiusKm * c * 10) / 10;
          setOutput(`${km} km`);
        },
        () => setOutput('Konum izni verilmedi')
      );
    }
  }

  const viewer = document.querySelector('.image-viewer');
  const viewerImage = viewer?.querySelector('.image-viewer-img');
  const closeTriggers = viewer ? Array.from(viewer.querySelectorAll('[data-close-viewer]')) : [];
  const galleryButtons = Array.from(document.querySelectorAll('[data-viewer-image]'));

  const closeViewer = () => {
    if (!viewer || !viewerImage) return;
    viewer.classList.remove('is-open');
    viewer.setAttribute('aria-hidden', 'true');
    viewerImage.setAttribute('src', '');
    document.body.style.overflow = '';
  };

  galleryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!viewer || !viewerImage) return;
      const imageUrl = button.getAttribute('data-viewer-image') || '';
      if (!imageUrl) return;
      viewerImage.setAttribute('src', imageUrl);
      viewer.classList.add('is-open');
      viewer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    });
  });

  closeTriggers.forEach((node) => node.addEventListener('click', closeViewer));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeViewer();
  });
</script>

<style>
  .detail-page {
    background:
      radial-gradient(circle at top left, rgba(227, 10, 23, 0.08), transparent 38%),
      radial-gradient(circle at top right, rgba(22, 28, 36, 0.06), transparent 30%),
      #f4f6f8;
    min-height: 60vh;
  }
  .detail {
    max-width: 75rem;
  }
  .back-link {
    color: #6c757d;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .hero {
    margin-top: 0.85rem;
    border: 1px solid #e5e9ef;
    border-radius: 1rem;
    background: linear-gradient(140deg, #ffffff 0%, #f9fbff 100%);
    padding: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.9rem;
  }
  .hero-main {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .icon {
    width: 54px;
    height: 54px;
    border-radius: 0.85rem;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    background: color-mix(in srgb, var(--branch-color, #E30A17) 14%, transparent);
  }
  .hero-kicker {
    margin: 0;
    color: #e30a17;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .hero h1 {
    margin: 0.2rem 0 0;
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    font-weight: 900;
    color: #212529;
  }
  .hero-sub {
    margin: 0.35rem 0 0;
    color: #6c757d;
    font-size: 1rem;
  }
  .hero-badges {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    align-content: flex-start;
  }
  .hero-badges span {
    border: 1px solid #e8ecf1;
    border-radius: 999px;
    background: #fbfcfd;
    color: #3f4953;
    padding: 0.35rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .program-zone {
    margin-top: 1rem;
  }
  .section-title {
    margin: 0 0 0.6rem;
    font-size: 1.35rem;
    color: #1f2933;
    font-weight: 900;
  }
  .program-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }
  .program-item {
    border: 1px solid #e5e9ef;
    border-radius: 1rem;
    padding: 1rem;
    background: #fff;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
  }
  .program-item strong {
    font-size: 1.2rem;
    color: #17212b;
  }
  .listing-badges {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .price-badge {
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 800;
    border: 1px solid #dbe3f5;
    color: #1f2a44;
    background: #f2f6ff;
  }
  .program-level {
    font-size: 0.72rem;
    background: #fff2f3;
    color: #a30f1c;
    border: 1px solid #ffd9dd;
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    font-weight: 700;
  }
  .program-empty {
    color: #6c757d;
    border: 1px dashed #d6dce3;
    border-radius: 0.8rem;
    background: #fff;
    padding: 0.9rem;
  }
  .listing-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .listing-meta {
    margin: 0.3rem 0 0;
    color: #5b6670;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .listing-grid {
    margin-top: 0.65rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 0.8rem;
    background: #f8fafc;
    border: 1px solid #e9edf2;
    border-radius: 0.7rem;
    padding: 0.65rem;
    list-style: none;
  }
  .listing-grid li {
    margin: 0;
    display: grid;
    gap: 0.08rem;
    padding: 0.2rem 0.15rem;
  }
  .listing-grid span {
    color: #74808c;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .listing-grid strong {
    font-size: 0.98rem;
    color: #1f2933;
    font-weight: 700;
  }
  .listing-summary {
    margin-top: 0.7rem;
    font-weight: 600;
    line-height: 1.65;
    font-size: 1rem;
    color: #25313d;
  }
  .listing-body p {
    margin: 0.45rem 0 0;
    color: #3f4953;
    line-height: 1.68;
  }
  .listing-gallery,
  .listing-contact {
    margin-top: 0.85rem;
    border-top: 1px solid #edf0f2;
    padding-top: 0.75rem;
  }
  .listing-gallery h3,
  .listing-contact h3 {
    margin: 0;
    font-size: 1rem;
    color: #1f2933;
    font-weight: 800;
  }
  .gallery-grid {
    margin-top: 0.55rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.55rem;
  }
  .gallery-item {
    border: 0;
    padding: 0;
    width: 100%;
    cursor: zoom-in;
    background: transparent;
  }
  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.55rem;
    border: 1px solid #e9ecef;
  }
  .contact-list {
    list-style: none;
    margin: 0.45rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    color: #4b5563;
    font-size: 0.92rem;
  }
  .contact-list strong {
    color: #1f2933;
  }
  .muted {
    margin-top: 0.35rem;
    color: #6c757d;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .image-viewer {
    position: fixed;
    inset: 0;
    z-index: 50;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .image-viewer.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .image-viewer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
  }
  .image-viewer-dialog {
    position: relative;
    z-index: 1;
    margin: auto;
    max-width: min(960px, calc(100% - 2rem));
    max-height: calc(100% - 2rem);
    top: 50%;
    transform: translateY(-50%);
  }
  .image-viewer-img {
    display: block;
    width: 100%;
    max-height: calc(100vh - 2rem);
    object-fit: contain;
    border-radius: 0.75rem;
    background: #111;
  }
  .image-viewer-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.2rem;
    height: 2.2rem;
    border: 0;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.85);
    color: white;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  @media (max-width: 760px) {
    .hero {
      padding: 0.9rem;
    }
    .hero-main {
      align-items: flex-start;
    }
    .listing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

