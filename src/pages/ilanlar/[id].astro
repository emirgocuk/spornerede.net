---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getProgramListingById } from '../../lib/repositories/catalog';
import { courseSchema, SITE_URL } from '../../lib/seo/jsonld';
import { extractIdFromSlug, listingSlug, isPureNumericSlug, clubSlug } from '../../lib/seo/slug';

// URL segmenti hem "42" hem "yuzme-kursu-istanbul-42" olabilir.
// Numerik id'yi her zaman sondan parse ederiz.
const rawSlug = String(Astro.params.id ?? '').trim();
const id = extractIdFromSlug(rawSlug);
const listing = id !== null ? await getProgramListingById(id) : null;
if (!listing) {
  return new Response(null, { status: 404 });
}

// Kanonik slug'i uret
const expectedSlug = listingSlug({
  id: listing.id,
  ad: listing.ad,
  clubAd: listing.club.ad,
});

// Gelen slug pure-numeric VEYA yanlis ise kanonik URL'ye 301 yonlendir
if (isPureNumericSlug(rawSlug) || rawSlug !== expectedSlug) {
  return Astro.redirect(`/ilanlar/${expectedSlug}`, 301);
}

function escapeHtml(value: unknown) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function renderInlineContent(content: unknown) {
  if (!Array.isArray(content)) return '';
  return content
    .map((child) => {
      if (!child || typeof child !== 'object') return '';
      const node = child as { text?: unknown; marks?: Array<{ type?: string }> };
      let text = escapeHtml(node.text ?? '');
      if (!text) return '';
      if (node.marks?.some((mark) => mark.type === 'bold')) text = `<strong>${text}</strong>`;
      if (node.marks?.some((mark) => mark.type === 'italic')) text = `<em>${text}</em>`;
      return text;
    })
    .join('');
}

function renderRichTextHtml(bodyJson: unknown) {
  if (!bodyJson || typeof bodyJson !== 'object') return '';
  const content = (bodyJson as { content?: unknown }).content;
  if (!Array.isArray(content)) return '';
  return content
    .map((node) => {
      if (!node || typeof node !== 'object') return '';
      const typedNode = node as { type?: string; content?: unknown; attrs?: { level?: number } };
      if (typedNode.type === 'heading') {
        const level = typedNode.attrs?.level === 2 ? 2 : 3;
        return `<h${level}>${renderInlineContent(typedNode.content)}</h${level}>`;
      }
      if (typedNode.type === 'bulletList' || typedNode.type === 'orderedList') {
        const tag = typedNode.type === 'orderedList' ? 'ol' : 'ul';
        const items = Array.isArray(typedNode.content)
          ? typedNode.content
              .map((item) => {
                const paragraph = Array.isArray((item as { content?: unknown }).content)
                  ? ((item as { content?: unknown }).content as unknown[]).find(
                      (child) => child && typeof child === 'object' && (child as { type?: string }).type === 'paragraph'
                    )
                  : null;
                return `<li>${renderInlineContent((paragraph as { content?: unknown } | null)?.content)}</li>`;
              })
              .join('')
          : '';
        return `<${tag}>${items}</${tag}>`;
      }
      return `<p>${renderInlineContent(typedNode.content)}</p>`;
    })
    .join('');
}

function formatDateTr(value: string) {
  if (!value) return '';
  const date = new Date(`${value}T00:00:00`);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
}

function dateRangeText() {
  if (listing.isOngoing) return 'Sürekli devam ediyor';
  const start = formatDateTr(listing.eventDate);
  const end = formatDateTr(listing.endDate);
  if (start && end) return `${start} - ${end}`;
  return start || 'Tarih belirtilmedi';
}

function scheduleText() {
  const days = Array.isArray(listing.days) && listing.days.length ? listing.days.join(', ') : '';
  const time = listing.startTime && listing.endTime ? `${listing.startTime} - ${listing.endTime}` : listing.gunSaat;
  return [days, time].filter(Boolean).join(' / ') || 'Saat belirtilmedi';
}

const bodyHtml = renderRichTextHtml(listing.bodyJson);

const canonicalUrl = `${SITE_URL}/ilanlar/${expectedSlug}`;
const ilanDescription = listing.aciklama
  ? listing.aciklama.slice(0, 160)
  : `${listing.ad} - ${listing.club.ad} (${listing.club.ilce || listing.club.il}). ${listing.club.brans || 'Spor'} ilanı, tarih, saat, konum ve detaylar.`;

const listingJsonLd = courseSchema({
  url: canonicalUrl,
  name: listing.ad,
  description: ilanDescription,
  providerName: listing.club.ad,
  providerUrl: `${SITE_URL}/kulupler/${clubSlug({ id: listing.club.id, ad: listing.club.ad })}`,
  branch: listing.club.brans || undefined,
  level: listing.seviye || undefined,
  price: listing.ucretBilgisi || undefined,
  startDate: listing.eventDate || undefined,
  endDate: listing.endDate || undefined,
  isOngoing: listing.isOngoing,
  locationText:
    listing.locationText || listing.club.ilce || listing.club.il || undefined,
  latitude: listing.club.enlem || undefined,
  longitude: listing.club.boylam || undefined,
  image: listing.gallery,
});

const breadcrumbs = [
  { name: 'Ana Sayfa', url: `${SITE_URL}/` },
  { name: 'Arama', url: `${SITE_URL}/ara` },
  ...(listing.club.bransSlug
    ? [{ name: listing.club.brans, url: `${SITE_URL}/branslar/${listing.club.bransSlug}` }]
    : []),
  {
    name: listing.club.ad,
    url: `${SITE_URL}/kulupler/${clubSlug({ id: listing.club.id, ad: listing.club.ad })}`,
  },
  { name: listing.ad, url: canonicalUrl },
];

// OG image: ilan galerisi varsa ilk goruntu, yoksa dinamik endpoint
const ogParams = new URLSearchParams({
  title: listing.ad,
  kicker: listing.club.brans || 'Spor ilani',
  badge: listing.club.ilce || listing.club.il || '',
});
const ogImage = listing.gallery?.[0] || `${SITE_URL}/api/og.png?${ogParams.toString()}`;
---

<BaseLayout
  title={`${listing.ad} | ${listing.club.ad}`}
  description={ilanDescription}
  keywords={`${listing.club.bransSlug} ilanı, ${listing.club.ilce} spor kursu, ${listing.ad.toLowerCase()}`}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={ogImage}
  breadcrumbs={breadcrumbs}
  jsonLd={listingJsonLd}
>
  <div class="page-background"></div>
  <section class="section listing-page relative z-10">
    <div class="container listing-wrap" data-club-lat={listing.club.enlem || ''} data-club-lng={listing.club.boylam || ''}>

      <div class="mb-3 animate-fade-in-up">
        <Breadcrumb items={breadcrumbs.map((b) => ({ name: b.name, url: b.url }))} />
      </div>

      <!-- Back Link -->
      <div class="mb-6 animate-fade-in-up">
        <a href={`/ara?brans=${listing.club.bransSlug || ''}`} class="back-link group">
          <span class="back-icon group-hover:-translate-x-1 transition-transform">←</span>
          <span>Arama sonuçlarına dön</span>
        </a>
      </div>

      <!-- Hero Section -->
      <header class="listing-hero card-glass animate-fade-in-up delay-100">
        <div class="hero-content">
          <div class="icon-wrapper" style={`--branch-color: ${listing.club.renk || '#E30A17'}`}>
            <div class="icon-bg"></div>
            <span class="icon-emoji">{listing.club.emoji}</span>
          </div>
          <div class="hero-text">
            <p class="kicker">
              <span class="pulse-dot"></span>
              {listing.club.brans || 'Spor'} İlanı
            </p>
            <h1 class="listing-title">{listing.ad}</h1>
            <div class="hero-badges-inline">
              <span class="badge-modern"><i class="badge-icon">📅</i>{dateRangeText()}</span>
              <span class="badge-modern"><i class="badge-icon">⏰</i>{scheduleText()}</span>
              <span class="badge-modern"><i class="badge-icon">⭐</i>{listing.seviye || 'Genel seviye'}</span>
              <span class="badge-modern badge-highlight"><i class="badge-icon">💳</i>{listing.ucretBilgisi || 'Fiyat sorunuz'}</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Details Grid -->
      <div class="grid-layout animate-fade-in-up delay-200">
        <!-- Main Content -->
        <div class="main-column">
          <article class="content-card card-glass">
            <h2 class="card-title">Kurs Detayları</h2>
            <ul class="meta-grid">
              <li class="meta-item">
                <div class="meta-icon">📅</div>
                <div class="meta-info">
                  <span class="meta-label">Tarih Aralığı</span>
                  <strong class="meta-value">{dateRangeText()}</strong>
                </div>
              </li>
              <li class="meta-item">
                <div class="meta-icon">⏰</div>
                <div class="meta-info">
                  <span class="meta-label">Gün / Saat</span>
                  <strong class="meta-value">{scheduleText()}</strong>
                </div>
              </li>
              <li class="meta-item">
                <div class="meta-icon">🗺️</div>
                <div class="meta-info">
                  <span class="meta-label">Konum</span>
                  <strong class="meta-value">{listing.locationText || listing.club.ilce || listing.club.il}</strong>
                  {listing.mapsUrl && (
                    <a class="maps-link" href={listing.mapsUrl} target="_blank" rel="noreferrer">Google Maps'te Aç</a>
                  )}
                </div>
              </li>
              <li class="meta-item location-item">
                <div class="meta-icon">📍</div>
                <div class="meta-info">
                  <span class="meta-label">Eve Uzaklık</span>
                  <strong class="meta-value distance-output text-brand-red">Hesaplanıyor...</strong>
                </div>
              </li>
            </ul>
            
            {listing.aciklama && (
              <div class="summary-box">
                <p>{listing.aciklama}</p>
              </div>
            )}
            
            {bodyHtml && <div class="body-content" set:html={bodyHtml} />}

            <div class="cta-box mt-6">
              <h3 class="cta-title">Kulüple İletişime Geç</h3>
              <p class="cta-desc">Bu ilanla ilgileniyorsanız aşağıdaki bilgilerden hemen ulaşabilirsiniz.</p>
              <ul class="contact-list">
                <li><strong>Telefon:</strong> {listing.club.telefon || 'Belirtilmedi'}</li>
                <li><strong>E-posta:</strong> {listing.club.email || 'Belirtilmedi'}</li>
                <li><strong>Adres:</strong> {listing.club.adres || listing.locationText || listing.club.ilce || listing.club.il || 'Belirtilmedi'}</li>
              </ul>
            </div>
          </article>

        </div>

        <!-- Sidebar -->
        <div class="sidebar-column">
          <article class="content-card card-glass sticky-sidebar">
            <h2 class="card-title">Galeri</h2>
            {listing.gallery.length > 0 ? (
              <div class="gallery-grid">
                {listing.gallery.map((imageUrl, idx) => (
                  <button type="button" class="gallery-item" data-viewer-image={imageUrl}>
                    <img
                      src={imageUrl}
                      alt={`${listing.ad} - ${listing.club.brans || 'spor'} ilanı görseli ${idx + 1}`}
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      width="800"
                      height="600"
                    />
                    <div class="gallery-overlay"><span>Büyüt</span></div>
                  </button>
                ))}
              </div>
            ) : (
              <div class="empty-state sm">
                <div class="empty-icon">📷</div>
                <p>Bu ilan için henüz görsel eklenmedi.</p>
              </div>
            )}
            
          </article>
        </div>
      </div>
    </div>
  </section>
  <div class="image-viewer" aria-hidden="true">
    <div class="image-viewer-backdrop" data-close-viewer></div>
    <div class="image-viewer-dialog" role="dialog" aria-modal="true" aria-label="Görsel görüntüleyici">
      <button type="button" class="image-viewer-close" data-close-viewer aria-label="Kapat">×</button>
      <img class="image-viewer-img" src="" alt="Büyütülmüş ilan görseli" />
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const container = document.querySelector('.listing-wrap');
  if (container) {
    const lat = Number(container.getAttribute('data-club-lat'));
    const lng = Number(container.getAttribute('data-club-lng'));
    const out = document.querySelector('.distance-output');
    const setOutput = (text) => {
      if (out) out.textContent = text;
    };
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
      setOutput('Konum bilgisi yok');
    } else if (!navigator.geolocation) {
      setOutput('Tarayıcı desteklemiyor');
    } else {
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const toRad = (value) => (value * Math.PI) / 180;
          const earthRadiusKm = 6371;
          const dLat = toRad(lat - pos.coords.latitude);
          const dLon = toRad(lng - pos.coords.longitude);
          const a =
            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(toRad(pos.coords.latitude)) * Math.cos(toRad(lat)) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
          const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
          const km = Math.round(earthRadiusKm * c * 10) / 10;
          setOutput(`${km} km`);
        },
        () => setOutput('Konum izni verilmedi')
      );
    }
  }

  const viewer = document.querySelector('.image-viewer');
  const viewerImage = viewer?.querySelector('.image-viewer-img');
  const closeTriggers = viewer ? Array.from(viewer.querySelectorAll('[data-close-viewer]')) : [];
  const galleryButtons = Array.from(document.querySelectorAll('[data-viewer-image]'));

  const closeViewer = () => {
    if (!viewer || !viewerImage) return;
    viewer.classList.remove('is-open');
    viewer.setAttribute('aria-hidden', 'true');
    viewerImage.setAttribute('src', '');
    document.body.style.overflow = '';
  };

  galleryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!viewer || !viewerImage) return;
      const imageUrl = button.getAttribute('data-viewer-image') || '';
      if (!imageUrl) return;
      viewerImage.setAttribute('src', imageUrl);
      viewer.classList.add('is-open');
      viewer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    });
  });

  closeTriggers.forEach((node) => node.addEventListener('click', closeViewer));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeViewer();
  });
</script>

<style>
  .page-background {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(135deg, #f8f9fa 0%, #fff1f2 100%);
    z-index: 0;
    pointer-events: none;
  }
  
  .listing-page {
    min-height: 80vh;
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  
  .listing-wrap {
    max-width: 1100px;
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-brand-gray-600);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-brand-gray-200);
    transition: all 0.2s ease;
  }
  
  .back-link:hover {
    color: var(--color-brand-red);
    background: white;
    border-color: var(--color-brand-red-100);
    box-shadow: 0 4px 12px rgba(227, 10, 23, 0.08);
  }
  
  .card-glass {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04), inset 0 1px 0 rgba(255,255,255,1);
    border-radius: 1.25rem;
  }
  
  .listing-hero {
    padding: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  
  .listing-hero::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 300px; height: 300px;
    background: radial-gradient(circle, var(--color-brand-red-50) 0%, transparent 70%);
    opacity: 0.6;
    border-radius: 50%;
    transform: translate(30%, -30%);
    pointer-events: none;
  }
  
  .hero-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1 1 min-content;
    z-index: 1;
  }
  
  .icon-wrapper {
    position: relative;
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
  }
  
  .icon-bg {
    position: absolute;
    inset: 0;
    background: var(--branch-color);
    opacity: 0.15;
    border-radius: 1.25rem;
    transform: rotate(-3deg);
    transition: transform 0.3s ease;
  }
  
  .listing-hero:hover .icon-bg {
    transform: rotate(3deg) scale(1.05);
  }
  
  .icon-emoji {
    font-size: 2.5rem;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
  }
  
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-brand-red);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }
  
  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-brand-red);
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(227, 10, 23, 0.4);
    animation: pulse-red 2s infinite;
  }
  
  @keyframes pulse-red {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(227, 10, 23, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(227, 10, 23, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(227, 10, 23, 0); }
  }
  
  .listing-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 900;
    color: var(--color-brand-gray-900);
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  
  .hero-badges-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  
  .badge-modern {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    background: var(--color-brand-gray-50);
    border: 1px solid var(--color-brand-gray-200);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-brand-gray-700);
    transition: all 0.2s;
  }
  
  .badge-modern:hover {
    background: white;
    border-color: var(--color-brand-gray-300);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  
  .badge-icon {
    font-style: normal;
    font-size: 1rem;
  }
  
  .badge-highlight {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #166534;
  }
  
  /* Layout Grid */
  .grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  @media (min-width: 992px) {
    .grid-layout {
      grid-template-columns: 2fr 1fr;
    }
  }
  
  .main-column, .sidebar-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .sticky-sidebar {
    position: sticky;
    top: 6rem;
  }
  
  .content-card {
    padding: 2rem;
  }
  
  .card-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-brand-gray-900);
    margin-bottom: 1.5rem;
    position: relative;
    padding-bottom: 0.75rem;
  }
  
  .card-title::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 40px; height: 4px;
    background: linear-gradient(90deg, var(--color-brand-red), #ff7a82);
    border-radius: 2px;
  }
  
  /* Meta Grid */
  .meta-grid {
    list-style: none;
    margin: 0 0 2rem 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  
  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: white;
    padding: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--color-brand-gray-100);
    transition: all 0.2s ease;
  }
  
  .meta-item:hover {
    border-color: var(--color-brand-red-100);
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transform: translateY(-2px);
  }
  
  .meta-icon {
    font-size: 1.5rem;
    width: 40px; height: 40px;
    background: var(--color-brand-gray-50);
    border-radius: 0.75rem;
    display: grid;
    place-items: center;
  }
  
  .meta-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  
  .meta-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand-gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .meta-value {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-brand-gray-900);
  }

  .maps-link {
    width: fit-content;
    margin-top: 0.45rem;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #111827;
    color: white;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 800;
  }
  
  .text-brand-red { color: var(--color-brand-red); }
  
  /* Content Text */
  .summary-box {
    background: var(--color-brand-red-50);
    border-left: 4px solid var(--color-brand-red);
    padding: 1.5rem;
    border-radius: 0 1rem 1rem 0;
    margin-bottom: 2rem;
  }
  
  .summary-box p {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-brand-gray-800);
    font-weight: 600;
    line-height: 1.6;
  }
  
  .body-content {
    padding: 1.25rem;
    border: 1px solid var(--color-brand-gray-100);
    border-radius: 1.1rem;
    background: linear-gradient(180deg, #ffffff 0%, #fbfcfd 100%);
  }

  .body-content h2,
