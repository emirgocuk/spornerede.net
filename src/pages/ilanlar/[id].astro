---
import AnalyticsPageEvent from '../../components/AnalyticsPageEvent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProgramListingById } from '../../lib/repositories/catalog';
import { courseSchema, SITE_URL } from '../../lib/seo/jsonld';
import { extractIdFromSlug, listingSlug, isPureNumericSlug, clubSlug } from '../../lib/seo/slug';

const rawSlug = String(Astro.params.id ?? '').trim();
const id = extractIdFromSlug(rawSlug);
const listing = id !== null ? await getProgramListingById(id) : null;
if (!listing) {
  return new Response(null, { status: 404 });
}

const expectedSlug = listingSlug({
  id: listing.id,
  ad: listing.ad,
  clubAd: listing.club.ad,
});

if (isPureNumericSlug(rawSlug) || rawSlug !== expectedSlug) {
  return Astro.redirect(`/ilanlar/${expectedSlug}`, 301);
}

function escapeHtml(value: unknown) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function renderInlineContent(content: unknown) {
  if (!Array.isArray(content)) return '';
  return content
    .map((child) => {
      if (!child || typeof child !== 'object') return '';
      const node = child as { text?: unknown; marks?: Array<{ type?: string }> };
      let text = escapeHtml(node.text ?? '');
      if (!text) return '';
      if (node.marks?.some((mark) => mark.type === 'bold')) text = `<strong>${text}</strong>`;
      if (node.marks?.some((mark) => mark.type === 'italic')) text = `<em>${text}</em>`;
      return text;
    })
    .join('');
}

function renderRichTextHtml(bodyJson: unknown) {
  if (!bodyJson || typeof bodyJson !== 'object') return '';
  const content = (bodyJson as { content?: unknown }).content;
  if (!Array.isArray(content)) return '';
  return content
    .map((node) => {
      if (!node || typeof node !== 'object') return '';
      const typedNode = node as { type?: string; content?: unknown; attrs?: { level?: number } };
      if (typedNode.type === 'heading') {
        const level = typedNode.attrs?.level === 2 ? 2 : 3;
        return `<h${level}>${renderInlineContent(typedNode.content)}</h${level}>`;
      }
      if (typedNode.type === 'bulletList' || typedNode.type === 'orderedList') {
        const tag = typedNode.type === 'orderedList' ? 'ol' : 'ul';
        const items = Array.isArray(typedNode.content)
          ? typedNode.content
              .map((item) => {
                const paragraph = Array.isArray((item as { content?: unknown }).content)
                  ? ((item as { content?: unknown }).content as unknown[]).find(
                      (child) => child && typeof child === 'object' && (child as { type?: string }).type === 'paragraph'
                    )
                  : null;
                return `<li>${renderInlineContent((paragraph as { content?: unknown } | null)?.content)}</li>`;
              })
              .join('')
          : '';
        return `<${tag}>${items}</${tag}>`;
      }
      return `<p>${renderInlineContent(typedNode.content)}</p>`;
    })
    .join('');
}

function formatDateTr(value: string) {
  if (!value) return '';
  const date = new Date(`${value}T00:00:00`);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
}

function dateRangeText() {
  if (listing.isOngoing) return 'Sürekli devam ediyor';
  const start = formatDateTr(listing.eventDate);
  const end = formatDateTr(listing.endDate);
  if (start && end) return `${start} - ${end}`;
  return start || '';
}

function scheduleText() {
  const days = Array.isArray(listing.days) && listing.days.length ? listing.days.join(', ') : '';
  const time = listing.startTime && listing.endTime ? `${listing.startTime} - ${listing.endTime}` : listing.gunSaat;
  return [days, time].filter(Boolean).join(' · ');
}

function cleanPhoneNumber(phone?: string | null) {
  if (!phone) return null;
  const digits = phone.replace(/\D/g, '');
  if (!digits) return null;
  if (digits.startsWith('0')) return `90${digits.slice(1)}`;
  if (digits.length === 10) return `90${digits}`;
  return digits;
}

function formatPhoneDisplay(phone?: string | null) {
  if (!phone) return 'Belirtilmedi';
  const clean = phone.replace(/\D/g, '');
  if (clean.length === 11 && clean.startsWith('0')) {
    return `${clean.slice(0, 4)} ${clean.slice(4, 7)} ${clean.slice(7, 9)} ${clean.slice(9)}`;
  }
  if (clean.length === 10) {
    return `0${clean.slice(0, 3)} ${clean.slice(3, 6)} ${clean.slice(6, 8)} ${clean.slice(8)}`;
  }
  return phone;
}

const cleanedPhone = cleanPhoneNumber(listing.club.telefon);
const formattedPhone = formatPhoneDisplay(listing.club.telefon);
const whatsappText = encodeURIComponent(
  `Merhaba, SporNerede.net üzerinden "${listing.club.ad} - ${listing.ad}" programınız hakkında bilgi almak istiyorum.`
);
const whatsappUrl = cleanedPhone ? `https://wa.me/${cleanedPhone}?text=${whatsappText}` : null;
const telUrl = listing.club.telefon ? `tel:${listing.club.telefon.replace(/\s+/g, '')}` : null;

const fullAddress = [listing.club.adres, listing.locationText, listing.club.ilce, listing.club.il]
  .filter(Boolean)
  .filter((v, i, a) => a.indexOf(v) === i)
  .join(', ');

const mapsQuery = encodeURIComponent(
  listing.mapsUrl || [listing.club.ad, fullAddress].filter(Boolean).join(', ')
);
const googleMapsUrl = listing.mapsUrl || `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;

const bodyHtml = renderRichTextHtml(listing.bodyJson);

const canonicalUrl = `${SITE_URL}/ilanlar/${expectedSlug}`;
const ilanDescription = listing.aciklama
  ? listing.aciklama.slice(0, 160)
  : `${listing.ad} - ${listing.club.ad} (${listing.club.ilce || listing.club.il}). ${listing.club.brans || 'Spor'} ilanı, tarih, saat, konum ve detaylar.`;

const listingJsonLd = courseSchema({
  url: canonicalUrl,
  name: `${listing.club.ad} — ${listing.ad}`,
  description: ilanDescription,
  providerName: listing.club.ad,
  providerUrl: `${SITE_URL}/kulupler/${clubSlug({ id: listing.club.id, ad: listing.club.ad })}`,
  branch: listing.club.brans || undefined,
  level: listing.seviye || undefined,
  price: listing.ucretBilgisi || undefined,
  startDate: listing.eventDate || undefined,
  endDate: listing.endDate || undefined,
  isOngoing: listing.isOngoing,
  locationText:
    listing.locationText || listing.club.ilce || listing.club.il || undefined,
  latitude: listing.club.enlem || undefined,
  longitude: listing.club.boylam || undefined,
  image: listing.gallery,
});

const breadcrumbs = [
  { name: 'Ana Sayfa', url: `${SITE_URL}/` },
  { name: 'Arama', url: `${SITE_URL}/ara` },
  ...(listing.club.bransSlug
    ? [{ name: listing.club.brans, url: `${SITE_URL}/branslar/${listing.club.bransSlug}` }]
    : []),
  {
    name: listing.club.ad,
    url: `${SITE_URL}/kulupler/${clubSlug({ id: listing.club.id, ad: listing.club.ad })}`,
  },
  { name: `${listing.club.ad} — ${listing.ad}`, url: canonicalUrl },
];

const ogParams = new URLSearchParams({
  title: listing.club.ad,
  kicker: `${listing.ad} · ${listing.club.brans || 'Spor'}`,
  badge: listing.club.ilce || listing.club.il || '',
});
const ogImage = `${SITE_URL}/api/og.png?${ogParams.toString()}`;

const schedule = scheduleText();
const dateRange = dateRangeText();

function formatCourseTitle(ad: string) {
  const clean = (ad || '').trim();
  const lower = clean.toLowerCase();
  if (lower.includes('kurs') || lower.includes('okul') || lower.includes('eğitim') || lower.includes('akademi')) {
    return clean;
  }
  return `${clean} Kursu`;
}

const courseTitle = formatCourseTitle(listing.ad);
---

<BaseLayout
  title={`${listing.club.ad} — ${courseTitle}`}
  description={ilanDescription}
  keywords={`${listing.club.bransSlug} ilanı, ${listing.club.ilce} spor kursu, ${listing.ad.toLowerCase()}`}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={ogImage}
  breadcrumbs={breadcrumbs}
  jsonLd={listingJsonLd}
>
  <div class="page-wrap">
    <div class="page-container">

      <!-- Geri Dönüş Linki -->
      <div class="top-nav">
        <a href={`/ara?brans=${listing.club.bransSlug || ''}`} class="back-btn">
          <span>←</span>
          <span>{listing.club.brans || 'Arama'} sonuçlarına dön</span>
        </a>
      </div>

      <!-- Hero Kartı -->
      <header class="hero-card">
        <div class="hero-avatar" style={`--branch-color: ${listing.club.renk || '#E30A17'}`}>
          <span class="hero-emoji">{listing.club.emoji || '🏅'}</span>
        </div>

        <div class="hero-content">
          <h1 class="hero-title">{listing.club.ad}</h1>
          <p class="hero-subtitle">{courseTitle}</p>

          <div class="hero-pills">
            {listing.yasAraligi && (
              <span class="pill">
                <strong>Yaş:</strong> {listing.yasAraligi}
              </span>
            )}
            <span class="pill pill-highlight">
              <strong>Aidat:</strong> {listing.ucretBilgisi || 'Fiyat sorunuz'}
            </span>
            <span class="pill">
              <strong>Konum:</strong> {listing.club.il}{listing.club.ilce ? ` - ${listing.club.ilce}` : ''}
            </span>
          </div>
        </div>
      </header>

      <!-- 2 Kolonlu Sayfa Yapısı -->
      <div class="content-layout">

        <!-- Sol Kolon: Tesis, Detaylar ve Açıklama -->
        <main class="main-flow">

          <!-- 1. Tesis & Antrenman Alanı (Görsel Doğrulama) -->
          <section class="info-card">
            <div class="card-header">
              <h2 class="card-title">Tesis ve Antrenman Alanı</h2>
              <span class="badge-status">Görsel İnceleme</span>
            </div>

            {listing.gallery && listing.gallery.length > 0 ? (
              <div class="photo-gallery">
                {listing.gallery.map((imgUrl, idx) => (
                  <div class="photo-item">
                    <img src={imgUrl} alt={`${listing.club.ad} tesis görseli ${idx + 1}`} loading="lazy" />
                  </div>
                ))}
              </div>
            ) : (
              <div class="facility-notice">
                <div class="notice-icon">🏟️</div>
                <div class="notice-text">
                  <h3>Tesis ve Saha Fotoğrafları Onay Sürecinde</h3>
                  <p>
                    Kulübün resmi kaydı ve faaliyet bilgileri SporNerede tarafından onaylanmıştır.
                    Güncel antrenman sahası ve tesis fotoğrafları kulüp yetkilisinden talep edilmiştir.
                  </p>
                  <div class="notice-tip">
                    <span>💡</span>
                    <span>Tesis ortamını ve antrenman şartlarını yerinde görmek için kulüpten <strong>1 günlük deneme antrenmanı</strong> talep edebilirsiniz.</span>
                  </div>
                </div>
              </div>
            )}
          </section>

          <!-- 2. Program ve Kulüp Bilgileri -->
          <section class="info-card">
            <div class="card-header">
              <h2 class="card-title">Kurs ve Eğitim Detayları</h2>
            </div>

            <div class="meta-row-grid">
              <div class="meta-cell">
                <span class="cell-label">Branş</span>
                <strong class="cell-value">{listing.club.brans || 'Spor'}</strong>
              </div>
              <div class="meta-cell">
                <span class="cell-label">Hedef Yaş</span>
                <strong class="cell-value">{listing.yasAraligi ? `${listing.yasAraligi} Yaş` : 'Tüm Yaş Grupları'}</strong>
              </div>
              <div class="meta-cell">
                <span class="cell-label">Aidat / Ücret</span>
                <strong class="cell-value text-green">{listing.ucretBilgisi || 'Aidat Sorunuz'}</strong>
              </div>
              <div class="meta-cell">
                <span class="cell-label">Bölge</span>
                <strong class="cell-value">{listing.club.ilce ? `${listing.club.ilce}, ` : ''}{listing.club.il}</strong>
              </div>
            </div>

            {(schedule || dateRange) && (
              <div class="schedule-box">
                <div class="schedule-title">Antrenman Saatleri & Sezon</div>
                {schedule && <div class="schedule-main">{schedule}</div>}
                {dateRange && <div class="schedule-sub">{dateRange}</div>}
              </div>
            )}

            {listing.aciklama && (
              <div class="description-text">
                <p>{listing.aciklama}</p>
              </div>
            )}

            {listing.club.aciklama && listing.club.aciklama !== listing.aciklama && (
              <div class="club-bio">
                <h4>Kulüp Hakkında</h4>
                <p>{listing.club.aciklama}</p>
              </div>
            )}

            {bodyHtml && <div class="rich-content" set:html={bodyHtml} />}
          </section>

          <!-- 3. Konum & Harita -->
          <section class="info-card">
            <div class="card-header">
              <h2 class="card-title">Tesis Konumu</h2>
            </div>
            <p class="address-text">{fullAddress || 'Adres detayları kulüpten öğrenilebilir.'}</p>
            <div class="maps-action">
              <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="maps-btn">
                <span>Google Haritalar'da Aç ↗</span>
              </a>
            </div>
          </section>

        </main>

        <!-- Sağ Kolon: İletişim Kartı -->
        <aside class="sidebar-flow">
          <div class="contact-card">
            <h3 class="contact-title">Kulüple İletişime Geç</h3>
            <p class="contact-sub">Kayıt şartları, aidat ve deneme antrenmanı randevusu için kulübe hemen ulaşabilirsiniz.</p>

            <div class="contact-details">
              <div class="detail-row">
                <span class="detail-label">Telefon</span>
                {telUrl ? (
                  <a href={telUrl} class="detail-val link">{formattedPhone}</a>
                ) : (
                  <span class="detail-val">Belirtilmedi</span>
                )}
              </div>

              <div class="detail-row">
                <span class="detail-label">E-posta</span>
                {listing.club.email ? (
                  <a href={`mailto:${listing.club.email}`} class="detail-val link">{listing.club.email}</a>
                ) : (
                  <span class="detail-val">Belirtilmedi</span>
                )}
              </div>

              <div class="detail-row">
                <span class="detail-label">Adres</span>
                <span class="detail-val">{fullAddress || 'Belirtilmedi'}</span>
              </div>
            </div>

            <div class="trust-box">
              <strong>%100 Doğrudan İletişim</strong>
              <p>SporNerede bir aracı değildir. Yapacağınız tüm görüşmeler doğrudan spor kulübü yetkilisiyle gerçekleştirilir.</p>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </div>

  <AnalyticsPageEvent
    event="view_listing"
    params={{
      listing_id: listing.id,
      club_id: listing.club.id,
      branch: listing.club.bransSlug || listing.club.brans || '',
      city: listing.club.il || '',
    }}
  />
</BaseLayout>

<style>
  .page-wrap {
    min-height: 85vh;
    background-color: #f8f9fa;
    padding: 2rem 0 5rem;
    font-family: inherit;
  }

  .page-container {
    max-width: 1050px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Top Navigation */
  .top-nav {
    margin-bottom: 1.5rem;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #495057;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.4rem 0.9rem;
    background: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .back-btn:hover {
    color: #e30a17;
    border-color: #e30a17;
    transform: translateX(-2px);
  }

  /* Hero Section */
  .hero-card {
    background: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 1.25rem;
    padding: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .hero-avatar {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--branch-color, #e30a17) 12%, #f8f9fa);
    display: grid;
    place-items: center;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .hero-emoji {
    font-size: 2.75rem;
    line-height: 1;
  }

  .hero-content {
    flex: 1;
    min-width: 0;
  }



  .hero-title {
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 900;
    color: #212529;
    margin: 0 0 0.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: #6c757d;
    font-weight: 600;
    margin: 0 0 1rem;
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 999px;
    font-size: 0.85rem;
    color: #495057;
  }

  .pill-highlight {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #166534;
  }

  /* 2-Column Content Layout */
  .content-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: flex-start;
  }

  @media (min-width: 960px) {
    .content-layout {
      grid-template-columns: 1fr 340px;
    }
  }

  .main-flow {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 1.25rem;
    padding: 1.75rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #f1f3f5;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #212529;
    margin: 0;
  }

  .badge-status {
    font-size: 0.75rem;
    font-weight: 700;
    color: #6c757d;
    background: #f1f3f5;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  /* Facility Photo / Verification */
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .photo-item {
    border-radius: 1rem;
    overflow: hidden;
    aspect-ratio: 16/9;
    border: 1px solid #e9ecef;
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .facility-notice {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: #fbfcfd;
    border: 1px solid #e9ecef;
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .notice-icon {
    font-size: 2.2rem;
    line-height: 1;
  }

  .notice-text h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 800;
    color: #212529;
  }

  .notice-text p {
    margin: 0 0 0.85rem;
    font-size: 0.9rem;
    color: #6c757d;
    line-height: 1.6;
  }

  .notice-tip {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: #495057;
    line-height: 1.5;
  }

  /* Meta Grid */
  .meta-row-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 600px) {
    .meta-row-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .meta-cell {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 0.85rem;
    padding: 0.85rem;
  }

  .cell-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #6c757d;
    margin-bottom: 0.2rem;
  }

  .cell-value {
    font-size: 0.95rem;
    font-weight: 800;
    color: #212529;
  }

  .text-green {
    color: #166534 !important;
  }

  /* Schedule Box */
  .schedule-box {
    background: #fffbeb;
    border: 1px solid #fef3c7;
    border-radius: 0.85rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .schedule-title {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #92400e;
    margin-bottom: 0.25rem;
  }

  .schedule-main {
    font-size: 1rem;
    font-weight: 800;
    color: #78350f;
  }

  .schedule-sub {
    font-size: 0.85rem;
    color: #b45309;
    margin-top: 0.2rem;
  }

  .description-text p {
    font-size: 0.98rem;
    line-height: 1.7;
    color: #343a40;
    margin: 0;
  }

  .club-bio {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid #f1f3f5;
  }

  .club-bio h4 {
    margin: 0 0 0.35rem;
    font-size: 0.92rem;
    font-weight: 800;
    color: #495057;
  }

  .club-bio p {
    margin: 0;
    font-size: 0.9rem;
    color: #6c757d;
    line-height: 1.6;
  }

  .address-text {
    font-size: 0.95rem;
    color: #343a40;
    margin: 0 0 1rem;
  }

  .maps-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: #212529;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.2s;
