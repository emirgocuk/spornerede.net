---
/**
 * Header.astro
 * SporNerede.net için sticky, dropdown menülü, mobil uyumlu header.
 */
const navItems = [
  { label: 'Spor Ara', href: '/ara?il=&ilce=&brans=' },
  { label: 'Haberler',  href: '/haberler' },
  { label: 'Hakkımızda', href: '/hakkimizda' },
  { label: 'İletişim',  href: '/iletisim' },
];

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/';
---

<header id="site-header" class={`site-header ${isHomePage ? 'site-header--home' : ''}`}>
  <div class="header-inner container">

    <!-- ===== LOGO ===== -->
    <a href="/" class="site-logo" aria-label="Spor Nerede? Ana Sayfa">
      <span class="logo-markup">
        <span class="logo-stack">
          <span class="logo-line logo-line--top">spor</span>
          <span class="logo-line logo-line--bottom">nerede</span>
        </span>
        <span class="logo-q" aria-hidden="true">?</span>
      </span>
    </a>

    <!-- ===== MASAÜSTÜ NAVİGASYON ===== -->
    <nav class="desktop-nav" aria-label="Ana Navigasyon">
      <ul class="nav-list" role="list">
        {navItems.map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class={`nav-link ${(item.href.startsWith('/ara?') ? currentPath === '/ara' : currentPath === item.href || currentPath.startsWith(item.href + '/')) ? 'active' : ''}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- ===== HEADER SAĞ KISIM ===== -->
    <div class="header-actions">
      <a href="/panel/giris" class="btn btn-outline btn-sm header-login" data-auth-link>Üye girişi</a>
      <!-- Masaüstünde CTA -->
      <a href="/basvuru" class="btn btn-primary header-cta" id="header-cta-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <span class="header-cta-text">
          <span class="header-cta-line"><span class="cta-brand">Spor Kursunu</span></span>
          <span class="header-cta-sep">/</span>
          <span class="header-cta-line">Kulübünü Ekle</span>
        </span>
      </a>

      <!-- Mobil hamburger butonu -->
      <button
        id="mobile-menu-btn"
        class="hamburger-btn"
        aria-label="Menüyü Aç/Kapat"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</header>

<!-- ===== MOBİL MENÜ OVERLAY ===== -->
<div id="mobile-menu" class="mobile-menu" aria-hidden="true" role="dialog" aria-label="Mobil Menü">
  <div class="mobile-menu-inner">

    <!-- Mobil menü üst -->
    <div class="mobile-menu-header">
      <a href="/" class="site-logo" aria-label="Spor Nerede? Ana Sayfa">
        <span class="logo-markup">
          <span class="logo-stack">
            <span class="logo-line logo-line--top">spor</span>
            <span class="logo-line logo-line--bottom">nerede</span>
          </span>
          <span class="logo-q" aria-hidden="true">?</span>
        </span>
      </a>
      <button id="mobile-close-btn" class="mobile-close-btn" aria-label="Menüyü Kapat">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Mobil nav linkler -->
    <nav class="mobile-nav" aria-label="Mobil Navigasyon">
      {navItems.map((item) => (
        <div class="mobile-nav-group">
          <a href={item.href} class="mobile-nav-link">
            {item.label}
          </a>
        </div>
      ))}
      <div class="mobile-nav-group mobile-nav-group--account">
        <a href="/panel/giris" class="mobile-nav-link mobile-nav-link--secondary" data-auth-link-mobile>Üye girişi</a>
      </div>
    </nav>

    <!-- Mobil CTA -->
    <div class="mobile-cta">
      <a href="/basvuru" class="btn btn-primary btn-lg mobile-cta-btn" style="width: 100%; justify-content: center;">
        <span class="header-cta-text">
          <span class="header-cta-line"><span class="cta-brand">Spor Kursunu</span></span>
          <span class="header-cta-sep">/</span>
          <span class="header-cta-line">Kulübünü Ekle</span>
        </span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>

<!-- Overlay backdrop -->
<div id="mobile-backdrop" class="mobile-backdrop" aria-hidden="true"></div>

<!-- ===== HEADER STİLLERİ ===== -->
<style>
  /* --- Base Header --- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.98);
    border-bottom: 1px solid #E9ECEF;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    transition: box-shadow 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
  }

  .site-header--home {
    background-color: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  .site-header.scrolled {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(12px);
    background-color: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid #E9ECEF;
  }

  .site-header.scrolled .logo-q {
    color: #E30A17;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 2rem;
  }

  /* --- Logo --- */
  .site-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-logo:hover .logo-line {
    color: #E30A17;
  }

  .logo-markup {
    display: inline-flex;
    align-items: stretch;
    gap: 0.16rem;
  }

  .logo-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.08rem;
    line-height: 1;
  }

  .logo-line {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #212529;
    transition: color 0.2s ease;
  }

  .logo-line--top {
    font-size: 1.2rem;
    letter-spacing: -0.03em;
    text-transform: none;
  }

  .logo-line--bottom {
    font-size: 1.08rem;
    letter-spacing: -0.025em;
  }

  .logo-q {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    color: #FF6B75;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-size: 2.7rem;
    line-height: 0.85;
    padding: 0 0.08rem;
    transition: color 0.2s ease;
  }

  .site-header--home:not(.scrolled) .logo-line {
    color: #ffffff;
  }

  .site-header--home:not(.scrolled) .logo-q {
    color: #FF6B75;
  }

  .site-header--home:not(.scrolled) .site-logo:hover .logo-line,
  .site-header--home:not(.scrolled) .site-logo:hover .logo-q {
    color: rgba(255, 255, 255, 0.82);
  }

  /* --- Masaüstü Nav --- */
  .desktop-nav {
    display: none;
    flex: 1;
  }

  @media (min-width: 1024px) {
    .desktop-nav { display: flex; }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.875rem;
    border-radius: 0.375rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: #495057;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #E30A17;
    background-color: #FFF1F2;
  }

  .site-header--home:not(.scrolled) .nav-link {
    color: rgba(255, 255, 255, 0.92);
  }

  .site-header--home:not(.scrolled) .nav-link:hover,
  .site-header--home:not(.scrolled) .nav-link.active {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.14);
  }

  .chevron {
    transition: transform 0.2s ease;
    color: #ADB5BD;
  }

  .site-header--home:not(.scrolled) .chevron {
    color: rgba(255, 255, 255, 0.8);
  }

  .has-dropdown:hover .chevron {
    transform: rotate(180deg);
    color: #E30A17;
  }

  .site-header--home:not(.scrolled) .has-dropdown:hover .chevron {
    color: #ffffff;
  }

  /* --- Dropdown Menü --- */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    padding-top: 10px;
    margin: 0;
    min-width: 280px;
    background: transparent;
    border: none;
    box-shadow: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 200;
  }

  .dropdown-menu > ul {
    list-style: none;
    padding: 0.5rem;
    margin: 0;
    background: #ffffff;
    border: 1px solid #E9ECEF;
    border-radius: 0.875rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12), 0 4px 12px rgba(0, 0, 0, 0.06);
  }

  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
    gap: 0.1rem;
  }

  .dropdown-item:hover {
    background-color: #FFF1F2;
  }

  .dropdown-item:hover .dropdown-label {
    color: #E30A17;
  }

  .dropdown-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #343A40;
    transition: color 0.15s ease;
  }

  .dropdown-desc {
    font-size: 0.78rem;
    color: #6C757D;
  }

  .dropdown-cta .dropdown-label {
    color: #E30A17;
    font-weight: 800;
  }

  .dropdown-cta:hover {
    background-color: #E30A17;
  }

  .dropdown-cta:hover .dropdown-label {
    color: #ffffff;
  }

  /* --- Header Actions --- */
  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  /* Üye girişi: mobilde kompakt metin, md+ outline buton */
  .header-login {
    font-size: 0.82rem;
    padding: 0.4rem 0.65rem;
    border-width: 2px;
  }

  @media (max-width: 767px) {
    .header-login {
      background: transparent;
      border-color: transparent;
      color: #e30a17;
      padding: 0.35rem 0.45rem;
      font-weight: 700;
      box-shadow: none;
      transform: none;
    }

    .header-login:hover {
      background: rgba(227, 10, 23, 0.08);
      border-color: transparent;
      color: #b5080f;
      transform: none;
      box-shadow: none;
    }

    .site-header--home:not(.scrolled) .header-login {
      color: rgba(255, 255, 255, 0.95);
    }

    .site-header--home:not(.scrolled) .header-login:hover {
      background: rgba(255, 255, 255, 0.12);
      color: #ffffff;
    }
  }

  @media (min-width: 768px) {
    .header-login {
      font-size: 0.8rem;
      padding: 0.5rem 0.85rem;
    }
  }

  .site-header--home:not(.scrolled) .header-login {
    color: rgba(255, 255, 255, 0.95);
    border-color: rgba(255, 255, 255, 0.55);
  }

  .site-header--home:not(.scrolled) .header-login:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border-color: #ffffff;
    transform: translateY(-1px);
  }

  .header-cta.btn {
    /* global .btn { white-space: nowrap } — uzun metin taşmasın */
    white-space: normal;
  }

  .header-cta {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    padding: 0.55rem 0.9rem;
    white-space: normal;
    text-align: left;
    line-height: 1.2;
    max-width: min(340px, 92vw);
  }

  .header-cta-text {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.25rem;
  }

  .header-cta-line {
    font-weight: 700;
    white-space: nowrap;
  }

  .header-cta-sep {
    font-weight: 600;
    opacity: 0.85;
  }

  .cta-brand {
    color: #E30A17;
    font-weight: 700;
  }

  /* Kırmızı CTA: marka kelimesi okunur kalsın; ağırlık/gölge ile gövdeden ayrılmasın */
  .btn-primary.header-cta .cta-brand,
  .btn-primary.mobile-cta-btn .cta-brand {
    color: #fff3d6;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .header-cta { display: inline-flex; }
  }

  @media (min-width: 1100px) {
    .header-cta {
      font-size: 0.85rem;
      padding: 0.6rem 1.1rem;
      max-width: none;
    }
  }

  .mobile-cta-btn .header-cta-text {
    justify-content: center;
  }

  /* --- Hamburger --- */
  .hamburger-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 2px solid #E9ECEF;
    border-radius: 8px;
    cursor: pointer;
    padding: 8px;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .hamburger-btn:hover {
    border-color: #E30A17;
    background-color: #FFF1F2;
  }

  .site-header--home:not(.scrolled) .hamburger-btn {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.08);
  }

  .site-header--home:not(.scrolled) .hamburger-btn:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.2);
  }

  .hamburger-line {
    display: block;
    width: 18px;
    height: 2px;
    background-color: #343A40;
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  .site-header--home:not(.scrolled) .hamburger-line {
    background-color: #ffffff;
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .hamburger-btn { display: none; }
  }

  /* --- Mobil Menü --- */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    width: min(360px, 100vw);
    background: #ffffff;
    z-index: 300;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.15);
  }

  .mobile-menu.open {
    transform: translateX(0);
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    gap: 1.5rem;
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid #E9ECEF;
  }

  .mobile-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: #F1F3F5;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    color: #495057;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mobile-close-btn:hover {
    background-color: #FFE0E2;
    color: #E30A17;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .mobile-nav-group {
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 0.875rem;
    font-size: 1rem;
    font-weight: 700;
    color: #212529;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .mobile-nav-link:hover {
    background-color: #FFF1F2;
    color: #E30A17;
  }

  .mobile-nav-group--account {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px dashed #dee2e6;
  }

  .mobile-nav-link--secondary {
    font-size: 0.95rem;
    font-weight: 800;
    color: #e30a17;
  }

  .mobile-nav-link--secondary:hover {
    color: #b5080f;
  }

  .mobile-sub-links {
    display: flex;
    flex-direction: column;
    margin-left: 1rem;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .mobile-sub-link {
    display: block;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #6C757D;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .mobile-sub-link:hover {
    color: #E30A17;
    background-color: #FFF1F2;
  }

  .mobile-cta {
    padding-top: 1rem;
    border-top: 1px solid #E9ECEF;
  }

  .mobile-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    text-align: center;
  }

  /* --- Backdrop --- */
  .mobile-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s;
    backdrop-filter: blur(2px);
  }

  .mobile-backdrop.visible {
    opacity: 1;
    visibility: visible;
  }
</style>

<!-- ===== HEADER JAVASCRIPT ===== -->
<script>
  // Scroll efekti
  const header = document.getElementById('site-header');
  const scrollHandler = () => {
    if (window.scrollY > 20) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  };
  window.addEventListener('scroll', scrollHandler, { passive: true });
  scrollHandler();

  // Mobil menü toggle
  const menuBtn     = document.getElementById('mobile-menu-btn');
  const closeBtn    = document.getElementById('mobile-close-btn');
  const mobileMenu  = document.getElementById('mobile-menu');
  const backdrop    = document.getElementById('mobile-backdrop');

  function openMenu() {
    mobileMenu?.classList.add('open');
    backdrop?.classList.add('visible');
    menuBtn?.setAttribute('aria-expanded', 'true');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.remove('open');
    backdrop?.classList.remove('visible');
    menuBtn?.setAttribute('aria-expanded', 'false');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  // ESC tuşuyla kapat
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Oturum varsa header login linklerini panel linkine cevir
  async function hydrateAuthLinks() {
    try {
      const response = await fetch('/api/panel/session', { credentials: 'same-origin' });
      if (!response.ok) return;
      const payload = await response.json();
      if (!payload?.authenticated) return;

      const desktop = document.querySelector('[data-auth-link]');
      if (desktop) {
        desktop.setAttribute('href', '/panel');
        desktop.textContent = 'Panelim';
      }

      const mobile = document.querySelector('[data-auth-link-mobile]');
      if (mobile) {
        mobile.setAttribute('href', '/panel');
        mobile.textContent = 'Panelim';
      }
    } catch {
      // Sessiz gec: auth endpoint ulasilamazsa varsayilan link kalsin.
    }
  }

  hydrateAuthLinks();
</script>
