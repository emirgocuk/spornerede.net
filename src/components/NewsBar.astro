---
/**
 * NewsBar.astro
 * Haberler / Duyurular bölümü — Landing page orta kısmı.
 * Veritabanından dinamik beslenir.
 */
import { getActiveNews } from '../lib/repositories/news';

const haberler = (await getActiveNews()).slice(0, 3);

const kategoriRenkler: Record<string, string> = {
  red:    'badge-red',
  blue:   'badge-blue',
  green:  'badge-green',
  orange: 'badge-orange',
  purple: 'badge-purple',
  gray:   'badge-gray',
};

---

<section class="newsbar-section section" aria-labelledby="haberler-baslik">
  <div class="container">
    <div class="newsbar-header">
      <div>
        <h2 id="haberler-baslik" class="section-title">
          Haberler & Duyurular
        </h2>
        <p class="section-subtitle">Spor dünyasından güncel haberler ve duyurular</p>
      </div>
      <a href="/haberler" class="btn btn-outline btn-sm" aria-label="Tüm haberleri görüntüle">
        Tümünü Gör →
      </a>
    </div>

    {haberler.length > 0 ? (
      <div class="news-slider" data-news-slider>
        <div class="news-slider-viewport">
          <div class="news-slider-track" data-news-track>
            {haberler.map((haber) => (
              <article class="featured-news news-slide">
                <div class="featured-glow" aria-hidden="true"></div>
                <div class="featured-topline">
                  <span class={`haber-kategori ${kategoriRenkler[haber.kategoriRenk] ?? 'badge-gray'}`}>
                    {haber.kategori}
                  </span>
                  <time class="haber-tarih" datetime={haber.tarih}>{haber.tarih}</time>
                </div>
                <h3 class="featured-title">
                  <a href={`/haberler/${haber.slug}`}>{haber.baslik}</a>
                </h3>
                <p class="featured-summary">{haber.kartOzet}</p>
                <a href={`/haberler/${haber.slug}`} class="featured-link" aria-label={`${haber.baslik} haberini oku`}>
                  Haberi İncele
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </div>

        {haberler.length > 1 && (
          <div class="news-slider-controls">
            <button type="button" class="news-nav-btn" data-news-prev aria-label="Önceki haber">←</button>
            <div class="news-dots" role="tablist" aria-label="Haber slaytları">
              {haberler.map((_, index) => (
                <button
                  type="button"
                  class={`news-dot ${index === 0 ? 'is-active' : ''}`}
                  data-news-dot={index}
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-label={`${index + 1}. habere git`}
                ></button>
              ))}
            </div>
            <button type="button" class="news-nav-btn" data-news-next aria-label="Sonraki haber">→</button>
          </div>
        )}
      </div>
    ) : (
      <div class="empty-news-state">
        <p>Henüz yayınlanmış haber veya duyuru bulunmuyor.</p>
      </div>
    )}
  </div>
</section>

<script is:inline>
  const sliders = document.querySelectorAll('[data-news-slider]');

  sliders.forEach((slider) => {
    const track = slider.querySelector('[data-news-track]');
    const prevBtn = slider.querySelector('[data-news-prev]');
    const nextBtn = slider.querySelector('[data-news-next]');
    const dots = Array.from(slider.querySelectorAll('[data-news-dot]'));
    if (!track) return;

    const slides = Array.from(track.children);
    if (slides.length <= 1) return;
    let currentIndex = 0;
    let autoTimer;

    const update = (index) => {
      currentIndex = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === currentIndex;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    };

    const restartAuto = () => {
      if (autoTimer) clearInterval(autoTimer);
      autoTimer = setInterval(() => update(currentIndex + 1), 4500);
    };

    update(0);
    restartAuto();
    prevBtn?.addEventListener('click', () => update(currentIndex - 1));
    nextBtn?.addEventListener('click', () => update(currentIndex + 1));
    prevBtn?.addEventListener('click', restartAuto);
    nextBtn?.addEventListener('click', restartAuto);
    dots.forEach((dot, index) => dot.addEventListener('click', () => {
      update(index);
      restartAuto();
    }));
  });
</script>

<style>
  /* ===== SECTION ===== */
  .newsbar-section {
    background:
      radial-gradient(circle at 16% 0%, rgba(227, 10, 23, 0.12), transparent 36%),
      radial-gradient(circle at 80% 100%, rgba(17, 24, 39, 0.06), transparent 34%),
      linear-gradient(180deg, #FFF8F8 0%, #FFFFFF 100%);
    border-top: 1px solid #F7DFE1;
    border-bottom: 1px solid #F7DFE1;
  }

  /* ===== BAŞLIK ALANI ===== */
  .newsbar-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .news-slider {
    display: grid;
    gap: 1rem;
  }

  .news-slider-track {
    display: flex;
    height: 100%;
    align-items: stretch;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .news-slider-viewport {
    overflow: hidden;
    border-radius: 1.4rem;
    height: clamp(300px, 36vw, 380px);
  }

  .news-slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
  }

  .empty-news-state {
    border: 1px dashed #F0DCDD;
    border-radius: 1rem;
    padding: 2rem 1.25rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.8);
    color: #6C757D;
    font-weight: 600;
  }

  .featured-news {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 1.4rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    min-height: 100%;
    background:
      linear-gradient(135deg, rgba(227, 10, 23, 0.96) 0%, rgba(90, 4, 10, 0.96) 62%, rgba(17, 24, 39, 0.98) 100%);
    color: #ffffff;
    box-shadow: 0 18px 48px rgba(127, 29, 29, 0.22);
    display: flex;
    flex-direction: column;
  }

  .featured-glow {
    position: absolute;
    width: 220px;
    height: 220px;
    right: -70px;
    top: -70px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    filter: blur(8px);
    z-index: -1;
  }

  .featured-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.4rem;
  }

  .featured-news .haber-kategori {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.24);
  }

  .featured-news .haber-tarih {
    color: rgba(255, 255, 255, 0.78);
  }

  .featured-title {
    max-width: 680px;
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 900;
    margin: 0 0 1rem;
  }

  .featured-title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-summary {
    max-width: 620px;
    margin: 0 0 1.5rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.65;
    font-size: 0.98rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: #ffffff;
    color: #E30A17;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.18s ease, gap 0.18s ease;
    margin-top: auto;
  }

  .featured-link:hover {
    gap: 0.8rem;
    transform: translateY(-2px);
  }

  .news-slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .news-nav-btn {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    border: 1px solid #f0dcdd;
    background: #fff;
    color: #b5080f;
    font-weight: 800;
    cursor: pointer;
  }

  .news-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .news-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    border: 0;
    background: #e5e7eb;
    cursor: pointer;
  }

  .news-dot.is-active {
    background: #e30a17;
  }

  /* ===== META ===== */
  .haber-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .haber-kategori {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.7rem;
    border-radius: 9999px;
  }

  /* Kategori renkleri */
  .badge-red    { background:#FFF1F2; color:#E30A17; border:1px solid #FFE0E2; }
  .badge-blue   { background:#EFF6FF; color:#1D4ED8; border:1px solid #DBEAFE; }
  .badge-green  { background:#F0FDF4; color:#15803D; border:1px solid #BBF7D0; }
  .badge-orange { background:#FFF7ED; color:#C2410C; border:1px solid #FED7AA; }
  .badge-purple { background:#FAF5FF; color:#7C3AED; border:1px solid #E9D5FF; }
  .badge-gray   { background:#F1F3F5; color:#495057; border:1px solid #DEE2E6; }

  .haber-tarih {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: #6C757D;
    font-weight: 500;
  }

</style>
