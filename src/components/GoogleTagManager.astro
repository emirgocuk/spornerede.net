---
/**
 * GoogleTagManager.astro
 * Conditional GTM + GA4 yukleyici (env-driven, consent-aware).
 *
 * - PUBLIC_GA4_ID set ise gtag.js dogrudan yuklenir (GA4 kurulum dogrulayicisi bunu arar).
 * - PUBLIC_GTM_ID set ise GTM de yuklenir (ileride Ads / ek tag'ler icin).
 * - GTM kullanirken konteyner icine ayri GA4 Configuration tag EKLEMEYIN — cift sayim olur.
 * - Consent default ConsentModeHead'de GTM/GA4 oncesi set edilir.
 */
const gtmId = (import.meta.env.PUBLIC_GTM_ID ?? '').trim();
const ga4Id = (import.meta.env.PUBLIC_GA4_ID ?? '').trim();
const hasGtm = /^GTM-[A-Z0-9]+$/.test(gtmId);
const hasGa4 = /^G-[A-Z0-9]+$/.test(ga4Id);
---

{hasGa4 && (
  <Fragment>
    {/* GA4 — dogrudan (Consent Mode ConsentModeHead ile uyumlu) */}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ window.dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;
      gtag('js', new Date());
      gtag('config', ga4Id, {
        anonymize_ip: true,
        send_page_view: true,
      });
    </script>
  </Fragment>
)}

{hasGtm && (
  <Fragment>
    {/* Google Tag Manager */}
    <script is:inline define:vars={{ gtmId }}>
      (function(w,d,s,l,i){
        w[l]=w[l]||[];
        w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
        var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),
            dl=l!='dataLayer'?'&l='+l:'';
        j.async=true;
        j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
        f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer', gtmId);
    </script>
  </Fragment>
)}
