---
/**
 * Hero.astro
 * Landing page hero bölümü.
 * "SPOR NEREDE?" vurgusu + arama formu + popüler branşlar.
 */
import { getAllCities, getAllDistricts, getAllBranches, searchClubs } from '../lib/repositories/catalog';

const { searchParams } = Astro.url;
const seciliIl = searchParams.get('il') || '';
const seciliIlce = searchParams.get('ilce') || '';
const seciliBrans = searchParams.get('brans') || '';

const [tumIller, tumIlceler, tumBranslar, heroClubs] = await Promise.all([
  getAllCities(),
  getAllDistricts(seciliIl || undefined),
  getAllBranches(),
  searchClubs({}),
]);

const clubBranchAreaIndex = heroClubs.map((c) => ({
  ilSlug: c.ilSlug,
  ilceSlug: c.ilceSlug,
  bransSlug: c.bransSlug,
}));

const prioritizedCities = ['Ankara', 'İstanbul', 'İzmir', 'Adana'];
const normalizedCities = Array.from(new Set(tumIller.map((il) => il.ad).filter(Boolean))).filter(
  (city) => !prioritizedCities.includes(city),
);

for (let i = normalizedCities.length - 1; i > 0; i -= 1) {
  const j = Math.floor(Math.random() * (i + 1));
  [normalizedCities[i], normalizedCities[j]] = [normalizedCities[j], normalizedCities[i]];
}

const cityNames = [...prioritizedCities, ...normalizedCities];

const bransOptions = [...tumBranslar]
  .sort((a, b) => a.isim.localeCompare(b.isim, 'tr'))
  .map((b) => ({ ad: b.isim, slug: b.slug }));

const cityOptions = tumIller.map((il) => ({ ad: il.ad, slug: il.slug }));

const seciliIlAdi = tumIller.find((il) => il.slug === seciliIl)?.ad ?? '';
const seciliIlceAdi = tumIlceler.find((ilce) => ilce.slug === seciliIlce)?.ad ?? '';
const seciliBransAdi = tumBranslar.find((b) => b.slug === seciliBrans)?.isim ?? '';
---

<section class="hero-section" aria-label="Ana Arama Bölümü">

  <!-- Arka plan dekorasyon (blur orbs) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="hero-pattern"></div>
  </div>

  <div class="container hero-content">

    <!-- Badge -->
    <div class="hero-badge animate-fade-in-up">
      <span class="city-chip">
        <span class="city-rotator" data-city-rotator>
          <span class="city-track" data-city-track>
            {cityNames.concat(cityNames.slice(0, 2)).map((city) => (
              <span class="city-item">{city}</span>
            ))}
          </span>
        </span>
      </span>
      <span class="badge-text">için En Kapsamlı Spor Rehberi 🏆</span>
    </div>

    <!-- Ana başlık -->
    <h1 class="hero-title animate-fade-in-up delay-100">
      <span class="hero-title-sub">Çocuğunuz için</span>
      <span class="hero-title-main">
        <span class="hero-highlight">spor kursu</span>
        <br />veya <span class="hero-highlight">kulüp</span> bul
      </span>
    </h1>

    <!-- Alt slogan -->
    <p class="hero-desc animate-fade-in-up delay-200">
      Adresinize en yakın spor kursları ve kulüpler bir tık uzağınızda.
    </p>

    <!-- Arama Formu -->
    <div class="hero-search-wrapper animate-fade-in-up delay-300">
      <form
        id="hero-search-form"
        class="hero-search-form"
        method="get"
        action="/ara"
        aria-label="Spor Arama Formu"
      >
        <!-- İl -->
        <div class="search-field">
          <label class="search-label" for="hero-il-input" id="hero-il-lbl">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2l7 4v6c0 5-3.5 9.74-7 10-3.5-.26-7-5-7-10V6l7-4z"/>
            </svg>
            İl
          </label>
          <div class="hero-typeahead" data-hero-city-select>
            <input type="hidden" name="il" value={seciliIl} data-hero-city-hidden />
            <input
              id="hero-il-input"
              type="text"
              class="search-input"
              placeholder="Tüm Türkiye"
              value={seciliIlAdi}
              autocomplete="off"
              role="combobox"
              aria-labelledby="hero-il-lbl"
              aria-autocomplete="list"
              aria-controls="hero-city-menu"
              aria-expanded="false"
              data-hero-city-input
            />
            <div class="search-suggestions" role="listbox" id="hero-city-menu" data-hero-city-menu></div>
          </div>
        </div>

        <div class="search-divider" aria-hidden="true"></div>

        <!-- İlçe -->
        <div class="search-field">
          <label class="search-label" for="hero-ilce-input" id="hero-ilce-lbl">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            İlçe
          </label>
          <div class="hero-typeahead" data-hero-district-select>
            <input type="hidden" name="ilce" value={seciliIlce} data-hero-district-hidden />
            <input
              id="hero-ilce-input"
              type="text"
              class="search-input"
              placeholder={seciliIl ? 'Tüm ilçeler' : 'Önce il seçin'}
              value={seciliIl ? (seciliIlce ? seciliIlceAdi : '') : ''}
              autocomplete="off"
              role="combobox"
              aria-labelledby="hero-ilce-lbl"
              aria-autocomplete="list"
              aria-controls="hero-district-menu"
              aria-expanded="false"
              disabled={!seciliIl}
              data-hero-district-input
            />
            <div class="search-suggestions" role="listbox" id="hero-district-menu" data-hero-district-menu></div>
          </div>
        </div>

        <div class="search-divider" aria-hidden="true"></div>

        <!-- Branş -->
        <div class="search-field">
          <label class="search-label" for="hero-brans-input" id="hero-brans-lbl">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polygon points="10 8 16 12 10 16 10 8"/>
            </svg>
            Branş
          </label>
          <div class="hero-typeahead" data-hero-branch-select>
            <input type="hidden" name="brans" value={seciliBrans} data-hero-branch-hidden />
            <input
              id="hero-brans-input"
              type="text"
              class="search-input"
              placeholder="Tüm Branşlar"
              value={seciliBransAdi}
              autocomplete="off"
              role="combobox"
              aria-labelledby="hero-brans-lbl"
              aria-autocomplete="list"
              aria-controls="hero-branch-menu"
              aria-expanded="false"
              data-hero-branch-input
            />
            <div class="search-suggestions search-suggestions--tall" role="listbox" id="hero-branch-menu" data-hero-branch-menu></div>
          </div>
        </div>

        <!-- Ara Butonu -->
        <button id="hero-search-btn" type="submit" class="search-btn" aria-label="Ara">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <span class="search-btn-text">Ara</span>
        </button>
      </form>
    </div>

  </div>

  <!-- Scroll aşağı oku -->
  <div class="scroll-indicator animate-bounce-y" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </div>

  <!-- "SPOR NEREDE?" büyük watermark -->
  <div class="hero-watermark" aria-hidden="true">SPOR NEREDE?</div>

</section>

<script define:vars={{ branchOptions: bransOptions, clubBranchAreaIndex, cityOptions }}>
  const heroForm = document.getElementById('hero-search-form');
  const cityRotator = document.querySelector('[data-city-rotator]');

  const citySelect = document.querySelector('[data-hero-city-select]');
  const cityInput = citySelect?.querySelector('[data-hero-city-input]');
  const cityHidden = citySelect?.querySelector('[data-hero-city-hidden]');
  const cityMenu = citySelect?.querySelector('[data-hero-city-menu]');

  const districtSelect = document.querySelector('[data-hero-district-select]');
  const districtInput = districtSelect?.querySelector('[data-hero-district-input]');
  const districtHidden = districtSelect?.querySelector('[data-hero-district-hidden]');
  const districtMenu = districtSelect?.querySelector('[data-hero-district-menu]');

  const branchSelect = document.querySelector('[data-hero-branch-select]');
  const branchInput = branchSelect?.querySelector('[data-hero-branch-input]');
  const branchHidden = branchSelect?.querySelector('[data-hero-branch-hidden]');
  const branchMenu = branchSelect?.querySelector('[data-hero-branch-menu]');

  const branchBySlug = new Map(branchOptions.map((b) => [b.slug, b]));
  let districtList = [];

  const norm = (value) => value?.toLocaleLowerCase('tr-TR').trim() ?? '';
  const findMatch = (options, value) => options.find((item) => norm(item.ad) === norm(value));

  function closeDropdown(select, ariaInput) {
    select?.classList.remove('open');
    ariaInput?.setAttribute('aria-expanded', 'false');
  }

  function closeAllDropdowns() {
    closeDropdown(citySelect, cityInput);
    closeDropdown(districtSelect, districtInput);
    closeDropdown(branchSelect, branchInput);
    heroForm?.classList.remove('is-expanded');
  }

  function openOnly(select, ariaInput) {
    if (!select || !ariaInput) return;
    for (const s of [citySelect, districtSelect, branchSelect]) {
      if (!s || s === select) continue;
      const inp = s === citySelect ? cityInput : s === districtSelect ? districtInput : branchInput;
      closeDropdown(s, inp);
    }
    select.classList.add('open');
    ariaInput.setAttribute('aria-expanded', 'true');
    heroForm?.classList.add('is-expanded');
  }

  function setDistrictDisabled(disabled) {
    if (districtInput) districtInput.disabled = disabled;
    if (districtInput) {
      districtInput.placeholder = disabled ? 'Önce il seçin' : 'Tüm ilçeler';
    }
  }

  function createItem(attrs, text) {
    const btn = document.createElement('button');
    btn.type = 'button';
    const dis = attrs.disabled ? ' suggestion-item--disabled' : '';
    btn.className = `suggestion-item${attrs.active ? ' is-active' : ''}${dis}`.trim();
    btn.textContent = text;
    btn.disabled = Boolean(attrs.disabled);
    for (const [k, v] of Object.entries(attrs.attrs ?? {})) btn.setAttribute(k, String(v));
    return btn;
  }

  /** mousedown + preventDefault: öneri tıklanırken input blur sırası yüzünden kaçırılmasın */
  function bindPick(el, handler) {
    el.addEventListener('mousedown', (e) => {
      e.preventDefault();
      handler();
    });
  }

  function renderCityMenu(query) {
    if (!cityMenu || !cityHidden) return;
    const q = norm(query);
    const filtered = !q ? cityOptions.slice() : cityOptions.filter((c) => norm(c.ad).includes(q));
    const current = cityHidden.value?.trim() ?? '';

    cityMenu.innerHTML = '';
    const allBtn = createItem(
      { active: !current, disabled: false, attrs: { 'data-hero-city-value': '', 'data-hero-city-text': 'Tüm Türkiye' } },
      'Tüm Türkiye',
    );
    cityMenu.append(allBtn);
    bindPick(allBtn, () => {
      cityHidden.value = '';
      if (cityInput) cityInput.value = '';
      if (districtHidden) districtHidden.value = '';
      if (districtInput) districtInput.value = '';
      if (branchHidden) branchHidden.value = '';
      if (branchInput) branchInput.value = '';
      loadDistricts('', '');
      closeAllDropdowns();
    });

    for (const c of filtered.slice(0, 200)) {
      const btn = createItem(
        { active: c.slug === current, disabled: false, attrs: { 'data-hero-city-value': c.slug, 'data-hero-city-text': c.ad } },
        c.ad,
      );
      cityMenu.append(btn);
      bindPick(btn, () => {
        cityHidden.value = c.slug;
        if (cityInput) cityInput.value = c.ad;
        if (districtHidden) districtHidden.value = '';
        if (districtInput) districtInput.value = '';
        if (branchHidden) branchHidden.value = '';
        if (branchInput) branchInput.value = '';
        loadDistricts(c.slug, '');
        closeAllDropdowns();
      });
    }

    if (filtered.length === 0 && q) {
      const p = document.createElement('p');
      p.className = 'hero-combobox-empty';
      p.textContent = 'Eşleşen il bulunamadı.';
      cityMenu.append(p);
    }
  }

  function renderDistrictMenu(query) {
    if (!districtMenu || !districtHidden) return;
    if (!cityHidden?.value) {
      districtMenu.innerHTML = '';
      districtMenu.append(
        createItem({ active: false, disabled: true, attrs: { 'data-hero-district-value': '', 'data-hero-district-text': '' } }, 'Önce il seçin'),
      );
      return;
    }

    const q = norm(query);
    const filtered = !q ? districtList.slice() : districtList.filter((d) => norm(d.ad).includes(q));
    const current = districtHidden.value?.trim() ?? '';

    districtMenu.innerHTML = '';
    const allBtn = createItem(
      { active: !current, disabled: false, attrs: { 'data-hero-district-value': '', 'data-hero-district-text': 'Tüm İlçeler' } },
      'Tüm İlçeler',
    );
    districtMenu.append(allBtn);
    bindPick(allBtn, () => {
      districtHidden.value = '';
      if (districtInput) districtInput.value = '';
      if (branchHidden) branchHidden.value = '';
      if (branchInput) branchInput.value = '';
      renderBranchMenu();
      closeAllDropdowns();
    });

    for (const d of filtered.slice(0, 250)) {
      const btn = createItem(
        { active: d.slug === current, disabled: false, attrs: { 'data-hero-district-value': d.slug, 'data-hero-district-text': d.ad } },
        d.ad,
      );
      districtMenu.append(btn);
      bindPick(btn, () => {
        districtHidden.value = d.slug;
        if (districtInput) districtInput.value = d.ad;
        if (branchHidden) branchHidden.value = '';
        if (branchInput) branchInput.value = '';
        renderBranchMenu();
        closeAllDropdowns();
      });
    }

    if (filtered.length === 0 && q) {
      const p = document.createElement('p');
      p.className = 'hero-combobox-empty';
      p.textContent = 'Eşleşen ilçe bulunamadı.';
      districtMenu.append(p);
    }
  }

  function branchesForLocation(ilSlug, ilceSlug) {
    if (!ilSlug) return branchOptions.slice();
    const filtered = clubBranchAreaIndex.filter((row) => {
      if (!row.bransSlug || row.ilSlug !== ilSlug) return false;
      if (ilceSlug) return row.ilceSlug === ilceSlug;
      return true;
    });
    const slugs = [...new Set(filtered.map((r) => r.bransSlug))];
    return slugs
      .map((s) => branchBySlug.get(s))
      .filter(Boolean)
      .sort((a, b) => a.ad.localeCompare(b.ad, 'tr'));
  }

  /** filterText === undefined → inputtaki metinle süz; boş string → odakta tüm liste */
  function renderBranchMenu(filterText) {
    if (!branchMenu || !branchHidden) return;
    const ilSlug = cityHidden?.value?.trim() ?? '';
    const ilceSlug = districtHidden?.value?.trim() ?? '';
    const narrowed = Boolean(ilSlug);
    let list = narrowed ? branchesForLocation(ilSlug, ilceSlug) : branchOptions.slice();
    const rawFilter = filterText === undefined ? (branchInput?.value ?? '') : filterText;
    const typeQ = norm(rawFilter);
    if (typeQ) {
      list = list.filter((b) => norm(b.ad).includes(typeQ));
    }
    const currentSlug = branchHidden.value?.trim() ?? '';

    branchMenu.innerHTML = '';

    const allBtn = createItem(
      { active: !currentSlug, disabled: false, attrs: { 'data-hero-branch-value': '', 'data-hero-branch-text': 'Tüm Branşlar' } },
      'Tüm Branşlar',
    );
    branchMenu.append(allBtn);
    bindPick(allBtn, () => {
      branchHidden.value = '';
      if (branchInput) branchInput.value = '';
      closeAllDropdowns();
    });

    if (narrowed && branchesForLocation(ilSlug, ilceSlug).length === 0 && !typeQ) {
      const empty = document.createElement('div');
      empty.className = 'hero-branch-empty';
      empty.innerHTML =
        '<p class="hero-branch-empty-title">Bu konumda kayıtlı branş yok</p>' +
        '<p class="hero-branch-empty-desc">Seçtiğiniz il ve ilçede üyeliği olan kulüp henüz bulunmuyor. Kulübünüzü eklemek için başvurun veya bize yazın.</p>';
      branchMenu.append(empty);
      if (currentSlug) {
        branchHidden.value = '';
        if (branchInput) branchInput.value = '';
      }
      allBtn.classList.add('is-active');
      return;
    }

    if (narrowed && branchesForLocation(ilSlug, ilceSlug).length > 0 && !typeQ) {
      const hint = document.createElement('p');
      hint.className = 'hero-branch-filter-hint';
      hint.textContent = ilceSlug
        ? 'Bu ilçede kayıtlı kulübü olan branşlar:'
        : 'Bu ilde kayıtlı kulübü olan branşlar:';
      branchMenu.append(hint);
    }

    if (typeQ && list.length === 0) {
      const p = document.createElement('p');
      p.className = 'hero-combobox-empty';
      p.textContent = 'Eşleşen branş bulunamadı.';
      branchMenu.append(p);
    }

    for (const b of list) {
      const btn = createItem(
        { active: b.slug === currentSlug, disabled: false, attrs: { 'data-hero-branch-value': b.slug, 'data-hero-branch-text': b.ad } },
        b.ad,
      );
      branchMenu.append(btn);
      bindPick(btn, () => {
        branchHidden.value = b.slug;
        if (branchInput) branchInput.value = b.ad;
        closeAllDropdowns();
      });
    }

    if (currentSlug && !list.some((b) => b.slug === currentSlug)) {
      branchHidden.value = '';
      if (branchInput) branchInput.value = '';
      allBtn.classList.add('is-active');
    }
  }

  function syncCityFromInput() {
    if (!cityInput || !cityHidden) return;
    if (!(cityInput.value ?? '').trim()) return;
    const m = findMatch(cityOptions, cityInput.value);
    cityHidden.value = m?.slug ?? '';
  }

  function syncDistrictFromInput() {
    if (!districtInput || !districtHidden) return;
    if (!(districtInput.value ?? '').trim()) return;
    const m = findMatch(districtList, districtInput.value);
    districtHidden.value = m?.slug ?? '';
  }

  function syncBranchFromInput() {
    if (!branchInput || !branchHidden) return;
    if (!(branchInput.value ?? '').trim()) return;
    const m = findMatch(branchOptions, branchInput.value);
    branchHidden.value = m?.slug ?? '';
  }

  function renderDefaultDistrictState() {
    districtList = [];
    if (branchHidden) branchHidden.value = '';
    if (branchInput) branchInput.value = '';
    if (!districtMenu || !districtHidden || !districtInput) return;
    districtMenu.innerHTML = '';
    districtHidden.value = '';
    districtInput.value = '';
    setDistrictDisabled(true);
    renderDistrictMenu('');
  }

  async function loadDistricts(citySlug, preferredValue = '') {
    if (!districtMenu || !districtHidden || !districtInput) return;
    if (!citySlug) {
      renderDefaultDistrictState();
      renderBranchMenu();
      return;
    }

    setDistrictDisabled(true);
    districtMenu.innerHTML = '';
    districtMenu.append(createItem({ active: false, disabled: true, attrs: {} }, 'Yükleniyor...'));

    try {
      const response = await fetch(`/api/districts?il=${encodeURIComponent(citySlug)}`);
      if (!response.ok) throw new Error('İlçe listesi alınamadı');
      const payload = await response.json();
      const items = Array.isArray(payload?.items) ? payload.items : [];
      districtList = items;
      const selectedDistrict = items.find((item) => item.slug === preferredValue);

      districtHidden.value = selectedDistrict?.slug ?? '';
      districtInput.value = selectedDistrict?.ad ?? '';
      districtInput.placeholder = 'Tüm ilçeler';
      setDistrictDisabled(false);
      renderDistrictMenu('');
      renderBranchMenu();
    } catch (_e) {
      districtList = [];
      districtMenu.innerHTML = '';
      districtMenu.append(createItem({ active: false, disabled: true, attrs: {} }, 'İlçeler yüklenemedi'));
      districtHidden.value = '';
      districtInput.value = '';
      if (branchHidden) branchHidden.value = '';
      if (branchInput) branchInput.value = '';
      setDistrictDisabled(true);
      renderBranchMenu();
    }
  }

  function openCityDropdown() {
    openOnly(citySelect, cityInput);
    if (cityInput) cityInput.value = '';
    renderCityMenu('');
  }

  function openDistrictDropdown() {
    if (districtInput?.disabled) return;
    openOnly(districtSelect, districtInput);
    if (districtInput) districtInput.value = '';
    renderDistrictMenu('');
  }

  function openBranchDropdown() {
    openOnly(branchSelect, branchInput);
    if (branchInput) branchInput.value = '';
    renderBranchMenu('');
  }

  cityInput?.addEventListener('focus', () => {
    openCityDropdown();
  });

  cityInput?.addEventListener('input', () => {
    openOnly(citySelect, cityInput);
    renderCityMenu(cityInput.value);
  });

  cityInput?.addEventListener('blur', () => {
    const before = cityHidden?.value ?? '';
    if (cityInput && !(cityInput.value ?? '').trim() && cityHidden?.value?.trim()) {
      const keep = cityOptions.find((c) => c.slug === cityHidden.value.trim());
      if (keep) cityInput.value = keep.ad;
    }
    syncCityFromInput();
    let after = cityHidden?.value ?? '';
    const m = cityOptions.find((c) => c.slug === after);
    if (!m && cityInput?.value?.trim()) {
      if (cityHidden) cityHidden.value = '';
      after = '';
    }
    if (cityInput) {
      if (m) cityInput.value = m.ad;
      else if (!after) cityInput.value = '';
    }
    if (before !== after) {
      loadDistricts(after, '');
    }
  });

  districtInput?.addEventListener('focus', () => {
    if (!districtInput.disabled) openDistrictDropdown();
  });

  districtInput?.addEventListener('input', () => {
    if (districtInput.disabled) return;
    openOnly(districtSelect, districtInput);
    renderDistrictMenu(districtInput.value);
  });

  districtInput?.addEventListener('blur', () => {
    const before = districtHidden?.value ?? '';
    if (districtInput && !(districtInput.value ?? '').trim() && districtHidden?.value?.trim()) {
      const keep = districtList.find((d) => d.slug === districtHidden.value.trim());
      if (keep) districtInput.value = keep.ad;
    }
    syncDistrictFromInput();
    let after = districtHidden?.value ?? '';
    const m = districtList.find((d) => d.slug === after);
    if (!m && districtInput?.value?.trim()) {
      if (districtHidden) districtHidden.value = '';
      after = '';
    }
    if (districtInput) {
      if (m) districtInput.value = m.ad;
      else if (!after) districtInput.value = '';
    }
    if (before !== after) {
      renderBranchMenu();
    }
  });

  branchInput?.addEventListener('focus', () => {
    openBranchDropdown();
  });

  branchInput?.addEventListener('input', () => {
    openOnly(branchSelect, branchInput);
    renderBranchMenu();
  });

  branchInput?.addEventListener('blur', () => {
    if (branchInput && !(branchInput.value ?? '').trim() && branchHidden?.value?.trim()) {
      const keep = branchOptions.find((b) => b.slug === branchHidden.value.trim());
      if (keep) branchInput.value = keep.ad;
    }
    syncBranchFromInput();
    const after = branchHidden?.value ?? '';
    const m = branchOptions.find((b) => b.slug === after);
    if (!m && branchInput?.value?.trim()) {
      if (branchHidden) branchHidden.value = '';
    }
    if (branchInput) {
      if (m) branchInput.value = m.ad;
      else if (!branchHidden?.value) branchInput.value = '';
    }
  });

  heroForm?.addEventListener('submit', () => {
    syncCityFromInput();
    syncDistrictFromInput();
    syncBranchFromInput();
  });

  if (cityHidden?.value) {
    loadDistricts(cityHidden.value, districtHidden?.value ?? '');
  } else {
    renderDefaultDistrictState();
    renderBranchMenu();
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (citySelect?.contains(target) || districtSelect?.contains(target) || branchSelect?.contains(target)) return;
    closeAllDropdowns();
  });

  if (cityRotator) {
    const track = cityRotator.querySelector('[data-city-track]');
    const items = track ? Array.from(track.querySelectorAll('.city-item')) : [];
    let index = 0;
    const itemHeight = items[0]?.getBoundingClientRect().height ?? 0;

    if (track && itemHeight > 0 && items.length > 2) {
      window.setInterval(() => {
        index += 1;
        track.style.transition = 'transform 420ms cubic-bezier(0.4, 0, 0.2, 1)';
        track.style.transform = `translateY(-${index * itemHeight}px)`;

        if (index >= items.length - 2) {
          window.setTimeout(() => {
            track.style.transition = 'none';
            track.style.transform = 'translateY(0)';
            index = 0;
          }, 450);
        }
      }, 1800);
    }
  }
</script>

