---
interface Props {
  errorCode?: string;
}

const { errorCode = '' } = Astro.props;

const errorMessage =
  errorCode === 'invalid'
    ? 'E-posta veya şifre hatalı.'
    : errorCode === 'missing'
      ? 'Lütfen e-posta ve şifre alanlarını doldurun.'
      : errorCode === 'rate_limit'
        ? 'Çok fazla hatalı giriş denemesi yapıldı. Güvenliğiniz için lütfen birkaç dakika sonra tekrar deneyin.'
        : errorCode === 'auth'
          ? 'Bu sayfayı görmek için giriş yapmalısınız.'
          : errorCode === 'forbidden'
            ? 'Panele erişim için onaylı kulüp hesabı gerekir.'
            : errorCode === 'password_changed'
              ? 'Şifreniz güncellendi. Yeni şifrenizle giriş yapabilirsiniz.'
              : '';
---

<section class="admin-login-page">
  <div class="admin-login-card">
    <div class="admin-login-brand">
      <a href="/" class="admin-login-logo-link" title="SporNerede.net Ana Sayfa">
        <img src="/logo-spornerede-header-markup.svg" alt="Spor Nerede?" class="admin-login-logo-img" width="115" height="46" />
      </a>
      <div class="admin-login-brand-text">
        <h1>Yönetim Merkezi</h1>
        <p>SporNerede.net başvuru ve kulüp yönetimi</p>
      </div>
    </div>

    {errorMessage && <p class="admin-login-error" role="alert">{errorMessage}</p>}

    <form class="admin-login-form" method="post" action="/api/panel/login">
      <input type="hidden" name="redirectTo" value="/merkez" />
      <label>
        <span>E-posta</span>
        <input name="email" type="email" autocomplete="username" required />
      </label>
      <label>
        <span>Şifre</span>
        <input name="password" type="password" autocomplete="current-password" required />
      </label>
      <button type="submit">Giriş yap</button>
    </form>

    <p class="admin-login-foot">
      <a href="/">← Ana siteye dön</a>
    </p>
  </div>
</section>

<style>
  .admin-login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem;
    background:
      radial-gradient(ellipse 80% 60% at 20% 0%, rgba(227, 10, 23, 0.12), transparent 55%),
      radial-gradient(ellipse 70% 50% at 100% 100%, rgba(15, 23, 42, 0.08), transparent 50%),
      #f1f5f9;
  }

  .admin-login-card {
    width: 100%;
    max-width: 26rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1.25rem;
    padding: 2rem 1.75rem;
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.08);
  }

  .admin-login-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .admin-login-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .admin-login-logo-img {
    height: 42px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    display: block;
  }

  .admin-login-brand-text h1 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  .admin-login-brand-text p {
    margin: 0.25rem 0 0;
    font-size: 0.88rem;
    color: #64748b;
  }

  .admin-login-error {
    margin: 0 0 1rem;
    padding: 0.65rem 0.85rem;
    border-radius: 0.65rem;
    background: #fff5f5;
    border: 1px solid #ffc9c9;
    color: #c92a2a;
    font-size: 0.88rem;
  }

  .admin-login-form {
    display: grid;
    gap: 1rem;
  }

  .admin-login-form label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
  }

  .admin-login-form input {
    border: 1px solid #cbd5e1;
    border-radius: 0.65rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.95rem;
  }

  .admin-login-form input:focus {
    outline: none;
    border-color: #e30a17;
    box-shadow: 0 0 0 3px rgba(227, 10, 23, 0.15);
  }

  .admin-login-form button {
    margin-top: 0.25rem;
    border: 0;
    border-radius: 0.7rem;
    padding: 0.75rem 1rem;
    background: #e30a17;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .admin-login-form button:hover {
    background: #b5080f;
  }

  .admin-login-foot {
    margin: 1.25rem 0 0;
    text-align: center;
    font-size: 0.85rem;
  }

  .admin-login-foot a {
    color: #64748b;
    text-decoration: none;
  }

  .admin-login-foot a:hover {
    color: #e30a17;
  }
</style>
