---
/**
 * AdSlot.astro
 *
 * CLS (Cumulative Layout Shift) güvenli reklam slot placeholder'ı.
 * Şu an reklam yayını yok, ileride Google AdSense / direct / programmatic
 * eklendiğinde bu component'in içeriği değiştirilir, layout zıplamaz.
 *
 * Slot tipleri (önerilen boyutlar):
 *   - "leaderboard"   = 728x90 (desktop), 320x100 (mobil) — sayfa basi/sonu
 *   - "rectangle"     = 300x250 — sidebar / icerik arasi
 *   - "skyscraper"    = 160x600 — desktop sidebar
 *   - "feed"          = 300x250 — liste sonuclarinin arasi
 *
 * Reklam env aktif değilse görünmez yer kaplama (placeholder).
 * `data-ad-slot` ile GTM tarafından doldurulabilir.
 */

interface Props {
  /** Slot tipi (boyut profili) */
  variant?: 'leaderboard' | 'rectangle' | 'skyscraper' | 'feed';
  /** GTM/AdSense slot id'si (data-ad-slot olarak yazilir) */
  slotId?: string;
  /** Reklam etiketi (zorunlu, ICTA standardı) */
  label?: string;
  /** Sınıf adı (özelleştirme için) */
  class?: string;
}

const {
  variant = 'leaderboard',
  slotId = '',
  label = 'Reklam',
  class: className = '',
} = Astro.props;

// Reklam yayını aktif mi? Eger PUBLIC_AD_PROVIDER set degilse slot gorunmez.
const adProvider = (import.meta.env.PUBLIC_AD_PROVIDER ?? '').trim();
const isAdActive = Boolean(adProvider);
---

{isAdActive ? (
  <aside
    class:list={['ad-slot', `ad-slot--${variant}`, className]}
    data-ad-slot={slotId}
    data-ad-variant={variant}
    aria-label={label}
  >
    <span class="ad-slot-label" aria-hidden="true">{label}</span>
    {/* GTM bu container'a tag enjekte eder. Su an placeholder. */}
    <div class="ad-slot-inner"></div>
  </aside>
) : (
  /* Reklam yayini yokken bile yer rezerve edilir; render edilmiyor.
     Tasarim test'i icin debug=1 ile querystring'te aktif edilebilir. */
  <Fragment />
)}

<style>
  .ad-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    margin: 1rem auto;
    background: #fafbfc;
    border: 1px dashed #d6dce3;
    border-radius: 0.6rem;
    overflow: hidden;
    position: relative;
  }
  .ad-slot-label {
    position: absolute;
    top: 4px;
    left: 8px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9aa3ad;
    pointer-events: none;
  }
  .ad-slot-inner {
    width: 100%;
    height: 100%;
  }

  /* CLS-safe sabit boyutlar (aspect-ratio + min-height) */
  .ad-slot--leaderboard {
    width: 100%;
    max-width: 728px;
    aspect-ratio: 728 / 90;
    min-height: 90px;
  }
  @media (max-width: 768px) {
    .ad-slot--leaderboard {
      max-width: 320px;
      aspect-ratio: 320 / 100;
      min-height: 100px;
    }
  }

  .ad-slot--rectangle {
    width: 300px;
    height: 250px;
  }

  .ad-slot--skyscraper {
    width: 160px;
    height: 600px;
  }
  @media (max-width: 992px) {
    .ad-slot--skyscraper { display: none; }
  }

  .ad-slot--feed {
    width: 100%;
    max-width: 320px;
    height: 250px;
  }
</style>
