---
/**
 * Footer.astro
 * Site genelinde kullanılan footer bileşeni.
 */

const hizliLinkler = [
  { label: 'Ana Sayfa',   href: '/' },
  { label: 'Arama',       href: '/ara' },
  { label: 'Haberler',    href: '/haberler' },
];

const bilgiLinkleri = [
  { label: 'Hakkımızda',    href: '/hakkimizda' },
  { label: 'İletişim',     href: '/iletisim' },
  { label: 'Gizlilik',     href: '/gizlilik' },
  { label: 'Kullanım Koş.', href: '/kullanim' },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">

  <!-- ===== ÜST KISiM ===== -->
  <div class="footer-top">
    <div class="container footer-grid">

      <!-- Sütun 1: Logo & Açıklama -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Spor Nerede? Ana Sayfa">
          <span class="footer-logo-markup">
            <span class="footer-logo-stack">
              <span class="footer-logo-line footer-logo-line--top">spor</span>
              <span class="footer-logo-line footer-logo-line--bottom">nerede</span>
            </span>
            <span class="footer-logo-q" aria-hidden="true">?</span>
          </span>
        </a>
        <p class="footer-desc">
          Türkiye'nin en kapsamlı spor branş ve kulüp rehberi. Sporu keşfet, harekete geç.
        </p>
        <div class="footer-social" aria-label="Sosyal Medya">
          <a href="#" class="social-link" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Twitter/X">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4l16 16M4 20L20 4"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.95C18.88 4 12 4 12 4s-6.88 0-8.59.47a2.78 2.78 0 0 0-1.95 1.95C1 8.12 1 12 1 12s0 3.88.46 5.58a2.78 2.78 0 0 0 1.95 1.95C5.12 20 12 20 12 20s6.88 0 8.59-.47a2.78 2.78 0 0 0 1.95-1.95C23 15.88 23 12 23 12s0-3.88-.46-5.58z"/>
              <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Sütun 2: Hızlı Linkler -->
      <div class="footer-col">
        <h3 class="footer-col-title">Hızlı Linkler</h3>
        <ul class="footer-links" role="list">
          {hizliLinkler.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Sütun 3: Bilgi -->
      <div class="footer-col">
        <h3 class="footer-col-title">Bilgi</h3>
        <ul class="footer-links" role="list">
          {bilgiLinkleri.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>

  <!-- ===== ALT KISIM ===== -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {currentYear} SporNerede.net — Spor dünyasını ailelerle buluşturan
        <strong>Murat Aktaş</strong> girişimidir.
      </p>
      <p class="footer-tagline">
        <span aria-hidden="true">🏙️</span>
        Türkiye genelinde spor kursu ve kulüp arayan ailelerin buluşma noktası
      </p>
    </div>
  </div>

</footer>

<style>
  /* ===== FOOTER ===== */
  .site-footer {
    background-color: #0D0D0D;
    color: rgba(255,255,255,0.7);
  }

  /* ===== ÜST KISIM ===== */
  .footer-top {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .footer-grid { grid-template-columns: 2fr 1fr 1fr; }
  }

  /* ===== BRAND ===== */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    width: fit-content;
  }

  .footer-logo-markup {
    display: inline-flex;
    align-items: stretch;
    gap: 0.14rem;
  }

  .footer-logo-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.06rem;
    line-height: 1;
  }

  .footer-logo-line {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .footer-logo-line--top {
    font-size: 1.14rem;
    letter-spacing: -0.03em;
  }

  .footer-logo-line--bottom {
    font-size: 1.01rem;
    letter-spacing: -0.025em;
  }

  .footer-logo-q {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-size: 2.45rem;
    line-height: 0.85;
    color: #FF6B75;
  }

  .footer-desc {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.7;
    max-width: 260px;
  }

  /* ===== SOSYAL MEDYA ===== */
  .footer-social {
    display: flex;
    gap: 0.625rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    color: rgba(255,255,255,0.5);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    background: #E30A17;
    border-color: #E30A17;
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* ===== SÜTUNLAR ===== */
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-col-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.85);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-link {
    font-size: 0.86rem;
    color: rgba(255,255,255,0.45);
    text-decoration: none;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .footer-link:hover {
    color: #E30A17;
  }

  /* ===== ALT KISIM ===== */
  .footer-bottom {
    padding: 1.5rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-copyright {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.35);
  }

  .footer-copyright strong {
    color: rgba(255,255,255,0.65);
    font-weight: 700;
  }

  .footer-tagline {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.25);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>
