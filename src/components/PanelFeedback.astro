---
const isPanel = Astro.url.pathname.startsWith('/panel');
---

{isPanel && (
<div id="panel-feedback-wrapper" class="panel-feedback-wrapper">
  <button id="panel-feedback-btn" class="panel-feedback-btn" type="button" aria-label="Geribildirim Gönder">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span>Geribildirim</span>
  </button>

  <div id="panel-feedback-box" class="panel-feedback-box" hidden>
    <div class="feedback-head">
      <div>
        <h4>Geliştirme Önerisi Gönderin</h4>
        <p>Paneli sizin kullanımınıza göre iyileştirelim.</p>
      </div>
      <button id="close-feedback-btn" type="button" aria-label="Kapat">&times;</button>
    </div>
    <div class="feedback-body">
      <label class="feedback-field">
        <span>Ad Soyad</span>
        <input id="feedback-name" type="text" placeholder="Adınız ve soyadınız" autocomplete="name" />
      </label>
      <label class="feedback-field">
        <span>Mesajınız</span>
        <textarea id="feedback-message" rows="5" placeholder="Panelde neyi geliştirmemizi istersiniz? Yaşadığınız hata veya öneriyi mümkünse adım adım yazın..." required></textarea>
      </label>
      <label class="feedback-upload">
        <input id="feedback-image" type="file" accept="image/*" />
        <span class="upload-copy">
          <strong>Fotoğraf / ekran görüntüsü ekle</strong>
          <small>PNG, JPG veya WebP - en fazla 5 MB</small>
        </span>
      </label>
      <div id="feedback-file-name" class="feedback-file-name"></div>
      <div id="feedback-status" class="feedback-status"></div>
      <button id="submit-feedback-btn" class="btn btn-primary btn-block" type="button">Geliştirme Ekibine Gönder</button>
    </div>
  </div>
</div>
)}

<style>
  .panel-feedback-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .panel-feedback-btn {
    background: #0f172a;
    color: white;
    border: none;
    border-radius: 999px;
    padding: 10px 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(15,23,42,0.25);
    transition: all 0.2s;
  }
  
  .panel-feedback-btn:hover {
    background: #1e293b;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(15,23,42,0.3);
  }

  .panel-feedback-btn.is-hidden {
    display: none;
  }

  .panel-feedback-box {
    background: white;
    border-radius: 18px;
    width: 390px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.15);
    border: 1px solid #e2e8f0;
    margin-bottom: 12px;
    overflow: hidden;
    animation: feedbackSlideUp 0.3s ease-out;
    transform-origin: bottom right;
  }

  .panel-feedback-box[hidden] {
    display: none;
  }

  .feedback-head {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    padding: 16px 18px;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .feedback-head h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
  }

  .feedback-head p {
    margin: 0.25rem 0 0;
    color: rgba(255,255,255,0.72);
    font-size: 0.82rem;
  }

  #close-feedback-btn {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    color: rgba(255,255,255,0.72);
    cursor: pointer;
    padding: 0;
  }
  
  #close-feedback-btn:hover {
    color: #ffffff;
  }

  .feedback-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feedback-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .feedback-field span {
    color: #0f172a;
    font-size: 0.82rem;
    font-weight: 800;
  }

  #feedback-message,
  #feedback-name {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px;
    font-family: inherit;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }

  #feedback-message {
    resize: vertical;
    min-height: 120px;
  }

  #feedback-message:focus,
  #feedback-name:focus {
    border-color: #3b82f6;
  }

  .feedback-upload {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    background: #f8fafc;
    cursor: pointer;
  }

  .feedback-upload:hover {
    border-color: #94a3b8;
    background: #f1f5f9;
  }

  .feedback-upload input {
    width: 1rem;
    height: 1rem;
    accent-color: #0f172a;
  }

  .upload-copy {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .upload-copy strong {
    color: #0f172a;
    font-size: 0.86rem;
  }

  .upload-copy small,
  .feedback-file-name {
    color: #64748b;
    font-size: 0.78rem;
  }

  .feedback-status {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .feedback-status.error { color: #dc2626; }
  .feedback-status.success { color: #16a34a; }

  @keyframes feedbackSlideUp {
    from { opacity: 0; transform: scale(0.95) translateY(10px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  
  @media (max-width: 480px) {
    .panel-feedback-wrapper {
      bottom: 16px;
      right: 16px;
    }
    .panel-feedback-box {
      width: calc(100vw - 32px);
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('panel-feedback-btn');
  const closeBtn = document.getElementById('close-feedback-btn');
  const feedbackBox = document.getElementById('panel-feedback-box');
  const submitBtn = document.getElementById('submit-feedback-btn');
  const nameInput = document.getElementById('feedback-name') as HTMLInputElement;
  const messageInput = document.getElementById('feedback-message') as HTMLTextAreaElement;
  const imageInput = document.getElementById('feedback-image') as HTMLInputElement;
  const fileNameDiv = document.getElementById('feedback-file-name');
  const statusDiv = document.getElementById('feedback-status');

  if (toggleBtn && closeBtn && feedbackBox && submitBtn && nameInput && messageInput && imageInput && fileNameDiv && statusDiv) {
    toggleBtn.addEventListener('click', () => {
      feedbackBox.hidden = false;
      toggleBtn.classList.add('is-hidden');
      messageInput.focus();
    });

    closeBtn.addEventListener('click', () => {
      feedbackBox.hidden = true;
      toggleBtn.classList.remove('is-hidden');
      statusDiv.textContent = '';
      statusDiv.className = 'feedback-status';
    });

    imageInput.addEventListener('change', () => {
      const file = imageInput.files?.[0];
      fileNameDiv.textContent = file ? `Eklenen dosya: ${file.name}` : '';
    });

    submitBtn.addEventListener('click', async () => {
      const mesaj = messageInput.value.trim();
      const adSoyad = nameInput.value.trim();
      if (!mesaj) {
        statusDiv.textContent = 'Lütfen bir mesaj yazın.';
        statusDiv.className = 'feedback-status error';
        return;
      }

      const file = imageInput.files?.[0];
      if (file && file.size > 5 * 1024 * 1024) {
        statusDiv.textContent = 'Eklediğiniz görsel 5 MB sınırını aşıyor.';
        statusDiv.className = 'feedback-status error';
        return;
      }

      statusDiv.textContent = 'Gönderiliyor...';
      statusDiv.className = 'feedback-status';
      submitBtn.setAttribute('disabled', 'true');

      try {
        const browserInfo = {
          userAgent: navigator.userAgent,
          language: navigator.language,
          platform: navigator.platform,
          viewport: `${window.innerWidth}x${window.innerHeight}`,
          screen: `${window.screen.width}x${window.screen.height}`,
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
          url: window.location.href,
          referrer: document.referrer,
        };

        const formData = new FormData();
        formData.append('adSoyad', adSoyad);
        formData.append('mesaj', mesaj);
        formData.append('sayfaUrl', window.location.href);
        formData.append('tarayiciBilgisi', JSON.stringify(browserInfo, null, 2));
        if (file) {
          formData.append('gorsel', file);
        }

        const res = await fetch('/api/panel/feedback', {
          method: 'POST',
          body: formData,
        });
        
        const data = await res.json();
        if (res.ok) {
          statusDiv.textContent = 'Geri bildiriminiz tarafımıza ulaştı. En kısa sürede inceleyip paneli daha iyi hale getirmek için değerlendireceğiz. Katkınız için teşekkür ederiz.';
          statusDiv.className = 'feedback-status success';
          nameInput.value = '';
          messageInput.value = '';
          imageInput.value = '';
          fileNameDiv.textContent = '';
          setTimeout(() => {
            feedbackBox.hidden = true;
            toggleBtn.classList.remove('is-hidden');
            statusDiv.textContent = '';
          }, 3000);
        } else {
          throw new Error(data.error || 'Gönderilemedi');
        }
      } catch (err: any) {
        statusDiv.textContent = err.message || 'Bir hata oluştu.';
        statusDiv.className = 'feedback-status error';
      } finally {
        submitBtn.removeAttribute('disabled');
      }
    });
  }
</script>