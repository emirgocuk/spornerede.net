{
  "name": "spornerede",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "release:gate": "node scripts/release-gate.mjs",
    "smoke:check": "node scripts/smoke-check.mjs",
    "build:outbox": "npm run build && node scripts/sync-outbox.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:seed": "tsx scripts/db-seed.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "pb:up": "docker compose -f docker-compose.pocketbase.yml up -d",
    "pb:down": "docker compose -f docker-compose.pocketbase.yml down",
    "pb:start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"./pocketbase/pocketbase.exe serve --http=127.0.0.1:8090\"",
    "pb:stop": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$pbPid=(Get-NetTCPConnection -LocalAddress 127.0.0.1 -LocalPort 8090 -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty OwningProcess); if ($pbPid) { Stop-Process -Id $pbPid -Force; Write-Host ('Stopped PID ' + $pbPid) } else { Write-Host 'PocketBase not running on 8090' }\"",
    "pb:setup": "tsx scripts/pb-setup.ts",
    "user:create": "tsx scripts/create-user.ts",
    "user:assign-club": "tsx scripts/assign-user-club.ts",
    "deploy:remote": "bash deploy.sh",
    "deploy:win": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
    "ssh:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ssh-key.ps1",
    "rollback:remote": "bash rollback.sh",
    "deploy:prod": "bash deploy/all-in-one.sh",
    "deploy:quick": "bash deploy.sh --update-nginx",
    "deploy:app": "bash deploy.sh",
    "rollback:prod": "bash rollback.sh"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.5",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tiptap/core": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "astro": "^6.1.6",
    "nodemailer": "^8.0.5",
    "pocketbase": "^0.26.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.21.0"
  }
}
