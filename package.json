{
  "name": "spornerede",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run fonts:copy",
    "build": "astro build",
    "release:gate": "node scripts/release-gate.mjs",
    "smoke:check": "node scripts/smoke-check.mjs",
    "build:outbox": "npm run build && node scripts/sync-outbox.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:seed": "tsx scripts/db-seed.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "pb:up": "docker compose -f docker-compose.pocketbase.yml up -d",
    "pb:down": "docker compose -f docker-compose.pocketbase.yml down",
    "pb:start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"./pocketbase/pocketbase.exe serve --http=127.0.0.1:8090\"",
    "pb:import-il-ilce": "node scripts/pb-import-il-ilce.mjs",
    "pb:sync-branch-emojis": "tsx scripts/sync-branch-emojis.ts",
    "pb:check-il-ilce": "node scripts/pb-check-il-ilce.mjs",
    "pb:stop": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$pbPid=(Get-NetTCPConnection -LocalAddress 127.0.0.1 -LocalPort 8090 -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty OwningProcess); if ($pbPid) { Stop-Process -Id $pbPid -Force; Write-Host ('Stopped PID ' + $pbPid) } else { Write-Host 'PocketBase not running on 8090' }\"",
    "backup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-backup.ps1",
    "pb:setup": "tsx scripts/pb-setup.ts",
    "content-engine:install": "npm install --prefix content-engine",
    "content-engine:check": "npm run check:env --prefix content-engine",
    "content-engine:setup": "npm run setup:collections --prefix content-engine",
    "content-engine:repair": "npm run repair:collections --prefix content-engine",
    "content-engine:seed": "npm run seed:keywords --prefix content-engine",
    "content-engine:drafts": "npm run list:drafts --prefix content-engine",
    "content-engine:publish": "npm run publish:draft --prefix content-engine",
    "content-engine:keywords": "npm run job:keywords --prefix content-engine",
    "content-engine:gsc": "npm run job:gsc --prefix content-engine",
    "content-engine:gsc-check": "npm run gsc:check --prefix content-engine",
    "content-engine:gsc-oauth": "npm run gsc:oauth --prefix content-engine",
    "content-engine:smoke": "npm run smoke --prefix content-engine",
    "content-engine:smoke-quick": "npm run smoke:quick --prefix content-engine",
    "content-engine:manual-draft": "npm run create:manual-draft --prefix content-engine",
    "content-engine:manual-news": "npm run create:manual-news --prefix content-engine",
    "content-engine:news": "npm run list:news --prefix content-engine",
    "content-engine:publish-news": "npm run publish:news --prefix content-engine",
    "content-engine:complete-news": "npm run complete:news --prefix content-engine",
    "content-engine:template-news": "npm run template:news --prefix content-engine",
    "mail:up": "docker compose -f docker-compose.mailpit.yml up -d",
    "mail:down": "docker compose -f docker-compose.mailpit.yml down",
    "mail:queue": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Invoke-RestMethod -Uri 'http://localhost:4321/api/internal/mail-queue' -Method POST -Headers @{ 'x-mail-queue-token' = 'local-test-token' }\"",
    "user:create": "tsx scripts/create-user.ts",
    "user:assign-club": "tsx scripts/assign-user-club.ts",
    "deploy:remote": "bash deploy.sh",
    "deploy:win": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
    "ssh:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ssh-key.ps1",
    "rollback:remote": "bash rollback.sh",
    "deploy:prod": "bash deploy/all-in-one.sh",
    "deploy:quick": "bash deploy.sh --update-nginx",
    "logo:header-outline": "node scripts/outline-header-logo.mjs && node scripts/write-header-logo-canvas.mjs",
    "logo:outfit-outline": "node scripts/outline-outfit-logo.mjs",
    "og:generate": "node scripts/generate-og-image.mjs",
    "fonts:copy": "node scripts/copy-fonts.mjs",
    "deploy:app": "bash deploy.sh",
    "rollback:prod": "bash rollback.sh"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.5",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.6",
    "nodemailer": "^8.0.5",
    "pocketbase": "^0.26.2",
    "quill": "^2.0.3",
    "tailwindcss": "^4.2.2",
    "tinymce": "^8.4.0"
  },
  "devDependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@types/nodemailer": "^8.0.0",
    "opentype.js": "^1.3.5",
    "tsx": "^4.21.0"
  }
}
