# Bu dosyayi repoda `.env.deploy` olarak kopyalayin (GIT'e eklemeyin; .gitignore'da).
#
#   cp deploy/env.deploy.example .env.deploy
#
# SSH anahtari (bir kez; sonra sifresiz deploy):
#   npm run ssh:setup
#   npm run ssh:setup -- -UpdateEnvDeploy
#
# Windows PowerShell (ssh/scp/tar; .env.deploy DEPLOY_SSH okunur):
#   npm run deploy:win
#
# Sunucu doctor + bash deploy (Git Bash onerilir):
#   npm run deploy:prod
#
# Sadece hizli yukleme (sunucu doctor atlanir, lokal build deploy.sh icinde):
#   npm run deploy:quick

# ASAGIDAKI SATIRI DUZENLE: SUNUCU_IP yazma — gercek IP veya alan adi (ornek: root@45.155.19.82)
DEPLOY_SSH=root@GERCEK_IP_VEYA_ALAN_ADI

# Opsiyonel:
# REMOTE_BASE=/opt/spornerede
# SYSTEMD_UNIT=spornerede
# NGINX_SERVER_NAME=spornerede.net
# DISABLE_SSH_MUX=1   # SSH mux sorun cikarirsa (genelde gerekmez)
